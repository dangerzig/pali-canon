{
  "id": "kp",
  "name_pali": "Khuddakapāṭha",
  "name_eng": "The Short Passages",
  "collection": "kn",
  "items": [
    {
      "id": "kp1",
      "segments": [
        {
          "id": "kp1:0.1",
          "pali": "Khuddakapāṭha 1"
        },
        {
          "id": "kp1:0.2",
          "pali": "Saraṇattaya"
        },
        {
          "id": "kp1:1.1",
          "pali": "Namo tassa Bhagavato Arahato Sammāsambuddhassa."
        },
        {
          "id": "kp1:2.1",
          "pali": "Buddhaṃ saraṇaṃ gacchāmi,"
        },
        {
          "id": "kp1:2.2",
          "pali": "Dhammaṃ saraṇaṃ gacchāmi,"
        },
        {
          "id": "kp1:2.3",
          "pali": "Saṅghaṃ saraṇaṃ gacchāmi."
        },
        {
          "id": "kp1:3.1",
          "pali": "Dutiyampi buddhaṃ saraṇaṃ gacchāmi,"
        },
        {
          "id": "kp1:3.2",
          "pali": "Dutiyampi dhammaṃ saraṇaṃ gacchāmi,"
        },
        {
          "id": "kp1:3.3",
          "pali": "Dutiyampi saṅghaṃ saraṇaṃ gacchāmi."
        },
        {
          "id": "kp1:4.1",
          "pali": "Tatiyampi buddhaṃ saraṇaṃ gacchāmi,"
        },
        {
          "id": "kp1:4.2",
          "pali": "Tatiyampi dhammaṃ saraṇaṃ gacchāmi,"
        },
        {
          "id": "kp1:4.3",
          "pali": "Tatiyampi saṅghaṃ saraṇaṃ gacchāmi."
        },
        {
          "id": "kp1:5.1",
          "pali": "Saraṇattayaṃ."
        }
      ]
    },
    {
      "id": "kp2",
      "segments": [
        {
          "id": "kp2:0.1",
          "pali": "Khuddakapāṭha 2"
        },
        {
          "id": "kp2:0.2",
          "pali": "Dasasikkhāpada"
        },
        {
          "id": "kp2:1.1",
          "pali": "Pāṇātipātā veramaṇisikkhāpadaṃ samādiyāmi."
        },
        {
          "id": "kp2:2.1",
          "pali": "Adinnādānā veramaṇisikkhāpadaṃ samādiyāmi."
        },
        {
          "id": "kp2:3.1",
          "pali": "Abrahmacariyā veramaṇisikkhāpadaṃ samādiyāmi."
        },
        {
          "id": "kp2:4.1",
          "pali": "Musāvādā veramaṇisikkhāpadaṃ samādiyāmi."
        },
        {
          "id": "kp2:5.1",
          "pali": "Surāmerayamajjapamādaṭṭhānā veramaṇisikkhāpadaṃ samādiyāmi."
        },
        {
          "id": "kp2:6.1",
          "pali": "Vikālabhojanā veramaṇisikkhāpadaṃ samādiyāmi."
        },
        {
          "id": "kp2:7.1",
          "pali": "Naccagītavāditavisūkadassanā veramaṇisikkhāpadaṃ samādiyāmi."
        },
        {
          "id": "kp2:8.1",
          "pali": "Mālāgandhavilepanadhāraṇamaṇḍanavibhūsanaṭṭhānā veramaṇisikkhāpadaṃ samādiyāmi."
        },
        {
          "id": "kp2:9.1",
          "pali": "Uccāsayanamahāsayanā veramaṇisikkhāpadaṃ samādiyāmi."
        },
        {
          "id": "kp2:10.1",
          "pali": "Jātarūparajatapaṭiggahaṇā veramaṇisikkhāpadaṃ samādiyāmi."
        },
        {
          "id": "kp2:11.1",
          "pali": "Dasasikkhāpadaṃ."
        }
      ]
    },
    {
      "id": "kp3",
      "segments": [
        {
          "id": "kp3:0.1",
          "pali": "Khuddakapāṭha 3"
        },
        {
          "id": "kp3:0.2",
          "pali": "Dvattiṃsākāra"
        },
        {
          "id": "kp3:1.1",
          "pali": "Atthi imasmiṃ kāye—Kesā lomā nakhā dantā taco, maṃsaṃ nhāru aṭṭhi aṭṭhimiñjaṃ vakkaṃ, hadayaṃ yakanaṃ kilomakaṃ pihakaṃ papphāsaṃ, antaṃ antaguṇaṃ udariyaṃ karīsaṃ matthaluṅgaṃ, pittaṃ semhaṃ pubbo lohitaṃ sedo medo, assu vasā kheḷo siṅghāṇikā lasikā muttanti."
        },
        {
          "id": "kp3:2.1",
          "pali": "Dvattiṃsākāraṃ."
        }
      ]
    },
    {
      "id": "kp4",
      "segments": [
        {
          "id": "kp4:0.1",
          "pali": "Khuddakapāṭha 4"
        },
        {
          "id": "kp4:0.2",
          "pali": "Kumārapañhā"
        },
        {
          "id": "kp4:1.1",
          "pali": "Ekaṃ nāma kiṃ?"
        },
        {
          "id": "kp4:1.2",
          "pali": "Sabbe sattā āhāraṭṭhitikā."
        },
        {
          "id": "kp4:2.1",
          "pali": "Dve nāma kiṃ?"
        },
        {
          "id": "kp4:2.2",
          "pali": "Nāmañca rūpañca."
        },
        {
          "id": "kp4:3.1",
          "pali": "Tīṇi nāma kiṃ?"
        },
        {
          "id": "kp4:3.2",
          "pali": "Tisso vedanā."
        },
        {
          "id": "kp4:4.1",
          "pali": "Cattāri nāma kiṃ?"
        },
        {
          "id": "kp4:4.2",
          "pali": "Cattāri ariyasaccāni."
        },
        {
          "id": "kp4:5.1",
          "pali": "Pañca nāma kiṃ?"
        },
        {
          "id": "kp4:5.2",
          "pali": "Pañcupādānakkhandhā."
        },
        {
          "id": "kp4:6.1",
          "pali": "Cha nāma kiṃ?"
        },
        {
          "id": "kp4:6.2",
          "pali": "Cha ajjhattikāni āyatanāni."
        },
        {
          "id": "kp4:7.1",
          "pali": "Satta nāma kiṃ?"
        },
        {
          "id": "kp4:7.2",
          "pali": "Satta bojjhaṅgā."
        },
        {
          "id": "kp4:8.1",
          "pali": "Aṭṭha nāma kiṃ?"
        },
        {
          "id": "kp4:8.2",
          "pali": "Ariyo aṭṭhaṅgiko maggo."
        },
        {
          "id": "kp4:9.1",
          "pali": "Nava nāma kiṃ?"
        },
        {
          "id": "kp4:9.2",
          "pali": "Nava sattāvāsā."
        },
        {
          "id": "kp4:10.1",
          "pali": "Dasa nāma kiṃ?"
        },
        {
          "id": "kp4:10.2",
          "pali": "Dasahaṅgehi samannāgato “arahā”ti vuccatīti."
        },
        {
          "id": "kp4:11.1",
          "pali": "Kumārapañhā."
        }
      ]
    },
    {
      "id": "kp5",
      "segments": [
        {
          "id": "kp5:0.1",
          "pali": "Khuddakapāṭha 5"
        },
        {
          "id": "kp5:0.2",
          "pali": "Maṅgalasutta"
        },
        {
          "id": "kp5:1.1",
          "pali": "Evaṃ me sutaṃ—"
        },
        {
          "id": "kp5:1.2",
          "pali": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
        },
        {
          "id": "kp5:1.3",
          "pali": "Atha kho aññatarā devatā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ jetavanaṃ obhāsetvā yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ aṭṭhāsi."
        },
        {
          "id": "kp5:1.4",
          "pali": "Ekamantaṃ ṭhitā kho sā devatā bhagavantaṃ gāthāya ajjhabhāsi—"
        },
        {
          "id": "kp5:2.1",
          "pali": "“Bahū devā manussā ca,"
        },
        {
          "id": "kp5:2.2",
          "pali": "maṅgalāni acintayuṃ;"
        },
        {
          "id": "kp5:2.3",
          "pali": "Ākaṅkhamānā sotthānaṃ,"
        },
        {
          "id": "kp5:2.4",
          "pali": "brūhi maṅgalamuttamaṃ”."
        },
        {
          "id": "kp5:3.1",
          "pali": "“Asevanā ca bālānaṃ,"
        },
        {
          "id": "kp5:3.2",
          "pali": "paṇḍitānañca sevanā;"
        },
        {
          "id": "kp5:3.3",
          "pali": "Pūjā ca pūjaneyyānaṃ,"
        },
        {
          "id": "kp5:3.4",
          "pali": "etaṃ maṅgalamuttamaṃ."
        },
        {
          "id": "kp5:4.1",
          "pali": "Patirūpadesavāso ca,"
        },
        {
          "id": "kp5:4.2",
          "pali": "pubbe ca katapuññatā;"
        },
        {
          "id": "kp5:4.3",
          "pali": "Attasammāpaṇidhi ca,"
        },
        {
          "id": "kp5:4.4",
          "pali": "etaṃ maṅgalamuttamaṃ."
        },
        {
          "id": "kp5:5.1",
          "pali": "Bāhusaccañca sippañca,"
        },
        {
          "id": "kp5:5.2",
          "pali": "vinayo ca susikkhito;"
        },
        {
          "id": "kp5:5.3",
          "pali": "Subhāsitā ca yā vācā,"
        },
        {
          "id": "kp5:5.4",
          "pali": "etaṃ maṅgalamuttamaṃ."
        },
        {
          "id": "kp5:6.1",
          "pali": "Mātāpituupaṭṭhānaṃ,"
        },
        {
          "id": "kp5:6.2",
          "pali": "puttadārassa saṅgaho;"
        },
        {
          "id": "kp5:6.3",
          "pali": "Anākulā ca kammantā,"
        },
        {
          "id": "kp5:6.4",
          "pali": "etaṃ maṅgalamuttamaṃ."
        },
        {
          "id": "kp5:7.1",
          "pali": "Dānañca dhammacariyā ca,"
        },
        {
          "id": "kp5:7.2",
          "pali": "ñātakānañca saṅgaho;"
        },
        {
          "id": "kp5:7.3",
          "pali": "Anavajjāni kammāni,"
        },
        {
          "id": "kp5:7.4",
          "pali": "etaṃ maṅgalamuttamaṃ."
        },
        {
          "id": "kp5:8.1",
          "pali": "Āratī viratī pāpā,"
        },
        {
          "id": "kp5:8.2",
          "pali": "majjapānā ca saṃyamo;"
        },
        {
          "id": "kp5:8.3",
          "pali": "Appamādo ca dhammesu,"
        },
        {
          "id": "kp5:8.4",
          "pali": "etaṃ maṅgalamuttamaṃ."
        },
        {
          "id": "kp5:9.1",
          "pali": "Gāravo ca nivāto ca,"
        },
        {
          "id": "kp5:9.2",
          "pali": "santuṭṭhi ca kataññutā;"
        },
        {
          "id": "kp5:9.3",
          "pali": "Kālena dhammassavanaṃ,"
        },
        {
          "id": "kp5:9.4",
          "pali": "etaṃ maṅgalamuttamaṃ."
        },
        {
          "id": "kp5:10.1",
          "pali": "Khantī ca sovacassatā,"
        },
        {
          "id": "kp5:10.2",
          "pali": "samaṇānañca dassanaṃ;"
        },
        {
          "id": "kp5:10.3",
          "pali": "Kālena dhammasākacchā,"
        },
        {
          "id": "kp5:10.4",
          "pali": "etaṃ maṅgalamuttamaṃ."
        },
        {
          "id": "kp5:11.1",
          "pali": "Tapo ca brahmacariyañca,"
        },
        {
          "id": "kp5:11.2",
          "pali": "ariyasaccāna dassanaṃ;"
        },
        {
          "id": "kp5:11.3",
          "pali": "Nibbānasacchikiriyā ca,"
        },
        {
          "id": "kp5:11.4",
          "pali": "etaṃ maṅgalamuttamaṃ."
        },
        {
          "id": "kp5:12.1",
          "pali": "Phuṭṭhassa lokadhammehi,"
        },
        {
          "id": "kp5:12.2",
          "pali": "cittaṃ yassa na kampati;"
        },
        {
          "id": "kp5:12.3",
          "pali": "Asokaṃ virajaṃ khemaṃ,"
        },
        {
          "id": "kp5:12.4",
          "pali": "etaṃ maṅgalamuttamaṃ."
        },
        {
          "id": "kp5:13.1",
          "pali": "Etādisāni katvāna,"
        },
        {
          "id": "kp5:13.2",
          "pali": "Sabbattha maparājitā;"
        },
        {
          "id": "kp5:13.3",
          "pali": "Sabbattha sotthiṃ gacchanti,"
        },
        {
          "id": "kp5:13.4",
          "pali": "Taṃ tesaṃ maṅgalamuttaman”ti."
        },
        {
          "id": "kp5:14.1",
          "pali": "Maṅgalasuttaṃ."
        }
      ]
    },
    {
      "id": "kp6",
      "segments": [
        {
          "id": "kp6:0.1",
          "pali": "Khuddakapāṭha 6"
        },
        {
          "id": "kp6:0.2",
          "pali": "Ratanasutta"
        },
        {
          "id": "kp6:1.1",
          "pali": "Yānīdha bhūtāni samāgatāni,"
        },
        {
          "id": "kp6:1.2",
          "pali": "Bhummāni vā yāni va antalikkhe;"
        },
        {
          "id": "kp6:1.3",
          "pali": "Sabbeva bhūtā sumanā bhavantu,"
        },
        {
          "id": "kp6:1.4",
          "pali": "Athopi sakkacca suṇantu bhāsitaṃ."
        },
        {
          "id": "kp6:2.1",
          "pali": "Tasmā hi bhūtā nisāmetha sabbe,"
        },
        {
          "id": "kp6:2.2",
          "pali": "Mettaṃ karotha mānusiyā pajāya;"
        },
        {
          "id": "kp6:2.3",
          "pali": "Divā ca ratto ca haranti ye baliṃ,"
        },
        {
          "id": "kp6:2.4",
          "pali": "Tasmā hi ne rakkhatha appamattā."
        },
        {
          "id": "kp6:3.1",
          "pali": "Yaṃ kiñci vittaṃ idha vā huraṃ vā,"
        },
        {
          "id": "kp6:3.2",
          "pali": "Saggesu vā yaṃ ratanaṃ paṇītaṃ;"
        },
        {
          "id": "kp6:3.3",
          "pali": "Na no samaṃ atthi tathāgatena,"
        },
        {
          "id": "kp6:3.4",
          "pali": "Idampi buddhe ratanaṃ paṇītaṃ;"
        },
        {
          "id": "kp6:3.5",
          "pali": "Etena saccena suvatthi hotu."
        },
        {
          "id": "kp6:4.1",
          "pali": "Khayaṃ virāgaṃ amataṃ paṇītaṃ,"
        },
        {
          "id": "kp6:4.2",
          "pali": "Yadajjhagā sakyamunī samāhito;"
        },
        {
          "id": "kp6:4.3",
          "pali": "Na tena dhammena samatthi kiñci,"
        },
        {
          "id": "kp6:4.4",
          "pali": "Idampi dhamme ratanaṃ paṇītaṃ;"
        },
        {
          "id": "kp6:4.5",
          "pali": "Etena saccena suvatthi hotu."
        },
        {
          "id": "kp6:5.1",
          "pali": "Yaṃ buddhaseṭṭho parivaṇṇayī suciṃ,"
        },
        {
          "id": "kp6:5.2",
          "pali": "Samādhimānantarikaññamāhu;"
        },
        {
          "id": "kp6:5.3",
          "pali": "Samādhinā tena samo na vijjati,"
        },
        {
          "id": "kp6:5.4",
          "pali": "Idampi dhamme ratanaṃ paṇītaṃ;"
        },
        {
          "id": "kp6:5.5",
          "pali": "Etena saccena suvatthi hotu."
        },
        {
          "id": "kp6:6.1",
          "pali": "Ye puggalā aṭṭha sataṃ pasatthā,"
        },
        {
          "id": "kp6:6.2",
          "pali": "Cattāri etāni yugāni honti;"
        },
        {
          "id": "kp6:6.3",
          "pali": "Te dakkhiṇeyyā sugatassa sāvakā,"
        },
        {
          "id": "kp6:6.4",
          "pali": "Etesu dinnāni mahapphalāni;"
        },
        {
          "id": "kp6:6.5",
          "pali": "Idampi saṅghe ratanaṃ paṇītaṃ,"
        },
        {
          "id": "kp6:6.6",
          "pali": "Etena saccena suvatthi hotu."
        },
        {
          "id": "kp6:7.1",
          "pali": "Ye suppayuttā manasā daḷhena,"
        },
        {
          "id": "kp6:7.2",
          "pali": "Nikkāmino gotamasāsanamhi;"
        },
        {
          "id": "kp6:7.3",
          "pali": "Te pattipattā amataṃ vigayha,"
        },
        {
          "id": "kp6:7.4",
          "pali": "Laddhā mudhā nibbutiṃ bhuñjamānā;"
        },
        {
          "id": "kp6:7.5",
          "pali": "Idampi saṅghe ratanaṃ paṇītaṃ,"
        },
        {
          "id": "kp6:7.6",
          "pali": "Etena saccena suvatthi hotu."
        },
        {
          "id": "kp6:8.1",
          "pali": "Yathindakhīlo pathavissito siyā,"
        },
        {
          "id": "kp6:8.2",
          "pali": "Catubbhi vātehi asampakampiyo;"
        },
        {
          "id": "kp6:8.3",
          "pali": "Tathūpamaṃ sappurisaṃ vadāmi,"
        },
        {
          "id": "kp6:8.4",
          "pali": "Yo ariyasaccāni avecca passati;"
        },
        {
          "id": "kp6:8.5",
          "pali": "Idampi saṅghe ratanaṃ paṇītaṃ,"
        },
        {
          "id": "kp6:8.6",
          "pali": "Etena saccena suvatthi hotu."
        },
        {
          "id": "kp6:9.1",
          "pali": "Ye ariyasaccāni vibhāvayanti,"
        },
        {
          "id": "kp6:9.2",
          "pali": "Gambhīrapaññena sudesitāni;"
        },
        {
          "id": "kp6:9.3",
          "pali": "Kiñcāpi te honti bhusaṃ pamattā,"
        },
        {
          "id": "kp6:9.4",
          "pali": "Na te bhavaṃ aṭṭhamamādiyanti;"
        },
        {
          "id": "kp6:9.5",
          "pali": "Idampi saṅghe ratanaṃ paṇītaṃ,"
        },
        {
          "id": "kp6:9.6",
          "pali": "Etena saccena suvatthi hotu."
        },
        {
          "id": "kp6:10.1",
          "pali": "Sahāvassa dassanasampadāya,"
        },
        {
          "id": "kp6:10.2",
          "pali": "Tayassu dhammā jahitā bhavanti;"
        },
        {
          "id": "kp6:10.3",
          "pali": "Sakkāyadiṭṭhī vicikicchitañca,"
        },
        {
          "id": "kp6:10.4",
          "pali": "Sīlabbataṃ vāpi yadatthi kiñci."
        },
        {
          "id": "kp6:11.1",
          "pali": "Catūhapāyehi ca vippamutto,"
        },
        {
          "id": "kp6:11.2",
          "pali": "Chaccābhiṭhānāni abhabba kātuṃ;"
        },
        {
          "id": "kp6:11.3",
          "pali": "Idampi saṅghe ratanaṃ paṇītaṃ,"
        },
        {
          "id": "kp6:11.4",
          "pali": "Etena saccena suvatthi hotu."
        },
        {
          "id": "kp6:12.1",
          "pali": "Kiñcāpi so kamma karoti pāpakaṃ,"
        },
        {
          "id": "kp6:12.2",
          "pali": "Kāyena vācā uda cetasā vā;"
        },
        {
          "id": "kp6:12.3",
          "pali": "Abhabba so tassa paṭicchadāya,"
        },
        {
          "id": "kp6:12.4",
          "pali": "Abhabbatā diṭṭhapadassa vuttā;"
        },
        {
          "id": "kp6:12.5",
          "pali": "Idampi saṅghe ratanaṃ paṇītaṃ,"
        },
        {
          "id": "kp6:12.6",
          "pali": "Etena saccena suvatthi hotu."
        },
        {
          "id": "kp6:13.1",
          "pali": "Vanappagumbe yatha phussitagge,"
        },
        {
          "id": "kp6:13.2",
          "pali": "Gimhānamāse paṭhamasmiṃ gimhe;"
        },
        {
          "id": "kp6:13.3",
          "pali": "Tathūpamaṃ dhammavaraṃ adesayi,"
        },
        {
          "id": "kp6:13.4",
          "pali": "Nibbānagāmiṃ paramaṃ hitāya;"
        },
        {
          "id": "kp6:13.5",
          "pali": "Idampi buddhe ratanaṃ paṇītaṃ,"
        },
        {
          "id": "kp6:13.6",
          "pali": "Etena saccena suvatthi hotu."
        },
        {
          "id": "kp6:14.1",
          "pali": "Varo varaññū varado varāharo,"
        },
        {
          "id": "kp6:14.2",
          "pali": "Anuttaro dhammavaraṃ adesayi;"
        },
        {
          "id": "kp6:14.3",
          "pali": "Idampi buddhe ratanaṃ paṇītaṃ,"
        },
        {
          "id": "kp6:14.4",
          "pali": "Etena saccena suvatthi hotu."
        },
        {
          "id": "kp6:15.1",
          "pali": "Khīṇaṃ purāṇaṃ nava natthi sambhavaṃ,"
        },
        {
          "id": "kp6:15.2",
          "pali": "Virattacittāyatike bhavasmiṃ;"
        },
        {
          "id": "kp6:15.3",
          "pali": "Te khīṇabījā avirūḷhichandā,"
        },
        {
          "id": "kp6:15.4",
          "pali": "Nibbanti dhīrā yathāyaṃ padīpo;"
        },
        {
          "id": "kp6:15.5",
          "pali": "Idampi saṅghe ratanaṃ paṇītaṃ,"
        },
        {
          "id": "kp6:15.6",
          "pali": "Etena saccena suvatthi hotu."
        },
        {
          "id": "kp6:16.1",
          "pali": "Yānīdha bhūtāni samāgatāni,"
        },
        {
          "id": "kp6:16.2",
          "pali": "Bhummāni vā yāni va antalikkhe;"
        },
        {
          "id": "kp6:16.3",
          "pali": "Tathāgataṃ devamanussapūjitaṃ,"
        },
        {
          "id": "kp6:16.4",
          "pali": "Buddhaṃ namassāma suvatthi hotu."
        },
        {
          "id": "kp6:17.1",
          "pali": "Yānīdha bhūtāni samāgatāni,"
        },
        {
          "id": "kp6:17.2",
          "pali": "Bhummāni vā yāni va antalikkhe;"
        },
        {
          "id": "kp6:17.3",
          "pali": "Tathāgataṃ devamanussapūjitaṃ,"
        },
        {
          "id": "kp6:17.4",
          "pali": "Dhammaṃ namassāma suvatthi hotu."
        },
        {
          "id": "kp6:18.1",
          "pali": "Yānīdha bhūtāni samāgatāni,"
        },
        {
          "id": "kp6:18.2",
          "pali": "Bhummāni vā yāni va antalikkhe;"
        },
        {
          "id": "kp6:18.3",
          "pali": "Tathāgataṃ devamanussapūjitaṃ,"
        },
        {
          "id": "kp6:18.4",
          "pali": "Saṅghaṃ namassāma suvatthi hotūti."
        },
        {
          "id": "kp6:19.1",
          "pali": "Ratanasuttaṃ."
        }
      ]
    },
    {
      "id": "kp7",
      "segments": [
        {
          "id": "kp7:0.1",
          "pali": "Khuddakapāṭha 7"
        },
        {
          "id": "kp7:0.2",
          "pali": "Tirokuṭṭasutta"
        },
        {
          "id": "kp7:1.1",
          "pali": "Tirokuṭṭesu tiṭṭhanti,"
        },
        {
          "id": "kp7:1.2",
          "pali": "sandhisiṅghāṭakesu ca;"
        },
        {
          "id": "kp7:1.3",
          "pali": "Dvārabāhāsu tiṭṭhanti,"
        },
        {
          "id": "kp7:1.4",
          "pali": "āgantvāna sakaṃ gharaṃ."
        },
        {
          "id": "kp7:2.1",
          "pali": "Pahūte annapānamhi,"
        },
        {
          "id": "kp7:2.2",
          "pali": "khajjabhojje upaṭṭhite;"
        },
        {
          "id": "kp7:2.3",
          "pali": "Na tesaṃ koci sarati,"
        },
        {
          "id": "kp7:2.4",
          "pali": "sattānaṃ kammapaccayā."
        },
        {
          "id": "kp7:3.1",
          "pali": "Evaṃ dadanti ñātīnaṃ,"
        },
        {
          "id": "kp7:3.2",
          "pali": "ye honti anukampakā;"
        },
        {
          "id": "kp7:3.3",
          "pali": "Suciṃ paṇītaṃ kālena,"
        },
        {
          "id": "kp7:3.4",
          "pali": "kappiyaṃ pānabhojanaṃ."
        },
        {
          "id": "kp7:4.1",
          "pali": "Idaṃ vo ñātīnaṃ hotu,"
        },
        {
          "id": "kp7:4.2",
          "pali": "sukhitā hontu ñātayo;"
        },
        {
          "id": "kp7:4.3",
          "pali": "Te ca tattha samāgantvā,"
        },
        {
          "id": "kp7:4.4",
          "pali": "ñātipetā samāgatā."
        },
        {
          "id": "kp7:5.1",
          "pali": "Pahūte annapānamhi,"
        },
        {
          "id": "kp7:5.2",
          "pali": "sakkaccaṃ anumodare;"
        },
        {
          "id": "kp7:5.3",
          "pali": "Ciraṃ jīvantu no ñātī,"
        },
        {
          "id": "kp7:5.4",
          "pali": "yesaṃ hetu labhāmase."
        },
        {
          "id": "kp7:6.1",
          "pali": "Amhākañca katā pūjā,"
        },
        {
          "id": "kp7:6.2",
          "pali": "dāyakā ca anipphalā;"
        },
        {
          "id": "kp7:6.3",
          "pali": "Na hi tattha kasī atthi,"
        },
        {
          "id": "kp7:6.4",
          "pali": "gorakkhettha na vijjati."
        },
        {
          "id": "kp7:7.1",
          "pali": "Vaṇijjā tādisī natthi,"
        },
        {
          "id": "kp7:7.2",
          "pali": "hiraññena kayākayaṃ;"
        },
        {
          "id": "kp7:7.3",
          "pali": "Ito dinnena yāpenti,"
        },
        {
          "id": "kp7:7.4",
          "pali": "petā kālagatā tahiṃ."
        },
        {
          "id": "kp7:8.1",
          "pali": "Unname udakaṃ vuṭṭhaṃ,"
        },
        {
          "id": "kp7:8.2",
          "pali": "yathā ninnaṃ pavattati;"
        },
        {
          "id": "kp7:8.3",
          "pali": "Evamevaṃ ito dinnaṃ,"
        },
        {
          "id": "kp7:8.4",
          "pali": "petānaṃ upakappati."
        },
        {
          "id": "kp7:9.1",
          "pali": "Yathā vārivahā pūrā,"
        },
        {
          "id": "kp7:9.2",
          "pali": "paripūrenti sāgaraṃ;"
        },
        {
          "id": "kp7:9.3",
          "pali": "Evamevaṃ ito dinnaṃ,"
        },
        {
          "id": "kp7:9.4",
          "pali": "petānaṃ upakappati."
        },
        {
          "id": "kp7:10.1",
          "pali": "Adāsi me akāsi me,"
        },
        {
          "id": "kp7:10.2",
          "pali": "ñāti mittā sakhā ca me;"
        },
        {
          "id": "kp7:10.3",
          "pali": "Petānaṃ dakkhiṇaṃ dajjā,"
        },
        {
          "id": "kp7:10.4",
          "pali": "pubbe katamanussaraṃ."
        },
        {
          "id": "kp7:11.1",
          "pali": "Na hi ruṇṇaṃ vā soko vā,"
        },
        {
          "id": "kp7:11.2",
          "pali": "yā caññā paridevanā;"
        },
        {
          "id": "kp7:11.3",
          "pali": "Na taṃ petānamatthāya,"
        },
        {
          "id": "kp7:11.4",
          "pali": "evaṃ tiṭṭhanti ñātayo."
        },
        {
          "id": "kp7:12.1",
          "pali": "Ayañca kho dakkhiṇā dinnā,"
        },
        {
          "id": "kp7:12.2",
          "pali": "saṅghamhi suppatiṭṭhitā;"
        },
        {
          "id": "kp7:12.3",
          "pali": "Dīgharattaṃ hitāyassa,"
        },
        {
          "id": "kp7:12.4",
          "pali": "ṭhānaso upakappati."
        },
        {
          "id": "kp7:13.1",
          "pali": "So ñātidhammo ca ayaṃ nidassito,"
        },
        {
          "id": "kp7:13.2",
          "pali": "Petāna pūjā ca katā uḷārā;"
        },
        {
          "id": "kp7:13.3",
          "pali": "Balañca bhikkhūnamanuppadinnaṃ,"
        },
        {
          "id": "kp7:13.4",
          "pali": "Tumhehi puññaṃ pasutaṃ anappakanti."
        },
        {
          "id": "kp7:14.1",
          "pali": "Tirokuṭṭasuttaṃ."
        }
      ]
    },
    {
      "id": "kp8",
      "segments": [
        {
          "id": "kp8:0.1",
          "pali": "Khuddakapāṭha 8"
        },
        {
          "id": "kp8:0.2",
          "pali": "Nidhikaṇḍasutta"
        },
        {
          "id": "kp8:1.1",
          "pali": "Nidhiṃ nidheti puriso,"
        },
        {
          "id": "kp8:1.2",
          "pali": "gambhīre odakantike;"
        },
        {
          "id": "kp8:1.3",
          "pali": "Atthe kicce samuppanne,"
        },
        {
          "id": "kp8:1.4",
          "pali": "atthāya me bhavissati."
        },
        {
          "id": "kp8:2.1",
          "pali": "Rājato vā duruttassa,"
        },
        {
          "id": "kp8:2.2",
          "pali": "corato pīḷitassa vā;"
        },
        {
          "id": "kp8:2.3",
          "pali": "Iṇassa vā pamokkhāya,"
        },
        {
          "id": "kp8:2.4",
          "pali": "dubbhikkhe āpadāsu vā;"
        },
        {
          "id": "kp8:2.5",
          "pali": "Etadatthāya lokasmiṃ,"
        },
        {
          "id": "kp8:2.6",
          "pali": "nidhi nāma nidhīyati."
        },
        {
          "id": "kp8:3.1",
          "pali": "Tāvassunihito santo,"
        },
        {
          "id": "kp8:3.2",
          "pali": "gambhīre odakantike;"
        },
        {
          "id": "kp8:3.3",
          "pali": "Na sabbo sabbadā eva,"
        },
        {
          "id": "kp8:3.4",
          "pali": "tassa taṃ upakappati."
        },
        {
          "id": "kp8:4.1",
          "pali": "Nidhi vā ṭhānā cavati,"
        },
        {
          "id": "kp8:4.2",
          "pali": "saññā vāssa vimuyhati;"
        },
        {
          "id": "kp8:4.3",
          "pali": "Nāgā vā apanāmenti,"
        },
        {
          "id": "kp8:4.4",
          "pali": "yakkhā vāpi haranti naṃ."
        },
        {
          "id": "kp8:5.1",
          "pali": "Appiyā vāpi dāyādā,"
        },
        {
          "id": "kp8:5.2",
          "pali": "uddharanti apassato;"
        },
        {
          "id": "kp8:5.3",
          "pali": "Yadā puññakkhayo hoti,"
        },
        {
          "id": "kp8:5.4",
          "pali": "sabbametaṃ vinassati."
        },
        {
          "id": "kp8:6.1",
          "pali": "Yassa dānena sīlena,"
        },
        {
          "id": "kp8:6.2",
          "pali": "saṃyamena damena ca;"
        },
        {
          "id": "kp8:6.3",
          "pali": "Nidhī sunihito hoti,"
        },
        {
          "id": "kp8:6.4",
          "pali": "itthiyā purisassa vā."
        },
        {
          "id": "kp8:7.1",
          "pali": "Cetiyamhi ca saṅghe vā,"
        },
        {
          "id": "kp8:7.2",
          "pali": "puggale atithīsu vā;"
        },
        {
          "id": "kp8:7.3",
          "pali": "Mātari pitari cāpi,"
        },
        {
          "id": "kp8:7.4",
          "pali": "atho jeṭṭhamhi bhātari."
        },
        {
          "id": "kp8:8.1",
          "pali": "Eso nidhi sunihito,"
        },
        {
          "id": "kp8:8.2",
          "pali": "ajeyyo anugāmiko;"
        },
        {
          "id": "kp8:8.3",
          "pali": "Pahāya gamanīyesu,"
        },
        {
          "id": "kp8:8.4",
          "pali": "etaṃ ādāya gacchati."
        },
        {
          "id": "kp8:9.1",
          "pali": "Asādhāraṇamaññesaṃ,"
        },
        {
          "id": "kp8:9.2",
          "pali": "acorāharaṇo nidhi;"
        },
        {
          "id": "kp8:9.3",
          "pali": "Kayirātha dhīro puññāni,"
        },
        {
          "id": "kp8:9.4",
          "pali": "yo nidhi anugāmiko."
        },
        {
          "id": "kp8:10.1",
          "pali": "Esa devamanussānaṃ,"
        },
        {
          "id": "kp8:10.2",
          "pali": "sabbakāmadado nidhi;"
        },
        {
          "id": "kp8:10.3",
          "pali": "Yaṃ yadevābhipatthenti,"
        },
        {
          "id": "kp8:10.4",
          "pali": "sabbametena labbhati."
        },
        {
          "id": "kp8:11.1",
          "pali": "Suvaṇṇatā susaratā,"
        },
        {
          "id": "kp8:11.2",
          "pali": "susaṇṭhānā surūpatā;"
        },
        {
          "id": "kp8:11.3",
          "pali": "Ādhipaccaparivāro,"
        },
        {
          "id": "kp8:11.4",
          "pali": "sabbametena labbhati."
        },
        {
          "id": "kp8:12.1",
          "pali": "Padesarajjaṃ issariyaṃ,"
        },
        {
          "id": "kp8:12.2",
          "pali": "cakkavattisukhaṃ piyaṃ;"
        },
        {
          "id": "kp8:12.3",
          "pali": "Devarajjampi dibbesu,"
        },
        {
          "id": "kp8:12.4",
          "pali": "sabbametena labbhati."
        },
        {
          "id": "kp8:13.1",
          "pali": "Mānussikā ca sampatti,"
        },
        {
          "id": "kp8:13.2",
          "pali": "devaloke ca yā rati;"
        },
        {
          "id": "kp8:13.3",
          "pali": "Yā ca nibbānasampatti,"
        },
        {
          "id": "kp8:13.4",
          "pali": "sabbametena labbhati."
        },
        {
          "id": "kp8:14.1",
          "pali": "Mittasampadamāgamma,"
        },
        {
          "id": "kp8:14.2",
          "pali": "yonisova payuñjato;"
        },
        {
          "id": "kp8:14.3",
          "pali": "Vijjāvimuttivasībhāvo,"
        },
        {
          "id": "kp8:14.4",
          "pali": "sabbametena labbhati."
        },
        {
          "id": "kp8:15.1",
          "pali": "Paṭisambhidā vimokkhā ca,"
        },
        {
          "id": "kp8:15.2",
          "pali": "yā ca sāvakapāramī;"
        },
        {
          "id": "kp8:15.3",
          "pali": "Paccekabodhi buddhabhūmi,"
        },
        {
          "id": "kp8:15.4",
          "pali": "sabbametena labbhati."
        },
        {
          "id": "kp8:16.1",
          "pali": "Evaṃ mahatthikā esā,"
        },
        {
          "id": "kp8:16.2",
          "pali": "yadidaṃ puññasampadā;"
        },
        {
          "id": "kp8:16.3",
          "pali": "Tasmā dhīrā pasaṃsanti,"
        },
        {
          "id": "kp8:16.4",
          "pali": "paṇḍitā katapuññatanti."
        },
        {
          "id": "kp8:17.1",
          "pali": "Nidhikaṇḍasuttaṃ."
        }
      ]
    },
    {
      "id": "kp9",
      "segments": [
        {
          "id": "kp9:0.1",
          "pali": "Khuddakapāṭha 9"
        },
        {
          "id": "kp9:0.2",
          "pali": "Mettasutta"
        },
        {
          "id": "kp9:1.1",
          "pali": "Karaṇīyamatthakusalena,"
        },
        {
          "id": "kp9:1.2",
          "pali": "Yanta santaṃ padaṃ abhisamecca;"
        },
        {
          "id": "kp9:1.3",
          "pali": "Sakko ujū ca suhujū ca,"
        },
        {
          "id": "kp9:1.4",
          "pali": "Sūvaco cassa mudu anatimānī."
        },
        {
          "id": "kp9:2.1",
          "pali": "Santussako ca subharo ca,"
        },
        {
          "id": "kp9:2.2",
          "pali": "Appakicco ca sallahukavutti;"
        },
        {
          "id": "kp9:2.3",
          "pali": "Santindriyo ca nipako ca,"
        },
        {
          "id": "kp9:2.4",
          "pali": "Appagabbho kulesvananugiddho."
        },
        {
          "id": "kp9:3.1",
          "pali": "Na ca khuddamācare kiñci,"
        },
        {
          "id": "kp9:3.2",
          "pali": "Yena viññū pare upavadeyyuṃ;"
        },
        {
          "id": "kp9:3.3",
          "pali": "Sukhino va khemino hontu,"
        },
        {
          "id": "kp9:3.4",
          "pali": "Sabbasattā bhavantu sukhitattā."
        },
        {
          "id": "kp9:4.1",
          "pali": "Ye keci pāṇabhūtatthi,"
        },
        {
          "id": "kp9:4.2",
          "pali": "Tasā vā thāvarā vanavasesā;"
        },
        {
          "id": "kp9:4.3",
          "pali": "Dīghā vā ye va mahantā,"
        },
        {
          "id": "kp9:4.4",
          "pali": "Majjhimā rassakā aṇukathūlā."
        },
        {
          "id": "kp9:5.1",
          "pali": "Diṭṭhā vā ye va adiṭṭhā,"
        },
        {
          "id": "kp9:5.2",
          "pali": "Ye va dūre vasanti avidūre;"
        },
        {
          "id": "kp9:5.3",
          "pali": "Bhūtā va sambhavesī va,"
        },
        {
          "id": "kp9:5.4",
          "pali": "Sabbasattā bhavantu sukhitattā."
        },
        {
          "id": "kp9:6.1",
          "pali": "Na paro paraṃ nikubbetha,"
        },
        {
          "id": "kp9:6.2",
          "pali": "Nātimaññetha katthaci na kañci;"
        },
        {
          "id": "kp9:6.3",
          "pali": "Byārosanā paṭighasañña,"
        },
        {
          "id": "kp9:6.4",
          "pali": "Nāññamaññassa dukkhamiccheyya."
        },
        {
          "id": "kp9:7.1",
          "pali": "Mātā yathā niyaṃ puttam"
        },
        {
          "id": "kp9:7.2",
          "pali": "Āyusā ekaputtamanurakkhe;"
        },
        {
          "id": "kp9:7.3",
          "pali": "Evampi sabbabhūtesu,"
        },
        {
          "id": "kp9:7.4",
          "pali": "Mānasaṃ bhāvaye aparimāṇaṃ."
        },
        {
          "id": "kp9:8.1",
          "pali": "Mettañca sabbalokasmi,"
        },
        {
          "id": "kp9:8.2",
          "pali": "Mānasaṃ bhāvaye aparimāṇaṃ;"
        },
        {
          "id": "kp9:8.3",
          "pali": "Uddhaṃ adho ca tiriyañca,"
        },
        {
          "id": "kp9:8.4",
          "pali": "Asambādhaṃ averamasapattaṃ."
        },
        {
          "id": "kp9:9.1",
          "pali": "Tiṭṭhaṃ caraṃ nisinno va,"
        },
        {
          "id": "kp9:9.2",
          "pali": "Sayāno yāvatāssa vitamiddho;"
        },
        {
          "id": "kp9:9.3",
          "pali": "Etaṃ satiṃ adhiṭṭheyya,"
        },
        {
          "id": "kp9:9.4",
          "pali": "Brahmametaṃ vihāramidhamāhu."
        },
        {
          "id": "kp9:10.1",
          "pali": "Diṭṭhiñca anupaggamma,"
        },
        {
          "id": "kp9:10.2",
          "pali": "Sīlavā dassanena sampanno;"
        },
        {
          "id": "kp9:10.3",
          "pali": "Kāmesu vinaya gedhaṃ,"
        },
        {
          "id": "kp9:10.4",
          "pali": "Na hi jātuggabbhaseyya punaretīti."
        },
        {
          "id": "kp9:11.1",
          "pali": "Mettasuttaṃ."
        },
        {
          "id": "kp9:12.1",
          "pali": "Khuddakapāṭhapāḷi niṭṭhitā."
        }
      ]
    }
  ]
}