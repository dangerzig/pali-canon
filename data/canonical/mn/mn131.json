{
  "id": "mn131",
  "title_pali": "Bhaddekarattasutta",
  "title_eng": "One Fortunate Attachment",
  "collection": "mn",
  "pannasa": "Uparipaṇṇāsa",
  "vagga": "Vibhaṅgavagga",
  "pts": "M iii 187–189",
  "segments": [
    {
      "id": "mn131:0.1",
      "pali": "Majjhima Nikāya 131"
    },
    {
      "id": "mn131:0.2",
      "pali": "Bhaddekarattasutta"
    },
    {
      "id": "mn131:1.1",
      "pali": "Evaṃ me sutaṃ—"
    },
    {
      "id": "mn131:1.2",
      "pali": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
    },
    {
      "id": "mn131:1.3",
      "pali": "Tatra kho bhagavā bhikkhū āmantesi:"
    },
    {
      "id": "mn131:1.4",
      "pali": "“bhikkhavo”ti."
    },
    {
      "id": "mn131:1.5",
      "pali": "“Bhadante”ti te bhikkhū bhagavato paccassosuṃ."
    },
    {
      "id": "mn131:1.6",
      "pali": "Bhagavā etadavoca:"
    },
    {
      "id": "mn131:2.1",
      "pali": "“bhaddekarattassa vo, bhikkhave, uddesañca vibhaṅgañca desessāmi."
    },
    {
      "id": "mn131:2.2",
      "pali": "Taṃ suṇātha, sādhukaṃ manasi karotha, bhāsissāmī”ti."
    },
    {
      "id": "mn131:2.3",
      "pali": "“Evaṃ, bhante”ti kho te bhikkhū bhagavato paccassosuṃ."
    },
    {
      "id": "mn131:2.4",
      "pali": "Bhagavā etadavoca:"
    },
    {
      "id": "mn131:3.1",
      "pali": "“Atītaṃ nānvāgameyya,"
    },
    {
      "id": "mn131:3.2",
      "pali": "nappaṭikaṅkhe anāgataṃ;"
    },
    {
      "id": "mn131:3.3",
      "pali": "Yadatītaṃ pahīnaṃ taṃ,"
    },
    {
      "id": "mn131:3.4",
      "pali": "appattañca anāgataṃ."
    },
    {
      "id": "mn131:3.5",
      "pali": "Paccuppannañca yo dhammaṃ,"
    },
    {
      "id": "mn131:3.6",
      "pali": "Tattha tattha vipassati;"
    },
    {
      "id": "mn131:3.7",
      "pali": "Asaṃhīraṃ asaṅkuppaṃ,"
    },
    {
      "id": "mn131:3.8",
      "pali": "Taṃ vidvā manubrūhaye."
    },
    {
      "id": "mn131:3.9",
      "pali": "Ajjeva kiccamātappaṃ,"
    },
    {
      "id": "mn131:3.10",
      "pali": "ko jaññā maraṇaṃ suve;"
    },
    {
      "id": "mn131:3.11",
      "pali": "Na hi no saṅgaraṃ tena,"
    },
    {
      "id": "mn131:3.12",
      "pali": "mahāsenena maccunā."
    },
    {
      "id": "mn131:3.13",
      "pali": "Evaṃvihāriṃ ātāpiṃ,"
    },
    {
      "id": "mn131:3.14",
      "pali": "ahorattamatanditaṃ;"
    },
    {
      "id": "mn131:3.15",
      "pali": "Taṃ ve bhaddekarattoti,"
    },
    {
      "id": "mn131:3.16",
      "pali": "santo ācikkhate muni."
    },
    {
      "id": "mn131:4.1",
      "pali": "Kathañca, bhikkhave, atītaṃ anvāgameti?"
    },
    {
      "id": "mn131:4.2",
      "pali": "‘Evaṃrūpo ahosiṃ atītamaddhānan’ti tattha nandiṃ samanvāneti, ‘evaṃvedano ahosiṃ atītamaddhānan’ti tattha nandiṃ samanvāneti, ‘evaṃsañño ahosiṃ atītamaddhānan’ti tattha nandiṃ samanvāneti, ‘evaṃsaṅkhāro ahosiṃ atītamaddhānan’ti tattha nandiṃ samanvāneti, ‘evaṃviññāṇo ahosiṃ atītamaddhānan’ti tattha nandiṃ samanvāneti—"
    },
    {
      "id": "mn131:4.3",
      "pali": "evaṃ kho, bhikkhave, atītaṃ anvāgameti."
    },
    {
      "id": "mn131:5.1",
      "pali": "Kathañca, bhikkhave, atītaṃ nānvāgameti?"
    },
    {
      "id": "mn131:5.2",
      "pali": "‘Evaṃrūpo ahosiṃ atītamaddhānan’ti tattha nandiṃ na samanvāneti, ‘evaṃvedano ahosiṃ atītamaddhānan’ti tattha nandiṃ na samanvāneti, ‘evaṃsañño ahosiṃ atītamaddhānan’ti tattha nandiṃ na samanvāneti, ‘evaṃsaṅkhāro ahosiṃ atītamaddhānan’ti tattha nandiṃ na samanvāneti, ‘evaṃviññāṇo ahosiṃ atītamaddhānan’ti tattha nandiṃ na samanvāneti—"
    },
    {
      "id": "mn131:5.3",
      "pali": "evaṃ kho, bhikkhave, atītaṃ nānvāgameti."
    },
    {
      "id": "mn131:6.1",
      "pali": "Kathañca, bhikkhave, anāgataṃ paṭikaṅkhati?"
    },
    {
      "id": "mn131:6.2",
      "pali": "‘Evaṃrūpo siyaṃ anāgatamaddhānan’ti tattha nandiṃ samanvāneti, evaṃvedano siyaṃ …pe… evaṃsañño siyaṃ … evaṃsaṅkhāro siyaṃ … evaṃviññāṇo siyaṃ anāgatamaddhānanti tattha nandiṃ samanvāneti—"
    },
    {
      "id": "mn131:6.3",
      "pali": "evaṃ kho, bhikkhave, anāgataṃ paṭikaṅkhati."
    },
    {
      "id": "mn131:7.1",
      "pali": "Kathañca, bhikkhave, anāgataṃ nappaṭikaṅkhati?"
    },
    {
      "id": "mn131:7.2",
      "pali": "‘Evaṃrūpo siyaṃ anāgatamaddhānan’ti tattha nandiṃ na samanvāneti, evaṃvedano siyaṃ … evaṃsañño siyaṃ … evaṃsaṅkhāro siyaṃ … ‘evaṃviññāṇo siyaṃ anāgatamaddhānan’ti tattha nandiṃ na samanvāneti—"
    },
    {
      "id": "mn131:7.3",
      "pali": "evaṃ kho, bhikkhave, anāgataṃ nappaṭikaṅkhati."
    },
    {
      "id": "mn131:8.1",
      "pali": "Kathañca, bhikkhave, paccuppannesu dhammesu saṃhīrati?"
    },
    {
      "id": "mn131:8.2",
      "pali": "Idha, bhikkhave, assutavā puthujjano ariyānaṃ adassāvī ariyadhammassa akovido ariyadhamme avinīto sappurisānaṃ adassāvī sappurisadhammassa akovido sappurisadhamme avinīto"
    },
    {
      "id": "mn131:8.3",
      "pali": "rūpaṃ attato samanupassati, rūpavantaṃ vā attānaṃ, attani vā rūpaṃ, rūpasmiṃ vā attānaṃ;"
    },
    {
      "id": "mn131:8.4",
      "pali": "vedanaṃ …pe…"
    },
    {
      "id": "mn131:8.5",
      "pali": "saññaṃ …"
    },
    {
      "id": "mn131:8.6",
      "pali": "saṅkhāre …"
    },
    {
      "id": "mn131:8.7",
      "pali": "viññāṇaṃ attato samanupassati, viññāṇavantaṃ vā attānaṃ attani vā viññāṇaṃ, viññāṇasmiṃ vā attānaṃ—"
    },
    {
      "id": "mn131:8.8",
      "pali": "evaṃ kho, bhikkhave, paccuppannesu dhammesu saṃhīrati."
    },
    {
      "id": "mn131:9.1",
      "pali": "Kathañca, bhikkhave, paccuppannesu dhammesu na saṃhīrati?"
    },
    {
      "id": "mn131:9.2",
      "pali": "Idha, bhikkhave, sutavā ariyasāvako ariyānaṃ dassāvī ariyadhammassa kovido ariyadhamme suvinīto sappurisānaṃ dassāvī sappurisadhammassa kovido sappurisadhamme suvinīto"
    },
    {
      "id": "mn131:9.3",
      "pali": "na rūpaṃ attato samanupassati, na rūpavantaṃ vā attānaṃ, na attani vā rūpaṃ, na rūpasmiṃ vā attānaṃ;"
    },
    {
      "id": "mn131:9.4",
      "pali": "na vedanaṃ …"
    },
    {
      "id": "mn131:9.5",
      "pali": "na saññaṃ …"
    },
    {
      "id": "mn131:9.6",
      "pali": "na saṅkhāre …"
    },
    {
      "id": "mn131:9.7",
      "pali": "na viññāṇaṃ attato samanupassati, na viññāṇavantaṃ vā attānaṃ, na attani vā viññāṇaṃ, na viññāṇasmiṃ vā attānaṃ—"
    },
    {
      "id": "mn131:9.8",
      "pali": "evaṃ kho, bhikkhave, paccuppannesu dhammesu na saṃhīrati."
    },
    {
      "id": "mn131:10.1",
      "pali": "Atītaṃ nānvāgameyya,"
    },
    {
      "id": "mn131:10.2",
      "pali": "nappaṭikaṅkhe anāgataṃ;"
    },
    {
      "id": "mn131:10.3",
      "pali": "Yadatītaṃ pahīnaṃ taṃ,"
    },
    {
      "id": "mn131:10.4",
      "pali": "appattañca anāgataṃ."
    },
    {
      "id": "mn131:10.5",
      "pali": "Paccuppannañca yo dhammaṃ,"
    },
    {
      "id": "mn131:10.6",
      "pali": "tattha tattha vipassati;"
    },
    {
      "id": "mn131:10.7",
      "pali": "Asaṃhīraṃ asaṅkuppaṃ,"
    },
    {
      "id": "mn131:10.8",
      "pali": "taṃ vidvā manubrūhaye."
    },
    {
      "id": "mn131:10.9",
      "pali": "Ajjeva kiccamātappaṃ,"
    },
    {
      "id": "mn131:10.10",
      "pali": "ko jaññā maraṇaṃ suve;"
    },
    {
      "id": "mn131:10.11",
      "pali": "Na hi no saṅgaraṃ tena,"
    },
    {
      "id": "mn131:10.12",
      "pali": "mahāsenena maccunā."
    },
    {
      "id": "mn131:10.13",
      "pali": "Evaṃvihāriṃ ātāpiṃ,"
    },
    {
      "id": "mn131:10.14",
      "pali": "ahorattamatanditaṃ;"
    },
    {
      "id": "mn131:10.15",
      "pali": "Taṃ ve bhaddekarattoti,"
    },
    {
      "id": "mn131:10.16",
      "pali": "santo ācikkhate munīti."
    },
    {
      "id": "mn131:11.1",
      "pali": "‘Bhaddekarattassa vo, bhikkhave, uddesañca vibhaṅgañca desessāmī’ti—"
    },
    {
      "id": "mn131:11.2",
      "pali": "iti yaṃ taṃ vuttaṃ idametaṃ paṭicca vuttan”ti."
    },
    {
      "id": "mn131:11.3",
      "pali": "Idamavoca bhagavā."
    },
    {
      "id": "mn131:11.4",
      "pali": "Attamanā te bhikkhū bhagavato bhāsitaṃ abhinandunti."
    },
    {
      "id": "mn131:11.5",
      "pali": "Bhaddekarattasuttaṃ niṭṭhitaṃ paṭhamaṃ."
    }
  ]
}