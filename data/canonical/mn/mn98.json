{
  "id": "mn98",
  "title_pali": "Vāseṭṭhasutta",
  "title_eng": "To Vāseṭṭha",
  "collection": "mn",
  "pannasa": "Majjhimapaṇṇāsa",
  "vagga": "Brāhmaṇavagga",
  "pts": "M ii 196–209",
  "segments": [
    {
      "id": "mn98:0.1",
      "pali": "Majjhima Nikāya 98"
    },
    {
      "id": "mn98:0.2",
      "pali": "Vāseṭṭhasutta"
    },
    {
      "id": "mn98:1.1",
      "pali": "Evaṃ me sutaṃ—"
    },
    {
      "id": "mn98:1.2",
      "pali": "ekaṃ samayaṃ bhagavā icchānaṅgale viharati icchānaṅgalavanasaṇḍe."
    },
    {
      "id": "mn98:2.1",
      "pali": "Tena kho pana samayena sambahulā abhiññātā abhiññātā brāhmaṇamahāsālā icchānaṅgale paṭivasanti, seyyathidaṃ—"
    },
    {
      "id": "mn98:2.2",
      "pali": "caṅkī brāhmaṇo, tārukkho brāhmaṇo, pokkharasāti brāhmaṇo, jāṇussoṇi brāhmaṇo, todeyyo brāhmaṇo, aññe ca abhiññātā abhiññātā brāhmaṇamahāsālā."
    },
    {
      "id": "mn98:3.1",
      "pali": "Atha kho vāseṭṭhabhāradvājānaṃ māṇavānaṃ jaṅghāvihāraṃ anucaṅkamantānaṃ anuvicarantānaṃ ayamantarākathā udapādi:"
    },
    {
      "id": "mn98:3.2",
      "pali": "“kathaṃ, bho, brāhmaṇo hotī”ti?"
    },
    {
      "id": "mn98:3.3",
      "pali": "Bhāradvājo māṇavo evamāha:"
    },
    {
      "id": "mn98:3.4",
      "pali": "“yato kho, bho, ubhato sujāto mātito ca pitito ca saṃsuddhagahaṇiko yāva sattamā pitāmahayugā akkhitto anupakkuṭṭho jātivādena—"
    },
    {
      "id": "mn98:3.5",
      "pali": "ettāvatā kho, bho, brāhmaṇo hotī”ti."
    },
    {
      "id": "mn98:3.6",
      "pali": "Vāseṭṭho māṇavo evamāha:"
    },
    {
      "id": "mn98:3.7",
      "pali": "“yato kho, bho, sīlavā ca hoti vattasampanno ca—"
    },
    {
      "id": "mn98:3.8",
      "pali": "ettāvatā kho, bho, brāhmaṇo hotī”ti."
    },
    {
      "id": "mn98:4.1",
      "pali": "Neva kho asakkhi bhāradvājo māṇavo vāseṭṭhaṃ māṇavaṃ saññāpetuṃ, na pana asakkhi vāseṭṭho māṇavo bhāradvājaṃ māṇavaṃ saññāpetuṃ."
    },
    {
      "id": "mn98:5.1",
      "pali": "Atha kho vāseṭṭho māṇavo bhāradvājaṃ māṇavaṃ āmantesi:"
    },
    {
      "id": "mn98:5.2",
      "pali": "“ayaṃ kho, bho bhāradvāja, samaṇo gotamo sakyaputto sakyakulā pabbajito icchānaṅgale viharati icchānaṅgalavanasaṇḍe."
    },
    {
      "id": "mn98:5.3",
      "pali": "Taṃ kho pana bhavantaṃ gotamaṃ evaṃ kalyāṇo kittisaddo abbhuggato:"
    },
    {
      "id": "mn98:5.4",
      "pali": "‘itipi so bhagavā arahaṃ sammāsambuddho vijjācaraṇasampanno sugato lokavidū anuttaro purisadammasārathi satthā devamanussānaṃ buddho bhagavā’ti."
    },
    {
      "id": "mn98:5.5",
      "pali": "Āyāma, bho bhāradvāja, yena samaṇo gotamo tenupasaṅkamissāma; upasaṅkamitvā samaṇaṃ gotamaṃ etamatthaṃ pucchissāma."
    },
    {
      "id": "mn98:5.6",
      "pali": "Yathā no samaṇo gotamo byākarissati tathā naṃ dhāressāmā”ti."
    },
    {
      "id": "mn98:5.7",
      "pali": "“Evaṃ, bho”ti kho bhāradvājo māṇavo vāseṭṭhassa māṇavassa paccassosi."
    },
    {
      "id": "mn98:6.1",
      "pali": "Atha kho vāseṭṭhabhāradvājā māṇavā yena bhagavā tenupasaṅkamiṃsu; upasaṅkamitvā bhagavatā saddhiṃ sammodiṃsu."
    },
    {
      "id": "mn98:6.2",
      "pali": "Sammodanīyaṃ kathaṃ sāraṇīyaṃ vītisāretvā ekamantaṃ nisīdiṃsu."
    },
    {
      "id": "mn98:6.3",
      "pali": "Ekamantaṃ nisinno kho vāseṭṭho māṇavo bhagavantaṃ gāthāhi ajjhabhāsi:"
    },
    {
      "id": "mn98:7.1",
      "pali": "“Anuññātapaṭiññātā,"
    },
    {
      "id": "mn98:7.2",
      "pali": "tevijjā mayamasmubho;"
    },
    {
      "id": "mn98:7.3",
      "pali": "Ahaṃ pokkharasātissa,"
    },
    {
      "id": "mn98:7.4",
      "pali": "tārukkhassāyaṃ māṇavo."
    },
    {
      "id": "mn98:7.5",
      "pali": "Tevijjānaṃ yadakkhātaṃ,"
    },
    {
      "id": "mn98:7.6",
      "pali": "tatra kevalinosmase;"
    },
    {
      "id": "mn98:7.7",
      "pali": "Padakasmā veyyākaraṇā,"
    },
    {
      "id": "mn98:7.8",
      "pali": "jappe ācariyasādisā;"
    },
    {
      "id": "mn98:7.9",
      "pali": "Tesaṃ no jātivādasmiṃ,"
    },
    {
      "id": "mn98:7.10",
      "pali": "vivādo atthi gotama."
    },
    {
      "id": "mn98:7.11",
      "pali": "Jātiyā brāhmaṇo hoti,"
    },
    {
      "id": "mn98:7.12",
      "pali": "bhāradvājo iti bhāsati;"
    },
    {
      "id": "mn98:7.13",
      "pali": "Ahañca kammunā brūmi,"
    },
    {
      "id": "mn98:7.14",
      "pali": "evaṃ jānāhi cakkhuma."
    },
    {
      "id": "mn98:7.15",
      "pali": "Te na sakkoma ñāpetuṃ,"
    },
    {
      "id": "mn98:7.16",
      "pali": "aññamaññaṃ mayaṃ ubho;"
    },
    {
      "id": "mn98:7.17",
      "pali": "Bhavantaṃ puṭṭhumāgamā,"
    },
    {
      "id": "mn98:7.18",
      "pali": "sambuddhaṃ iti vissutaṃ."
    },
    {
      "id": "mn98:7.19",
      "pali": "Candaṃ yathā khayātītaṃ,"
    },
    {
      "id": "mn98:7.20",
      "pali": "pecca pañjalikā janā;"
    },
    {
      "id": "mn98:7.21",
      "pali": "Vandamānā namassanti,"
    },
    {
      "id": "mn98:7.22",
      "pali": "lokasmiṃ gotamaṃ."
    },
    {
      "id": "mn98:7.23",
      "pali": "Cakkhuṃ loke samuppannaṃ,"
    },
    {
      "id": "mn98:7.24",
      "pali": "mayaṃ pucchāma gotamaṃ;"
    },
    {
      "id": "mn98:7.25",
      "pali": "Jātiyā brāhmaṇo hoti,"
    },
    {
      "id": "mn98:7.26",
      "pali": "udāhu bhavati kammunā;"
    },
    {
      "id": "mn98:7.27",
      "pali": "Ajānataṃ no pabrūhi,"
    },
    {
      "id": "mn98:7.28",
      "pali": "yathā jānemu brāhmaṇan”ti."
    },
    {
      "id": "mn98:8.1",
      "pali": "“Tesaṃ vo ahaṃ byakkhissaṃ,"
    },
    {
      "id": "mn98:8.2",
      "pali": "(vāseṭṭhāti bhagavā)"
    },
    {
      "id": "mn98:8.3",
      "pali": "Anupubbaṃ yathātathaṃ;"
    },
    {
      "id": "mn98:8.4",
      "pali": "Jātivibhaṅgaṃ pāṇānaṃ,"
    },
    {
      "id": "mn98:8.5",
      "pali": "Aññamaññāhi jātiyo."
    },
    {
      "id": "mn98:8.6",
      "pali": "Tiṇarukkhepi jānātha,"
    },
    {
      "id": "mn98:8.7",
      "pali": "na cāpi paṭijānare;"
    },
    {
      "id": "mn98:8.8",
      "pali": "Liṅgaṃ jātimayaṃ tesaṃ,"
    },
    {
      "id": "mn98:8.9",
      "pali": "aññamaññā hi jātiyo."
    },
    {
      "id": "mn98:8.10",
      "pali": "Tato kīṭe paṭaṅge ca,"
    },
    {
      "id": "mn98:8.11",
      "pali": "yāva kunthakipillike;"
    },
    {
      "id": "mn98:8.12",
      "pali": "Liṅgaṃ jātimayaṃ tesaṃ,"
    },
    {
      "id": "mn98:8.13",
      "pali": "aññamaññā hi jātiyo."
    },
    {
      "id": "mn98:8.14",
      "pali": "Catuppadepi jānātha,"
    },
    {
      "id": "mn98:8.15",
      "pali": "khuddake ca mahallake;"
    },
    {
      "id": "mn98:8.16",
      "pali": "Liṅgaṃ jātimayaṃ tesaṃ,"
    },
    {
      "id": "mn98:8.17",
      "pali": "aññamaññā hi jātiyo."
    },
    {
      "id": "mn98:8.18",
      "pali": "Pādudarepi jānātha,"
    },
    {
      "id": "mn98:8.19",
      "pali": "urage dīghapiṭṭhike;"
    },
    {
      "id": "mn98:8.20",
      "pali": "Liṅgaṃ jātimayaṃ tesaṃ,"
    },
    {
      "id": "mn98:8.21",
      "pali": "aññamaññā hi jātiyo."
    },
    {
      "id": "mn98:8.22",
      "pali": "Tato macchepi jānātha,"
    },
    {
      "id": "mn98:8.23",
      "pali": "udake vārigocare;"
    },
    {
      "id": "mn98:8.24",
      "pali": "Liṅgaṃ jātimayaṃ tesaṃ,"
    },
    {
      "id": "mn98:8.25",
      "pali": "aññamaññā hi jātiyo."
    },
    {
      "id": "mn98:8.26",
      "pali": "Tato pakkhīpi jānātha,"
    },
    {
      "id": "mn98:8.27",
      "pali": "pattayāne vihaṅgame;"
    },
    {
      "id": "mn98:8.28",
      "pali": "Liṅgaṃ jātimayaṃ tesaṃ,"
    },
    {
      "id": "mn98:8.29",
      "pali": "aññamaññā hi jātiyo."
    },
    {
      "id": "mn98:9.1",
      "pali": "Yathā etāsu jātīsu,"
    },
    {
      "id": "mn98:9.2",
      "pali": "liṅgaṃ jātimayaṃ puthu;"
    },
    {
      "id": "mn98:9.3",
      "pali": "Evaṃ natthi manussesu,"
    },
    {
      "id": "mn98:9.4",
      "pali": "liṅgaṃ jātimayaṃ puthu."
    },
    {
      "id": "mn98:9.5",
      "pali": "Na kesehi na sīsehi,"
    },
    {
      "id": "mn98:9.6",
      "pali": "na kaṇṇehi na akkhīhi;"
    },
    {
      "id": "mn98:9.7",
      "pali": "Na mukhena na nāsāya,"
    },
    {
      "id": "mn98:9.8",
      "pali": "na oṭṭhehi bhamūhi vā."
    },
    {
      "id": "mn98:9.9",
      "pali": "Na gīvāya na aṃsehi,"
    },
    {
      "id": "mn98:9.10",
      "pali": "na udarena na piṭṭhiyā;"
    },
    {
      "id": "mn98:9.11",
      "pali": "Na soṇiyā na urasā,"
    },
    {
      "id": "mn98:9.12",
      "pali": "na sambādhe na methune."
    },
    {
      "id": "mn98:9.13",
      "pali": "Na hatthehi na pādehi,"
    },
    {
      "id": "mn98:9.14",
      "pali": "naṅgulīhi nakhehi vā;"
    },
    {
      "id": "mn98:9.15",
      "pali": "Na jaṅghāhi na ūrūhi,"
    },
    {
      "id": "mn98:9.16",
      "pali": "na vaṇṇena sarena vā;"
    },
    {
      "id": "mn98:9.17",
      "pali": "Liṅgaṃ jātimayaṃ neva,"
    },
    {
      "id": "mn98:9.18",
      "pali": "yathā aññāsu jātisu."
    },
    {
      "id": "mn98:9.19",
      "pali": "Paccattañca sarīresu,"
    },
    {
      "id": "mn98:9.20",
      "pali": "manussesvetaṃ na vijjati;"
    },
    {
      "id": "mn98:9.21",
      "pali": "Vokārañca manussesu,"
    },
    {
      "id": "mn98:9.22",
      "pali": "samaññāya pavuccati."
    },
    {
      "id": "mn98:10.1",
      "pali": "Yo hi koci manussesu,"
    },
    {
      "id": "mn98:10.2",
      "pali": "gorakkhaṃ upajīvati;"
    },
    {
      "id": "mn98:10.3",
      "pali": "Evaṃ vāseṭṭha jānāhi,"
    },
    {
      "id": "mn98:10.4",
      "pali": "kassako so na brāhmaṇo."
    },
    {
      "id": "mn98:10.5",
      "pali": "Yo hi koci manussesu,"
    },
    {
      "id": "mn98:10.6",
      "pali": "puthusippena jīvati;"
    },
    {
      "id": "mn98:10.7",
      "pali": "Evaṃ vāseṭṭha jānāhi,"
    },
    {
      "id": "mn98:10.8",
      "pali": "sippiko so na brāhmaṇo."
    },
    {
      "id": "mn98:10.9",
      "pali": "Yo hi koci manussesu,"
    },
    {
      "id": "mn98:10.10",
      "pali": "vohāraṃ upajīvati;"
    },
    {
      "id": "mn98:10.11",
      "pali": "Evaṃ vāseṭṭha jānāhi,"
    },
    {
      "id": "mn98:10.12",
      "pali": "vāṇijo so na brāhmaṇo."
    },
    {
      "id": "mn98:10.13",
      "pali": "Yo hi koci manussesu,"
    },
    {
      "id": "mn98:10.14",
      "pali": "parapessena jīvati;"
    },
    {
      "id": "mn98:10.15",
      "pali": "Evaṃ vāseṭṭha jānāhi,"
    },
    {
      "id": "mn98:10.16",
      "pali": "pessako so na brāhmaṇo."
    },
    {
      "id": "mn98:10.17",
      "pali": "Yo hi koci manussesu,"
    },
    {
      "id": "mn98:10.18",
      "pali": "adinnaṃ upajīvati;"
    },
    {
      "id": "mn98:10.19",
      "pali": "Evaṃ vāseṭṭha jānāhi,"
    },
    {
      "id": "mn98:10.20",
      "pali": "coro eso na brāhmaṇo."
    },
    {
      "id": "mn98:10.21",
      "pali": "Yo hi koci manussesu,"
    },
    {
      "id": "mn98:10.22",
      "pali": "issatthaṃ upajīvati;"
    },
    {
      "id": "mn98:10.23",
      "pali": "Evaṃ vāseṭṭha jānāhi,"
    },
    {
      "id": "mn98:10.24",
      "pali": "yodhājīvo na brāhmaṇo."
    },
    {
      "id": "mn98:10.25",
      "pali": "Yo hi koci manussesu,"
    },
    {
      "id": "mn98:10.26",
      "pali": "porohiccena jīvati;"
    },
    {
      "id": "mn98:10.27",
      "pali": "Evaṃ vāseṭṭha jānāhi,"
    },
    {
      "id": "mn98:10.28",
      "pali": "yājako so na brāhmaṇo."
    },
    {
      "id": "mn98:10.29",
      "pali": "Yo hi koci manussesu,"
    },
    {
      "id": "mn98:10.30",
      "pali": "gāmaṃ raṭṭhañca bhuñjati;"
    },
    {
      "id": "mn98:10.31",
      "pali": "Evaṃ vāseṭṭha jānāhi,"
    },
    {
      "id": "mn98:10.32",
      "pali": "rājā eso na brāhmaṇo."
    },
    {
      "id": "mn98:11.1",
      "pali": "Na cāhaṃ brāhmaṇaṃ brūmi,"
    },
    {
      "id": "mn98:11.2",
      "pali": "yonijaṃ mattisambhavaṃ;"
    },
    {
      "id": "mn98:11.3",
      "pali": "Bhovādi nāma so hoti,"
    },
    {
      "id": "mn98:11.4",
      "pali": "sace hoti sakiñcano;"
    },
    {
      "id": "mn98:11.5",
      "pali": "Akiñcanaṃ anādānaṃ,"
    },
    {
      "id": "mn98:11.6",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.7",
      "pali": "Sabbasaṃyojanaṃ chetvā,"
    },
    {
      "id": "mn98:11.8",
      "pali": "yo ve na paritassati;"
    },
    {
      "id": "mn98:11.9",
      "pali": "Saṅgātigaṃ visaṃyuttaṃ,"
    },
    {
      "id": "mn98:11.10",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.11",
      "pali": "Chetvā naddhiṃ varattañca,"
    },
    {
      "id": "mn98:11.12",
      "pali": "sandānaṃ sahanukkamaṃ;"
    },
    {
      "id": "mn98:11.13",
      "pali": "Ukkhittapalighaṃ buddhaṃ,"
    },
    {
      "id": "mn98:11.14",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.15",
      "pali": "Akkosaṃ vadhabandhañca,"
    },
    {
      "id": "mn98:11.16",
      "pali": "aduṭṭho yo titikkhati;"
    },
    {
      "id": "mn98:11.17",
      "pali": "Khantībalaṃ balānīkaṃ,"
    },
    {
      "id": "mn98:11.18",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.19",
      "pali": "Akkodhanaṃ vatavantaṃ,"
    },
    {
      "id": "mn98:11.20",
      "pali": "sīlavantaṃ anussadaṃ;"
    },
    {
      "id": "mn98:11.21",
      "pali": "Dantaṃ antimasārīraṃ,"
    },
    {
      "id": "mn98:11.22",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.23",
      "pali": "Vāripokkharapatteva,"
    },
    {
      "id": "mn98:11.24",
      "pali": "āraggeriva sāsapo;"
    },
    {
      "id": "mn98:11.25",
      "pali": "Yo na limpati kāmesu,"
    },
    {
      "id": "mn98:11.26",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.27",
      "pali": "Yo dukkhassa pajānāti,"
    },
    {
      "id": "mn98:11.28",
      "pali": "idheva khayamattano;"
    },
    {
      "id": "mn98:11.29",
      "pali": "Pannabhāraṃ visaṃyuttaṃ,"
    },
    {
      "id": "mn98:11.30",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.31",
      "pali": "Gambhīrapaññaṃ medhāviṃ,"
    },
    {
      "id": "mn98:11.32",
      "pali": "maggāmaggassa kovidaṃ;"
    },
    {
      "id": "mn98:11.33",
      "pali": "Uttamatthamanuppattaṃ,"
    },
    {
      "id": "mn98:11.34",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.35",
      "pali": "Asaṃsaṭṭhaṃ gahaṭṭhehi,"
    },
    {
      "id": "mn98:11.36",
      "pali": "anāgārehi cūbhayaṃ;"
    },
    {
      "id": "mn98:11.37",
      "pali": "Anokasārimappicchaṃ,"
    },
    {
      "id": "mn98:11.38",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.39",
      "pali": "Nidhāya daṇḍaṃ bhūtesu,"
    },
    {
      "id": "mn98:11.40",
      "pali": "tasesu thāvaresu ca;"
    },
    {
      "id": "mn98:11.41",
      "pali": "Yo na hanti na ghāteti,"
    },
    {
      "id": "mn98:11.42",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.43",
      "pali": "Aviruddhaṃ viruddhesu,"
    },
    {
      "id": "mn98:11.44",
      "pali": "attadaṇḍesu nibbutaṃ;"
    },
    {
      "id": "mn98:11.45",
      "pali": "Sādānesu anādānaṃ,"
    },
    {
      "id": "mn98:11.46",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.47",
      "pali": "Yassa rāgo ca doso ca,"
    },
    {
      "id": "mn98:11.48",
      "pali": "māno makkho ca ohito;"
    },
    {
      "id": "mn98:11.49",
      "pali": "Sāsaporiva āraggā,"
    },
    {
      "id": "mn98:11.50",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.51",
      "pali": "Akakkasaṃ viññāpaniṃ,"
    },
    {
      "id": "mn98:11.52",
      "pali": "giraṃ saccaṃ udīraye;"
    },
    {
      "id": "mn98:11.53",
      "pali": "Yāya nābhisajje kiñci,"
    },
    {
      "id": "mn98:11.54",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.55",
      "pali": "Yo ca dīghaṃ va rassaṃ vā,"
    },
    {
      "id": "mn98:11.56",
      "pali": "aṇuṃ thūlaṃ subhāsubhaṃ;"
    },
    {
      "id": "mn98:11.57",
      "pali": "Loke adinnaṃ nādeti,"
    },
    {
      "id": "mn98:11.58",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.59",
      "pali": "Āsā yassa na vijjanti,"
    },
    {
      "id": "mn98:11.60",
      "pali": "asmiṃ loke paramhi ca;"
    },
    {
      "id": "mn98:11.61",
      "pali": "Nirāsāsaṃ visaṃyuttaṃ,"
    },
    {
      "id": "mn98:11.62",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.63",
      "pali": "Yassālayā na vijjanti,"
    },
    {
      "id": "mn98:11.64",
      "pali": "aññāya akathaṅkathiṃ;"
    },
    {
      "id": "mn98:11.65",
      "pali": "Amatogadhaṃ anuppattaṃ,"
    },
    {
      "id": "mn98:11.66",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.67",
      "pali": "Yodhapuññañca pāpañca,"
    },
    {
      "id": "mn98:11.68",
      "pali": "ubho saṅgaṃ upaccagā;"
    },
    {
      "id": "mn98:11.69",
      "pali": "Asokaṃ virajaṃ suddhaṃ,"
    },
    {
      "id": "mn98:11.70",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.71",
      "pali": "Candaṃ va vimalaṃ suddhaṃ,"
    },
    {
      "id": "mn98:11.72",
      "pali": "vippasannaṃ anāvilaṃ;"
    },
    {
      "id": "mn98:11.73",
      "pali": "Nandībhavaparikkhīṇaṃ,"
    },
    {
      "id": "mn98:11.74",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.75",
      "pali": "Yo imaṃ palipathaṃ duggaṃ,"
    },
    {
      "id": "mn98:11.76",
      "pali": "saṃsāraṃ mohamaccagā;"
    },
    {
      "id": "mn98:11.77",
      "pali": "Tiṇṇo pāraṅgato jhāyī,"
    },
    {
      "id": "mn98:11.78",
      "pali": "anejo akathaṅkathī;"
    },
    {
      "id": "mn98:11.79",
      "pali": "Anupādāya nibbuto,"
    },
    {
      "id": "mn98:11.80",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.81",
      "pali": "Yodhakāme pahantvāna,"
    },
    {
      "id": "mn98:11.82",
      "pali": "anāgāro paribbaje;"
    },
    {
      "id": "mn98:11.83",
      "pali": "Kāmabhavaparikkhīṇaṃ,"
    },
    {
      "id": "mn98:11.84",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.85",
      "pali": "Yodhataṇhaṃ pahantvāna,"
    },
    {
      "id": "mn98:11.86",
      "pali": "anāgāro paribbaje;"
    },
    {
      "id": "mn98:11.87",
      "pali": "Taṇhābhavaparikkhīṇaṃ,"
    },
    {
      "id": "mn98:11.88",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.89",
      "pali": "Hitvā mānusakaṃ yogaṃ,"
    },
    {
      "id": "mn98:11.90",
      "pali": "dibbaṃ yogaṃ upaccagā;"
    },
    {
      "id": "mn98:11.91",
      "pali": "Sabbayogavisaṃyuttaṃ,"
    },
    {
      "id": "mn98:11.92",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.93",
      "pali": "Hitvā ratiñca aratiṃ,"
    },
    {
      "id": "mn98:11.94",
      "pali": "sītībhūtaṃ nirūpadhiṃ;"
    },
    {
      "id": "mn98:11.95",
      "pali": "Sabbalokābhibhuṃ vīraṃ,"
    },
    {
      "id": "mn98:11.96",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.97",
      "pali": "Cutiṃ yo vedi sattānaṃ,"
    },
    {
      "id": "mn98:11.98",
      "pali": "upapattiñca sabbaso;"
    },
    {
      "id": "mn98:11.99",
      "pali": "Asattaṃ sugataṃ buddhaṃ,"
    },
    {
      "id": "mn98:11.100",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.101",
      "pali": "Yassa gatiṃ na jānanti,"
    },
    {
      "id": "mn98:11.102",
      "pali": "devā gandhabbamānusā;"
    },
    {
      "id": "mn98:11.103",
      "pali": "Khīṇāsavaṃ arahantaṃ,"
    },
    {
      "id": "mn98:11.104",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.105",
      "pali": "Yassa pure ca pacchā ca,"
    },
    {
      "id": "mn98:11.106",
      "pali": "majjhe ca natthi kiñcanaṃ;"
    },
    {
      "id": "mn98:11.107",
      "pali": "Akiñcanaṃ anādānaṃ,"
    },
    {
      "id": "mn98:11.108",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.109",
      "pali": "Usabhaṃ pavaraṃ vīraṃ,"
    },
    {
      "id": "mn98:11.110",
      "pali": "mahesiṃ vijitāvinaṃ;"
    },
    {
      "id": "mn98:11.111",
      "pali": "Anejaṃ nhātakaṃ buddhaṃ,"
    },
    {
      "id": "mn98:11.112",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:11.113",
      "pali": "Pubbenivāsaṃ yo vedi,"
    },
    {
      "id": "mn98:11.114",
      "pali": "saggāpāyañca passati;"
    },
    {
      "id": "mn98:11.115",
      "pali": "Atho jātikkhayaṃ patto,"
    },
    {
      "id": "mn98:11.116",
      "pali": "tamahaṃ brūmi brāhmaṇaṃ."
    },
    {
      "id": "mn98:12.1",
      "pali": "Samaññā hesā lokasmiṃ,"
    },
    {
      "id": "mn98:12.2",
      "pali": "nāmagottaṃ pakappitaṃ;"
    },
    {
      "id": "mn98:12.3",
      "pali": "Sammuccā samudāgataṃ,"
    },
    {
      "id": "mn98:12.4",
      "pali": "tattha tattha pakappitaṃ."
    },
    {
      "id": "mn98:12.5",
      "pali": "Dīgharattānusayitaṃ,"
    },
    {
      "id": "mn98:12.6",
      "pali": "diṭṭhigatamajānataṃ;"
    },
    {
      "id": "mn98:12.7",
      "pali": "Ajānantā no pabrunti,"
    },
    {
      "id": "mn98:12.8",
      "pali": "jātiyā hoti brāhmaṇo."
    },
    {
      "id": "mn98:12.9",
      "pali": "Na jaccā brāhmaṇo hoti,"
    },
    {
      "id": "mn98:12.10",
      "pali": "na jaccā hoti abrāhmaṇo;"
    },
    {
      "id": "mn98:12.11",
      "pali": "Kammunā brāhmaṇo hoti,"
    },
    {
      "id": "mn98:12.12",
      "pali": "kammunā hoti abrāhmaṇo."
    },
    {
      "id": "mn98:12.13",
      "pali": "Kassako kammunā hoti,"
    },
    {
      "id": "mn98:12.14",
      "pali": "sippiko hoti kammunā;"
    },
    {
      "id": "mn98:12.15",
      "pali": "Vāṇijo kammunā hoti,"
    },
    {
      "id": "mn98:12.16",
      "pali": "pessako hoti kammunā."
    },
    {
      "id": "mn98:12.17",
      "pali": "Coropi kammunā hoti,"
    },
    {
      "id": "mn98:12.18",
      "pali": "yodhājīvopi kammunā;"
    },
    {
      "id": "mn98:12.19",
      "pali": "Yājako kammunā hoti,"
    },
    {
      "id": "mn98:12.20",
      "pali": "rājāpi hoti kammunā."
    },
    {
      "id": "mn98:13.1",
      "pali": "Evametaṃ yathābhūtaṃ,"
    },
    {
      "id": "mn98:13.2",
      "pali": "kammaṃ passanti paṇḍitā;"
    },
    {
      "id": "mn98:13.3",
      "pali": "Paṭiccasamuppādadassā,"
    },
    {
      "id": "mn98:13.4",
      "pali": "kammavipākakovidā."
    },
    {
      "id": "mn98:13.5",
      "pali": "Kammunā vattati loko,"
    },
    {
      "id": "mn98:13.6",
      "pali": "kammunā vattati pajā;"
    },
    {
      "id": "mn98:13.7",
      "pali": "Kammanibandhanā sattā,"
    },
    {
      "id": "mn98:13.8",
      "pali": "rathassāṇīva yāyato."
    },
    {
      "id": "mn98:13.9",
      "pali": "Tapena brahmacariyena,"
    },
    {
      "id": "mn98:13.10",
      "pali": "saṃyamena damena ca;"
    },
    {
      "id": "mn98:13.11",
      "pali": "Etena brāhmaṇo hoti,"
    },
    {
      "id": "mn98:13.12",
      "pali": "etaṃ brāhmaṇamuttamaṃ."
    },
    {
      "id": "mn98:13.13",
      "pali": "Tīhi vijjāhi sampanno,"
    },
    {
      "id": "mn98:13.14",
      "pali": "santo khīṇapunabbhavo;"
    },
    {
      "id": "mn98:13.15",
      "pali": "Evaṃ vāseṭṭha jānāhi,"
    },
    {
      "id": "mn98:13.16",
      "pali": "brahmā sakko vijānatan”ti."
    },
    {
      "id": "mn98:14.1",
      "pali": "Evaṃ vutte, vāseṭṭhabhāradvājā māṇavā bhagavantaṃ etadavocuṃ:"
    },
    {
      "id": "mn98:14.2",
      "pali": "“abhikkantaṃ, bho gotama, abhikkantaṃ, bho gotama."
    },
    {
      "id": "mn98:14.3",
      "pali": "Seyyathāpi, bho gotama, nikkujjitaṃ vā ukkujjeyya, paṭicchannaṃ vā vivareyya, mūḷhassa vā maggaṃ ācikkheyya, andhakāre vā telapajjotaṃ dhāreyya ‘cakkhumanto rūpāni dakkhantī’ti; evamevaṃ bhotā gotamena anekapariyāyena dhammo pakāsito."
    },
    {
      "id": "mn98:14.4",
      "pali": "Ete mayaṃ bhavantaṃ gotamaṃ saraṇaṃ gacchāma dhammañca bhikkhusaṅghañca."
    },
    {
      "id": "mn98:14.5",
      "pali": "Upāsake no bhavaṃ gotamo dhāretu ajjatagge pāṇupetaṃ saraṇaṃ gate”ti."
    },
    {
      "id": "mn98:14.6",
      "pali": "Vāseṭṭhasuttaṃ niṭṭhitaṃ aṭṭhamaṃ."
    }
  ]
}