{
  "id": "mn23",
  "title_pali": "Vammikasutta",
  "title_eng": "The Ant-hill",
  "collection": "mn",
  "pannasa": "Mūlapaṇṇāsa",
  "vagga": "Opammavagga",
  "pts": "M i 142–145",
  "segments": [
    {
      "id": "mn23:0.1",
      "pali": "Majjhima Nikāya 23"
    },
    {
      "id": "mn23:0.2",
      "pali": "Vammikasutta"
    },
    {
      "id": "mn23:1.1",
      "pali": "Evaṃ me sutaṃ—"
    },
    {
      "id": "mn23:1.2",
      "pali": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
    },
    {
      "id": "mn23:1.3",
      "pali": "Tena kho pana samayena āyasmā kumārakassapo andhavane viharati."
    },
    {
      "id": "mn23:1.4",
      "pali": "Atha kho aññatarā devatā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ andhavanaṃ obhāsetvā yenāyasmā kumārakassapo tenupasaṅkami; upasaṅkamitvā ekamantaṃ aṭṭhāsi. Ekamantaṃ ṭhitā kho sā devatā āyasmantaṃ kumārakassapaṃ etadavoca:"
    },
    {
      "id": "mn23:2.1",
      "pali": "“Bhikkhu bhikkhu, ayaṃ vammiko rattiṃ dhūmāyati, divā pajjalati."
    },
    {
      "id": "mn23:2.2",
      "pali": "Brāhmaṇo evamāha:"
    },
    {
      "id": "mn23:2.3",
      "pali": "‘abhikkhaṇa, sumedha, satthaṃ ādāyā’ti."
    },
    {
      "id": "mn23:2.4",
      "pali": "Abhikkhaṇanto sumedho satthaṃ ādāya addasa laṅgiṃ"
    },
    {
      "id": "mn23:2.5",
      "pali": "‘laṅgī, bhadante’ti."
    },
    {
      "id": "mn23:2.6",
      "pali": "Brāhmaṇo evamāha:"
    },
    {
      "id": "mn23:2.7",
      "pali": "‘ukkhipa laṅgiṃ;"
    },
    {
      "id": "mn23:2.8",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyā’ti."
    },
    {
      "id": "mn23:2.9",
      "pali": "Abhikkhaṇanto sumedho satthaṃ ādāya addasa uddhumāyikaṃ."
    },
    {
      "id": "mn23:2.10",
      "pali": "‘Uddhumāyikā, bhadante’ti."
    },
    {
      "id": "mn23:2.11",
      "pali": "Brāhmaṇo evamāha:"
    },
    {
      "id": "mn23:2.12",
      "pali": "‘ukkhipa uddhumāyikaṃ;"
    },
    {
      "id": "mn23:2.13",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyā’ti."
    },
    {
      "id": "mn23:2.14",
      "pali": "Abhikkhaṇanto sumedho satthaṃ ādāya addasa dvidhāpathaṃ."
    },
    {
      "id": "mn23:2.15",
      "pali": "‘Dvidhāpatho, bhadante’ti."
    },
    {
      "id": "mn23:2.16",
      "pali": "Brāhmaṇo evamāha:"
    },
    {
      "id": "mn23:2.17",
      "pali": "‘ukkhipa dvidhāpathaṃ;"
    },
    {
      "id": "mn23:2.18",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyā’ti."
    },
    {
      "id": "mn23:2.19",
      "pali": "Abhikkhaṇanto sumedho satthaṃ ādāya addasa caṅgavāraṃ."
    },
    {
      "id": "mn23:2.20",
      "pali": "‘Caṅgavāro, bhadante’ti."
    },
    {
      "id": "mn23:2.21",
      "pali": "Brāhmaṇo evamāha:"
    },
    {
      "id": "mn23:2.22",
      "pali": "‘ukkhipa caṅgavāraṃ;"
    },
    {
      "id": "mn23:2.23",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyā’ti."
    },
    {
      "id": "mn23:2.24",
      "pali": "Abhikkhaṇanto sumedho satthaṃ ādāya addasa kummaṃ."
    },
    {
      "id": "mn23:2.25",
      "pali": "‘Kummo, bhadante’ti."
    },
    {
      "id": "mn23:2.26",
      "pali": "Brāhmaṇo evamāha:"
    },
    {
      "id": "mn23:2.27",
      "pali": "‘ukkhipa kummaṃ;"
    },
    {
      "id": "mn23:2.28",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyā’ti."
    },
    {
      "id": "mn23:2.29",
      "pali": "Abhikkhaṇanto sumedho satthaṃ ādāya addasa asisūnaṃ."
    },
    {
      "id": "mn23:2.30",
      "pali": "‘Asisūnā, bhadante’ti."
    },
    {
      "id": "mn23:2.31",
      "pali": "Brāhmaṇo evamāha:"
    },
    {
      "id": "mn23:2.32",
      "pali": "‘ukkhipa asisūnaṃ;"
    },
    {
      "id": "mn23:2.33",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyā’ti."
    },
    {
      "id": "mn23:2.34",
      "pali": "Abhikkhaṇanto sumedho satthaṃ ādāya addasa maṃsapesiṃ."
    },
    {
      "id": "mn23:2.35",
      "pali": "‘Maṃsapesi, bhadante’ti."
    },
    {
      "id": "mn23:2.36",
      "pali": "Brāhmaṇo evamāha:"
    },
    {
      "id": "mn23:2.37",
      "pali": "‘ukkhipa maṃsapesiṃ;"
    },
    {
      "id": "mn23:2.38",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyā’ti."
    },
    {
      "id": "mn23:2.39",
      "pali": "Abhikkhaṇanto sumedho satthaṃ ādāya addasa nāgaṃ."
    },
    {
      "id": "mn23:2.40",
      "pali": "‘Nāgo, bhadante’ti."
    },
    {
      "id": "mn23:2.41",
      "pali": "Brāhmaṇo evamāha:"
    },
    {
      "id": "mn23:2.42",
      "pali": "‘tiṭṭhatu nāgo, mā nāgaṃ ghaṭṭesi; namo karohi nāgassā’ti."
    },
    {
      "id": "mn23:2.43",
      "pali": "Ime kho tvaṃ, bhikkhu, pañhe bhagavantaṃ upasaṅkamitvā puccheyyāsi, yathā ca te bhagavā byākaroti tathā naṃ dhāreyyāsi."
    },
    {
      "id": "mn23:2.44",
      "pali": "Nāhaṃ taṃ, bhikkhu, passāmi sadevake loke samārake sabrahmake sassamaṇabrāhmaṇiyā pajāya sadevamanussāya, yo imesaṃ pañhānaṃ veyyākaraṇena cittaṃ ārādheyya aññatra tathāgatena vā, tathāgatasāvakena vā, ito vā pana sutvā”ti—"
    },
    {
      "id": "mn23:2.45",
      "pali": "Idamavoca sā devatā."
    },
    {
      "id": "mn23:2.46",
      "pali": "Idaṃ vatvā tatthevantaradhāyi."
    },
    {
      "id": "mn23:3.1",
      "pali": "Atha kho āyasmā kumārakassapo tassā rattiyā accayena yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho āyasmā kumārakassapo bhagavantaṃ etadavoca:"
    },
    {
      "id": "mn23:3.2",
      "pali": "“imaṃ, bhante, rattiṃ aññatarā devatā abhikkantāya rattiyā abhikkantavaṇṇā kevalakappaṃ andhavanaṃ obhāsetvā yenāhaṃ tenupasaṅkami; upasaṅkamitvā ekamantaṃ aṭṭhāsi. Ekamantaṃ ṭhitā kho, bhante, sā devatā maṃ etadavoca:"
    },
    {
      "id": "mn23:3.3",
      "pali": "‘bhikkhu bhikkhu, ayaṃ vammiko rattiṃ dhūmāyati, divā pajjalati."
    },
    {
      "id": "mn23:3.4",
      "pali": "Brāhmaṇo evamāha:"
    },
    {
      "id": "mn23:3.5",
      "pali": "“abhikkhaṇa, sumedha, satthaṃ ādāyā”ti."
    },
    {
      "id": "mn23:3.6",
      "pali": "Abhikkhaṇanto sumedho satthaṃ ādāya …pe…"
    },
    {
      "id": "mn23:3.7",
      "pali": "ito vā pana sutvā’ti."
    },
    {
      "id": "mn23:3.8",
      "pali": "Idamavoca, bhante, sā devatā."
    },
    {
      "id": "mn23:3.9",
      "pali": "Idaṃ vatvā tatthevantaradhāyi."
    },
    {
      "id": "mn23:3.10",
      "pali": "Ko nu kho, bhante, vammiko, kā rattiṃ dhūmāyanā, kā divā pajjalanā, ko brāhmaṇo, ko sumedho, kiṃ satthaṃ, kiṃ abhikkhaṇaṃ, kā laṅgī, kā uddhumāyikā, ko dvidhāpatho, kiṃ caṅgavāraṃ, ko kummo, kā asisūnā, kā maṃsapesi, ko nāgo”ti?"
    },
    {
      "id": "mn23:4.1",
      "pali": "“‘Vammiko’ti kho, bhikkhu, imassetaṃ cātumahābhūtikassa kāyassa adhivacanaṃ, mātāpettikasambhavassa odanakummāsūpacayassa aniccucchādanaparimaddanabhedanaviddhaṃsanadhammassa."
    },
    {
      "id": "mn23:4.2",
      "pali": "Yaṃ kho, bhikkhu, divā kammante ārabbha rattiṃ anuvitakketi anuvicāreti—"
    },
    {
      "id": "mn23:4.3",
      "pali": "ayaṃ rattiṃ dhūmāyanā."
    },
    {
      "id": "mn23:4.4",
      "pali": "Yaṃ kho, bhikkhu, rattiṃ anuvitakketvā anuvicāretvā divā kammante payojeti kāyena vācāya manasā—"
    },
    {
      "id": "mn23:4.5",
      "pali": "ayaṃ divā pajjalanā."
    },
    {
      "id": "mn23:4.6",
      "pali": "‘Brāhmaṇo’ti kho, bhikkhu, tathāgatassetaṃ adhivacanaṃ arahato sammāsambuddhassa."
    },
    {
      "id": "mn23:4.7",
      "pali": "‘Sumedho’ti kho, bhikkhu, sekkhassetaṃ bhikkhuno adhivacanaṃ."
    },
    {
      "id": "mn23:4.8",
      "pali": "‘Satthan’ti kho, bhikkhu, ariyāyetaṃ paññāya adhivacanaṃ."
    },
    {
      "id": "mn23:4.9",
      "pali": "‘Abhikkhaṇan’ti kho, bhikkhu, vīriyārambhassetaṃ adhivacanaṃ."
    },
    {
      "id": "mn23:4.10",
      "pali": "‘Laṅgī’ti kho, bhikkhu, avijjāyetaṃ adhivacanaṃ."
    },
    {
      "id": "mn23:4.11",
      "pali": "Ukkhipa laṅgiṃ, pajaha avijjaṃ;"
    },
    {
      "id": "mn23:4.12",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyāti ayametassa attho."
    },
    {
      "id": "mn23:4.13",
      "pali": "‘Uddhumāyikā’ti kho, bhikkhu, kodhūpāyāsassetaṃ adhivacanaṃ."
    },
    {
      "id": "mn23:4.14",
      "pali": "Ukkhipa uddhumāyikaṃ, pajaha kodhūpāyāsaṃ;"
    },
    {
      "id": "mn23:4.15",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyāti ayametassa attho."
    },
    {
      "id": "mn23:4.16",
      "pali": "‘Dvidhāpatho’ti kho, bhikkhu, vicikicchāyetaṃ adhivacanaṃ."
    },
    {
      "id": "mn23:4.17",
      "pali": "Ukkhipa dvidhāpathaṃ, pajaha vicikicchaṃ;"
    },
    {
      "id": "mn23:4.18",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyāti ayametassa attho."
    },
    {
      "id": "mn23:4.19",
      "pali": "‘Caṅgavāran’ti kho, bhikkhu, pañcannetaṃ nīvaraṇānaṃ adhivacanaṃ, seyyathidaṃ—"
    },
    {
      "id": "mn23:4.20",
      "pali": "kāmacchandanīvaraṇassa, byāpādanīvaraṇassa, thinamiddhanīvaraṇassa, uddhaccakukkuccanīvaraṇassa, vicikicchānīvaraṇassa."
    },
    {
      "id": "mn23:4.21",
      "pali": "Ukkhipa caṅgavāraṃ, pajaha pañca nīvaraṇe;"
    },
    {
      "id": "mn23:4.22",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyāti ayametassa attho."
    },
    {
      "id": "mn23:4.23",
      "pali": "‘Kummo’ti kho, bhikkhu, pañcannetaṃ upādānakkhandhānaṃ adhivacanaṃ, seyyathidaṃ—"
    },
    {
      "id": "mn23:4.24",
      "pali": "rūpupādānakkhandhassa, vedanupādānakkhandhassa, saññupādānakkhandhassa, saṅkhārupādānakkhandhassa, viññāṇupādānakkhandhassa."
    },
    {
      "id": "mn23:4.25",
      "pali": "Ukkhipa kummaṃ, pajaha pañcupādānakkhandhe;"
    },
    {
      "id": "mn23:4.26",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyāti ayametassa attho."
    },
    {
      "id": "mn23:4.27",
      "pali": "‘Asisūnā’ti kho, bhikkhu, pañcannetaṃ kāmaguṇānaṃ adhivacanaṃ—"
    },
    {
      "id": "mn23:4.28",
      "pali": "cakkhuviññeyyānaṃ rūpānaṃ iṭṭhānaṃ kantānaṃ manāpānaṃ piyarūpānaṃ kāmūpasaṃhitānaṃ rajanīyānaṃ,"
    },
    {
      "id": "mn23:4.29",
      "pali": "sotaviññeyyānaṃ saddānaṃ …pe…"
    },
    {
      "id": "mn23:4.30",
      "pali": "ghānaviññeyyānaṃ gandhānaṃ …pe…"
    },
    {
      "id": "mn23:4.31",
      "pali": "jivhāviññeyyānaṃ rasānaṃ …pe…"
    },
    {
      "id": "mn23:4.32",
      "pali": "kāyaviññeyyānaṃ phoṭṭhabbānaṃ iṭṭhānaṃ kantānaṃ manāpānaṃ piyarūpānaṃ kāmūpasaṃhitānaṃ rajanīyānaṃ."
    },
    {
      "id": "mn23:4.33",
      "pali": "Ukkhipa asisūnaṃ, pajaha pañca kāmaguṇe;"
    },
    {
      "id": "mn23:4.34",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyāti ayametassa attho."
    },
    {
      "id": "mn23:4.35",
      "pali": "‘Maṃsapesī’ti kho, bhikkhu, nandīrāgassetaṃ adhivacanaṃ."
    },
    {
      "id": "mn23:4.36",
      "pali": "Ukkhipa maṃsapesiṃ, pajaha nandīrāgaṃ;"
    },
    {
      "id": "mn23:4.37",
      "pali": "abhikkhaṇa, sumedha, satthaṃ ādāyāti ayametassa attho."
    },
    {
      "id": "mn23:4.38",
      "pali": "‘Nāgo’ti kho, bhikkhu, khīṇāsavassetaṃ bhikkhuno adhivacanaṃ."
    },
    {
      "id": "mn23:4.39",
      "pali": "Tiṭṭhatu nāgo, mā nāgaṃ ghaṭṭesi; namo karohi nāgassāti ayametassa attho”ti."
    },
    {
      "id": "mn23:4.40",
      "pali": "Idamavoca bhagavā."
    },
    {
      "id": "mn23:4.41",
      "pali": "Attamano āyasmā kumārakassapo bhagavato bhāsitaṃ abhinandīti."
    },
    {
      "id": "mn23:4.42",
      "pali": "Vammikasuttaṃ niṭṭhitaṃ tatiyaṃ."
    }
  ]
}