{
  "id": "mn134",
  "title_pali": "Lomasakaṅgiyabhaddekarattasutta",
  "title_eng": "Lomasakaṅgiya and One Fortunate Attachment",
  "collection": "mn",
  "pannasa": "Uparipaṇṇāsa",
  "vagga": "Vibhaṅgavagga",
  "pts": "M iii 195–199",
  "segments": [
    {
      "id": "mn134:0.1",
      "pali": "Majjhima Nikāya 134"
    },
    {
      "id": "mn134:0.2",
      "pali": "Lomasakaṅgiyabhaddekarattasutta"
    },
    {
      "id": "mn134:1.1",
      "pali": "Evaṃ me sutaṃ—"
    },
    {
      "id": "mn134:1.2",
      "pali": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
    },
    {
      "id": "mn134:1.3",
      "pali": "Tena kho pana samayena āyasmā lomasakaṅgiyo sakkesu viharati kapilavatthusmiṃ nigrodhārāme."
    },
    {
      "id": "mn134:2.1",
      "pali": "Atha kho candano devaputto abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṃ nigrodhārāmaṃ obhāsetvā yenāyasmā lomasakaṅgiyo tenupasaṅkami; upasaṅkamitvā ekamantaṃ aṭṭhāsi. Ekamantaṃ ṭhito kho candano devaputto āyasmantaṃ lomasakaṅgiyaṃ etadavoca:"
    },
    {
      "id": "mn134:2.2",
      "pali": "“dhāresi tvaṃ, bhikkhu, bhaddekarattassa uddesañca vibhaṅgañcā”ti?"
    },
    {
      "id": "mn134:2.3",
      "pali": "“Na kho ahaṃ, āvuso, dhāremi bhaddekarattassa uddesañca vibhaṅgañca."
    },
    {
      "id": "mn134:2.4",
      "pali": "Tvaṃ panāvuso, dhāresi bhaddekarattassa uddesañca vibhaṅgañcā”ti?"
    },
    {
      "id": "mn134:2.5",
      "pali": "“Ahampi kho, bhikkhu, na dhāremi bhaddekarattassa uddesañca vibhaṅgañca."
    },
    {
      "id": "mn134:2.6",
      "pali": "Dhāresi pana tvaṃ, bhikkhu, bhaddekarattiyo gāthā”ti?"
    },
    {
      "id": "mn134:2.7",
      "pali": "“Na kho ahaṃ, āvuso, dhāremi bhaddekarattiyo gāthā."
    },
    {
      "id": "mn134:2.8",
      "pali": "Tvaṃ panāvuso, dhāresi bhaddekarattiyo gāthā”ti?"
    },
    {
      "id": "mn134:2.9",
      "pali": "“Dhāremi kho ahaṃ, bhikkhu, bhaddekarattiyo gāthā”ti."
    },
    {
      "id": "mn134:2.10",
      "pali": "“Yathā kathaṃ pana tvaṃ, āvuso, dhāresi bhaddekarattiyo gāthā”ti?"
    },
    {
      "id": "mn134:2.11",
      "pali": "“Ekamidaṃ, bhikkhu, samayaṃ bhagavā devesu tāvatiṃsesu viharati pāricchattakamūle paṇḍukambalasilāyaṃ."
    },
    {
      "id": "mn134:2.12",
      "pali": "Tatra bhagavā devānaṃ tāvatiṃsānaṃ bhaddekarattassa uddesañca vibhaṅgañca abhāsi:"
    },
    {
      "id": "mn134:3.1",
      "pali": "‘Atītaṃ nānvāgameyya,"
    },
    {
      "id": "mn134:3.2",
      "pali": "nappaṭikaṅkhe anāgataṃ;"
    },
    {
      "id": "mn134:3.3",
      "pali": "Yadatītaṃ pahīnaṃ taṃ,"
    },
    {
      "id": "mn134:3.4",
      "pali": "appattañca anāgataṃ."
    },
    {
      "id": "mn134:3.5",
      "pali": "Paccuppannañca yo dhammaṃ,"
    },
    {
      "id": "mn134:3.6",
      "pali": "tattha tattha vipassati;"
    },
    {
      "id": "mn134:3.7",
      "pali": "Asaṃhīraṃ asaṅkuppaṃ,"
    },
    {
      "id": "mn134:3.8",
      "pali": "taṃ vidvā manubrūhaye."
    },
    {
      "id": "mn134:3.9",
      "pali": "Ajjeva kiccamātappaṃ,"
    },
    {
      "id": "mn134:3.10",
      "pali": "ko jaññā maraṇaṃ suve;"
    },
    {
      "id": "mn134:3.11",
      "pali": "Na hi no saṅgaraṃ tena,"
    },
    {
      "id": "mn134:3.12",
      "pali": "mahāsenena maccunā."
    },
    {
      "id": "mn134:3.13",
      "pali": "Evaṃvihāriṃ ātāpiṃ,"
    },
    {
      "id": "mn134:3.14",
      "pali": "ahorattamatanditaṃ;"
    },
    {
      "id": "mn134:3.15",
      "pali": "Taṃ ve bhaddekarattoti,"
    },
    {
      "id": "mn134:3.16",
      "pali": "santo ācikkhate munī’ti."
    },
    {
      "id": "mn134:4.1",
      "pali": "Evaṃ kho ahaṃ, bhikkhu, dhāremi bhaddekarattiyo gāthā."
    },
    {
      "id": "mn134:4.2",
      "pali": "Uggaṇhāhi tvaṃ, bhikkhu, bhaddekarattassa uddesañca vibhaṅgañca;"
    },
    {
      "id": "mn134:4.3",
      "pali": "pariyāpuṇāhi tvaṃ, bhikkhu, bhaddekarattassa uddesañca vibhaṅgañca;"
    },
    {
      "id": "mn134:4.4",
      "pali": "dhārehi tvaṃ, bhikkhu, bhaddekarattassa uddesañca vibhaṅgañca."
    },
    {
      "id": "mn134:4.5",
      "pali": "Atthasaṃhito, bhikkhu, bhaddekarattassa uddeso ca vibhaṅgo ca ādibrahmacariyako”ti."
    },
    {
      "id": "mn134:4.6",
      "pali": "Idamavoca candano devaputto."
    },
    {
      "id": "mn134:4.7",
      "pali": "Idaṃ vatvā tatthevantaradhāyi."
    },
    {
      "id": "mn134:5.1",
      "pali": "Atha kho āyasmā lomasakaṅgiyo tassā rattiyā accayena senāsanaṃ saṃsāmetvā pattacīvaramādāya yena sāvatthi tena cārikaṃ pakkāmi."
    },
    {
      "id": "mn134:5.2",
      "pali": "Anupubbena cārikaṃ caramāno yena sāvatthi jetavanaṃ anāthapiṇḍikassa ārāmo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho āyasmā lomasakaṅgiyo bhagavantaṃ etadavoca:"
    },
    {
      "id": "mn134:5.3",
      "pali": "“Ekamidāhaṃ, bhante, samayaṃ sakkesu viharāmi kapilavatthusmiṃ nigrodhārāme."
    },
    {
      "id": "mn134:5.4",
      "pali": "Atha kho, bhante, aññataro devaputto abhikkantāya rattiyā abhikkantavaṇṇo kevalakappaṃ nigrodhārāmaṃ obhāsetvā yenāhaṃ tenupasaṅkami; upasaṅkamitvā ekamantaṃ aṭṭhāsi. Ekamantaṃ ṭhito kho, bhante, so devaputto maṃ etadavoca:"
    },
    {
      "id": "mn134:5.5",
      "pali": "‘dhāresi tvaṃ, bhikkhu, bhaddekarattassa uddesañca vibhaṅgañcā’ti?"
    },
    {
      "id": "mn134:5.6",
      "pali": "Evaṃ vutte, ahaṃ, bhante, taṃ devaputtaṃ etadavocaṃ:"
    },
    {
      "id": "mn134:5.7",
      "pali": "‘na kho ahaṃ, āvuso, dhāremi bhaddekarattassa uddesañca vibhaṅgañca."
    },
    {
      "id": "mn134:5.8",
      "pali": "Tvaṃ panāvuso, dhāresi bhaddekarattassa uddesañca vibhaṅgañcā’ti?"
    },
    {
      "id": "mn134:5.9",
      "pali": "‘Ahampi kho, bhikkhu, na dhāremi bhaddekarattassa uddesañca vibhaṅgañca."
    },
    {
      "id": "mn134:5.10",
      "pali": "Dhāresi pana tvaṃ, bhikkhu, bhaddekarattiyo gāthā’ti?"
    },
    {
      "id": "mn134:5.11",
      "pali": "‘Na kho ahaṃ, āvuso, dhāremi bhaddekarattiyo gāthā."
    },
    {
      "id": "mn134:5.12",
      "pali": "Tvaṃ panāvuso, dhāresi bhaddekarattiyo gāthā’ti?"
    },
    {
      "id": "mn134:5.13",
      "pali": "‘Dhāremi kho ahaṃ, bhikkhu, bhaddekarattiyo gāthā’ti."
    },
    {
      "id": "mn134:5.14",
      "pali": "‘Yathā kathaṃ pana tvaṃ, āvuso, dhāresi bhaddekarattiyo gāthā’ti?"
    },
    {
      "id": "mn134:5.15",
      "pali": "‘Ekamidaṃ, bhikkhu, samayaṃ bhagavā devesu tāvatiṃsesu viharati pāricchattakamūle paṇḍukambalasilāyaṃ."
    },
    {
      "id": "mn134:5.16",
      "pali": "Tatra kho bhagavā devānaṃ tāvatiṃsānaṃ bhaddekarattassa uddesañca vibhaṅgañca abhāsi:"
    },
    {
      "id": "mn134:5.17",
      "pali": "“Atītaṃ nānvāgameyya,"
    },
    {
      "id": "mn134:5.18",
      "pali": "…pe…"
    },
    {
      "id": "mn134:5.19",
      "pali": "Taṃ ve bhaddekarattoti,"
    },
    {
      "id": "mn134:5.20",
      "pali": "santo ācikkhate munī”ti."
    },
    {
      "id": "mn134:5.21",
      "pali": "Evaṃ kho ahaṃ, bhikkhu, dhāremi bhaddekarattiyo gāthā."
    },
    {
      "id": "mn134:5.22",
      "pali": "Uggaṇhāhi tvaṃ, bhikkhu, bhaddekarattassa uddesañca vibhaṅgañca;"
    },
    {
      "id": "mn134:5.23",
      "pali": "pariyāpuṇāhi tvaṃ, bhikkhu, bhaddekarattassa uddesañca vibhaṅgañca;"
    },
    {
      "id": "mn134:5.24",
      "pali": "dhārehi tvaṃ, bhikkhu, bhaddekarattassa uddesañca vibhaṅgañca."
    },
    {
      "id": "mn134:5.25",
      "pali": "Atthasaṃhito, bhikkhu, bhaddekarattassa uddeso ca vibhaṅgo ca ādibrahmacariyako’ti."
    },
    {
      "id": "mn134:5.26",
      "pali": "Idamavoca, bhante, so devaputto."
    },
    {
      "id": "mn134:5.27",
      "pali": "Idaṃ vatvā tatthevantaradhāyi."
    },
    {
      "id": "mn134:5.28",
      "pali": "Sādhu me, bhante, bhagavā bhaddekarattassa uddesañca vibhaṅgañca desetū”ti."
    },
    {
      "id": "mn134:6.1",
      "pali": "“Jānāsi pana tvaṃ, bhikkhu, taṃ devaputtan”ti?"
    },
    {
      "id": "mn134:6.2",
      "pali": "“Na kho ahaṃ, bhante, jānāmi taṃ devaputtan”ti."
    },
    {
      "id": "mn134:6.3",
      "pali": "“Candano nāma so, bhikkhu, devaputto."
    },
    {
      "id": "mn134:6.4",
      "pali": "Candano, bhikkhu, devaputto aṭṭhiṃ katvā manasikatvā sabbacetasā samannāharitvā ohitasoto dhammaṃ suṇāti."
    },
    {
      "id": "mn134:6.5",
      "pali": "Tena hi, bhikkhu, suṇāhi, sādhukaṃ manasi karohi; bhāsissāmī”ti."
    },
    {
      "id": "mn134:6.6",
      "pali": "“Evaṃ, bhante”ti kho āyasmā lomasakaṅgiyo bhagavato paccassosi."
    },
    {
      "id": "mn134:6.7",
      "pali": "Bhagavā etadavoca:"
    },
    {
      "id": "mn134:7.1",
      "pali": "“Atītaṃ nānvāgameyya,"
    },
    {
      "id": "mn134:7.2",
      "pali": "nappaṭikaṅkhe anāgataṃ;"
    },
    {
      "id": "mn134:7.3",
      "pali": "Yadatītaṃ pahīnaṃ taṃ,"
    },
    {
      "id": "mn134:7.4",
      "pali": "appattañca anāgataṃ."
    },
    {
      "id": "mn134:7.5",
      "pali": "Paccuppannañca yo dhammaṃ,"
    },
    {
      "id": "mn134:7.6",
      "pali": "tattha tattha vipassati;"
    },
    {
      "id": "mn134:7.7",
      "pali": "Asaṃhīraṃ asaṅkuppaṃ,"
    },
    {
      "id": "mn134:7.8",
      "pali": "taṃ vidvā manubrūhaye."
    },
    {
      "id": "mn134:7.9",
      "pali": "Ajjeva kiccamātappaṃ,"
    },
    {
      "id": "mn134:7.10",
      "pali": "ko jaññā maraṇaṃ suve;"
    },
    {
      "id": "mn134:7.11",
      "pali": "Na hi no saṅgaraṃ tena,"
    },
    {
      "id": "mn134:7.12",
      "pali": "mahāsenena maccunā."
    },
    {
      "id": "mn134:7.13",
      "pali": "Evaṃvihāriṃ ātāpiṃ,"
    },
    {
      "id": "mn134:7.14",
      "pali": "ahorattamatanditaṃ;"
    },
    {
      "id": "mn134:7.15",
      "pali": "Taṃ ve bhaddekarattoti,"
    },
    {
      "id": "mn134:7.16",
      "pali": "santo ācikkhate muni."
    },
    {
      "id": "mn134:8-13.1",
      "pali": "Kathañca, bhikkhu, atītaṃ anvāgameti …pe…"
    },
    {
      "id": "mn134:8-13.2",
      "pali": "evaṃ kho, bhikkhu, atītaṃ anvāgameti."
    },
    {
      "id": "mn134:8-13.3",
      "pali": "Kathañca, bhikkhu, atītaṃ nānvāgameti …pe…"
    },
    {
      "id": "mn134:8-13.4",
      "pali": "evaṃ kho, bhikkhu, atītaṃ nānvāgameti."
    },
    {
      "id": "mn134:8-13.5",
      "pali": "Kathañca, bhikkhu, anāgataṃ paṭikaṅkhati …pe…"
    },
    {
      "id": "mn134:8-13.6",
      "pali": "evaṃ kho, bhikkhu, anāgataṃ paṭikaṅkhati."
    },
    {
      "id": "mn134:8-13.7",
      "pali": "Kathañca, bhikkhu, anāgataṃ nappaṭikaṅkhati …pe…"
    },
    {
      "id": "mn134:8-13.8",
      "pali": "evaṃ kho, bhikkhu, anāgataṃ nappaṭikaṅkhati."
    },
    {
      "id": "mn134:8-13.9",
      "pali": "Kathañca, bhikkhu, paccuppannesu dhammesu saṃhīrati …pe…"
    },
    {
      "id": "mn134:8-13.10",
      "pali": "evaṃ kho, bhikkhu, paccuppannesu dhammesu saṃhīrati."
    },
    {
      "id": "mn134:8-13.11",
      "pali": "Kathañca, bhikkhu, paccuppannesu dhammesu na saṃhīrati …pe…"
    },
    {
      "id": "mn134:8-13.12",
      "pali": "evaṃ kho, bhikkhu, paccuppannesu dhammesu na saṃhīrati."
    },
    {
      "id": "mn134:14.1",
      "pali": "Atītaṃ nānvāgameyya,"
    },
    {
      "id": "mn134:14.2",
      "pali": "nappaṭikaṅkhe anāgataṃ;"
    },
    {
      "id": "mn134:14.3",
      "pali": "Yadatītaṃ pahīnaṃ taṃ,"
    },
    {
      "id": "mn134:14.4",
      "pali": "appattañca anāgataṃ."
    },
    {
      "id": "mn134:14.5",
      "pali": "Paccuppannañca yo dhammaṃ,"
    },
    {
      "id": "mn134:14.6",
      "pali": "tattha tattha vipassati;"
    },
    {
      "id": "mn134:14.7",
      "pali": "Asaṃhīraṃ asaṅkuppaṃ,"
    },
    {
      "id": "mn134:14.8",
      "pali": "taṃ vidvā manubrūhaye."
    },
    {
      "id": "mn134:14.9",
      "pali": "Ajjeva kiccamātappaṃ,"
    },
    {
      "id": "mn134:14.10",
      "pali": "ko jaññā maraṇaṃ suve;"
    },
    {
      "id": "mn134:14.11",
      "pali": "Na hi no saṅgaraṃ tena,"
    },
    {
      "id": "mn134:14.12",
      "pali": "mahāsenena maccunā."
    },
    {
      "id": "mn134:14.13",
      "pali": "Evaṃvihāriṃ ātāpiṃ,"
    },
    {
      "id": "mn134:14.14",
      "pali": "ahorattamatanditaṃ;"
    },
    {
      "id": "mn134:14.15",
      "pali": "Taṃ ve bhaddekarattoti,"
    },
    {
      "id": "mn134:14.16",
      "pali": "santo ācikkhate munī”ti."
    },
    {
      "id": "mn134:14.17",
      "pali": "Idamavoca bhagavā."
    },
    {
      "id": "mn134:14.18",
      "pali": "Attamano āyasmā lomasakaṅgiyo bhagavato bhāsitaṃ abhinandīti."
    },
    {
      "id": "mn134:14.19",
      "pali": "Lomasakaṅgiyabhaddekarattasuttaṃ niṭṭhitaṃ catutthaṃ."
    }
  ]
}