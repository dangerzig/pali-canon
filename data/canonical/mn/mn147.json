    },
    {
      "id": "mn147:4-8.1",
      "pali": "“Taṃ kiṃ maññasi rāhula, sotaṃ niccaṃ vā aniccaṃ vā”ti?"
    },
    {
      "id": "mn147:4-8.2",
      "pali": "“Aniccaṃ, bhante …pe…"
    },
    {
      "id": "mn147:4-8.3",
      "pali": "ghānaṃ niccaṃ vā aniccaṃ vā”ti?"
    },
    {
      "id": "mn147:4-8.4",
      "pali": "“Aniccaṃ, bhante …pe…"
    },
    {
      "id": "mn147:4-8.5",
      "pali": "jivhā niccā vā aniccā vā”ti?"
    },
    {
      "id": "mn147:4-8.6",
      "pali": "“Aniccā, bhante …"
    },
    {
      "id": "mn147:4-8.7",
      "pali": "kāyo nicco vā anicco vā”ti?"
    },
    {
      "id": "mn147:4-8.8",
      "pali": "“Anicco, bhante …"
    },
    {
      "id": "mn147:4-8.9",
      "pali": "mano nicco vā anicco vā”ti?"
    },
    {
      "id": "mn147:4-8.10",
      "pali": "“Anicco, bhante”."
    },
    {
      "id": "mn147:4-8.11",
      "pali": "“Yaṃ panāniccaṃ dukkhaṃ vā taṃ sukhaṃ vā”ti?"
    },
    {
      "id": "mn147:4-8.12",
      "pali": "“Dukkhaṃ, bhante”."
    },
    {
      "id": "mn147:4-8.13",
      "pali": "“Yaṃ panāniccaṃ dukkhaṃ vipariṇāmadhammaṃ, kallaṃ nu taṃ samanupassituṃ:"
    },
    {
      "id": "mn147:4-8.14",
      "pali": "‘etaṃ mama, esohamasmi, eso me attā’”ti?"
    },
    {
      "id": "mn147:4-8.15",
      "pali": "“No hetaṃ, bhante”."
    },
    {
      "id": "mn147:4-8.16",
      "pali": "“Taṃ kiṃ maññasi rāhula, dhammā niccā vā aniccā vā”ti?"
    },
    {
      "id": "mn147:4-8.17",
      "pali": "“Aniccā, bhante”."
    },
    {
      "id": "mn147:4-8.18",
      "pali": "“Yaṃ panāniccaṃ dukkhaṃ vā taṃ sukhaṃ vā”ti?"
    },
    {
      "id": "mn147:4-8.19",
      "pali": "“Dukkhaṃ, bhante”."
    },
    {
      "id": "mn147:4-8.20",
      "pali": "“Yaṃ panāniccaṃ dukkhaṃ vipariṇāmadhammaṃ, kallaṃ nu taṃ samanupassituṃ:"
    },
    {
      "id": "mn147:4-8.21",
