    },
    {
      "id": "mn147:4-8.42",
      "pali": "“Yaṃ panāniccaṃ dukkhaṃ vipariṇāmadhammaṃ kallaṃ nu taṃ samanupassituṃ:"
    },
    {
      "id": "mn147:4-8.43",
      "pali": "‘etaṃ mama, esohamasmi, eso me attā’”ti?"
    },
    {
      "id": "mn147:4-8.44",
      "pali": "“No hetaṃ, bhante”."
    },
    {
      "id": "mn147:9.1",
      "pali": "“Evaṃ passaṃ, rāhula, sutavā ariyasāvako cakkhusmiṃ nibbindati, rūpesu nibbindati, cakkhuviññāṇe nibbindati, cakkhusamphasse nibbindati, yamidaṃ cakkhusamphassapaccayā uppajjati vedanāgataṃ saññāgataṃ saṅkhāragataṃ viññāṇagataṃ tasmimpi nibbindati."
    },
    {
      "id": "mn147:9.2",
      "pali": "Sotasmiṃ nibbindati, saddesu nibbindati …pe…"
    },
    {
      "id": "mn147:9.3",
      "pali": "ghānasmiṃ nibbindati, gandhesu nibbindati …"
    },
    {
      "id": "mn147:9.4",
      "pali": "jivhāya nibbindati, rasesu nibbindati …"
    },
    {
      "id": "mn147:9.5",
      "pali": "kāyasmiṃ nibbindati, phoṭṭhabbesu nibbindati …"
    },
    {
      "id": "mn147:9.6",
      "pali": "manasmiṃ nibbindati, dhammesu nibbindati, manoviññāṇe nibbindati, manosamphasse nibbindati, yamidaṃ manosamphassapaccayā uppajjati vedanāgataṃ saññāgataṃ saṅkhāragataṃ viññāṇagataṃ tasmimpi nibbindati."
    },
    {
      "id": "mn147:9.7",
      "pali": "Nibbindaṃ virajjati, virāgā vimuccati. Vimuttasmiṃ vimuttamiti ñāṇaṃ hoti."
    },
    {
      "id": "mn147:9.8",
      "pali": "‘Khīṇā jāti, vusitaṃ brahmacariyaṃ, kataṃ karaṇīyaṃ, nāparaṃ itthattāyā’ti pajānātī”ti."
    },
    {
      "id": "mn147:9.9",
      "pali": "Idamavoca bhagavā."
    },
    {
      "id": "mn147:9.10",
      "pali": "Attamano āyasmā rāhulo bhagavato bhāsitaṃ abhinandīti."
    },
    {
      "id": "mn147:9.11",
      "pali": "Imasmiñca pana veyyākaraṇasmiṃ bhaññamāne āyasmato rāhulassa anupādāya āsavehi cittaṃ vimucci."
    },
    {
      "id": "mn147:9.12",
      "pali": "Tāsañca anekānaṃ devatāsahassānaṃ virajaṃ vītamalaṃ dhammacakkhuṃ udapādi:"
    },
    {
      "id": "mn147:9.13",
      "pali": "“yaṃ kiñci samudayadhammaṃ sabbaṃ taṃ nirodhadhamman”ti."
    },
    {
      "id": "mn147:9.14",
      "pali": "Cūḷarāhulovādasuttaṃ niṭṭhitaṃ pañcamaṃ."
    }
  ]
}