{
  "id": "mn147",
  "title_pali": "Cūḷarāhulovādasutta",
  "title_eng": "The Shorter Discourse of Advice to Rāhula",
  "collection": "mn",
  "pannasa": "Uparipaṇṇāsa",
  "vagga": "Saḷāyatanavagga",
  "pts": "M iii 277–280",
  "segments": [
    {
      "id": "mn147:0.1",
      "pali": "Majjhima Nikāya 147"
    },
    {
      "id": "mn147:0.2",
      "pali": "Cūḷarāhulovādasutta"
    },
    {
      "id": "mn147:1.1",
      "pali": "Evaṃ me sutaṃ—"
    },
    {
      "id": "mn147:1.2",
      "pali": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
    },
    {
      "id": "mn147:1.3",
      "pali": "Atha kho bhagavato rahogatassa paṭisallīnassa evaṃ cetaso parivitakko udapādi:"
    },
    {
      "id": "mn147:1.4",
      "pali": "“paripakkā kho rāhulassa vimuttiparipācanīyā dhammā."
    },
    {
      "id": "mn147:1.5",
      "pali": "Yannūnāhaṃ rāhulaṃ uttariṃ āsavānaṃ khaye vineyyan”ti."
    },
    {
      "id": "mn147:1.6",
      "pali": "Atha kho bhagavā pubbaṇhasamayaṃ nivāsetvā pattacīvaramādāya sāvatthiṃ piṇḍāya pāvisi."
    },
    {
      "id": "mn147:1.7",
      "pali": "Sāvatthiyaṃ piṇḍāya caritvā pacchābhattaṃ piṇḍapātapaṭikkanto āyasmantaṃ rāhulaṃ āmantesi:"
    },
    {
      "id": "mn147:1.8",
      "pali": "“gaṇhāhi, rāhula, nisīdanaṃ;"
    },
    {
      "id": "mn147:1.9",
      "pali": "yena andhavanaṃ tenupasaṅkamissāma divāvihārāyā”ti."
    },
    {
      "id": "mn147:1.10",
      "pali": "“Evaṃ, bhante”ti kho āyasmā rāhulo bhagavato paṭissutvā nisīdanaṃ ādāya bhagavantaṃ piṭṭhito piṭṭhito anubandhi."
    },
    {
      "id": "mn147:2.1",
      "pali": "Tena kho pana samayena anekāni devatāsahassāni bhagavantaṃ anubandhāni honti:"
    },
    {
      "id": "mn147:2.2",
      "pali": "“ajja bhagavā āyasmantaṃ rāhulaṃ uttariṃ āsavānaṃ khaye vinessatī”ti."
    },
    {
      "id": "mn147:2.3",
      "pali": "Atha kho bhagavā andhavanaṃ ajjhogāhetvā aññatarasmiṃ rukkhamūle paññatte āsane nisīdi."
    },
    {
      "id": "mn147:2.4",
      "pali": "Āyasmāpi kho rāhulo bhagavantaṃ abhivādetvā ekamantaṃ nisīdi."
    },
    {
      "id": "mn147:2.5",
      "pali": "Ekamantaṃ nisinnaṃ kho āyasmantaṃ rāhulaṃ bhagavā etadavoca:"
    },
    {
      "id": "mn147:2.6",
      "pali": "“Taṃ kiṃ maññasi, rāhula,"
    },
    {
      "id": "mn147:2.7",
      "pali": "cakkhu niccaṃ vā aniccaṃ vā”ti?"
    },
    {
      "id": "mn147:2.8",
      "pali": "“Aniccaṃ, bhante”."
    },
    {
      "id": "mn147:2.9",
      "pali": "“Yaṃ panāniccaṃ dukkhaṃ vā taṃ sukhaṃ vā”ti?"
    },
    {
      "id": "mn147:2.10",
      "pali": "“Dukkhaṃ, bhante”."
    },
    {
      "id": "mn147:2.11",
      "pali": "“Yaṃ panāniccaṃ dukkhaṃ vipariṇāmadhammaṃ, kallaṃ nu taṃ samanupassituṃ:"
    },
    {
      "id": "mn147:2.12",
      "pali": "‘etaṃ mama, esohamasmi, eso me attā’”ti?"
    },
    {
      "id": "mn147:2.13",
      "pali": "“No hetaṃ, bhante”."
    },
    {
      "id": "mn147:3.1",
      "pali": "“Taṃ kiṃ maññasi, rāhula,"
    },
    {
      "id": "mn147:3.2",
      "pali": "rūpā niccā vā aniccā vā”ti?"
    },
    {
      "id": "mn147:3.3",
