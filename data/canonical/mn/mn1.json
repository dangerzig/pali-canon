{
  "id": "mn1",
  "title_pali": "Mūlapariyāyasutta",
  "title_eng": "The Root of All Things",
  "collection": "mn",
  "pannasa": "Mūlapaṇṇāsa",
  "vagga": "Mūlapariyāyavagga",
  "pts": "M i 1–6",
  "segments": [
    {
      "id": "mn1:0.1",
      "pali": "Majjhima Nikāya 1"
    },
    {
      "id": "mn1:0.2",
      "pali": "Mūlapariyāyasutta"
    },
    {
      "id": "mn1:1.1",
      "pali": "Evaṃ me sutaṃ—"
    },
    {
      "id": "mn1:1.2",
      "pali": "ekaṃ samayaṃ bhagavā ukkaṭṭhāyaṃ viharati subhagavane sālarājamūle."
    },
    {
      "id": "mn1:1.3",
      "pali": "Tatra kho bhagavā bhikkhū āmantesi:"
    },
    {
      "id": "mn1:1.4",
      "pali": "“bhikkhavo”ti."
    },
    {
      "id": "mn1:1.5",
      "pali": "“Bhadante”ti te bhikkhū bhagavato paccassosuṃ."
    },
    {
      "id": "mn1:1.6",
      "pali": "Bhagavā etadavoca:"
    },
    {
      "id": "mn1:2.1",
      "pali": "“sabbadhammamūlapariyāyaṃ vo, bhikkhave, desessāmi."
    },
    {
      "id": "mn1:2.2",
      "pali": "Taṃ suṇātha, sādhukaṃ manasi karotha, bhāsissāmī”ti."
    },
    {
      "id": "mn1:2.3",
      "pali": "“Evaṃ, bhante”ti kho te bhikkhū bhagavato paccassosuṃ."
    },
    {
      "id": "mn1:2.4",
      "pali": "Bhagavā etadavoca:"
    },
    {
      "id": "mn1:3.1",
      "pali": "“Idha, bhikkhave, assutavā puthujjano ariyānaṃ adassāvī ariyadhammassa akovido ariyadhamme avinīto, sappurisānaṃ adassāvī sappurisadhammassa akovido sappurisadhamme avinīto—"
    },
    {
      "id": "mn1:3.2",
      "pali": "pathaviṃ pathavito sañjānāti;"
    },
    {
      "id": "mn1:3.3",
      "pali": "pathaviṃ pathavito saññatvā pathaviṃ maññati, pathaviyā maññati, pathavito maññati, pathaviṃ meti maññati, pathaviṃ abhinandati."
    },
    {
      "id": "mn1:3.4",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:3.5",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:4.1",
      "pali": "Āpaṃ āpato sañjānāti;"
    },
    {
      "id": "mn1:4.2",
      "pali": "āpaṃ āpato saññatvā āpaṃ maññati, āpasmiṃ maññati, āpato maññati, āpaṃ meti maññati, āpaṃ abhinandati."
    },
    {
      "id": "mn1:4.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:4.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:5.1",
      "pali": "Tejaṃ tejato sañjānāti;"
    },
    {
      "id": "mn1:5.2",
      "pali": "tejaṃ tejato saññatvā tejaṃ maññati, tejasmiṃ maññati, tejato maññati, tejaṃ meti maññati, tejaṃ abhinandati."
    },
    {
      "id": "mn1:5.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:5.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:6.1",
      "pali": "Vāyaṃ vāyato sañjānāti;"
    },
    {
      "id": "mn1:6.2",
      "pali": "vāyaṃ vāyato saññatvā vāyaṃ maññati, vāyasmiṃ maññati, vāyato maññati, vāyaṃ meti maññati, vāyaṃ abhinandati."
    },
    {
      "id": "mn1:6.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:6.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:7.1",
      "pali": "Bhūte bhūtato sañjānāti;"
    },
    {
      "id": "mn1:7.2",
      "pali": "bhūte bhūtato saññatvā bhūte maññati, bhūtesu maññati, bhūtato maññati, bhūte meti maññati, bhūte abhinandati."
    },
    {
      "id": "mn1:7.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:7.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:8.1",
      "pali": "Deve devato sañjānāti;"
    },
    {
      "id": "mn1:8.2",
      "pali": "deve devato saññatvā deve maññati, devesu maññati, devato maññati, deve meti maññati, deve abhinandati."
    },
    {
      "id": "mn1:8.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:8.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:9.1",
      "pali": "Pajāpatiṃ pajāpatito sañjānāti;"
    },
    {
      "id": "mn1:9.2",
      "pali": "pajāpatiṃ pajāpatito saññatvā pajāpatiṃ maññati, pajāpatismiṃ maññati, pajāpatito maññati, pajāpatiṃ meti maññati, pajāpatiṃ abhinandati."
    },
    {
      "id": "mn1:9.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:9.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:10.1",
      "pali": "Brahmaṃ brahmato sañjānāti;"
    },
    {
      "id": "mn1:10.2",
      "pali": "brahmaṃ brahmato saññatvā brahmaṃ maññati, brahmasmiṃ maññati, brahmato maññati, brahmaṃ meti maññati, brahmaṃ abhinandati."
    },
    {
      "id": "mn1:10.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:10.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:11.1",
      "pali": "Ābhassare ābhassarato sañjānāti;"
    },
    {
      "id": "mn1:11.2",
      "pali": "ābhassare ābhassarato saññatvā ābhassare maññati, ābhassaresu maññati, ābhassarato maññati, ābhassare meti maññati, ābhassare abhinandati."
    },
    {
      "id": "mn1:11.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:11.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:12.1",
      "pali": "Subhakiṇhe subhakiṇhato sañjānāti;"
    },
    {
      "id": "mn1:12.2",
      "pali": "subhakiṇhe subhakiṇhato saññatvā subhakiṇhe maññati, subhakiṇhesu maññati, subhakiṇhato maññati, subhakiṇhe meti maññati, subhakiṇhe abhinandati."
    },
    {
      "id": "mn1:12.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:12.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:13.1",
      "pali": "Vehapphale vehapphalato sañjānāti;"
    },
    {
      "id": "mn1:13.2",
      "pali": "vehapphale vehapphalato saññatvā vehapphale maññati, vehapphalesu maññati, vehapphalato maññati, vehapphale meti maññati, vehapphale abhinandati."
    },
    {
      "id": "mn1:13.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:13.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:14.1",
      "pali": "Abhibhuṃ abhibhuto sañjānāti;"
    },
    {
      "id": "mn1:14.2",
      "pali": "abhibhuṃ abhibhuto saññatvā abhibhuṃ maññati, abhibhusmiṃ maññati, abhibhuto maññati, abhibhuṃ meti maññati, abhibhuṃ abhinandati."
    },
    {
      "id": "mn1:14.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:14.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:15.1",
      "pali": "Ākāsānañcāyatanaṃ ākāsānañcāyatanato sañjānāti;"
    },
    {
      "id": "mn1:15.2",
      "pali": "ākāsānañcāyatanaṃ ākāsānañcāyatanato saññatvā ākāsānañcāyatanaṃ maññati, ākāsānañcāyatanasmiṃ maññati, ākāsānañcāyatanato maññati, ākāsānañcāyatanaṃ meti maññati, ākāsānañcāyatanaṃ abhinandati."
    },
    {
      "id": "mn1:15.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:15.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:16.1",
      "pali": "Viññāṇañcāyatanaṃ viññāṇañcāyatanato sañjānāti;"
    },
    {
      "id": "mn1:16.2",
      "pali": "viññāṇañcāyatanaṃ viññāṇañcāyatanato saññatvā viññāṇañcāyatanaṃ maññati, viññāṇañcāyatanasmiṃ maññati, viññāṇañcāyatanato maññati, viññāṇañcāyatanaṃ meti maññati, viññāṇañcāyatanaṃ abhinandati."
    },
    {
      "id": "mn1:16.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:16.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:17.1",
      "pali": "Ākiñcaññāyatanaṃ ākiñcaññāyatanato sañjānāti;"
    },
    {
      "id": "mn1:17.2",
      "pali": "ākiñcaññāyatanaṃ ākiñcaññāyatanato saññatvā ākiñcaññāyatanaṃ maññati, ākiñcaññāyatanasmiṃ maññati, ākiñcaññāyatanato maññati, ākiñcaññāyatanaṃ meti maññati, ākiñcaññāyatanaṃ abhinandati."
    },
    {
      "id": "mn1:17.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:17.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:18.1",
      "pali": "Nevasaññānāsaññāyatanaṃ nevasaññānāsaññāyatanato sañjānāti;"
    },
    {
      "id": "mn1:18.2",
      "pali": "nevasaññānāsaññāyatanaṃ nevasaññānāsaññāyatanato saññatvā nevasaññānāsaññāyatanaṃ maññati, nevasaññānāsaññāyatanasmiṃ maññati, nevasaññānāsaññāyatanato maññati, nevasaññānāsaññāyatanaṃ meti maññati, nevasaññānāsaññāyatanaṃ abhinandati."
    },
    {
      "id": "mn1:18.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:18.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:19.1",
      "pali": "Diṭṭhaṃ diṭṭhato sañjānāti;"
    },
    {
      "id": "mn1:19.2",
      "pali": "diṭṭhaṃ diṭṭhato saññatvā diṭṭhaṃ maññati, diṭṭhasmiṃ maññati, diṭṭhato maññati, diṭṭhaṃ meti maññati, diṭṭhaṃ abhinandati."
    },
    {
      "id": "mn1:19.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:19.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:20.1",
      "pali": "Sutaṃ sutato sañjānāti;"
    },
    {
      "id": "mn1:20.2",
      "pali": "sutaṃ sutato saññatvā sutaṃ maññati, sutasmiṃ maññati, sutato maññati, sutaṃ meti maññati, sutaṃ abhinandati."
    },
    {
      "id": "mn1:20.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:20.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:21.1",
      "pali": "Mutaṃ mutato sañjānāti;"
    },
    {
      "id": "mn1:21.2",
      "pali": "mutaṃ mutato saññatvā mutaṃ maññati, mutasmiṃ maññati, mutato maññati, mutaṃ meti maññati, mutaṃ abhinandati."
    },
    {
      "id": "mn1:21.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:21.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:22.1",
      "pali": "Viññātaṃ viññātato sañjānāti;"
    },
    {
      "id": "mn1:22.2",
      "pali": "viññātaṃ viññātato saññatvā viññātaṃ maññati, viññātasmiṃ maññati, viññātato maññati, viññātaṃ meti maññati, viññātaṃ abhinandati."
    },
    {
      "id": "mn1:22.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:22.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:23.1",
      "pali": "Ekattaṃ ekattato sañjānāti;"
    },
    {
      "id": "mn1:23.2",
      "pali": "ekattaṃ ekattato saññatvā ekattaṃ maññati, ekattasmiṃ maññati, ekattato maññati, ekattaṃ meti maññati, ekattaṃ abhinandati."
    },
    {
      "id": "mn1:23.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:23.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:24.1",
      "pali": "Nānattaṃ nānattato sañjānāti;"
    },
    {
      "id": "mn1:24.2",
      "pali": "nānattaṃ nānattato saññatvā nānattaṃ maññati, nānattasmiṃ maññati, nānattato maññati, nānattaṃ meti maññati, nānattaṃ abhinandati."
    },
    {
      "id": "mn1:24.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:24.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:25.1",
      "pali": "Sabbaṃ sabbato sañjānāti;"
    },
    {
      "id": "mn1:25.2",
      "pali": "sabbaṃ sabbato saññatvā sabbaṃ maññati, sabbasmiṃ maññati, sabbato maññati, sabbaṃ meti maññati, sabbaṃ abhinandati."
    },
    {
      "id": "mn1:25.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:25.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:26.1",
      "pali": "Nibbānaṃ nibbānato sañjānāti;"
    },
    {
      "id": "mn1:26.2",
      "pali": "nibbānaṃ nibbānato saññatvā nibbānaṃ maññati, nibbānasmiṃ maññati, nibbānato maññati, nibbānaṃ meti maññati, nibbānaṃ abhinandati."
    },
    {
      "id": "mn1:26.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:26.4",
      "pali": "‘Apariññātaṃ tassā’ti vadāmi."
    },
    {
      "id": "mn1:26.5",
      "pali": "Puthujjanavasena paṭhamanayabhūmiparicchedo niṭṭhito."
    },
    {
      "id": "mn1:27.1",
      "pali": "Yopi so, bhikkhave, bhikkhu sekkho appattamānaso anuttaraṃ yogakkhemaṃ patthayamāno viharati, sopi pathaviṃ pathavito abhijānāti;"
    },
    {
      "id": "mn1:27.2",
      "pali": "pathaviṃ pathavito abhiññāya pathaviṃ mā maññi, pathaviyā mā maññi, pathavito mā maññi, pathaviṃ meti mā maññi, pathaviṃ mābhinandi."
    },
    {
      "id": "mn1:27.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:27.4",
      "pali": "‘Pariññeyyaṃ tassā’ti vadāmi."
