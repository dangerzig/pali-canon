      "id": "mn1:187.1",
      "pali": "diṭṭhaṃ …"
    },
    {
      "id": "mn1:188.1",
      "pali": "sutaṃ …"
    },
    {
      "id": "mn1:189.1",
      "pali": "mutaṃ …"
    },
    {
      "id": "mn1:190.1",
      "pali": "viññātaṃ …"
    },
    {
      "id": "mn1:191.1",
      "pali": "ekattaṃ …"
    },
    {
      "id": "mn1:192.1",
      "pali": "nānattaṃ …"
    },
    {
      "id": "mn1:193.1",
      "pali": "sabbaṃ …"
    },
    {
      "id": "mn1:194.1",
      "pali": "nibbānaṃ nibbānato abhijānāti;"
    },
    {
      "id": "mn1:194.2",
      "pali": "nibbānaṃ nibbānato abhiññāya nibbānaṃ na maññati, nibbānasmiṃ na maññati, nibbānato na maññati, nibbānaṃ meti na maññati, nibbānaṃ nābhinandati."
    },
    {
      "id": "mn1:194.3",
      "pali": "Taṃ kissa hetu?"
    },
    {
      "id": "mn1:194.4",
      "pali": "‘Nandī dukkhassa mūlan’ti—"
    },
    {
      "id": "mn1:194.5",
      "pali": "iti viditvā ‘bhavā jāti bhūtassa jarāmaraṇan’ti."
    },
    {
      "id": "mn1:194.6",
      "pali": "Tasmātiha, bhikkhave, ‘tathāgato sabbaso taṇhānaṃ khayā virāgā nirodhā cāgā paṭinissaggā anuttaraṃ sammāsambodhiṃ abhisambuddho’ti vadāmī”ti."
    },
    {
      "id": "mn1:194.7",
      "pali": "Tathāgatavasena aṭṭhamanayabhūmiparicchedo niṭṭhito."
    },
    {
      "id": "mn1:194.8",
      "pali": "Idamavoca bhagavā."
    },
    {
      "id": "mn1:194.9",
      "pali": "Na te bhikkhū bhagavato bhāsitaṃ abhinandunti."
    },
    {
      "id": "mn1:194.10",
      "pali": "Mūlapariyāyasuttaṃ niṭṭhitaṃ paṭhamaṃ."
    }
  ]
}