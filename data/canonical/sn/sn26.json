    {
      "id": "sn26.1",
      "segments": [
        {
          "id": "sn26.1:0.1",
          "pali": "Saṃyutta Nikāya 26.1"
        },
        {
          "id": "sn26.1:0.2",
          "pali": "1. Uppādavagga"
        },
        {
          "id": "sn26.1:0.3",
          "pali": "Cakkhusutta"
        },
        {
          "id": "sn26.1:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn26.1:1.2",
          "pali": "“Yo kho, bhikkhave, cakkhussa uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo, rogānaṃ ṭhiti, jarāmaraṇassa pātubhāvo."
        },
        {
          "id": "sn26.1:1.3",
          "pali": "Yo sotassa uppādo ṭhiti …pe…"
        },
        {
          "id": "sn26.1:1.4",
          "pali": "yo ghānassa uppādo ṭhiti …"
        },
        {
          "id": "sn26.1:1.5",
          "pali": "yo jivhāya uppādo ṭhiti …"
        },
        {
          "id": "sn26.1:1.6",
          "pali": "yo kāyassa uppādo ṭhiti …"
        },
        {
          "id": "sn26.1:1.7",
          "pali": "yo manassa uppādo ṭhiti abhinibbatti pātubhāvo, dukkhasseso uppādo, rogānaṃ ṭhiti, jarāmaraṇassa pātubhāvo."
        },
        {
          "id": "sn26.1:1.8",
          "pali": "Yo ca, bhikkhave, cakkhussa nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho, rogānaṃ vūpasamo, jarāmaraṇassa atthaṅgamo."
        },
        {
          "id": "sn26.1:1.9",
          "pali": "Yo sotassa nirodho …pe…"
        },
        {
          "id": "sn26.1:1.10",
          "pali": "yo ghānassa nirodho …"
        },
        {
          "id": "sn26.1:1.11",
          "pali": "yo jivhāya nirodho …"
        },
        {
          "id": "sn26.1:1.12",
          "pali": "yo kāyassa nirodho …"
        },
        {
          "id": "sn26.1:1.13",
          "pali": "yo manassa nirodho vūpasamo atthaṅgamo, dukkhasseso nirodho, rogānaṃ vūpasamo, jarāmaraṇassa atthaṅgamo”ti."
        },
        {
          "id": "sn26.1:1.14",
