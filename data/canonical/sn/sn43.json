        },
        {
          "id": "sn43.12:9.1",
          "pali": "Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.12:9.2",
          "pali": "Idha, bhikkhave, bhikkhu saddhābalaṃ bhāveti vivekanissitaṃ …pe…"
