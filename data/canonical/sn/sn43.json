          "id": "sn43.32:1.2",
          "pali": "Taṃ suṇātha. Katamañca, bhikkhave, anītikaṃ …pe…."
        },
        {
          "id": "sn43.33:1.1",
          "pali": "Anītikadhammañca vo, bhikkhave, desessāmi anītikadhammagāmiñca maggaṃ."
        },
        {
          "id": "sn43.33:1.2",
          "pali": "Taṃ suṇātha. Katamañca, bhikkhave, anītikadhammaṃ …pe…."
        },
        {
          "id": "sn43.34:1.1",
          "pali": "Nibbānañca vo, bhikkhave, desessāmi nibbānagāmiñca maggaṃ."
        },
        {
          "id": "sn43.34:1.2",
          "pali": "Taṃ suṇātha. Katamañca, bhikkhave, nibbānaṃ …pe…."
        },
        {
          "id": "sn43.35:1.1",
          "pali": "Abyābajjhañca vo, bhikkhave, desessāmi abyābajjhagāmiñca maggaṃ."
        },
        {
          "id": "sn43.35:1.2",
          "pali": "Taṃ suṇātha. Katamañca, bhikkhave, abyābajjhaṃ …pe…."
        },
        {
          "id": "sn43.36:1.1",
          "pali": "Virāgañca vo, bhikkhave, desessāmi virāgagāmiñca maggaṃ."
        },
        {
          "id": "sn43.36:1.2",
          "pali": "Taṃ suṇātha."
        },
        {
          "id": "sn43.36:1.3",
          "pali": "Katamo ca, bhikkhave, virāgo …pe…?"
        },
        {
          "id": "sn43.37:1.1",
          "pali": "Suddhiñca vo, bhikkhave, desessāmi suddhigāmiñca maggaṃ."
        },
        {
          "id": "sn43.37:1.2",
          "pali": "Taṃ suṇātha. Katamā ca, bhikkhave, suddhi …pe…."
        },
        {
          "id": "sn43.38:1.1",
          "pali": "Muttiñca vo, bhikkhave, desessāmi muttigāmiñca maggaṃ."
        },
        {
          "id": "sn43.38:1.2",
          "pali": "Taṃ suṇātha. Katamā ca, bhikkhave, mutti …pe…."
        },
        {
          "id": "sn43.39:1.1",
          "pali": "Anālayañca vo, bhikkhave, desessāmi anālayagāmiñca maggaṃ."
        },
        {
          "id": "sn43.39:1.2",
          "pali": "Taṃ suṇātha. Katamo ca, bhikkhave, anālayo …pe…."
        },
        {
          "id": "sn43.40:1.1",
          "pali": "Dīpañca vo, bhikkhave, desessāmi dīpagāmiñca maggaṃ."
        },
        {
          "id": "sn43.40:1.2",
          "pali": "Taṃ suṇātha. Katamañca, bhikkhave, dīpaṃ …pe…."
        },
        {
          "id": "sn43.41:1.1",
          "pali": "Leṇañca vo, bhikkhave, desessāmi leṇagāmiñca maggaṃ."
        },
        {
          "id": "sn43.41:1.2",
          "pali": "Taṃ suṇātha. Katamañca, bhikkhave, leṇaṃ …pe…."
        },
        {
          "id": "sn43.42:1.1",
          "pali": "Tāṇañca vo, bhikkhave, desessāmi tāṇagāmiñca maggaṃ."
        },
        {
          "id": "sn43.42:1.2",
          "pali": "Taṃ suṇātha. Katamañca, bhikkhave, tāṇaṃ …pe…."
        },
        {
          "id": "sn43.43:1.1",
          "pali": "Saraṇañca vo, bhikkhave, desessāmi saraṇagāmiñca maggaṃ."
        },
        {
          "id": "sn43.43:1.2",
          "pali": "Taṃ suṇātha. Katamañca, bhikkhave, saraṇaṃ …pe…."
        },
        {
          "id": "sn43.43:1.3",
          "pali": "Bāttiṃsatimaṃ."
        }
      ]
    },
    {
      "id": "sn43.44",
      "segments": [
        {
          "id": "sn43.44:0.1",
          "pali": "Saṃyutta Nikāya 43.44"
        },
        {
          "id": "sn43.44:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn43.44:0.3",
          "pali": "Parāyanasutta"
        },
        {
          "id": "sn43.44:1.1",
          "pali": "“Parāyanañca vo, bhikkhave, desessāmi parāyanagāmiñca maggaṃ."
        },
        {
          "id": "sn43.44:1.2",
          "pali": "Taṃ suṇātha."
        },
        {
          "id": "sn43.44:1.3",
          "pali": "Katamañca, bhikkhave, parāyanaṃ?"
        },
        {
          "id": "sn43.44:1.4",
          "pali": "Yo, bhikkhave, rāgakkhayo dosakkhayo mohakkhayo—"
        },
        {
          "id": "sn43.44:1.5",
          "pali": "idaṃ vuccati, bhikkhave, parāyanaṃ."
        },
        {
          "id": "sn43.44:1.6",
          "pali": "Katamo ca, bhikkhave, parāyanagāmī maggo?"
        },
        {
          "id": "sn43.44:1.7",
          "pali": "Kāyagatāsati."
        },
        {
          "id": "sn43.44:1.8",
          "pali": "Ayaṃ vuccati, bhikkhave, parāyanagāmimaggo."
        },
        {
          "id": "sn43.44:1.9",
          "pali": "Iti kho, bhikkhave, desitaṃ vo mayā parāyanaṃ, desito parāyanagāmimaggo."
        },
        {
          "id": "sn43.44:1.10",
          "pali": "Yaṃ, bhikkhave, satthārā karaṇīyaṃ sāvakānaṃ hitesinā anukampakena anukampaṃ upādāya, kataṃ vo taṃ mayā."
        },
        {
          "id": "sn43.44:1.11",
          "pali": "Etāni, bhikkhave, rukkhamūlāni, etāni suññāgārāni. Jhāyatha, bhikkhave, mā pamādattha; mā pacchā vippaṭisārino ahuvattha. Ayaṃ vo amhākaṃ anusāsanī”ti."
        },
        {
          "id": "sn43.44:1.12",
          "pali": "(Yathā asaṅkhataṃ tathā vitthāretabbaṃ.)"
        },
        {
          "id": "sn43.44:1.13",
          "pali": "Tettiṃsatimaṃ."
        },
        {
          "id": "sn43.44:1.14",
          "pali": "Dutiyo vaggo."
        },
        {
          "id": "sn43.44:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn43.44:2.1",
          "pali": "Asaṅkhataṃ anataṃ anāsavaṃ,"
        },
        {
          "id": "sn43.44:2.2",
          "pali": "Saccañca pāraṃ nipuṇaṃ sududdasaṃ;"
        },
        {
          "id": "sn43.44:2.3",
          "pali": "Ajajjaraṃ dhuvaṃ apalokitaṃ,"
        },
        {
          "id": "sn43.44:2.4",
          "pali": "Anidassanaṃ nippapañca santaṃ."
        },
        {
          "id": "sn43.44:3.1",
          "pali": "Amataṃ paṇītañca sivañca khemaṃ,"
        },
        {
          "id": "sn43.44:3.2",
          "pali": "Taṇhākkhayo acchariyañca abbhutaṃ;"
        },
        {
          "id": "sn43.44:3.3",
          "pali": "Anītikaṃ anītikadhammaṃ,"
        },
        {
          "id": "sn43.44:3.4",
          "pali": "Nibbānametaṃ sugatena desitaṃ."
        },
        {
          "id": "sn43.44:4.1",
          "pali": "Abyābajjho virāgo ca,"
        },
        {
          "id": "sn43.44:4.2",
          "pali": "suddhi mutti anālayo;"
        },
        {
          "id": "sn43.44:4.3",
          "pali": "Dīpo leṇañca tāṇañca,"
        },
        {
          "id": "sn43.44:4.4",
          "pali": "saraṇañca parāyananti."
        },
        {
          "id": "sn43.44:4.5",
          "pali": "Asaṅkhatasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}