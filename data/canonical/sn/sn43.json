{
  "id": "sn43",
  "name_pali": "Asaṅkhatasaṃyutta",
  "name_eng": "The Unconditioned",
  "vagga": "Saḷāyatanavagga",
  "pts": "S iv 359–373",
  "suttas": [
    {
      "id": "sn43.1",
      "segments": [
        {
          "id": "sn43.1:0.1",
          "pali": "Saṃyutta Nikāya 43.1"
        },
        {
          "id": "sn43.1:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn43.1:0.3",
          "pali": "Kāyagatāsatisutta"
        },
        {
          "id": "sn43.1:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn43.1:1.2",
          "pali": "“Asaṅkhatañca vo, bhikkhave, desessāmi asaṅkhatagāmiñca maggaṃ."
        },
        {
          "id": "sn43.1:1.3",
          "pali": "Taṃ suṇātha."
        },
        {
          "id": "sn43.1:1.4",
          "pali": "Katamañca, bhikkhave, asaṅkhataṃ?"
        },
        {
          "id": "sn43.1:1.5",
          "pali": "Yo, bhikkhave, rāgakkhayo dosakkhayo mohakkhayo—"
        },
        {
          "id": "sn43.1:1.6",
          "pali": "idaṃ vuccati, bhikkhave, asaṅkhataṃ."
        },
        {
          "id": "sn43.1:1.7",
          "pali": "Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.1:1.8",
          "pali": "Kāyagatāsati."
        },
        {
          "id": "sn43.1:1.9",
          "pali": "Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo."
        },
        {
          "id": "sn43.1:2.1",
          "pali": "Iti kho, bhikkhave, desitaṃ vo mayā asaṅkhataṃ, desito asaṅkhatagāmimaggo."
        },
        {
          "id": "sn43.1:2.2",
          "pali": "Yaṃ, bhikkhave, satthārā karaṇīyaṃ sāvakānaṃ hitesinā anukampakena anukampaṃ upādāya, kataṃ vo taṃ mayā."
        },
        {
          "id": "sn43.1:2.3",
          "pali": "Etāni, bhikkhave, rukkhamūlāni, etāni suññāgārāni. Jhāyatha, bhikkhave, mā pamādattha; mā pacchā vippaṭisārino ahuvattha. Ayaṃ vo amhākaṃ anusāsanī”ti."
        },
        {
          "id": "sn43.1:2.4",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn43.2",
      "segments": [
        {
          "id": "sn43.2:0.1",
          "pali": "Saṃyutta Nikāya 43.2"
        },
        {
          "id": "sn43.2:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn43.2:0.3",
          "pali": "Samathavipassanāsutta"
        },
        {
          "id": "sn43.2:1.1",
          "pali": "“Asaṅkhatañca vo, bhikkhave, desessāmi asaṅkhatagāmiñca maggaṃ."
        },
        {
          "id": "sn43.2:1.2",
          "pali": "Taṃ suṇātha."
        },
        {
          "id": "sn43.2:1.3",
          "pali": "Katamañca, bhikkhave, asaṅkhataṃ?"
        },
        {
          "id": "sn43.2:1.4",
          "pali": "Yo, bhikkhave, rāgakkhayo dosakkhayo mohakkhayo—"
        },
        {
          "id": "sn43.2:1.5",
          "pali": "idaṃ vuccati, bhikkhave, asaṅkhataṃ."
        },
        {
          "id": "sn43.2:1.6",
          "pali": "Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.2:1.7",
          "pali": "Samatho ca vipassanā ca."
        },
        {
          "id": "sn43.2:1.8",
          "pali": "Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…."
        },
        {
          "id": "sn43.2:1.9",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn43.3",
      "segments": [
        {
          "id": "sn43.3:0.1",
          "pali": "Saṃyutta Nikāya 43.3"
        },
        {
          "id": "sn43.3:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn43.3:0.3",
          "pali": "Savitakkasavicārasutta"
        },
        {
          "id": "sn43.3:1.1",
          "pali": "“Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.3:1.2",
          "pali": "Savitakkasavicāro samādhi, avitakkavicāramatto samādhi, avitakkaavicāro samādhi—ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…."
        },
        {
          "id": "sn43.3:1.3",
          "pali": "Tatiyaṃ."
        }
      ]
    },
    {
      "id": "sn43.4",
      "segments": [
        {
          "id": "sn43.4:0.1",
          "pali": "Saṃyutta Nikāya 43.4"
        },
        {
          "id": "sn43.4:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn43.4:0.3",
          "pali": "Suññatasamādhisutta"
        },
        {
          "id": "sn43.4:1.1",
          "pali": "“Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.4:1.2",
          "pali": "Suññato samādhi, animitto samādhi, appaṇihito samādhi—ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…."
        },
        {
          "id": "sn43.4:1.3",
          "pali": "Catutthaṃ."
        }
      ]
    },
    {
      "id": "sn43.5",
      "segments": [
        {
          "id": "sn43.5:0.1",
          "pali": "Saṃyutta Nikāya 43.5"
        },
        {
          "id": "sn43.5:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn43.5:0.3",
          "pali": "Satipaṭṭhānasutta"
        },
        {
          "id": "sn43.5:1.1",
          "pali": "“Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.5:1.2",
          "pali": "Cattāro satipaṭṭhānā. Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…."
        },
        {
          "id": "sn43.5:1.3",
          "pali": "Pañcamaṃ."
        }
      ]
    },
    {
      "id": "sn43.6",
      "segments": [
        {
          "id": "sn43.6:0.1",
          "pali": "Saṃyutta Nikāya 43.6"
        },
        {
          "id": "sn43.6:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn43.6:0.3",
          "pali": "Sammappadhānasutta"
        },
        {
          "id": "sn43.6:1.1",
          "pali": "“Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.6:1.2",
          "pali": "Cattāro sammappadhānā. Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…."
        },
        {
          "id": "sn43.6:1.3",
          "pali": "Chaṭṭhaṃ."
        }
      ]
    },
    {
      "id": "sn43.7",
      "segments": [
        {
          "id": "sn43.7:0.1",
          "pali": "Saṃyutta Nikāya 43.7"
        },
        {
          "id": "sn43.7:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn43.7:0.3",
          "pali": "Iddhipādasutta"
        },
        {
          "id": "sn43.7:1.1",
          "pali": "“Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.7:1.2",
          "pali": "Cattāro iddhipādā. Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…."
        },
        {
          "id": "sn43.7:1.3",
          "pali": "Sattamaṃ."
        }
      ]
    },
    {
