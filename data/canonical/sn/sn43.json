        },
        {
          "id": "sn43.8:0.3",
          "pali": "Indriyasutta"
        },
        {
          "id": "sn43.8:1.1",
          "pali": "“Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.8:1.2",
          "pali": "Pañcindriyāni. Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…."
        },
        {
          "id": "sn43.8:1.3",
          "pali": "Aṭṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn43.9",
      "segments": [
        {
          "id": "sn43.9:0.1",
          "pali": "Saṃyutta Nikāya 43.9"
        },
        {
          "id": "sn43.9:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn43.9:0.3",
          "pali": "Balasutta"
        },
        {
          "id": "sn43.9:1.1",
          "pali": "“Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.9:1.2",
          "pali": "Pañca balāni. Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…."
        },
        {
          "id": "sn43.9:1.3",
          "pali": "Navamaṃ."
        }
      ]
    },
    {
      "id": "sn43.10",
      "segments": [
        {
          "id": "sn43.10:0.1",
          "pali": "Saṃyutta Nikāya 43.10"
        },
        {
          "id": "sn43.10:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn43.10:0.3",
          "pali": "Bojjhaṅgasutta"
        },
        {
          "id": "sn43.10:1.1",
          "pali": "“Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.10:1.2",
          "pali": "Satta bojjhaṅgā. Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…."
        },
        {
          "id": "sn43.10:1.3",
          "pali": "Dasamaṃ."
        }
      ]
    },
    {
      "id": "sn43.11",
      "segments": [
        {
          "id": "sn43.11:0.1",
          "pali": "Saṃyutta Nikāya 43.11"
        },
        {
          "id": "sn43.11:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn43.11:0.3",
          "pali": "Maggaṅgasutta"
        },
        {
          "id": "sn43.11:1.1",
          "pali": "“Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.11:1.2",
          "pali": "Ariyo aṭṭhaṅgiko maggo."
        },
        {
          "id": "sn43.11:1.3",
          "pali": "Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo."
        },
        {
          "id": "sn43.11:1.4",
          "pali": "Iti kho, bhikkhave, desitaṃ vo mayā asaṅkhataṃ, desito asaṅkhatagāmimaggo."
        },
        {
          "id": "sn43.11:1.5",
          "pali": "Yaṃ, bhikkhave, satthārā karaṇīyaṃ sāvakānaṃ hitesinā anukampakena anukampaṃ upādāya kataṃ vo taṃ mayā."
        },
        {
          "id": "sn43.11:1.6",
          "pali": "Etāni, bhikkhave, rukkhamūlāni, etāni suññāgārāni. Jhāyatha, bhikkhave, mā pamādattha; mā pacchā vippaṭisārino ahuvattha. Ayaṃ vo amhākaṃ anusāsanī”ti."
        },
        {
          "id": "sn43.11:1.7",
          "pali": "Ekādasamaṃ."
        },
        {
          "id": "sn43.11:1.8",
          "pali": "Asaṅkhatasaṃyuttassa paṭhamo vaggo."
        },
        {
          "id": "sn43.11:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn43.11:2.1",
          "pali": "Kāyo samatho savitakko,"
        },
        {
          "id": "sn43.11:2.2",
          "pali": "suññato satipaṭṭhānā;"
        },
        {
          "id": "sn43.11:2.3",
          "pali": "Sammappadhānā iddhipādā,"
        },
        {
          "id": "sn43.11:2.4",
          "pali": "indriyabalabojjhaṅgā;"
        },
        {
          "id": "sn43.11:2.5",
          "pali": "Maggena ekādasamaṃ,"
        },
        {
          "id": "sn43.11:2.6",
          "pali": "Tassuddānaṃ pavuccati."
        }
      ]
    },
    {
      "id": "sn43.12",
      "segments": [
        {
          "id": "sn43.12:0.1",
          "pali": "Saṃyutta Nikāya 43.12"
        },
        {
          "id": "sn43.12:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn43.12:0.3",
          "pali": "Asaṅkhatasutta"
        },
        {
          "id": "sn43.12:1.1",
          "pali": "“Asaṅkhatañca vo, bhikkhave, desessāmi asaṅkhatagāmiñca maggaṃ."
        },
        {
          "id": "sn43.12:1.2",
          "pali": "Taṃ suṇātha."
        },
        {
          "id": "sn43.12:1.3",
          "pali": "Katamañca, bhikkhave, asaṅkhataṃ?"
        },
        {
          "id": "sn43.12:1.4",
          "pali": "Yo, bhikkhave, rāgakkhayo dosakkhayo mohakkhayo—"
        },
        {
          "id": "sn43.12:1.5",
          "pali": "idaṃ vuccati, bhikkhave, asaṅkhataṃ."
        },
        {
          "id": "sn43.12:1.6",
          "pali": "Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.12:1.7",
          "pali": "Samatho."
        },
        {
          "id": "sn43.12:1.8",
          "pali": "Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo."
        },
        {
          "id": "sn43.12:1.9",
          "pali": "Iti kho, bhikkhave, desitaṃ vo mayā asaṅkhataṃ, desito asaṅkhatagāmimaggo."
        },
        {
          "id": "sn43.12:1.10",
          "pali": "Yaṃ, bhikkhave, satthārā karaṇīyaṃ sāvakānaṃ hitesinā anukampakena anukampaṃ upādāya, kataṃ vo taṃ mayā."
        },
        {
          "id": "sn43.12:1.11",
          "pali": "Etāni, bhikkhave, rukkhamūlāni, etāni suññāgārāni. Jhāyatha, bhikkhave, mā pamādattha; mā pacchā vippaṭisārino ahuvattha. Ayaṃ vo amhākaṃ anusāsanīti."
        },
        {
          "id": "sn43.12:2.1",
          "pali": "Asaṅkhatañca vo, bhikkhave, desessāmi asaṅkhatagāmiñca maggaṃ."
        },
        {
          "id": "sn43.12:2.2",
          "pali": "Taṃ suṇātha."
        },
        {
          "id": "sn43.12:2.3",
          "pali": "Katamañca, bhikkhave, asaṅkhataṃ?"
        },
        {
          "id": "sn43.12:2.4",
          "pali": "Yo, bhikkhave, rāgakkhayo dosakkhayo mohakkhayo—"
        },
        {
          "id": "sn43.12:2.5",
          "pali": "idaṃ vuccati, bhikkhave, asaṅkhataṃ."
        },
        {
          "id": "sn43.12:2.6",
          "pali": "Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.12:2.7",
          "pali": "Vipassanā."
        },
        {
          "id": "sn43.12:2.8",
          "pali": "Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo."
        },
        {
          "id": "sn43.12:2.9",
          "pali": "Iti kho, bhikkhave, desitaṃ vo mayā asaṅkhataṃ …pe…"
        },
        {
          "id": "sn43.12:2.10",
          "pali": "ayaṃ vo amhākaṃ anusāsanīti."
        },
        {
          "id": "sn43.12:3.1",
          "pali": "Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.12:3.2",
          "pali": "Savitakko savicāro samādhi."
        },
        {
          "id": "sn43.12:3.3",
          "pali": "Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…"
        },
        {
          "id": "sn43.12:3.4",
          "pali": "katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.12:3.5",
          "pali": "Avitakko vicāramatto samādhi."
        },
        {
          "id": "sn43.12:3.6",
          "pali": "Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…"
        },
        {
          "id": "sn43.12:3.7",
          "pali": "katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.12:3.8",
          "pali": "Avitakko avicāro samādhi. Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…."
        },
        {
          "id": "sn43.12:4.1",
          "pali": "Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.12:4.2",
          "pali": "Suññato samādhi."
        },
        {
          "id": "sn43.12:4.3",
          "pali": "Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…"
        },
        {
          "id": "sn43.12:4.4",
          "pali": "katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.12:4.5",
          "pali": "Animitto samādhi."
        },
        {
          "id": "sn43.12:4.6",
          "pali": "Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…"
        },
        {
          "id": "sn43.12:4.7",
          "pali": "katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.12:4.8",
          "pali": "Appaṇihito samādhi. Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…."
        },
        {
          "id": "sn43.12:5.1",
          "pali": "Katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.12:5.2",
          "pali": "Idha, bhikkhave, bhikkhu kāye kāyānupassī viharati ātāpī sampajāno satimā vineyya loke abhijjhādomanassaṃ."
        },
        {
          "id": "sn43.12:5.3",
          "pali": "Ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…"
        },
        {
          "id": "sn43.12:5.4",
          "pali": "katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.12:5.5",
          "pali": "Idha, bhikkhave, bhikkhu vedanāsu vedanānupassī viharati …pe…"
        },
        {
          "id": "sn43.12:5.6",
          "pali": "ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…"
        },
        {
          "id": "sn43.12:5.7",
          "pali": "katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.12:5.8",
          "pali": "Idha, bhikkhave, bhikkhu citte cittānupassī viharati …pe…"
        },
        {
          "id": "sn43.12:5.9",
          "pali": "ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…"
        },
        {
          "id": "sn43.12:5.10",
          "pali": "katamo ca, bhikkhave, asaṅkhatagāmimaggo?"
        },
        {
          "id": "sn43.12:5.11",
          "pali": "Idha, bhikkhave, bhikkhu dhammesu dhammānupassī viharati …pe… ayaṃ vuccati, bhikkhave, asaṅkhatagāmimaggo …pe…."
        },
        {
          "id": "sn43.12:6.1",
