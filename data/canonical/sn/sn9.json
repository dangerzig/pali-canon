{
  "id": "sn9",
  "name_pali": "Vanasaṃyutta",
  "name_eng": "The Forest",
  "vagga": "Sagāthāvagga",
  "pts": "S i 197–205",
  "suttas": [
    {
      "id": "sn9.1",
      "segments": [
        {
          "id": "sn9.1:0.1",
          "pali": "Saṃyutta Nikāya 9.1"
        },
        {
          "id": "sn9.1:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.1:0.3",
          "pali": "Vivekasutta"
        },
        {
          "id": "sn9.1:1.1",
          "pali": "Evaṃ me sutaṃ—"
        },
        {
          "id": "sn9.1:1.2",
          "pali": "ekaṃ samayaṃ aññataro bhikkhu kosalesu viharati aññatarasmiṃ vanasaṇḍe."
        },
        {
          "id": "sn9.1:1.3",
          "pali": "Tena kho pana samayena so bhikkhu divāvihāragato pāpake akusale vitakke vitakketi gehanissite."
        },
        {
          "id": "sn9.1:1.4",
          "pali": "Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā tassa bhikkhuno anukampikā atthakāmā taṃ bhikkhuṃ saṃvejetukāmā yena so bhikkhu tenupasaṅkami; upasaṅkamitvā taṃ bhikkhuṃ gāthāhi ajjhabhāsi:"
        },
        {
          "id": "sn9.1:2.1",
          "pali": "“Vivekakāmosi vanaṃ paviṭṭho,"
        },
        {
          "id": "sn9.1:2.2",
          "pali": "Atha te mano niccharatī bahiddhā;"
        },
        {
          "id": "sn9.1:2.3",
          "pali": "Jano janasmiṃ vinayassu chandaṃ,"
        },
        {
          "id": "sn9.1:2.4",
          "pali": "Tato sukhī hohisi vītarāgo."
        },
        {
          "id": "sn9.1:3.1",
          "pali": "Aratiṃ pajahāsi sato,"
        },
        {
          "id": "sn9.1:3.2",
          "pali": "Bhavāsi sataṃ taṃ sārayāmase;"
        },
        {
          "id": "sn9.1:3.3",
          "pali": "Pātālarajo hi duttaro,"
        },
        {
          "id": "sn9.1:3.4",
          "pali": "Mā taṃ kāmarajo avāhari."
        },
        {
          "id": "sn9.1:4.1",
          "pali": "Sakuṇo yathā paṃsukunthito,"
        },
        {
          "id": "sn9.1:4.2",
          "pali": "Vidhunaṃ pātayati sitaṃ rajaṃ;"
        },
        {
          "id": "sn9.1:4.3",
          "pali": "Evaṃ bhikkhu padhānavā satimā,"
        },
        {
          "id": "sn9.1:4.4",
          "pali": "Vidhunaṃ pātayati sitaṃ rajan”ti."
        },
        {
          "id": "sn9.1:5.1",
          "pali": "Atha kho so bhikkhu tāya devatāya saṃvejito saṃvegamāpādīti."
        }
      ]
    },
    {
      "id": "sn9.2",
      "segments": [
        {
          "id": "sn9.2:0.1",
          "pali": "Saṃyutta Nikāya 9.2"
        },
        {
          "id": "sn9.2:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.2:0.3",
          "pali": "Upaṭṭhānasutta"
        },
        {
          "id": "sn9.2:1.1",
          "pali": "Ekaṃ samayaṃ aññataro bhikkhu kosalesu viharati aññatarasmiṃ vanasaṇḍe."
        },
        {
          "id": "sn9.2:1.2",
          "pali": "Tena kho pana samayena so bhikkhu divāvihāragato supati."
        },
        {
          "id": "sn9.2:1.3",
          "pali": "Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā tassa bhikkhuno anukampikā atthakāmā taṃ bhikkhuṃ saṃvejetukāmā yena so bhikkhu tenupasaṅkami; upasaṅkamitvā taṃ bhikkhuṃ gāthāhi ajjhabhāsi:"
        },
        {
          "id": "sn9.2:2.1",
          "pali": "“Uṭṭhehi bhikkhu kiṃ sesi,"
        },
        {
          "id": "sn9.2:2.2",
          "pali": "ko attho supitena te;"
        },
        {
          "id": "sn9.2:2.3",
          "pali": "Āturassa hi kā niddā,"
        },
        {
          "id": "sn9.2:2.4",
          "pali": "sallaviddhassa ruppato."
        },
        {
          "id": "sn9.2:3.1",
          "pali": "Yāya saddhāya pabbajito,"
        },
        {
          "id": "sn9.2:3.2",
          "pali": "agārasmānagāriyaṃ;"
        },
        {
          "id": "sn9.2:3.3",
          "pali": "Tameva saddhaṃ brūhehi,"
        },
        {
          "id": "sn9.2:3.4",
          "pali": "mā niddāya vasaṃ gamī”ti."
        },
        {
          "id": "sn9.2:4.1",
          "pali": "“Aniccā addhuvā kāmā,"
        },
        {
          "id": "sn9.2:4.2",
          "pali": "yesu mandova mucchito;"
        },
        {
          "id": "sn9.2:4.3",
          "pali": "Baddhesu muttaṃ asitaṃ,"
        },
        {
          "id": "sn9.2:4.4",
          "pali": "kasmā pabbajitaṃ tape."
        },
        {
          "id": "sn9.2:5.1",
          "pali": "Chandarāgassa vinayā,"
        },
        {
          "id": "sn9.2:5.2",
          "pali": "avijjāsamatikkamā;"
        },
        {
          "id": "sn9.2:5.3",
          "pali": "Taṃ ñāṇaṃ paramodānaṃ,"
        },
        {
          "id": "sn9.2:5.4",
          "pali": "kasmā pabbajitaṃ tape."
        },
        {
          "id": "sn9.2:6.1",
          "pali": "Chetvā avijjaṃ vijjāya,"
        },
        {
          "id": "sn9.2:6.2",
          "pali": "āsavānaṃ parikkhayā;"
        },
        {
          "id": "sn9.2:6.3",
          "pali": "Asokaṃ anupāyāsaṃ,"
        },
        {
          "id": "sn9.2:6.4",
          "pali": "kasmā pabbajitaṃ tape."
        },
        {
          "id": "sn9.2:7.1",
          "pali": "Āraddhavīriyaṃ pahitattaṃ,"
        },
        {
          "id": "sn9.2:7.2",
          "pali": "Niccaṃ daḷhaparakkamaṃ;"
        },
        {
          "id": "sn9.2:7.3",
          "pali": "Nibbānaṃ abhikaṅkhantaṃ,"
        },
        {
          "id": "sn9.2:7.4",
          "pali": "Kasmā pabbajitaṃ tape”ti."
        }
      ]
    },
    {
      "id": "sn9.3",
      "segments": [
        {
          "id": "sn9.3:0.1",
          "pali": "Saṃyutta Nikāya 9.3"
        },
        {
          "id": "sn9.3:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.3:0.3",
          "pali": "Kassapagottasutta"
        },
        {
          "id": "sn9.3:1.1",
          "pali": "Ekaṃ samayaṃ āyasmā kassapagotto kosalesu viharati aññatarasmiṃ vanasaṇḍe."
        },
        {
          "id": "sn9.3:1.2",
          "pali": "Tena kho pana samayena āyasmā kassapagotto divāvihāragato aññataraṃ chetaṃ ovadati."
        },
        {
          "id": "sn9.3:1.3",
          "pali": "Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā āyasmantaṃ kassapagottaṃ saṃvejetukāmā yenāyasmā kassapagotto tenupasaṅkami; upasaṅkamitvā āyasmantaṃ kassapagottaṃ gāthāhi ajjhabhāsi:"
        },
        {
          "id": "sn9.3:2.1",
          "pali": "“Giriduggacaraṃ chetaṃ,"
        },
        {
          "id": "sn9.3:2.2",
          "pali": "appapaññaṃ acetasaṃ;"
        },
        {
          "id": "sn9.3:2.3",
          "pali": "Akāle ovadaṃ bhikkhu,"
        },
        {
          "id": "sn9.3:2.4",
          "pali": "mandova paṭibhāti maṃ."
        },
        {
          "id": "sn9.3:3.1",
          "pali": "Suṇāti na vijānāti,"
        },
        {
          "id": "sn9.3:3.2",
          "pali": "Āloketi na passati;"
        },
        {
          "id": "sn9.3:3.3",
          "pali": "Dhammasmiṃ bhaññamānasmiṃ,"
        },
        {
          "id": "sn9.3:3.4",
          "pali": "Atthaṃ bālo na bujjhati."
        },
        {
          "id": "sn9.3:4.1",
          "pali": "Sacepi dasa pajjote,"
        },
        {
          "id": "sn9.3:4.2",
          "pali": "dhārayissasi kassapa;"
        },
        {
          "id": "sn9.3:4.3",
          "pali": "Neva dakkhati rūpāni,"
        },
        {
          "id": "sn9.3:4.4",
          "pali": "cakkhu hissa na vijjatī”ti."
        },
        {
          "id": "sn9.3:5.1",
          "pali": "Atha kho āyasmā kassapagotto tāya devatāya saṃvejito saṃvegamāpādīti."
        }
      ]
    },
    {
      "id": "sn9.4",
      "segments": [
        {
          "id": "sn9.4:0.1",
          "pali": "Saṃyutta Nikāya 9.4"
        },
        {
          "id": "sn9.4:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.4:0.3",
          "pali": "Sambahulasutta"
        },
        {
          "id": "sn9.4:1.1",
          "pali": "Ekaṃ samayaṃ sambahulā bhikkhū kosalesu viharanti aññatarasmiṃ vanasaṇḍe."
        },
        {
          "id": "sn9.4:1.2",
          "pali": "Atha kho te bhikkhū vassaṃvuṭṭhā temāsaccayena cārikaṃ pakkamiṃsu."
        },
        {
          "id": "sn9.4:1.3",
          "pali": "Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā te bhikkhū apassantī paridevamānā tāyaṃ velāyaṃ imaṃ gāthaṃ abhāsi:"
        },
        {
          "id": "sn9.4:2.1",
          "pali": "“Arati viya mejja khāyati,"
        },
        {
          "id": "sn9.4:2.2",
          "pali": "Bahuke disvāna vivitte āsane;"
        },
        {
          "id": "sn9.4:2.3",
          "pali": "Te cittakathā bahussutā,"
        },
        {
          "id": "sn9.4:2.4",
          "pali": "Kome gotamasāvakā gatā”ti."
        },
        {
          "id": "sn9.4:3.1",
          "pali": "Evaṃ vutte, aññatarā devatā taṃ devataṃ gāthāya paccabhāsi:"
        },
        {
          "id": "sn9.4:4.1",
          "pali": "“Māgadhaṃ gatā kosalaṃ gatā,"
        },
        {
          "id": "sn9.4:4.2",
          "pali": "Ekacciyā pana vajjibhūmiyā;"
        },
        {
          "id": "sn9.4:4.3",
          "pali": "Magā viya asaṅgacārino,"
        },
        {
          "id": "sn9.4:4.4",
          "pali": "Aniketā viharanti bhikkhavo”ti."
        }
      ]
    },
    {
      "id": "sn9.5",
      "segments": [
        {
          "id": "sn9.5:0.1",
          "pali": "Saṃyutta Nikāya 9.5"
        },
        {
          "id": "sn9.5:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.5:0.3",
          "pali": "Ānandasutta"
        },
        {
          "id": "sn9.5:1.1",
          "pali": "Ekaṃ samayaṃ āyasmā ānando kosalesu viharati aññatarasmiṃ vanasaṇḍe."
        },
        {
          "id": "sn9.5:1.2",
          "pali": "Tena kho pana samayena āyasmā ānando ativelaṃ gihisaññattibahulo viharati."
        },
        {
          "id": "sn9.5:1.3",
          "pali": "Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā āyasmato ānandassa anukampikā atthakāmā āyasmantaṃ ānandaṃ saṃvejetukāmā yenāyasmā ānando tenupasaṅkami; upasaṅkamitvā āyasmantaṃ ānandaṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn9.5:2.1",
          "pali": "“Rukkhamūlagahanaṃ pasakkiya,"
        },
        {
          "id": "sn9.5:2.2",
          "pali": "Nibbānaṃ hadayasmiṃ opiya;"
        },
        {
          "id": "sn9.5:2.3",
          "pali": "Jhāya gotama mā pamādo,"
        },
        {
          "id": "sn9.5:2.4",
          "pali": "Kiṃ te biḷibiḷikā karissatī”ti."
        },
        {
          "id": "sn9.5:3.1",
          "pali": "Atha kho āyasmā ānando tāya devatāya saṃvejito saṃvegamāpādīti."
        }
      ]
    },
    {
      "id": "sn9.6",
      "segments": [
        {
          "id": "sn9.6:0.1",
          "pali": "Saṃyutta Nikāya 9.6"
        },
        {
          "id": "sn9.6:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.6:0.3",
          "pali": "Anuruddhasutta"
        },
        {
          "id": "sn9.6:1.1",
          "pali": "Ekaṃ samayaṃ āyasmā anuruddho kosalesu viharati aññatarasmiṃ vanasaṇḍe."
        },
        {
          "id": "sn9.6:1.2",
          "pali": "Atha kho aññatarā tāvatiṃsakāyikā devatā jālinī nāma āyasmato anuruddhassa purāṇadutiyikā yenāyasmā anuruddho tenupasaṅkami; upasaṅkamitvā āyasmantaṃ anuruddhaṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn9.6:2.1",
          "pali": "“Tattha cittaṃ paṇidhehi,"
        },
        {
          "id": "sn9.6:2.2",
          "pali": "yattha te vusitaṃ pure;"
        },
        {
          "id": "sn9.6:2.3",
          "pali": "Tāvatiṃsesu devesu,"
        },
        {
          "id": "sn9.6:2.4",
          "pali": "sabbakāmasamiddhisu;"
        },
        {
          "id": "sn9.6:2.5",
          "pali": "Purakkhato parivuto,"
        },
        {
          "id": "sn9.6:2.6",
          "pali": "devakaññāhi sobhasī”ti."
        },
        {
          "id": "sn9.6:3.1",
          "pali": "“Duggatā devakaññāyo,"
        },
        {
          "id": "sn9.6:3.2",
          "pali": "sakkāyasmiṃ patiṭṭhitā;"
        },
        {
          "id": "sn9.6:3.3",
          "pali": "Te cāpi duggatā sattā,"
        },
        {
          "id": "sn9.6:3.4",
          "pali": "devakaññāhi patthitā”ti."
        },
        {
          "id": "sn9.6:4.1",
          "pali": "“Na te sukhaṃ pajānanti,"
        },
        {
          "id": "sn9.6:4.2",
          "pali": "ye na passanti nandanaṃ;"
        },
        {
          "id": "sn9.6:4.3",
          "pali": "Āvāsaṃ naradevānaṃ,"
        },
        {
          "id": "sn9.6:4.4",
          "pali": "tidasānaṃ yasassinan”ti."
        },
        {
          "id": "sn9.6:5.1",
          "pali": "“Na tvaṃ bāle vijānāsi,"
        },
        {
          "id": "sn9.6:5.2",
          "pali": "yathā arahataṃ vaco;"
        },
        {
          "id": "sn9.6:5.3",
          "pali": "Aniccā sabbasaṅkhārā,"
        },
        {
          "id": "sn9.6:5.4",
          "pali": "uppādavayadhammino;"
        },
        {
          "id": "sn9.6:5.5",
          "pali": "Uppajjitvā nirujjhanti,"
        },
        {
          "id": "sn9.6:5.6",
          "pali": "tesaṃ vūpasamo sukho."
        },
        {
          "id": "sn9.6:6.1",
          "pali": "Natthi dāni punāvāso,"
        },
        {
          "id": "sn9.6:6.2",
          "pali": "devakāyasmi jālini;"
        },
        {
          "id": "sn9.6:6.3",
          "pali": "Vikkhīṇo jātisaṃsāro,"
        },
        {
          "id": "sn9.6:6.4",
          "pali": "natthi dāni punabbhavo”ti."
        }
      ]
    },
    {
      "id": "sn9.7",
      "segments": [
        {
          "id": "sn9.7:0.1",
          "pali": "Saṃyutta Nikāya 9.7"
        },
        {
          "id": "sn9.7:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.7:0.3",
          "pali": "Nāgadattasutta"
        },
        {
          "id": "sn9.7:1.1",
          "pali": "Ekaṃ samayaṃ āyasmā nāgadatto kosalesu viharati aññatarasmiṃ vanasaṇḍe."
        },
        {
          "id": "sn9.7:1.2",
          "pali": "Tena kho pana samayena āyasmā nāgadatto atikālena gāmaṃ pavisati, atidivā paṭikkamati."
        },
        {
          "id": "sn9.7:1.3",
          "pali": "Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā āyasmato nāgadattassa anukampikā atthakāmā āyasmantaṃ nāgadattaṃ saṃvejetukāmā yenāyasmā nāgadatto tenupasaṅkami; upasaṅkamitvā āyasmantaṃ nāgadattaṃ gāthāhi ajjhabhāsi:"
        },
        {
          "id": "sn9.7:2.1",
          "pali": "“Kāle pavisa nāgadatta,"
        },
        {
          "id": "sn9.7:2.2",
          "pali": "Divā ca āgantvā ativelacārī;"
        },
        {
          "id": "sn9.7:2.3",
          "pali": "Saṃsaṭṭho gahaṭṭhehi,"
        },
        {
          "id": "sn9.7:2.4",
          "pali": "Samānasukhadukkho."
        },
        {
          "id": "sn9.7:3.1",
          "pali": "Bhāyāmi nāgadattaṃ suppagabbhaṃ,"
        },
        {
          "id": "sn9.7:3.2",
          "pali": "Kulesu vinibaddhaṃ;"
        },
        {
          "id": "sn9.7:3.3",
          "pali": "Mā heva maccurañño balavato,"
        },
        {
          "id": "sn9.7:3.4",
          "pali": "Antakassa vasaṃ upesī”ti."
        },
        {
          "id": "sn9.7:4.1",
          "pali": "Atha kho āyasmā nāgadatto tāya devatāya saṃvejito saṃvegamāpādīti."
        }
      ]
    },
    {
      "id": "sn9.8",
      "segments": [
        {
          "id": "sn9.8:0.1",
          "pali": "Saṃyutta Nikāya 9.8"
        },
        {
          "id": "sn9.8:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.8:0.3",
          "pali": "Kulagharaṇīsutta"
        },
        {
          "id": "sn9.8:1.1",
          "pali": "Ekaṃ samayaṃ aññataro bhikkhu kosalesu viharati aññatarasmiṃ vanasaṇḍe."
        },
        {
          "id": "sn9.8:1.2",
          "pali": "Tena kho pana samayena so bhikkhu aññatarasmiṃ kule ativelaṃ ajjhogāḷhappatto viharati."
        },
        {
          "id": "sn9.8:1.3",
          "pali": "Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā tassa bhikkhuno anukampikā atthakāmā taṃ bhikkhuṃ saṃvejetukāmā yā tasmiṃ kule kulagharaṇī, tassā vaṇṇaṃ abhinimminitvā yena so bhikkhu tenupasaṅkami; upasaṅkamitvā taṃ bhikkhuṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn9.8:2.1",
          "pali": "“Nadītīresu saṇṭhāne,"
        },
        {
          "id": "sn9.8:2.2",
          "pali": "sabhāsu rathiyāsu ca;"
        },
        {
          "id": "sn9.8:2.3",
          "pali": "Janā saṅgamma mantenti,"
        },
        {
          "id": "sn9.8:2.4",
          "pali": "mañca tañca kimantaran”ti."
        },
        {
          "id": "sn9.8:3.1",
          "pali": "“Bahūhi saddā paccūhā,"
        },
        {
          "id": "sn9.8:3.2",
          "pali": "khamitabbā tapassinā;"
        },
        {
          "id": "sn9.8:3.3",
          "pali": "Na tena maṅku hotabbaṃ,"
        },
        {
          "id": "sn9.8:3.4",
          "pali": "na hi tena kilissati."
        },
        {
          "id": "sn9.8:4.1",
          "pali": "Yo ca saddaparittāsī,"
        },
        {
          "id": "sn9.8:4.2",
          "pali": "vane vātamigo yathā;"
        },
        {
          "id": "sn9.8:4.3",
          "pali": "Lahucittoti taṃ āhu,"
        },
        {
          "id": "sn9.8:4.4",
          "pali": "nāssa sampajjate vatan”ti."
        }
      ]
    },
    {
      "id": "sn9.9",
      "segments": [
        {
          "id": "sn9.9:0.1",
          "pali": "Saṃyutta Nikāya 9.9"
        },
        {
          "id": "sn9.9:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.9:0.3",
          "pali": "Vajjiputtasutta"
        },
        {
          "id": "sn9.9:1.1",
          "pali": "Ekaṃ samayaṃ aññataro vajjiputtako bhikkhu vesāliyaṃ viharati aññatarasmiṃ vanasaṇḍe."
        },
        {
          "id": "sn9.9:1.2",
          "pali": "Tena kho pana samayena vesāliyaṃ vajjiputtako sabbaratticāro hoti."
        },
        {
          "id": "sn9.9:1.3",
          "pali": "Atha kho so bhikkhu vesāliyā tūriyatāḷitavāditanigghosasaddaṃ sutvā paridevamāno tāyaṃ velāyaṃ imaṃ gāthaṃ abhāsi:"
        },
        {
          "id": "sn9.9:2.1",
          "pali": "“Ekakā mayaṃ araññe viharāma,"
        },
        {
          "id": "sn9.9:2.2",
          "pali": "Apaviddhaṃva vanasmiṃ dārukaṃ;"
        },
        {
          "id": "sn9.9:2.3",
          "pali": "Etādisikāya rattiyā,"
        },
        {
          "id": "sn9.9:2.4",
          "pali": "Ko su nāmamhehi pāpiyo”ti."
        },
        {
          "id": "sn9.9:3.1",
          "pali": "Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā tassa bhikkhuno anukampikā atthakāmā taṃ bhikkhuṃ saṃvejetukāmā yena so bhikkhu tenupasaṅkami; upasaṅkamitvā taṃ bhikkhuṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn9.9:4.1",
          "pali": "“Ekakova tvaṃ araññe viharasi,"
        },
        {
          "id": "sn9.9:4.2",
          "pali": "Apaviddhaṃva vanasmiṃ dārukaṃ;"
        },
        {
          "id": "sn9.9:4.3",
          "pali": "Tassa te bahukā pihayanti,"
        },
        {
          "id": "sn9.9:4.4",
          "pali": "Nerayikā viya saggagāminan”ti."
        },
        {
          "id": "sn9.9:5.1",
          "pali": "Atha kho so bhikkhu tāya devatāya saṃvejito saṃvegamāpādīti."
        }
      ]
    },
    {
      "id": "sn9.10",
      "segments": [
        {
          "id": "sn9.10:0.1",
          "pali": "Saṃyutta Nikāya 9.10"
        },
        {
          "id": "sn9.10:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.10:0.3",
          "pali": "Sajjhāyasutta"
        },
        {
          "id": "sn9.10:1.1",
          "pali": "Ekaṃ samayaṃ aññataro bhikkhu kosalesu viharati aññatarasmiṃ vanasaṇḍe."
        },
        {
          "id": "sn9.10:1.2",
          "pali": "Tena kho pana samayena so bhikkhu yaṃ sudaṃ pubbe ativelaṃ sajjhāyabahulo viharati so aparena samayena appossukko tuṇhībhūto saṅkasāyati."
        },
        {
          "id": "sn9.10:1.3",
          "pali": "Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā tassa bhikkhuno dhammaṃ asuṇantī yena so bhikkhu tenupasaṅkami; upasaṅkamitvā taṃ bhikkhuṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn9.10:2.1",
          "pali": "“Kasmā tuvaṃ dhammapadāni bhikkhu,"
        },
        {
          "id": "sn9.10:2.2",
          "pali": "Nādhīyasi bhikkhuhi saṃvasanto;"
        },
        {
          "id": "sn9.10:2.3",
          "pali": "Sutvāna dhammaṃ labhatippasādaṃ,"
        },
        {
          "id": "sn9.10:2.4",
          "pali": "Diṭṭheva dhamme labhatippasaṃsan”ti."
        },
        {
          "id": "sn9.10:3.1",
          "pali": "“Ahu pure dhammapadesu chando,"
        },
        {
          "id": "sn9.10:3.2",
          "pali": "Yāva virāgena samāgamimha;"
        },
        {
          "id": "sn9.10:3.3",
          "pali": "Yato virāgena samāgamimha,"
        },
        {
          "id": "sn9.10:3.4",
          "pali": "Yaṃ kiñci diṭṭhaṃva sutaṃ mutaṃ vā;"
        },
        {
          "id": "sn9.10:3.5",
          "pali": "Aññāya nikkhepanamāhu santo”ti."
        }
      ]
    },
    {
      "id": "sn9.11",
      "segments": [
        {
          "id": "sn9.11:0.1",
          "pali": "Saṃyutta Nikāya 9.11"
        },
        {
          "id": "sn9.11:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.11:0.3",
          "pali": "Akusalavitakkasutta"
        },
        {
          "id": "sn9.11:1.1",
          "pali": "Ekaṃ samayaṃ aññataro bhikkhu kosalesu viharati aññatarasmiṃ vanasaṇḍe."
        },
        {
          "id": "sn9.11:1.2",
          "pali": "Tena kho pana samayena so bhikkhu divāvihāragato pāpake akusale vitakke vitakketi, seyyathidaṃ—"
        },
        {
          "id": "sn9.11:1.3",
          "pali": "kāmavitakkaṃ, byāpādavitakkaṃ, vihiṃsāvitakkaṃ."
        },
        {
          "id": "sn9.11:1.4",
          "pali": "Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā tassa bhikkhuno anukampikā atthakāmā taṃ bhikkhuṃ saṃvejetukāmā yena so bhikkhu tenupasaṅkami; upasaṅkamitvā taṃ bhikkhuṃ gāthāhi ajjhabhāsi:"
        },
        {
          "id": "sn9.11:2.1",
          "pali": "“Ayoniso manasikārā,"
        },
        {
          "id": "sn9.11:2.2",
          "pali": "so vitakkehi khajjasi;"
        },
        {
          "id": "sn9.11:2.3",
          "pali": "Ayoniso paṭinissajja,"
        },
        {
          "id": "sn9.11:2.4",
          "pali": "yoniso anucintaya."
        },
        {
          "id": "sn9.11:3.1",
          "pali": "Satthāraṃ dhammamārabbha,"
        },
        {
          "id": "sn9.11:3.2",
          "pali": "saṅghaṃ sīlāni attano;"
        },
        {
          "id": "sn9.11:3.3",
          "pali": "Adhigacchasi pāmojjaṃ,"
        },
        {
          "id": "sn9.11:3.4",
          "pali": "pītisukhamasaṃsayaṃ;"
        },
        {
          "id": "sn9.11:3.5",
          "pali": "Tato pāmojjabahulo,"
        },
        {
          "id": "sn9.11:3.6",
          "pali": "dukkhassantaṃ karissasī”ti."
        },
        {
          "id": "sn9.11:4.1",
          "pali": "Atha kho so bhikkhu tāya devatāya saṃvejito saṃvegamāpādīti."
        }
      ]
    },
    {
      "id": "sn9.12",
      "segments": [
        {
          "id": "sn9.12:0.1",
          "pali": "Saṃyutta Nikāya 9.12"
        },
        {
          "id": "sn9.12:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.12:0.3",
          "pali": "Majjhanhikasutta"
        },
        {
          "id": "sn9.12:1.1",
          "pali": "Ekaṃ samayaṃ aññataro bhikkhu kosalesu viharati aññatarasmiṃ vanasaṇḍe."
        },
        {
          "id": "sn9.12:1.2",
          "pali": "Atha kho tasmiṃ vanasaṇḍe adhivatthā devatā yena so bhikkhu tenupasaṅkami; upasaṅkamitvā tassa bhikkhuno santike imaṃ gāthaṃ abhāsi:"
        },
        {
          "id": "sn9.12:2.1",
          "pali": "“Ṭhite majjhanhike kāle,"
        },
        {
          "id": "sn9.12:2.2",
          "pali": "sannisīvesu pakkhisu;"
        },
        {
          "id": "sn9.12:2.3",
          "pali": "Saṇateva brahāraññaṃ,"
        },
        {
          "id": "sn9.12:2.4",
          "pali": "taṃ bhayaṃ paṭibhāti maṃ."
        },
        {
          "id": "sn9.12:3.1",
          "pali": "Ṭhite majjhanhike kāle,"
        },
        {
          "id": "sn9.12:3.2",
          "pali": "sannisīvesu pakkhisu;"
        },
        {
          "id": "sn9.12:3.3",
          "pali": "Saṇateva brahāraññaṃ,"
        },
        {
          "id": "sn9.12:3.4",
          "pali": "sā rati paṭibhāti man”ti."
        }
      ]
    },
    {
      "id": "sn9.13",
      "segments": [
        {
          "id": "sn9.13:0.1",
          "pali": "Saṃyutta Nikāya 9.13"
        },
        {
          "id": "sn9.13:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.13:0.3",
          "pali": "Pākatindriyasutta"
        },
        {
          "id": "sn9.13:1.1",
          "pali": "Ekaṃ samayaṃ sambahulā bhikkhū kosalesu viharanti aññatarasmiṃ vanasaṇḍe uddhatā unnaḷā capalā mukharā vikiṇṇavācā muṭṭhassatino asampajānā asamāhitā vibbhantacittā pākatindriyā."
        },
        {
          "id": "sn9.13:1.2",
          "pali": "Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā tesaṃ bhikkhūnaṃ anukampikā atthakāmā te bhikkhū saṃvejetukāmā yena te bhikkhū tenupasaṅkami; upasaṅkamitvā te bhikkhū gāthāhi ajjhabhāsi:"
        },
        {
          "id": "sn9.13:2.1",
          "pali": "“Sukhajīvino pure āsuṃ,"
        },
        {
          "id": "sn9.13:2.2",
          "pali": "bhikkhū gotamasāvakā;"
        },
        {
          "id": "sn9.13:2.3",
          "pali": "Anicchā piṇḍamesanā,"
        },
        {
          "id": "sn9.13:2.4",
          "pali": "anicchā sayanāsanaṃ;"
        },
        {
          "id": "sn9.13:2.5",
          "pali": "Loke aniccataṃ ñatvā,"
        },
        {
          "id": "sn9.13:2.6",
          "pali": "dukkhassantaṃ akaṃsu te."
        },
        {
          "id": "sn9.13:3.1",
          "pali": "Dupposaṃ katvā attānaṃ,"
        },
        {
          "id": "sn9.13:3.2",
          "pali": "gāme gāmaṇikā viya;"
        },
        {
          "id": "sn9.13:3.3",
          "pali": "Bhutvā bhutvā nipajjanti,"
        },
        {
          "id": "sn9.13:3.4",
          "pali": "parāgāresu mucchitā."
        },
        {
          "id": "sn9.13:4.1",
          "pali": "Saṅghassa añjaliṃ katvā,"
        },
        {
          "id": "sn9.13:4.2",
          "pali": "idhekacce vadāmahaṃ;"
        },
        {
          "id": "sn9.13:4.3",
          "pali": "Apaviddhā anāthā te,"
        },
        {
          "id": "sn9.13:4.4",
          "pali": "yathā petā tatheva te."
        },
        {
          "id": "sn9.13:5.1",
          "pali": "Ye kho pamattā viharanti,"
        },
        {
          "id": "sn9.13:5.2",
          "pali": "te me sandhāya bhāsitaṃ;"
        },
        {
          "id": "sn9.13:5.3",
          "pali": "Ye appamattā viharanti,"
        },
        {
          "id": "sn9.13:5.4",
          "pali": "namo tesaṃ karomahan”ti."
        },
        {
          "id": "sn9.13:6.1",
          "pali": "Atha kho te bhikkhū tāya devatāya saṃvejitā saṃvegamāpādunti."
        }
      ]
    },
    {
      "id": "sn9.14",
      "segments": [
        {
          "id": "sn9.14:0.1",
          "pali": "Saṃyutta Nikāya 9.14"
        },
        {
          "id": "sn9.14:0.2",
          "pali": "1. Vanavagga"
        },
        {
          "id": "sn9.14:0.3",
          "pali": "Gandhatthenasutta"
        },
        {
          "id": "sn9.14:1.1",
          "pali": "Ekaṃ samayaṃ aññataro bhikkhu kosalesu viharati aññatarasmiṃ vanasaṇḍe."
        },
        {
          "id": "sn9.14:1.2",
          "pali": "Tena kho pana samayena so bhikkhu pacchābhattaṃ piṇḍapātapaṭikkanto pokkharaṇiṃ ogāhetvā padumaṃ upasiṅghati."
        },
        {
          "id": "sn9.14:1.3",
          "pali": "Atha kho yā tasmiṃ vanasaṇḍe adhivatthā devatā tassa bhikkhuno anukampikā atthakāmā taṃ bhikkhuṃ saṃvejetukāmā yena so bhikkhu tenupasaṅkami; upasaṅkamitvā taṃ bhikkhuṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn9.14:2.1",
          "pali": "“Yametaṃ vārijaṃ pupphaṃ,"
        },
        {
          "id": "sn9.14:2.2",
          "pali": "adinnaṃ upasiṅghasi;"
        },
        {
          "id": "sn9.14:2.3",
          "pali": "Ekaṅgametaṃ theyyānaṃ,"
        },
        {
          "id": "sn9.14:2.4",
          "pali": "gandhatthenosi mārisā”ti."
        },
        {
          "id": "sn9.14:3.1",
          "pali": "“Na harāmi na bhañjāmi,"
        },
        {
          "id": "sn9.14:3.2",
          "pali": "ārā siṅghāmi vārijaṃ;"
        },
        {
          "id": "sn9.14:3.3",
          "pali": "Atha kena nu vaṇṇena,"
        },
        {
          "id": "sn9.14:3.4",
          "pali": "gandhatthenoti vuccati."
        },
        {
          "id": "sn9.14:4.1",
          "pali": "Yvāyaṃ bhisāni khanati,"
        },
        {
          "id": "sn9.14:4.2",
          "pali": "puṇḍarīkāni bhañjati;"
        },
        {
          "id": "sn9.14:4.3",
          "pali": "Evaṃ ākiṇṇakammanto,"
        },
        {
          "id": "sn9.14:4.4",
          "pali": "kasmā eso na vuccatī”ti."
        },
        {
          "id": "sn9.14:5.1",
          "pali": "“Ākiṇṇaluddo puriso,"
        },
        {
          "id": "sn9.14:5.2",
          "pali": "dhāticelaṃva makkhito;"
        },
        {
          "id": "sn9.14:5.3",
          "pali": "Tasmiṃ me vacanaṃ natthi,"
        },
        {
          "id": "sn9.14:5.4",
          "pali": "tvañcārahāmi vattave."
        },
        {
          "id": "sn9.14:6.1",
          "pali": "Anaṅgaṇassa posassa,"
        },
        {
          "id": "sn9.14:6.2",
          "pali": "niccaṃ sucigavesino;"
        },
        {
          "id": "sn9.14:6.3",
          "pali": "Vālaggamattaṃ pāpassa,"
        },
        {
          "id": "sn9.14:6.4",
          "pali": "abbhāmattaṃva khāyatī”ti."
        },
        {
          "id": "sn9.14:7.1",
          "pali": "“Addhā maṃ yakkha jānāsi,"
        },
        {
          "id": "sn9.14:7.2",
          "pali": "atho me anukampasi;"
        },
        {
          "id": "sn9.14:7.3",
          "pali": "Punapi yakkha vajjāsi,"
        },
        {
          "id": "sn9.14:7.4",
          "pali": "yadā passasi edisan”ti."
        },
        {
          "id": "sn9.14:8.1",
          "pali": "“Neva taṃ upajīvāma,"
        },
        {
          "id": "sn9.14:8.2",
          "pali": "napi te bhatakāmhase;"
        },
        {
          "id": "sn9.14:8.3",
          "pali": "Tvameva bhikkhu jāneyya,"
        },
        {
          "id": "sn9.14:8.4",
          "pali": "yena gaccheyya suggatin”ti."
        },
        {
          "id": "sn9.14:9.1",
          "pali": "Atha kho so bhikkhu tāya devatāya saṃvejito saṃvegamāpādīti."
        },
        {
          "id": "sn9.14:9.2",
          "pali": "Vanavaggo paṭhamo."
        },
        {
          "id": "sn9.14:10.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn9.14:10.1",
          "pali": "Vivekaṃ upaṭṭhānañca,"
        },
        {
          "id": "sn9.14:10.2",
          "pali": "Kassapagottena sambahulā;"
        },
        {
          "id": "sn9.14:10.3",
          "pali": "Ānando anuruddho ca,"
        },
        {
          "id": "sn9.14:10.4",
          "pali": "Nāgadattañca kulagharaṇī."
        },
        {
          "id": "sn9.14:11.1",
          "pali": "Vajjiputto ca vesālī,"
        },
        {
          "id": "sn9.14:11.2",
          "pali": "Sajjhāyena ayoniso;"
        },
        {
          "id": "sn9.14:11.3",
          "pali": "Majjhanhikālamhi pākatindriya—"
        },
        {
          "id": "sn9.14:11.4",
          "pali": "Padumapupphena cuddasa bhaveti."
        },
        {
          "id": "sn9.14:11.5",
          "pali": "Vanasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}