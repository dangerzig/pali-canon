{
  "id": "sn53",
  "name_pali": "Jhānasaṃyutta",
  "name_eng": "Jhāna",
  "vagga": "Mahāvagga",
  "pts": "S v 307–312",
  "suttas": [
    {
      "id": "sn53.1-12",
      "segments": [
        {
          "id": "sn53.1-12:0.1",
          "pali": "Saṃyutta Nikāya 53.1–12"
        },
        {
          "id": "sn53.1-12:0.2",
          "pali": "1. Gaṅgāpeyyālavagga"
        },
        {
          "id": "sn53.1-12:0.3",
          "pali": "Jhānādisutta"
        },
        {
          "id": "sn53.1-12:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn53.1-12:1.2",
          "pali": "Tatra kho …pe…"
        },
        {
          "id": "sn53.1-12:1.3",
          "pali": "“cattārome, bhikkhave, jhānā."
        },
        {
          "id": "sn53.1-12:1.4",
          "pali": "Katame cattāro?"
        },
        {
          "id": "sn53.1-12:1.5",
          "pali": "Idha, bhikkhave, bhikkhu vivicceva kāmehi vivicca akusalehi dhammehi savitakkaṃ savicāraṃ vivekajaṃ pītisukhaṃ paṭhamaṃ jhānaṃ upasampajja viharati."
        },
        {
          "id": "sn53.1-12:1.6",
          "pali": "Vitakkavicārānaṃ vūpasamā ajjhattaṃ sampasādanaṃ cetaso ekodibhāvaṃ avitakkaṃ avicāraṃ samādhijaṃ pītisukhaṃ dutiyaṃ jhānaṃ upasampajja viharati."
        },
        {
          "id": "sn53.1-12:1.7",
          "pali": "Pītiyā ca virāgā upekkhako ca viharati sato ca sampajāno sukhañca kāyena paṭisaṃvedeti, yaṃ taṃ ariyā ācikkhanti: ‘upekkhako satimā sukhavihārī’ti tatiyaṃ jhānaṃ upasampajja viharati."
        },
        {
          "id": "sn53.1-12:1.8",
          "pali": "Sukhassa ca pahānā dukkhassa ca pahānā pubbeva somanassadomanassānaṃ atthaṅgamā adukkhamasukhaṃ upekkhāsatipārisuddhiṃ catutthaṃ jhānaṃ upasampajja viharati."
        },
        {
          "id": "sn53.1-12:1.9",
          "pali": "Ime kho, bhikkhave, cattāro jhānāti."
        },
        {
          "id": "sn53.1-12:2.1",
          "pali": "Seyyathāpi, bhikkhave, gaṅgā nadī pācīnaninnā pācīnapoṇā pācīnapabbhārā;"
        },
        {
          "id": "sn53.1-12:2.2",
          "pali": "evameva kho, bhikkhave, bhikkhu cattāro jhāne bhāvento cattāro jhāne bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro."
        },
        {
          "id": "sn53.1-12:2.3",
          "pali": "Kathañca, bhikkhave, bhikkhu cattāro jhāne bhāvento cattāro jhāne bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro?"
        },
        {
          "id": "sn53.1-12:2.4",
          "pali": "Idha, bhikkhave, bhikkhu vivicceva kāmehi vivicca akusalehi dhammehi savitakkaṃ savicāraṃ vivekajaṃ pītisukhaṃ paṭhamaṃ jhānaṃ upasampajja viharati."
        },
        {
          "id": "sn53.1-12:2.5",
          "pali": "Vitakkavicārānaṃ vūpasamā …pe… dutiyaṃ jhānaṃ …"
        },
        {
          "id": "sn53.1-12:2.6",
          "pali": "tatiyaṃ jhānaṃ …"
        },
        {
          "id": "sn53.1-12:2.7",
          "pali": "catutthaṃ jhānaṃ upasampajja viharati."
        },
        {
          "id": "sn53.1-12:2.8",
          "pali": "Evaṃ kho, bhikkhave, bhikkhu cattāro jhāne bhāvento cattāro jhāne bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro”ti."
        },
        {
          "id": "sn53.1-12:2.9",
          "pali": "Dvādasamaṃ."
        },
        {
          "id": "sn53.1-12:2.10",
          "pali": "Gaṅgāpeyyālavaggo paṭhamo."
        },
        {
          "id": "sn53.1-12:3.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn53.1-12:3.1",
          "pali": "Cha pācīnato ninnā,"
        },
        {
          "id": "sn53.1-12:3.2",
          "pali": "cha ninnā ca samuddato;"
        },
        {
          "id": "sn53.1-12:3.3",
          "pali": "Dvete cha dvādasa honti,"
        },
        {
          "id": "sn53.1-12:3.4",
          "pali": "vaggo tena pavuccatīti."
        }
      ]
    },
    {
      "id": "sn53.13-22",
      "segments": [
        {
          "id": "sn53.13-22:0.1",
          "pali": "Saṃyutta Nikāya 53.13"
        },
        {
          "id": "sn53.13-22:0.2",
          "pali": "2. Appamādavagga"
        },
        {
          "id": "sn53.13-22:0.3",
          "pali": "Appamādavagga"
        },
        {
          "id": "sn53.13-22:1.1",
          "pali": "(Appamādavaggo vitthāretabbo.)"
        },
        {
          "id": "sn53.13-22:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn53.13-22:2.1",
          "pali": "Tathāgataṃ padaṃ kūṭaṃ,"
        },
        {
          "id": "sn53.13-22:2.2",
          "pali": "mūlaṃ sāro ca vassikaṃ;"
        },
        {
          "id": "sn53.13-22:2.3",
          "pali": "Rājā candimasūriyā,"
        },
        {
          "id": "sn53.13-22:2.4",
          "pali": "vatthena dasamaṃ padanti."
        }
      ]
    },
    {
      "id": "sn53.23-34",
      "segments": [
        {
          "id": "sn53.23-34:0.1",
          "pali": "Saṃyutta Nikāya 53.23"
        },
        {
          "id": "sn53.23-34:0.2",
          "pali": "3. Balakaraṇīyavagga"
        },
        {
          "id": "sn53.23-34:0.3",
          "pali": "Balakaraṇīyavagga"
        },
        {
          "id": "sn53.23-34:1.1",
          "pali": "(Balakaraṇīyavaggo vitthāretabbo.)"
        },
        {
          "id": "sn53.23-34:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn53.23-34:2.1",
          "pali": "Balaṃ bījañca nāgo ca,"
        },
        {
          "id": "sn53.23-34:2.2",
          "pali": "rukkho kumbhena sūkiyā;"
        },
        {
          "id": "sn53.23-34:2.3",
          "pali": "Ākāsena ca dve meghā,"
        },
        {
          "id": "sn53.23-34:2.4",
          "pali": "nāvā āgantukā nadīti."
        }
      ]
    },
    {
      "id": "sn53.35-44",
      "segments": [
        {
          "id": "sn53.35-44:0.1",
          "pali": "Saṃyutta Nikāya 53.35"
        },
        {
          "id": "sn53.35-44:0.2",
          "pali": "4. Esanāvagga"
        },
        {
          "id": "sn53.35-44:0.3",
          "pali": "Esanāvagga"
        },
        {
          "id": "sn53.35-44:1.1",
          "pali": "(Esanāvaggo vitthāretabbo.)"
        },
        {
          "id": "sn53.35-44:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn53.35-44:2.1",
          "pali": "Esanā vidhā āsavo,"
        },
        {
          "id": "sn53.35-44:2.2",
          "pali": "Bhavo ca dukkhatā tisso;"
        },
        {
          "id": "sn53.35-44:2.3",
          "pali": "Khilaṃ malañca nīgho ca,"
        },
        {
          "id": "sn53.35-44:2.4",
          "pali": "Vedanā taṇhā tasinā cāti."
        }
      ]
    },
    {
      "id": "sn53.45-54",
      "segments": [
        {
          "id": "sn53.45-54:0.1",
          "pali": "Saṃyutta Nikāya 53.45–54"
        },
        {
          "id": "sn53.45-54:0.2",
          "pali": "5. Oghavagga"
        },
        {
          "id": "sn53.45-54:0.3",
          "pali": "Oghādisutta"
        },
        {
          "id": "sn53.45-54:1.1",
          "pali": "“Pañcimāni, bhikkhave, uddhambhāgiyāni saṃyojanāni."
        },
        {
          "id": "sn53.45-54:1.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn53.45-54:1.3",
          "pali": "Rūparāgo, arūparāgo, māno, uddhaccaṃ, avijjā—"
        },
        {
          "id": "sn53.45-54:1.4",
          "pali": "imāni kho, bhikkhave, pañcuddhambhāgiyāni saṃyojanāni."
        },
        {
          "id": "sn53.45-54:1.5",
          "pali": "Imesaṃ kho, bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya pariññāya parikkhayāya pahānāya cattāro jhānā bhāvetabbā."
        },
        {
          "id": "sn53.45-54:1.6",
          "pali": "Katame cattāro?"
        },
        {
          "id": "sn53.45-54:1.7",
          "pali": "Idha, bhikkhave, bhikkhu vivicceva kāmehi vivicca akusalehi dhammehi savitakkaṃ savicāraṃ vivekajaṃ pītisukhaṃ paṭhamaṃ jhānaṃ upasampajja viharati."
        },
        {
          "id": "sn53.45-54:1.8",
          "pali": "Vitakkavicārānaṃ vūpasamā ajjhattaṃ sampasādanaṃ cetaso ekodibhāvaṃ avitakkaṃ avicāraṃ samādhijaṃ pītisukhaṃ dutiyaṃ jhānaṃ …pe…"
        },
        {
          "id": "sn53.45-54:1.9",
          "pali": "tatiyaṃ jhānaṃ …pe…"
        },
        {
          "id": "sn53.45-54:1.10",
          "pali": "catutthaṃ jhānaṃ upasampajja viharati."
        },
        {
          "id": "sn53.45-54:1.11",
          "pali": "Imesaṃ kho, bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya pariññāya parikkhayāya pahānāya ime cattāro jhānā bhāvetabbā”ti vitthāretabbaṃ."
        },
        {
          "id": "sn53.45-54:1.12",
          "pali": "(Yathā maggasaṃyuttaṃ tathā vitthāretabbaṃ.)"
        },
        {
          "id": "sn53.45-54:1.13",
          "pali": "Oghavaggo pañcamo."
        },
        {
          "id": "sn53.45-54:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn53.45-54:2.1",
          "pali": "Ogho yogo upādānaṃ,"
        },
        {
          "id": "sn53.45-54:2.2",
          "pali": "ganthā anusayena ca;"
        },
        {
          "id": "sn53.45-54:2.3",
          "pali": "Kāmaguṇā nīvaraṇā,"
        },
        {
          "id": "sn53.45-54:2.4",
          "pali": "khandhā oruddhambhāgiyāti."
        },
        {
          "id": "sn53.45-54:2.5",
          "pali": "Jhānasaṃyuttaṃ navamaṃ."
        }
      ]
    }
  ]
}