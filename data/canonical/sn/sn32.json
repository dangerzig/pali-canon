{
  "id": "sn32",
  "name_pali": "Valāhakasaṃyutta",
  "name_eng": "Cloud Devas",
  "vagga": "Khandhavagga",
  "pts": "S iii 254–257",
  "suttas": [
    {
      "id": "sn32.1",
      "segments": [
        {
          "id": "sn32.1:0.1",
          "pali": "Saṃyutta Nikāya 32.1"
        },
        {
          "id": "sn32.1:0.2",
          "pali": "1. Valāhakavagga"
        },
        {
          "id": "sn32.1:0.3",
          "pali": "Suddhikasutta"
        },
        {
          "id": "sn32.1:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn32.1:1.2",
          "pali": "“Valāhakakāyike vo, bhikkhave, deve desessāmi."
        },
        {
          "id": "sn32.1:1.3",
          "pali": "Taṃ suṇātha."
        },
        {
          "id": "sn32.1:1.4",
          "pali": "Katame ca, bhikkhave, valāhakakāyikā devā?"
        },
        {
          "id": "sn32.1:1.5",
          "pali": "Santi, bhikkhave, sītavalāhakā devā;"
        },
        {
          "id": "sn32.1:1.6",
          "pali": "santi uṇhavalāhakā devā;"
        },
        {
          "id": "sn32.1:1.7",
          "pali": "santi abbhavalāhakā devā;"
        },
        {
          "id": "sn32.1:1.8",
          "pali": "santi vātavalāhakā devā;"
        },
        {
          "id": "sn32.1:1.9",
          "pali": "santi vassavalāhakā devā—"
        },
        {
          "id": "sn32.1:1.10",
          "pali": "ime vuccanti, bhikkhave, ‘valāhakakāyikā devā’”ti."
        },
        {
          "id": "sn32.1:1.11",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn32.2",
      "segments": [
        {
          "id": "sn32.2:0.1",
          "pali": "Saṃyutta Nikāya 32.2"
        },
        {
          "id": "sn32.2:0.2",
          "pali": "1. Valāhakavagga"
        },
        {
          "id": "sn32.2:0.3",
          "pali": "Sucaritasutta"
        },
        {
          "id": "sn32.2:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn32.2:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn32.2:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā valāhakakāyikānaṃ devānaṃ sahabyataṃ upapajjatī”ti?"
        },
        {
          "id": "sn32.2:1.4",
          "pali": "“Idha, bhikkhu, ekacco kāyena sucaritaṃ carati, vācāya sucaritaṃ carati, manasā sucaritaṃ carati."
        },
        {
          "id": "sn32.2:1.5",
          "pali": "Tassa sutaṃ hoti:"
        },
        {
          "id": "sn32.2:1.6",
          "pali": "‘valāhakakāyikā devā dīghāyukā vaṇṇavanto sukhabahulā’ti."
        },
        {
          "id": "sn32.2:1.7",
          "pali": "Tassa evaṃ hoti:"
        },
        {
          "id": "sn32.2:1.8",
          "pali": "‘aho vatāhaṃ kāyassa bhedā paraṃ maraṇā valāhakakāyikānaṃ devānaṃ sahabyataṃ upapajjeyyan’ti."
        },
        {
          "id": "sn32.2:1.9",
          "pali": "So kāyassa bhedā paraṃ maraṇā valāhakakāyikānaṃ devānaṃ sahabyataṃ upapajjati."
        },
        {
          "id": "sn32.2:1.10",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā valāhakakāyikānaṃ devānaṃ sahabyataṃ upapajjatī”ti."
        },
        {
          "id": "sn32.2:1.11",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn32.3-12",
      "segments": [
        {
          "id": "sn32.3-12:0.1",
          "pali": "Saṃyutta Nikāya 32.3–12"
        },
        {
          "id": "sn32.3-12:0.2",
          "pali": "1. Valāhakavagga"
        },
        {
          "id": "sn32.3-12:0.3",
          "pali": "Sītavalāhakadānūpakārasuttadasaka"
        },
        {
          "id": "sn32.3-12:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn32.3-12:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn32.3-12:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā sītavalāhakānaṃ devānaṃ sahabyataṃ upapajjatī”ti?"
        },
        {
          "id": "sn32.3-12:1.4",
          "pali": "“Idha, bhikkhu, ekacco kāyena sucaritaṃ carati, vācāya sucaritaṃ carati, manasā sucaritaṃ carati."
        },
        {
          "id": "sn32.3-12:1.5",
          "pali": "Tassa sutaṃ hoti:"
        },
        {
          "id": "sn32.3-12:1.6",
          "pali": "‘sītavalāhakā devā dīghāyukā vaṇṇavanto sukhabahulā’ti."
        },
        {
          "id": "sn32.3-12:1.7",
          "pali": "Tassa evaṃ hoti:"
        },
        {
          "id": "sn32.3-12:1.8",
          "pali": "‘aho vatāhaṃ kāyassa bhedā paraṃ maraṇā sītavalāhakānaṃ devānaṃ sahabyataṃ upapajjeyyan’ti."
        },
        {
          "id": "sn32.3-12:1.9",
          "pali": "So annaṃ deti …pe…"
        },
        {
          "id": "sn32.3-12:1.10",
          "pali": "padīpeyyaṃ deti."
        },
        {
          "id": "sn32.3-12:1.11",
          "pali": "So kāyassa bhedā paraṃ maraṇā sītavalāhakānaṃ devānaṃ sahabyataṃ upapajjati."
        },
        {
          "id": "sn32.3-12:1.12",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā sītavalāhakānaṃ devānaṃ sahabyataṃ upapajjatī”ti."
        },
        {
          "id": "sn32.3-12:1.13",
          "pali": "Dvādasamaṃ."
        }
      ]
    },
    {
      "id": "sn32.13-52",
      "segments": [
        {
          "id": "sn32.13-52:0.1",
          "pali": "Saṃyutta Nikāya 32.13–52"
        },
        {
          "id": "sn32.13-52:0.2",
          "pali": "1. Valāhakavagga"
        },
        {
          "id": "sn32.13-52:0.3",
          "pali": "Uṇhavalāhakadānūpakārasutta"
        },
        {
          "id": "sn32.13-52:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn32.13-52:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn32.13-52:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā uṇhavalāhakānaṃ devānaṃ …pe…"
        },
        {
          "id": "sn32.13-52:1.4",
          "pali": "abbhavalāhakānaṃ devānaṃ …pe…"
        },
        {
          "id": "sn32.13-52:1.5",
          "pali": "vātavalāhakānaṃ devānaṃ …pe…"
        },
        {
          "id": "sn32.13-52:1.6",
          "pali": "vassavalāhakānaṃ devānaṃ sahabyataṃ upapajjatī”ti?"
        },
        {
          "id": "sn32.13-52:1.7",
          "pali": "“Idha, bhikkhu, ekacco kāyena sucaritaṃ carati, vācāya sucaritaṃ carati, manasā sucaritaṃ carati."
        },
        {
          "id": "sn32.13-52:1.8",
          "pali": "Tassa sutaṃ hoti:"
        },
        {
          "id": "sn32.13-52:1.9",
          "pali": "‘vassavalāhakā devā dīghāyukā vaṇṇavanto sukhabahulā’ti."
        },
        {
          "id": "sn32.13-52:1.10",
          "pali": "Tassa evaṃ hoti:"
        },
        {
          "id": "sn32.13-52:1.11",
          "pali": "‘aho vatāhaṃ kāyassa bhedā paraṃ maraṇā vassavalāhakānaṃ devānaṃ sahabyataṃ upapajjeyyan’ti."
        },
        {
          "id": "sn32.13-52:1.12",
          "pali": "So annaṃ deti …pe…"
        },
        {
          "id": "sn32.13-52:1.13",
          "pali": "padīpeyyaṃ deti."
        },
        {
          "id": "sn32.13-52:1.14",
          "pali": "So kāyassa bhedā paraṃ maraṇā vassavalāhakānaṃ devānaṃ sahabyataṃ upapajjati."
        },
        {
          "id": "sn32.13-52:1.15",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā vassavalāhakānaṃ devānaṃ sahabyataṃ upapajjatī”ti."
        },
        {
          "id": "sn32.13-52:1.16",
          "pali": "Dvepaññāsamaṃ."
        }
      ]
    },
    {
      "id": "sn32.53",
      "segments": [
        {
          "id": "sn32.53:0.1",
          "pali": "Saṃyutta Nikāya 32.53"
        },
        {
          "id": "sn32.53:0.2",
          "pali": "1. Valāhakavagga"
        },
        {
          "id": "sn32.53:0.3",
          "pali": "Sītavalāhakasutta"
        },
        {
          "id": "sn32.53:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn32.53:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn32.53:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yenekadā sītaṃ hotī”ti?"
        },
        {
          "id": "sn32.53:1.4",
          "pali": "“Santi, bhikkhu, sītavalāhakā nāma devā."
        },
        {
          "id": "sn32.53:1.5",
          "pali": "Tesaṃ yadā evaṃ hoti:"
        },
        {
          "id": "sn32.53:1.6",
          "pali": "‘yannūna mayaṃ sakāya ratiyā vaseyyāmā’ti, tesaṃ taṃ cetopaṇidhimanvāya sītaṃ hoti."
        },
        {
          "id": "sn32.53:1.7",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yenekadā sītaṃ hotī”ti."
        },
        {
          "id": "sn32.53:1.8",
          "pali": "Tepaññāsamaṃ."
        }
      ]
    },
    {
      "id": "sn32.54",
      "segments": [
        {
          "id": "sn32.54:0.1",
          "pali": "Saṃyutta Nikāya 32.54"
        },
        {
          "id": "sn32.54:0.2",
          "pali": "1. Valāhakavagga"
        },
        {
          "id": "sn32.54:0.3",
          "pali": "Uṇhavalāhakasutta"
        },
        {
          "id": "sn32.54:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn32.54:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn32.54:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yenekadā uṇhaṃ hotī”ti?"
        },
        {
          "id": "sn32.54:1.4",
          "pali": "“Santi, bhikkhu, uṇhavalāhakā nāma devā."
        },
        {
          "id": "sn32.54:1.5",
          "pali": "Tesaṃ yadā evaṃ hoti:"
        },
        {
          "id": "sn32.54:1.6",
          "pali": "‘yannūna mayaṃ sakāya ratiyā vaseyyāmā’ti, tesaṃ taṃ cetopaṇidhimanvāya uṇhaṃ hoti."
        },
        {
          "id": "sn32.54:1.7",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yenekadā uṇhaṃ hotī”ti."
        },
        {
          "id": "sn32.54:1.8",
          "pali": "Catupaññāsamaṃ."
        }
      ]
    },
    {
      "id": "sn32.55",
      "segments": [
        {
          "id": "sn32.55:0.1",
          "pali": "Saṃyutta Nikāya 32.55"
        },
        {
          "id": "sn32.55:0.2",
          "pali": "1. Valāhakavagga"
        },
        {
          "id": "sn32.55:0.3",
          "pali": "Abbhavalāhakasutta"
        },
        {
          "id": "sn32.55:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn32.55:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn32.55:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yenekadā abbhaṃ hotī”ti?"
        },
        {
          "id": "sn32.55:1.4",
          "pali": "“Santi, bhikkhu, abbhavalāhakā nāma devā."
        },
        {
          "id": "sn32.55:1.5",
          "pali": "Tesaṃ yadā evaṃ hoti:"
        },
        {
          "id": "sn32.55:1.6",
          "pali": "‘yannūna mayaṃ sakāya ratiyā vaseyyāmā’ti, tesaṃ taṃ cetopaṇidhimanvāya abbhaṃ hoti."
        },
        {
          "id": "sn32.55:1.7",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yenekadā abbhaṃ hotī”ti."
        },
        {
          "id": "sn32.55:1.8",
          "pali": "Pañcapaññāsamaṃ."
        }
      ]
    },
    {
      "id": "sn32.56",
      "segments": [
        {
          "id": "sn32.56:0.1",
          "pali": "Saṃyutta Nikāya 32.56"
        },
        {
          "id": "sn32.56:0.2",
          "pali": "1. Valāhakavagga"
        },
        {
          "id": "sn32.56:0.3",
          "pali": "Vātavalāhakasutta"
        },
        {
          "id": "sn32.56:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn32.56:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn32.56:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yenekadā vāto hotī”ti?"
        },
        {
          "id": "sn32.56:1.4",
          "pali": "“Santi, bhikkhu, vātavalāhakā nāma devā."
        },
        {
          "id": "sn32.56:1.5",
          "pali": "Tesaṃ yadā evaṃ hoti:"
        },
        {
          "id": "sn32.56:1.6",
          "pali": "‘yannūna mayaṃ sakāya ratiyā vaseyyāmā’ti, tesaṃ taṃ cetopaṇidhimanvāya vāto hoti."
        },
        {
          "id": "sn32.56:1.7",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yenekadā vāto hotī”ti."
        },
        {
          "id": "sn32.56:1.8",
          "pali": "Chappaññāsamaṃ."
        }
      ]
    },
    {
      "id": "sn32.57",
      "segments": [
        {
          "id": "sn32.57:0.1",
          "pali": "Saṃyutta Nikāya 32.57"
        },
        {
          "id": "sn32.57:0.2",
          "pali": "1. Valāhakavagga"
        },
        {
          "id": "sn32.57:0.3",
          "pali": "Vassavalāhakasutta"
        },
        {
          "id": "sn32.57:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn32.57:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn32.57:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yenekadā devo vassatī”ti?"
        },
        {
          "id": "sn32.57:1.4",
          "pali": "“Santi, bhikkhu, vassavalāhakā nāma devā."
        },
        {
          "id": "sn32.57:1.5",
          "pali": "Tesaṃ yadā evaṃ hoti:"
        },
        {
          "id": "sn32.57:1.6",
          "pali": "‘yannūna mayaṃ sakāya ratiyā vaseyyāmā’ti, tesaṃ taṃ cetopaṇidhimanvāya devo vassati."
        },
        {
          "id": "sn32.57:1.7",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yenekadā devo vassatī”ti."
        },
        {
          "id": "sn32.57:1.8",
          "pali": "Sattapaññāsamaṃ."
        },
        {
          "id": "sn32.57:1.9",
          "pali": "Sattapaññāsasuttantaṃ niṭṭhitaṃ."
        },
        {
          "id": "sn32.57:1.10",
          "pali": "Valāhakavaggo paṭhamo."
        },
        {
          "id": "sn32.57:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn32.57:2.1",
          "pali": "Suddhikaṃ sucaritañca,"
        },
        {
          "id": "sn32.57:2.2",
          "pali": "dānūpakārapaññāsaṃ;"
        },
        {
          "id": "sn32.57:2.3",
          "pali": "Sītaṃ uṇhañca abbhañca,"
        },
        {
          "id": "sn32.57:2.4",
          "pali": "vātavassavalāhakāti."
        },
        {
          "id": "sn32.57:2.5",
          "pali": "Valāhakasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}