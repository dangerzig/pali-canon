{
  "id": "sn49",
  "name_pali": "Sammappadhānasaṃyutta",
  "name_eng": "Right Striving",
  "vagga": "Mahāvagga",
  "pts": "S v 244–245",
  "suttas": [
    {
      "id": "sn49.1-12",
      "segments": [
        {
          "id": "sn49.1-12:0.1",
          "pali": "Saṃyutta Nikāya 49.1–12"
        },
        {
          "id": "sn49.1-12:0.2",
          "pali": "1. Gaṅgāpeyyālavagga"
        },
        {
          "id": "sn49.1-12:0.3",
          "pali": "Pācīnādisutta"
        },
        {
          "id": "sn49.1-12:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn49.1-12:1.2",
          "pali": "Tatra kho bhagavā etadavoca:"
        },
        {
          "id": "sn49.1-12:1.3",
          "pali": "“cattārome, bhikkhave, sammappadhānā."
        },
        {
          "id": "sn49.1-12:1.4",
          "pali": "Katame cattāro?"
        },
        {
          "id": "sn49.1-12:1.5",
          "pali": "Idha, bhikkhave, bhikkhu anuppannānaṃ pāpakānaṃ akusalānaṃ dhammānaṃ anuppādāya chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati."
        },
        {
          "id": "sn49.1-12:1.6",
          "pali": "Uppannānaṃ pāpakānaṃ akusalānaṃ dhammānaṃ pahānāya chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati."
        },
        {
          "id": "sn49.1-12:1.7",
          "pali": "Anuppannānaṃ kusalānaṃ dhammānaṃ uppādāya chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati."
        },
        {
          "id": "sn49.1-12:1.8",
          "pali": "Uppannānaṃ kusalānaṃ dhammānaṃ ṭhitiyā asammosāya bhiyyobhāvāya vepullāya bhāvanāya pāripūriyā chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati."
        },
        {
          "id": "sn49.1-12:1.9",
          "pali": "Ime kho, bhikkhave, cattāro sammappadhānāti."
        },
        {
          "id": "sn49.1-12:2.1",
          "pali": "Seyyathāpi, bhikkhave, gaṅgā nadī pācīnaninnā pācīnapoṇā pācīnapabbhārā;"
        },
        {
          "id": "sn49.1-12:2.2",
          "pali": "evameva kho, bhikkhave, bhikkhu cattāro sammappadhāne bhāvento cattāro sammappadhāne bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro."
        },
        {
          "id": "sn49.1-12:2.3",
          "pali": "Kathañca, bhikkhave, bhikkhu cattāro sammappadhāne bhāvento cattāro sammappadhāne bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro?"
        },
        {
          "id": "sn49.1-12:2.4",
          "pali": "Idha, bhikkhave, bhikkhu anuppannānaṃ pāpakānaṃ akusalānaṃ dhammānaṃ anuppādāya chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati."
        },
        {
          "id": "sn49.1-12:2.5",
          "pali": "Uppannānaṃ pāpakānaṃ akusalānaṃ dhammānaṃ pahānāya chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati."
        },
        {
          "id": "sn49.1-12:2.6",
          "pali": "Anuppannānaṃ kusalānaṃ dhammānaṃ uppādāya chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati."
        },
        {
          "id": "sn49.1-12:2.7",
          "pali": "Uppannānaṃ kusalānaṃ dhammānaṃ ṭhitiyā asammosāya bhiyyobhāvāya vepullāya bhāvanāya pāripūriyā chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati."
        },
        {
          "id": "sn49.1-12:2.8",
          "pali": "Evaṃ kho, bhikkhave, bhikkhu cattāro sammappadhāne bhāvento cattāro sammappadhāne bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro”ti."
        },
        {
          "id": "sn49.1-12:2.9",
          "pali": "Dvādasamaṃ."
        },
        {
          "id": "sn49.1-12:2.10",
          "pali": "Gaṅgāpeyyālavaggo paṭhamo."
        },
        {
          "id": "sn49.1-12:3.1",
          "pali": "(Sammappadhānasaṃyuttassa gaṅgāpeyyālī sammappadhānavasena vitthāretabbā.)"
        },
        {
          "id": "sn49.1-12:4.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn49.1-12:4.1",
          "pali": "Cha pācīnato ninnā,"
        },
        {
          "id": "sn49.1-12:4.2",
          "pali": "cha ninnā ca samuddato;"
        },
        {
          "id": "sn49.1-12:4.3",
          "pali": "Dvete cha dvādasa honti,"
        },
        {
          "id": "sn49.1-12:4.4",
          "pali": "vaggo tena pavuccatīti."
        }
      ]
    },
    {
      "id": "sn49.13-22",
      "segments": [
        {
          "id": "sn49.13-22:0.1",
          "pali": "Saṃyutta Nikāya 49.13"
        },
        {
          "id": "sn49.13-22:0.2",
          "pali": "2. Appamādavagga"
        },
        {
          "id": "sn49.13-22:0.3",
          "pali": "Appamādavagga"
        },
        {
          "id": "sn49.13-22:1.1",
          "pali": "(Appamādavaggo sammappadhānavasena vitthāretabbo.)"
        },
        {
          "id": "sn49.13-22:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn49.13-22:2.1",
          "pali": "Tathāgataṃ padaṃ kūṭaṃ,"
        },
        {
          "id": "sn49.13-22:2.2",
          "pali": "mūlaṃ sārena vassikaṃ;"
        },
        {
          "id": "sn49.13-22:2.3",
          "pali": "Rājā candimasūriyā,"
        },
        {
          "id": "sn49.13-22:2.4",
          "pali": "vatthena dasamaṃ padanti."
        }
      ]
    },
    {
      "id": "sn49.23-34",
      "segments": [
        {
          "id": "sn49.23-34:0.1",
          "pali": "Saṃyutta Nikāya 49.23–34"
        },
        {
          "id": "sn49.23-34:0.2",
          "pali": "3. Balakaraṇīyavagga"
        },
        {
          "id": "sn49.23-34:0.3",
          "pali": "Balakaraṇīyādisutta"
        },
        {
          "id": "sn49.23-34:1.1",
          "pali": "“Seyyathāpi, bhikkhave, ye keci balakaraṇīyā kammantā kayiranti, sabbe te pathaviṃ nissāya pathaviyaṃ patiṭṭhāya evamete balakaraṇīyā kammantā kayiranti;"
        },
        {
          "id": "sn49.23-34:1.2",
          "pali": "evameva kho, bhikkhave, bhikkhu sīlaṃ nissāya sīle patiṭṭhāya cattāro sammappadhāne bhāveti, cattāro sammappadhāne bahulīkaroti."
        },
        {
          "id": "sn49.23-34:1.3",
          "pali": "Kathañca, bhikkhave, bhikkhu sīlaṃ nissāya sīle patiṭṭhāya cattāro sammappadhāne bhāveti, cattāro sammappadhāne bahulīkaroti?"
        },
        {
          "id": "sn49.23-34:1.4",
          "pali": "Idha, bhikkhave, bhikkhu anuppannānaṃ pāpakānaṃ akusalānaṃ dhammānaṃ anuppādāya chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati …pe…"
        },
        {
          "id": "sn49.23-34:1.5",
          "pali": "uppannānaṃ kusalānaṃ dhammānaṃ ṭhitiyā asammosāya bhiyyobhāvāya vepullāya bhāvanāya pāripūriyā chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati."
        },
        {
          "id": "sn49.23-34:1.6",
          "pali": "Evaṃ kho, bhikkhave, bhikkhu sīlaṃ nissāya sīle patiṭṭhāya cattāro sammappadhāne bhāveti, cattāro sammappadhāne bahulīkarotī”ti."
        },
        {
          "id": "sn49.23-34:1.7",
          "pali": "(Evaṃ balakaraṇīyavaggo sammappadhānavasena vitthāretabbo.)"
        },
        {
          "id": "sn49.23-34:1.8",
          "pali": "Dvādasamaṃ."
        },
        {
          "id": "sn49.23-34:1.9",
          "pali": "Balakaraṇīyavaggo tatiyo."
        },
        {
          "id": "sn49.23-34:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn49.23-34:2.1",
          "pali": "Balaṃ bījañca nāgo ca,"
        },
        {
          "id": "sn49.23-34:2.2",
          "pali": "rukkho kumbhena sūkiyā;"
        },
        {
          "id": "sn49.23-34:2.3",
          "pali": "Ākāsena ca dve meghā,"
        },
        {
          "id": "sn49.23-34:2.4",
          "pali": "nāvā āgantukā nadīti."
        }
      ]
    },
    {
      "id": "sn49.35-44",
      "segments": [
        {
          "id": "sn49.35-44:0.1",
          "pali": "Saṃyutta Nikāya 49.35–44"
        },
        {
          "id": "sn49.35-44:0.2",
          "pali": "4. Esanāvagga"
        },
        {
          "id": "sn49.35-44:0.3",
          "pali": "Esanādisuttadasaka"
        },
        {
          "id": "sn49.35-44:1.1",
          "pali": "“Tisso imā, bhikkhave, esanā."
        },
        {
          "id": "sn49.35-44:1.2",
          "pali": "Katamā tisso?"
        },
        {
          "id": "sn49.35-44:1.3",
          "pali": "Kāmesanā, bhavesanā, brahmacariyesanā—"
        },
        {
          "id": "sn49.35-44:1.4",
          "pali": "imā kho, bhikkhave, tisso esanā."
        },
        {
          "id": "sn49.35-44:1.5",
          "pali": "Imāsaṃ kho, bhikkhave, tissannaṃ esanānaṃ abhiññāya pariññāya parikkhayāya pahānāya cattāro sammappadhānā bhāvetabbā."
        },
        {
          "id": "sn49.35-44:1.6",
          "pali": "Katame cattāro?"
        },
        {
          "id": "sn49.35-44:1.7",
          "pali": "Idha, bhikkhave, bhikkhu anuppannānaṃ …pe…"
        },
        {
          "id": "sn49.35-44:1.8",
          "pali": "uppannānaṃ kusalānaṃ dhammānaṃ ṭhitiyā asammosāya bhiyyobhāvāya vepullāya bhāvanāya pāripūriyā chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati."
        },
        {
          "id": "sn49.35-44:1.9",
          "pali": "Imāsaṃ kho, bhikkhave, tissannaṃ esanānaṃ abhiññāya pariññāya parikkhayāya pahānāya ime cattāro sammappadhānā bhāvetabbā”ti."
        },
        {
          "id": "sn49.35-44:1.10",
          "pali": "(Vitthāretabbaṃ.)"
        },
        {
          "id": "sn49.35-44:1.11",
          "pali": "Dasamaṃ."
        },
        {
          "id": "sn49.35-44:1.12",
          "pali": "Esanāvaggo catuttho."
        },
        {
          "id": "sn49.35-44:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn49.35-44:2.1",
          "pali": "Esanā vidhā āsavo,"
        },
        {
          "id": "sn49.35-44:2.2",
          "pali": "Bhavo ca dukkhatā tisso;"
        },
        {
          "id": "sn49.35-44:2.3",
          "pali": "Khilaṃ malañca nīgho ca,"
        },
        {
          "id": "sn49.35-44:2.4",
          "pali": "Vedanā taṇhā tasinā cāti."
        }
      ]
    },
    {
      "id": "sn49.45-54",
      "segments": [
        {
          "id": "sn49.45-54:0.1",
          "pali": "Saṃyutta Nikāya 49.45–54"
        },
        {
          "id": "sn49.45-54:0.2",
          "pali": "5. Oghavagga"
        },
        {
          "id": "sn49.45-54:0.3",
          "pali": "Oghādisutta"
        },
        {
          "id": "sn49.45-54:1.1",
          "pali": "“Pañcimāni, bhikkhave, uddhambhāgiyāni saṃyojanāni."
        },
        {
          "id": "sn49.45-54:1.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn49.45-54:1.3",
          "pali": "Rūparāgo, arūparāgo, māno, uddhaccaṃ, avijjā—"
        },
        {
          "id": "sn49.45-54:1.4",
          "pali": "imāni kho, bhikkhave, pañcuddhambhāgiyāni saṃyojanāni."
        },
        {
          "id": "sn49.45-54:1.5",
          "pali": "Imesaṃ kho, bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya pariññāya parikkhayāya pahānāya cattāro sammappadhānā bhāvetabbā."
        },
        {
          "id": "sn49.45-54:1.6",
          "pali": "Katame cattāro?"
        },
        {
          "id": "sn49.45-54:1.7",
          "pali": "Idha, bhikkhave, bhikkhu anuppannānaṃ …pe…"
        },
        {
          "id": "sn49.45-54:1.8",
          "pali": "uppannānaṃ kusalānaṃ dhammānaṃ ṭhitiyā asammosāya bhiyyobhāvāya vepullāya bhāvanāya pāripūriyā chandaṃ janeti vāyamati vīriyaṃ ārabhati cittaṃ paggaṇhāti padahati."
        },
        {
          "id": "sn49.45-54:1.9",
          "pali": "Imesaṃ kho, bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya pariññāya parikkhayāya pahānāya ime cattāro sammappadhānā bhāvetabbā”ti."
        },
        {
          "id": "sn49.45-54:1.10",
          "pali": "(Vitthāretabbā.)"
        },
        {
          "id": "sn49.45-54:1.11",
          "pali": "Dasamaṃ."
        },
        {
          "id": "sn49.45-54:1.12",
          "pali": "Oghavaggo pañcamo."
        },
        {
          "id": "sn49.45-54:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn49.45-54:2.1",
          "pali": "Ogho yogo upādānaṃ,"
        },
        {
          "id": "sn49.45-54:2.2",
          "pali": "ganthā anusayena ca;"
        },
        {
          "id": "sn49.45-54:2.3",
          "pali": "Kāmaguṇā nīvaraṇā,"
        },
        {
          "id": "sn49.45-54:2.4",
          "pali": "khandhā oruddhambhāgiyāti."
        },
        {
          "id": "sn49.45-54:2.5",
          "pali": "Sammappadhānasaṃyuttaṃ pañcamaṃ."
        }
      ]
    }
  ]
}