        },
        {
          "id": "sn18.2:1.9",
          "pali": "dhammā niccā vā aniccā vā”ti?"
        },
        {
          "id": "sn18.2:1.10",
          "pali": "“Aniccā, bhante” …"
        },
        {
          "id": "sn18.2:1.11",
          "pali": "“evaṃ passaṃ, rāhula, sutavā ariyasāvako rūpesupi nibbindati … saddesupi nibbindati … gandhesupi nibbindati … rasesupi nibbindati … phoṭṭhabbesupi nibbindati … dhammesupi nibbindati;"
        },
        {
          "id": "sn18.2:1.12",
          "pali": "nibbindaṃ virajjati …pe…"
        },
        {
          "id": "sn18.2:1.13",
          "pali": "pajānātī”ti."
        },
        {
          "id": "sn18.2:1.14",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
