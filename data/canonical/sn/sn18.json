{
  "id": "sn18",
  "name_pali": "Rāhulasaṃyutta",
  "name_eng": "Rāhula",
  "vagga": "Nidānavagga",
  "pts": "S ii 244–253",
  "suttas": [
    {
      "id": "sn18.1",
      "segments": [
        {
          "id": "sn18.1:0.1",
          "pali": "Saṃyutta Nikāya 18.1"
        },
        {
          "id": "sn18.1:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn18.1:0.3",
          "pali": "Cakkhusutta"
        },
        {
          "id": "sn18.1:1.1",
          "pali": "Evaṃ me sutaṃ—"
        },
        {
          "id": "sn18.1:1.2",
          "pali": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
        },
        {
          "id": "sn18.1:1.3",
          "pali": "Atha kho āyasmā rāhulo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho āyasmā rāhulo bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn18.1:1.4",
          "pali": "“sādhu me, bhante, bhagavā saṅkhittena dhammaṃ desetu, yamahaṃ bhagavato dhammaṃ sutvā eko vūpakaṭṭho appamatto ātāpī pahitatto vihareyyan”ti."
        },
        {
          "id": "sn18.1:2.1",
          "pali": "“Taṃ kiṃ maññasi, rāhula,"
        },
        {
          "id": "sn18.1:2.2",
          "pali": "cakkhuṃ niccaṃ vā aniccaṃ vā”ti?"
        },
        {
          "id": "sn18.1:2.3",
          "pali": "“Aniccaṃ, bhante”."
        },
        {
          "id": "sn18.1:2.4",
          "pali": "“Yaṃ panāniccaṃ dukkhaṃ vā taṃ sukhaṃ vā”ti?"
        },
        {
          "id": "sn18.1:2.5",
          "pali": "“Dukkhaṃ, bhante”."
        },
        {
          "id": "sn18.1:2.6",
          "pali": "“Yaṃ panāniccaṃ dukkhaṃ vipariṇāmadhammaṃ, kallaṃ nu taṃ samanupassituṃ:"
        },
        {
          "id": "sn18.1:2.7",
          "pali": "‘etaṃ mama, esohamasmi, eso me attā’”ti?"
        },
        {
          "id": "sn18.1:2.8",
          "pali": "“No hetaṃ, bhante”."
        },
        {
          "id": "sn18.1:3.1",
          "pali": "“Sotaṃ niccaṃ vā aniccaṃ vā”ti?"
        },
        {
          "id": "sn18.1:3.2",
          "pali": "“Aniccaṃ, bhante” …pe…."
        },
        {
          "id": "sn18.1:3.3",
          "pali": "“Ghānaṃ niccaṃ vā aniccaṃ vā”ti?"
        },
        {
          "id": "sn18.1:3.4",
          "pali": "“Aniccaṃ, bhante” …"
        },
        {
          "id": "sn18.1:3.5",
          "pali": "“Jivhā niccā vā aniccā vā”ti?"
        },
        {
          "id": "sn18.1:3.6",
          "pali": "“Aniccā, bhante” …"
        },
        {
          "id": "sn18.1:3.7",
          "pali": "“Kāyo nicco vā anicco vā”ti?"
        },
        {
          "id": "sn18.1:3.8",
          "pali": "“Anicco, bhante” …"
        },
        {
          "id": "sn18.1:3.9",
          "pali": "“Mano nicco vā anicco vā”ti?"
        },
        {
          "id": "sn18.1:3.10",
          "pali": "“Anicco, bhante”."
        },
        {
          "id": "sn18.1:3.11",
          "pali": "“Yaṃ panāniccaṃ dukkhaṃ vā taṃ sukhaṃ vā”ti?"
        },
        {
          "id": "sn18.1:3.12",
          "pali": "“Dukkhaṃ, bhante”."
        },
        {
          "id": "sn18.1:3.13",
          "pali": "“Yaṃ panāniccaṃ dukkhaṃ vipariṇāmadhammaṃ, kallaṃ nu taṃ samanupassituṃ:"
        },
        {
          "id": "sn18.1:3.14",
          "pali": "‘etaṃ mama, esohamasmi, eso me attā’”ti?"
        },
        {
          "id": "sn18.1:3.15",
          "pali": "“No hetaṃ, bhante”."
        },
        {
          "id": "sn18.1:4.1",
          "pali": "“Evaṃ passaṃ, rāhula, sutavā ariyasāvako cakkhusmimpi nibbindati …pe… sotasmimpi nibbindati … ghānasmimpi nibbindati … jivhāyapi nibbindati … kāyasmimpi nibbindati … manasmimpi nibbindati;"
        },
        {
          "id": "sn18.1:4.2",
          "pali": "nibbindaṃ virajjati; virāgā vimuccati; vimuttasmiṃ vimuttamiti ñāṇaṃ hoti."
        },
        {
          "id": "sn18.1:4.3",
          "pali": "‘Khīṇā jāti, vusitaṃ brahmacariyaṃ, kataṃ karaṇīyaṃ, nāparaṃ itthattāyā’ti pajānātī”ti."
        },
        {
          "id": "sn18.1:4.4",
          "pali": "(Etena peyyālena dasa suttantā kātabbā.)"
        },
        {
          "id": "sn18.1:4.5",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn18.2",
      "segments": [
        {
          "id": "sn18.2:0.1",
