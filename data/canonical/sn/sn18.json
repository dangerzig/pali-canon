        },
        {
          "id": "sn18.9:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn18.9:0.3",
          "pali": "Dhātusutta"
        },
        {
          "id": "sn18.9:1.1",
          "pali": "Sāvatthiyaṃ viharati."
        },
        {
          "id": "sn18.9:1.2",
          "pali": "“Taṃ kiṃ maññasi, rāhula,"
        },
        {
          "id": "sn18.9:1.3",
          "pali": "pathavīdhātu niccā vā aniccā vā”ti?"
        },
        {
          "id": "sn18.9:1.4",
          "pali": "“Aniccā, bhante” …"
        },
        {
          "id": "sn18.9:1.5",
          "pali": "“āpodhātu …pe…"
        },
        {
          "id": "sn18.9:1.6",
          "pali": "tejodhātu …"
        },
        {
          "id": "sn18.9:1.7",
          "pali": "vāyodhātu …"
        },
        {
          "id": "sn18.9:1.8",
          "pali": "ākāsadhātu …"
        },
        {
          "id": "sn18.9:1.9",
          "pali": "viññāṇadhātu niccā vā aniccā vā”ti?"
        },
        {
          "id": "sn18.9:1.10",
          "pali": "“Aniccā, bhante” …"
        },
        {
          "id": "sn18.9:1.11",
          "pali": "“evaṃ passaṃ, rāhula, sutavā ariyasāvako pathavīdhātuyāpi nibbindati …pe… āpodhātuyāpi nibbindati … tejodhātuyāpi nibbindati … vāyodhātuyāpi nibbindati … ākāsadhātuyāpi nibbindati … viññāṇadhātuyāpi nibbindati …pe…"
        },
        {
          "id": "sn18.9:1.12",
          "pali": "pajānātī”ti."
        },
        {
          "id": "sn18.9:1.13",
          "pali": "Navamaṃ."
        }
      ]
    },
    {
      "id": "sn18.10",
      "segments": [
        {
          "id": "sn18.10:0.1",
          "pali": "Saṃyutta Nikāya 18.10"
        },
        {
          "id": "sn18.10:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn18.10:0.3",
          "pali": "Khandhasutta"
        },
        {
          "id": "sn18.10:1.1",
          "pali": "Sāvatthiyaṃ viharati."
        },
        {
          "id": "sn18.10:1.2",
          "pali": "“Taṃ kiṃ maññasi, rāhula,"
        },
        {
          "id": "sn18.10:1.3",
          "pali": "rūpaṃ niccaṃ vā aniccaṃ vā”ti?"
        },
        {
          "id": "sn18.10:1.4",
          "pali": "“Aniccaṃ, bhante” …"
        },
        {
          "id": "sn18.10:1.5",
          "pali": "“vedanā …pe…"
        },
        {
          "id": "sn18.10:1.6",
          "pali": "saññā …"
        },
        {
          "id": "sn18.10:1.7",
          "pali": "saṅkhārā …"
        },
        {
          "id": "sn18.10:1.8",
          "pali": "viññāṇaṃ niccaṃ vā aniccaṃ vā”ti?"
        },
        {
          "id": "sn18.10:1.9",
          "pali": "“Aniccaṃ, bhante” …"
        },
        {
          "id": "sn18.10:1.10",
          "pali": "“evaṃ passaṃ, rāhula, sutavā ariyasāvako rūpasmimpi nibbindati …pe… vedanāyapi nibbindati … saññāyapi nibbindati … saṅkhāresupi nibbindati … viññāṇasmimpi nibbindati;"
        },
        {
          "id": "sn18.10:1.11",
          "pali": "nibbindaṃ virajjati; virāgā vimuccati; vimuttasmiṃ vimuttamiti ñāṇaṃ hoti."
        },
        {
          "id": "sn18.10:1.12",
          "pali": "‘Khīṇā jāti, vusitaṃ brahmacariyaṃ, kataṃ karaṇīyaṃ, nāparaṃ itthattāyā’ti pajānātī”ti."
        },
        {
          "id": "sn18.10:1.13",
          "pali": "Dasamaṃ."
        },
        {
          "id": "sn18.10:1.14",
          "pali": "Paṭhamo vaggo."
        },
        {
          "id": "sn18.10:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn18.10:2.1",
          "pali": "Cakkhu rūpañca viññāṇaṃ,"
        },
        {
          "id": "sn18.10:2.2",
          "pali": "samphasso vedanāya ca;"
        },
        {
          "id": "sn18.10:2.3",
          "pali": "Saññā sañcetanā taṇhā,"
        },
        {
          "id": "sn18.10:2.4",
          "pali": "dhātu khandhena te dasāti."
        }
      ]
    },
    {
      "id": "sn18.11",
      "segments": [
        {
          "id": "sn18.11:0.1",
          "pali": "Saṃyutta Nikāya 18.11"
        },
        {
          "id": "sn18.11:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn18.11:0.3",
          "pali": "Cakkhusutta"
        },
        {
          "id": "sn18.11:1.1",
          "pali": "Evaṃ me sutaṃ—"
        },
        {
          "id": "sn18.11:1.2",
          "pali": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati."
        },
        {
          "id": "sn18.11:1.3",
          "pali": "Atha kho āyasmā rāhulo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinnaṃ kho āyasmantaṃ rāhulaṃ bhagavā etadavoca:"
        },
        {
          "id": "sn18.11:1.4",
          "pali": "“Taṃ kiṃ maññasi, rāhula,"
        },
        {
          "id": "sn18.11:1.5",
          "pali": "cakkhuṃ niccaṃ vā aniccaṃ vā”ti?"
        },
        {
          "id": "sn18.11:1.6",
          "pali": "“Aniccaṃ, bhante”."
        },
        {
          "id": "sn18.11:1.7",
          "pali": "“Yaṃ panāniccaṃ dukkhaṃ vā taṃ sukhaṃ vā”ti?"
        },
        {
          "id": "sn18.11:1.8",
          "pali": "“Dukkhaṃ, bhante”."
        },
        {
          "id": "sn18.11:1.9",
          "pali": "“Yaṃ panāniccaṃ dukkhaṃ vipariṇāmadhammaṃ, kallaṃ nu taṃ samanupassituṃ:"
        },
        {
          "id": "sn18.11:1.10",
          "pali": "‘etaṃ mama, esohamasmi, eso me attā’”ti?"
        },
        {
          "id": "sn18.11:1.11",
          "pali": "“No hetaṃ, bhante”."
        },
        {
          "id": "sn18.11:1.12",
          "pali": "“Sotaṃ …pe…"
        },
        {
          "id": "sn18.11:1.13",
          "pali": "ghānaṃ …"
        },
        {
          "id": "sn18.11:1.14",
          "pali": "jivhā …"
        },
        {
          "id": "sn18.11:1.15",
          "pali": "kāyo …"
        },
        {
          "id": "sn18.11:1.16",
          "pali": "mano nicco vā anicco vā”ti?"
        },
        {
          "id": "sn18.11:1.17",
          "pali": "“Anicco, bhante”."
        },
        {
          "id": "sn18.11:1.18",
          "pali": "“Yaṃ panāniccaṃ dukkhaṃ vā taṃ sukhaṃ vā”ti?"
        },
        {
          "id": "sn18.11:1.19",
          "pali": "“Dukkhaṃ, bhante”."
        },
        {
          "id": "sn18.11:1.20",
          "pali": "“Yaṃ panāniccaṃ dukkhaṃ vipariṇāmadhammaṃ, kallaṃ nu taṃ samanupassituṃ:"
        },
        {
          "id": "sn18.11:1.21",
          "pali": "‘etaṃ mama, esohamasmi, eso me attā’”ti?"
        },
        {
          "id": "sn18.11:1.22",
          "pali": "“No hetaṃ, bhante”."
        },
        {
          "id": "sn18.11:1.23",
          "pali": "“Evaṃ passaṃ, rāhula, sutavā ariyasāvako cakkhusmimpi nibbindati …pe… sotasmimpi nibbindati … ghānasmimpi nibbindati … jivhāyapi nibbindati … kāyasmimpi nibbindati … manasmimpi nibbindati;"
        },
        {
          "id": "sn18.11:1.24",
          "pali": "nibbindaṃ virajjati; virāgā vimuccati; vimuttasmiṃ vimuttamiti ñāṇaṃ hoti."
        },
        {
          "id": "sn18.11:1.25",
          "pali": "‘Khīṇā jāti, vusitaṃ brahmacariyaṃ, kataṃ karaṇīyaṃ, nāparaṃ itthattāyā’ti pajānātī”ti."
        },
        {
          "id": "sn18.11:1.26",
          "pali": "(Etena peyyālena dasa suttantā kātabbā.)"
        },
        {
          "id": "sn18.11:1.27",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
