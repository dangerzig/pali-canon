        },
        {
          "id": "sn33.26-30:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn33.26-30:1.2",
          "pali": "“Rūpe kho, vaccha, asallakkhaṇā …pe… viññāṇe kho, vaccha, asallakkhaṇā …pe…."
        },
        {
          "id": "sn33.26-30:1.3",
          "pali": "Tiṃsatimaṃ."
        }
      ]
    },
    {
      "id": "sn33.31-35",
      "segments": [
        {
          "id": "sn33.31-35:0.1",
          "pali": "Saṃyutta Nikāya 33.31–35"
        },
        {
          "id": "sn33.31-35:0.2",
          "pali": "1. Vacchagottavagga"
        },
        {
          "id": "sn33.31-35:0.3",
          "pali": "Rūpaanupalakkhaṇādisuttapañcaka"
        },
        {
          "id": "sn33.31-35:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn33.31-35:1.2",
          "pali": "“Rūpe kho, vaccha, anupalakkhaṇā …pe… viññāṇe kho, vaccha, anupalakkhaṇā …pe…."
        },
        {
          "id": "sn33.31-35:1.3",
          "pali": "Pañcatiṃsatimaṃ."
        }
      ]
    },
    {
      "id": "sn33.36-40",
      "segments": [
        {
          "id": "sn33.36-40:0.1",
          "pali": "Saṃyutta Nikāya 33.36–40"
        },
        {
          "id": "sn33.36-40:0.2",
          "pali": "1. Vacchagottavagga"
        },
        {
          "id": "sn33.36-40:0.3",
          "pali": "Rūpaappaccupalakkhaṇādisuttapañcaka"
        },
        {
          "id": "sn33.36-40:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn33.36-40:1.2",
          "pali": "“Rūpe kho, vaccha, appaccupalakkhaṇā …pe… viññāṇe kho, vaccha, appaccupalakkhaṇā …pe…."
        },
        {
          "id": "sn33.36-40:1.3",
          "pali": "Cattālīsamaṃ."
        }
      ]
    },
    {
      "id": "sn33.41-45",
      "segments": [
        {
          "id": "sn33.41-45:0.1",
          "pali": "Saṃyutta Nikāya 33.41–45"
        },
        {
          "id": "sn33.41-45:0.2",
          "pali": "1. Vacchagottavagga"
        },
        {
          "id": "sn33.41-45:0.3",
          "pali": "Rūpaasamapekkhaṇādisuttapañcaka"
        },
        {
          "id": "sn33.41-45:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn33.41-45:1.2",
          "pali": "“Rūpe kho, vaccha, asamapekkhaṇā …pe… viññāṇe kho, vaccha, asamapekkhaṇā …pe…."
        },
        {
          "id": "sn33.41-45:1.3",
          "pali": "Pañcacattālīsamaṃ."
        }
      ]
    },
    {
      "id": "sn33.46-50",
      "segments": [
        {
          "id": "sn33.46-50:0.1",
          "pali": "Saṃyutta Nikāya 33.46–50"
        },
        {
          "id": "sn33.46-50:0.2",
          "pali": "1. Vacchagottavagga"
        },
        {
          "id": "sn33.46-50:0.3",
          "pali": "Rūpaappaccupekkhaṇādisuttapañcaka"
        },
        {
          "id": "sn33.46-50:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn33.46-50:1.2",
          "pali": "“Rūpe kho, vaccha, appaccupekkhaṇā …pe… viññāṇe kho, vaccha, appaccupekkhaṇā …pe…."
        },
        {
          "id": "sn33.46-50:1.3",
          "pali": "Paññāsamaṃ."
        }
      ]
    },
    {
      "id": "sn33.51-54",
      "segments": [
        {
          "id": "sn33.51:0.1",
          "pali": "Saṃyutta Nikāya 33.51–54"
        },
        {
          "id": "sn33.51:0.2",
          "pali": "1. Vacchagottavagga"
        },
        {
          "id": "sn33.51:0.3",
          "pali": "Rūpaappaccakkhakammādisuttacatukka"
        },
        {
          "id": "sn33.51:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn33.51:1.2",
          "pali": "Atha kho vacchagotto paribbājako yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavatā saddhiṃ sammodi."
        },
        {
          "id": "sn33.51:1.3",
          "pali": "Sammodanīyaṃ kathaṃ sāraṇīyaṃ vītisāretvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho vacchagotto paribbājako bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn33.51:1.4",
          "pali": "“ko nu kho, bho gotama, hetu, ko paccayo, yānimāni anekavihitāni diṭṭhigatāni loke uppajjanti—"
        },
        {
          "id": "sn33.51:1.5",
          "pali": "sassato lokoti vā …pe…"
        },
        {
          "id": "sn33.51:1.6",
          "pali": "neva hoti na na hoti tathāgato paraṃ maraṇāti vā”ti?"
        },
        {
          "id": "sn33.51:1.7",
          "pali": "“Rūpe kho, vaccha, appaccakkhakammā, rūpasamudaye appaccakkhakammā, rūpanirodhe appaccakkhakammā, rūpanirodhagāminiyā paṭipadāya appaccakkhakammā …pe…."
        },
        {
          "id": "sn33.52:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn33.52:1.2",
          "pali": "“Vedanāya kho, vaccha, appaccakkhakammā …pe… vedanānirodhagāminiyā paṭipadāya appaccakkhakammā …pe…."
        },
        {
          "id": "sn33.53:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn33.53:1.2",
          "pali": "“Saññāya kho, vaccha, appaccakkhakammā …pe… saññānirodhagāminiyā paṭipadāya appaccakkhakammā …pe…."
        },
        {
          "id": "sn33.54:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn33.54:1.2",
          "pali": "“Saṅkhāresu kho, vaccha, appaccakkhakammā …pe… saṅkhāranirodhagāminiyā paṭipadāya appaccakkhakammā …pe…."
        },
        {
          "id": "sn33.54:1.3",
          "pali": "Catupaññāsamaṃ."
        }
      ]
    },
    {
      "id": "sn33.55",
      "segments": [
        {
          "id": "sn33.55:0.1",
          "pali": "Saṃyutta Nikāya 33.55"
        },
        {
          "id": "sn33.55:0.2",
          "pali": "1. Vacchagottavagga"
        },
        {
          "id": "sn33.55:0.3",
          "pali": "Viññāṇaappaccakkhakammasutta"
        },
        {
          "id": "sn33.55:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn33.55:1.2",
          "pali": "“Viññāṇe kho, vaccha, appaccakkhakammā, viññāṇasamudaye appaccakkhakammā, viññāṇanirodhe appaccakkhakammā, viññāṇanirodhagāminiyā paṭipadāya appaccakkhakammā;"
        },
        {
          "id": "sn33.55:1.3",
          "pali": "evamimāni anekavihitāni diṭṭhigatāni loke uppajjanti—"
        },
        {
          "id": "sn33.55:1.4",
          "pali": "sassato lokoti vā, asassato lokoti vā …pe…"
        },
        {
          "id": "sn33.55:1.5",
          "pali": "neva hoti na na hoti tathāgato paraṃ maraṇāti vāti."
        },
        {
          "id": "sn33.55:1.6",
          "pali": "Ayaṃ kho, vaccha, hetu, ayaṃ paccayo, yānimāni anekavihitāni diṭṭhigatāni loke uppajjanti—"
        },
        {
          "id": "sn33.55:1.7",
          "pali": "sassato lokoti vā, asassato lokoti vā, antavā lokoti vā, anantavā lokoti vā, taṃ jīvaṃ taṃ sarīranti vā, aññaṃ jīvaṃ aññaṃ sarīranti vā, hoti tathāgato paraṃ maraṇāti vā, na hoti tathāgato paraṃ maraṇāti vā, hoti ca na ca hoti tathāgato paraṃ maraṇāti vā, neva hoti na na hoti tathāgato paraṃ maraṇāti vā”ti."
        },
        {
          "id": "sn33.55:1.8",
          "pali": "Pañcapaññāsamaṃ."
        },
        {
          "id": "sn33.55:1.9",
          "pali": "Vacchagottavaggo paṭhamo."
        },
        {
          "id": "sn33.55:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn33.55:2.1",
          "pali": "Aññāṇā adassanā ceva,"
        },
        {
          "id": "sn33.55:2.2",
          "pali": "Anabhisamayā ananubodhā;"
        },
        {
          "id": "sn33.55:2.3",
          "pali": "Appaṭivedhā asallakkhaṇā,"
        },
        {
          "id": "sn33.55:2.4",
          "pali": "Anupalakkhaṇena appaccupalakkhaṇā;"
        },
        {
          "id": "sn33.55:2.5",
          "pali": "Asamapekkhaṇā appaccupekkhaṇā,"
        },
        {
          "id": "sn33.55:2.6",
          "pali": "Appaccakkhakammanti."
        },
        {
          "id": "sn33.55:2.7",
          "pali": "Vacchagottasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}