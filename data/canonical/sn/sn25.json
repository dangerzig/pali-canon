{
  "id": "sn25",
  "name_pali": "Okkantisaṃyutta",
  "name_eng": "Entering",
  "vagga": "Khandhavagga",
  "pts": "S iii 225–228",
  "suttas": [
    {
      "id": "sn25.1",
      "segments": [
        {
          "id": "sn25.1:0.1",
          "pali": "Saṃyutta Nikāya 25.1"
        },
        {
          "id": "sn25.1:0.2",
          "pali": "1. Cakkhuvagga"
        },
        {
          "id": "sn25.1:0.3",
          "pali": "Cakkhusutta"
        },
        {
          "id": "sn25.1:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn25.1:1.2",
          "pali": "“Cakkhuṃ, bhikkhave, aniccaṃ vipariṇāmi aññathābhāvi;"
        },
        {
          "id": "sn25.1:1.3",
          "pali": "sotaṃ aniccaṃ vipariṇāmi aññathābhāvi;"
        },
        {
          "id": "sn25.1:1.4",
          "pali": "ghānaṃ aniccaṃ vipariṇāmi aññathābhāvi;"
        },
        {
          "id": "sn25.1:1.5",
          "pali": "jivhā aniccā vipariṇāmī aññathābhāvī;"
        },
        {
          "id": "sn25.1:1.6",
          "pali": "kāyo anicco vipariṇāmi aññathābhāvi;"
        },
        {
          "id": "sn25.1:1.7",
          "pali": "mano anicco vipariṇāmī aññathābhāvī."
        },
        {
          "id": "sn25.1:1.8",
          "pali": "Yo, bhikkhave, ime dhamme evaṃ saddahati adhimuccati—ayaṃ vuccati saddhānusārī, okkanto sammattaniyāmaṃ, sappurisabhūmiṃ okkanto, vītivatto puthujjanabhūmiṃ;"
        },
        {
          "id": "sn25.1:1.9",
          "pali": "abhabbo taṃ kammaṃ kātuṃ, yaṃ kammaṃ katvā nirayaṃ vā tiracchānayoniṃ vā pettivisayaṃ vā upapajjeyya;"
        },
        {
          "id": "sn25.1:1.10",
          "pali": "abhabbo ca tāva kālaṃ kātuṃ yāva na sotāpattiphalaṃ sacchikaroti."
        },
        {
          "id": "sn25.1:2.1",
          "pali": "Yassa kho, bhikkhave, ime dhammā evaṃ paññāya mattaso nijjhānaṃ khamanti, ayaṃ vuccati: ‘dhammānusārī, okkanto sammattaniyāmaṃ, sappurisabhūmiṃ okkanto, vītivatto puthujjanabhūmiṃ;"
        },
        {
          "id": "sn25.1:2.2",
          "pali": "abhabbo taṃ kammaṃ kātuṃ, yaṃ kammaṃ katvā nirayaṃ vā tiracchānayoniṃ vā pettivisayaṃ vā upapajjeyya;"
        },
        {
          "id": "sn25.1:2.3",
          "pali": "abhabbo ca tāva kālaṃ kātuṃ yāva na sotāpattiphalaṃ sacchikaroti’."
        },
        {
          "id": "sn25.1:2.4",
          "pali": "Yo, bhikkhave, ime dhamme evaṃ pajānāti evaṃ passati, ayaṃ vuccati: ‘sotāpanno avinipātadhammo niyato sambodhiparāyano’”ti."
        },
        {
          "id": "sn25.1:2.5",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
