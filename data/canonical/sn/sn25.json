          "pali": "abhabbo ca tāva kālaṃ kātuṃ yāva na sotāpattiphalaṃ sacchikaroti."
        },
        {
          "id": "sn25.2:2.1",
          "pali": "Yassa kho, bhikkhave, ime dhammā evaṃ paññāya mattaso nijjhānaṃ khamanti, ayaṃ vuccati: ‘dhammānusārī, okkanto sammattaniyāmaṃ, sappurisabhūmiṃ okkanto, vītivatto puthujjanabhūmiṃ;"
        },
        {
          "id": "sn25.2:2.2",
          "pali": "abhabbo taṃ kammaṃ kātuṃ, yaṃ kammaṃ katvā nirayaṃ vā tiracchānayoniṃ vā pettivisayaṃ vā upapajjeyya;"
        },
        {
          "id": "sn25.2:2.3",
          "pali": "abhabbo ca tāva kālaṃ kātuṃ yāva na sotāpattiphalaṃ sacchikaroti’."
        },
        {
          "id": "sn25.2:2.4",
          "pali": "Yo, bhikkhave, ime dhamme evaṃ pajānāti evaṃ passati, ayaṃ vuccati:"
        },
        {
          "id": "sn25.2:2.5",
          "pali": "‘sotāpanno avinipātadhammo niyato sambodhiparāyano’”ti."
        },
        {
          "id": "sn25.2:2.6",
          "pali": "Dutiyaṃ."
        }
      ]
