        {
          "id": "sn25.10:2.3",
          "pali": "abhabbo ca tāva kālaṃ kātuṃ yāva na sotāpattiphalaṃ sacchikaroti’."
        },
        {
          "id": "sn25.10:2.4",
          "pali": "Yo, bhikkhave, ime dhamme evaṃ pajānāti evaṃ passati, ayaṃ vuccati:"
        },
        {
          "id": "sn25.10:2.5",
          "pali": "‘sotāpanno avinipātadhammo niyato sambodhiparāyano’”ti."
        },
        {
          "id": "sn25.10:2.6",
          "pali": "Dasamaṃ."
        },
        {
          "id": "sn25.10:2.7",
          "pali": "Cakkhuvaggo paṭhamo."
        },
        {
          "id": "sn25.10:3.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn25.10:3.1",
          "pali": "Cakkhu rūpañca viññāṇaṃ,"
        },
        {
          "id": "sn25.10:3.2",
          "pali": "phasso ca vedanāya ca;"
        },
        {
          "id": "sn25.10:3.3",
          "pali": "Saññā ca cetanā taṇhā,"
        },
        {
          "id": "sn25.10:3.4",
          "pali": "dhātu khandhena te dasāti."
        },
        {
          "id": "sn25.10:3.5",
          "pali": "Okkantasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}