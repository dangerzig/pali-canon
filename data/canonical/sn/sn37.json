    },
    {
      "id": "sn37.14",
      "segments": [
        {
          "id": "sn37.14:0.1",
          "pali": "Saṃyutta Nikāya 37.14"
        },
        {
          "id": "sn37.14:0.2",
          "pali": "1. Paṭhamapeyyālavagga"
        },
        {
          "id": "sn37.14:0.3",
          "pali": "Pañcaverasutta"
        },
        {
          "id": "sn37.14:1.1",
          "pali": "“Pañcahi, anuruddha, dhammehi samannāgato mātugāmo …pe… nirayaṃ upapajjati."
        },
        {
          "id": "sn37.14:1.2",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.14:1.3",
          "pali": "Pāṇātipātī ca hoti, adinnādāyī ca hoti, kāmesumicchācārī ca hoti, musāvādī ca hoti, surāmerayamajjappamādaṭṭhāyī ca hoti—"
        },
        {
          "id": "sn37.14:1.4",
          "pali": "imehi kho, anuruddha, pañcahi dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjatī”ti."
        },
        {
          "id": "sn37.14:1.5",
          "pali": "Cuddasamaṃ."
        },
        {
          "id": "sn37.14:1.6",
          "pali": "Paṭhamapeyyālavaggo."
        },
        {
          "id": "sn37.14:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn37.14:2.1",
          "pali": "Mātugāmo puriso ca,"
        },
        {
          "id": "sn37.14:2.2",
          "pali": "āveṇikā tidhammo ca;"
        },
        {
          "id": "sn37.14:2.3",
          "pali": "Kodhano upanāhī ca,"
        },
        {
          "id": "sn37.14:2.4",
          "pali": "issukī maccharena ca;"
        },
        {
          "id": "sn37.14:2.5",
          "pali": "Aticārī ca dussīlo,"
        },
        {
          "id": "sn37.14:2.6",
          "pali": "appassuto ca kusīto;"
        },
        {
          "id": "sn37.14:2.7",
          "pali": "Muṭṭhassati pañcaveraṃ,"
        },
        {
          "id": "sn37.14:2.8",
          "pali": "kaṇhapakkhe pakāsito."
        }
      ]
    },
    {
      "id": "sn37.15",
      "segments": [
        {
          "id": "sn37.15:0.1",
          "pali": "Saṃyutta Nikāya 37.15"
        },
        {
          "id": "sn37.15:0.2",
          "pali": "2. Dutiyapeyyālavagga"
        },
        {
          "id": "sn37.15:0.3",
          "pali": "Akkodhanasutta"
        },
        {
          "id": "sn37.15:1.1",
          "pali": "Atha kho āyasmā anuruddho yena bhagavā tenupasaṅkami; upasaṅkamitvā …pe… ekamantaṃ nisinno kho āyasmā anuruddho bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn37.15:1.2",
          "pali": "“idhāhaṃ, bhante, mātugāmaṃ passāmi dibbena cakkhunā visuddhena atikkantamānusakena kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjantaṃ."
        },
        {
          "id": "sn37.15:1.3",
          "pali": "Katīhi nu kho, bhante, dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjatī”ti?"
        },
        {
          "id": "sn37.15:2.1",
          "pali": "“Pañcahi kho, anuruddha, dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjati."
        },
        {
          "id": "sn37.15:2.2",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.15:2.3",
          "pali": "Saddho ca hoti, hirimā ca hoti, ottappī ca hoti, akkodhano ca hoti, paññavā ca hoti—"
        },
        {
          "id": "sn37.15:2.4",
          "pali": "imehi kho, anuruddha, pañcahi dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjatī”ti."
        },
        {
          "id": "sn37.15:2.5",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn37.16",
      "segments": [
        {
          "id": "sn37.16:0.1",
          "pali": "Saṃyutta Nikāya 37.16"
        },
        {
          "id": "sn37.16:0.2",
          "pali": "2. Dutiyapeyyālavagga"
        },
        {
          "id": "sn37.16:0.3",
          "pali": "Anupanāhīsutta"
        },
        {
          "id": "sn37.16:1.1",
          "pali": "“Pañcahi, anuruddha, dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjati."
        },
        {
          "id": "sn37.16:1.2",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.16:1.3",
          "pali": "Saddho ca hoti, hirimā ca hoti, ottappī ca hoti, anupanāhī ca hoti, paññavā ca hoti—"
        },
        {
          "id": "sn37.16:1.4",
          "pali": "imehi kho, anuruddha, pañcahi dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjatī”ti."
        },
        {
          "id": "sn37.16:1.5",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn37.17",
      "segments": [
        {
          "id": "sn37.17:0.1",
          "pali": "Saṃyutta Nikāya 37.17"
        },
        {
          "id": "sn37.17:0.2",
          "pali": "2. Dutiyapeyyālavagga"
        },
        {
          "id": "sn37.17:0.3",
          "pali": "Anissukīsutta"
        },
        {
          "id": "sn37.17:1.1",
          "pali": "“Pañcahi, anuruddha, dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjati."
        },
        {
          "id": "sn37.17:1.2",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.17:1.3",
          "pali": "Saddho ca hoti, hirimā ca hoti, ottappī ca hoti, anissukī ca hoti, paññavā ca hoti …pe…."
        },
        {
          "id": "sn37.17:1.4",
          "pali": "Tatiyaṃ."
        }
      ]
    },
    {
      "id": "sn37.18",
      "segments": [
        {
          "id": "sn37.18:0.1",
          "pali": "Saṃyutta Nikāya 37.18"
        },
        {
          "id": "sn37.18:0.2",
          "pali": "2. Dutiyapeyyālavagga"
        },
        {
          "id": "sn37.18:0.3",
          "pali": "Amaccharīsutta"
        },
        {
          "id": "sn37.18:1.1",
          "pali": "“Amaccharī ca hoti, paññavā ca hoti …pe…."
        },
        {
          "id": "sn37.18:1.2",
          "pali": "Catutthaṃ."
        }
      ]
    },
    {
      "id": "sn37.19",
      "segments": [
        {
          "id": "sn37.19:0.1",
          "pali": "Saṃyutta Nikāya 37.19"
        },
        {
          "id": "sn37.19:0.2",
          "pali": "2. Dutiyapeyyālavagga"
        },
        {
          "id": "sn37.19:0.3",
          "pali": "Anaticārīsutta"
        },
        {
          "id": "sn37.19:1.1",
          "pali": "“Anaticārī ca hoti, paññavā ca hoti …pe…."
        },
        {
          "id": "sn37.19:1.2",
          "pali": "Pañcamaṃ."
        }
      ]
    },
    {
      "id": "sn37.20",
      "segments": [
        {
          "id": "sn37.20:0.1",
          "pali": "Saṃyutta Nikāya 37.20"
        },
        {
          "id": "sn37.20:0.2",
          "pali": "2. Dutiyapeyyālavagga"
        },
        {
          "id": "sn37.20:0.3",
          "pali": "Susīlasutta"
        },
        {
          "id": "sn37.20:1.1",
          "pali": "“Sīlavā ca hoti, paññavā ca hoti …pe…."
        },
        {
          "id": "sn37.20:1.2",
          "pali": "Chaṭṭhaṃ."
        }
      ]
    },
    {
      "id": "sn37.21",
      "segments": [
        {
          "id": "sn37.21:0.1",
          "pali": "Saṃyutta Nikāya 37.21"
        },
        {
          "id": "sn37.21:0.2",
          "pali": "2. Dutiyapeyyālavagga"
        },
        {
          "id": "sn37.21:0.3",
          "pali": "Bahussutasutta"
        },
        {
          "id": "sn37.21:1.1",
          "pali": "“Bahussuto ca hoti, paññavā ca hoti …pe…."
        },
        {
          "id": "sn37.21:1.2",
          "pali": "Sattamaṃ."
        }
      ]
    },
    {
      "id": "sn37.22",
      "segments": [
        {
          "id": "sn37.22:0.1",
          "pali": "Saṃyutta Nikāya 37.22"
        },
        {
          "id": "sn37.22:0.2",
          "pali": "2. Dutiyapeyyālavagga"
        },
        {
          "id": "sn37.22:0.3",
          "pali": "Āraddhavīriyasutta"
        },
        {
          "id": "sn37.22:1.1",
          "pali": "“Āraddhavīriyo ca hoti, paññavā ca hoti …pe…."
        },
        {
          "id": "sn37.22:1.2",
          "pali": "Aṭṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn37.23",
      "segments": [
        {
          "id": "sn37.23:0.1",
          "pali": "Saṃyutta Nikāya 37.23"
        },
        {
          "id": "sn37.23:0.2",
          "pali": "2. Dutiyapeyyālavagga"
        },
        {
          "id": "sn37.23:0.3",
          "pali": "Upaṭṭhitassatisutta"
        },
        {
          "id": "sn37.23:1.1",
          "pali": "“Upaṭṭhitassati ca hoti, paññavā ca hoti …pe…"
        },
        {
          "id": "sn37.23:1.2",
          "pali": "imehi kho, anuruddha, pañcahi dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjatī”ti."
        },
        {
          "id": "sn37.23:1.3",
          "pali": "Navamaṃ."
        },
        {
          "id": "sn37.23:2.1",
          "pali": "Ime aṭṭha suttantasaṅkhepā."
        }
      ]
    },
    {
      "id": "sn37.24",
      "segments": [
        {
          "id": "sn37.24:0.1",
          "pali": "Saṃyutta Nikāya 37.24"
        },
        {
          "id": "sn37.24:0.2",
          "pali": "2. Dutiyapeyyālavagga"
        },
        {
          "id": "sn37.24:0.3",
          "pali": "Pañcasīlasutta"
        },
        {
          "id": "sn37.24:1.1",
          "pali": "“Pañcahi, anuruddha, dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjati."
        },
        {
          "id": "sn37.24:1.2",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.24:1.3",
          "pali": "Pāṇātipātā paṭivirato ca hoti, adinnādānā paṭivirato ca hoti, kāmesumicchācārā paṭivirato ca hoti, musāvādā paṭivirato ca hoti, surāmerayamajjappamādaṭṭhānā paṭivirato ca hoti—"
        },
        {
          "id": "sn37.24:1.4",
          "pali": "imehi kho, anuruddha, pañcahi dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjatī”ti."
        },
        {
          "id": "sn37.24:1.5",
          "pali": "Dasamaṃ."
        },
        {
          "id": "sn37.24:1.6",
          "pali": "Dutiyapeyyālavaggo."
        },
        {
          "id": "sn37.24:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn37.24:2.1",
          "pali": "Dutiye ca akkodhano,"
        },
        {
          "id": "sn37.24:2.2",
          "pali": "anupanāhī anissukī;"
        },
        {
          "id": "sn37.24:2.3",
          "pali": "Amaccharī anaticārī,"
        },
        {
          "id": "sn37.24:2.4",
          "pali": "sīlavā ca bahussuto;"
        },
        {
          "id": "sn37.24:2.5",
          "pali": "Vīriyaṃ sati sīlañca,"
        },
        {
          "id": "sn37.24:2.6",
          "pali": "sukkapakkhe pakāsito."
        }
      ]
    },
    {
      "id": "sn37.25",
      "segments": [
        {
          "id": "sn37.25:0.1",
          "pali": "Saṃyutta Nikāya 37.25"
        },
        {
          "id": "sn37.25:0.2",
          "pali": "3. Balavagga"
        },
        {
          "id": "sn37.25:0.3",
          "pali": "Visāradasutta"
        },
        {
          "id": "sn37.25:1.1",
          "pali": "“Pañcimāni, bhikkhave, mātugāmassa balāni."
        },
        {
          "id": "sn37.25:1.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn37.25:1.3",
          "pali": "Rūpabalaṃ, bhogabalaṃ, ñātibalaṃ, puttabalaṃ, sīlabalaṃ—"
        },
        {
          "id": "sn37.25:1.4",
          "pali": "imāni kho, bhikkhave, pañca mātugāmassa balāni."
        },
        {
          "id": "sn37.25:1.5",
          "pali": "Imehi kho, bhikkhave, pañcahi balehi samannāgato mātugāmo visārado agāraṃ ajjhāvasatī”ti."
        },
        {
          "id": "sn37.25:1.6",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn37.26",
      "segments": [
        {
          "id": "sn37.26:0.1",
          "pali": "Saṃyutta Nikāya 37.26"
        },
        {
          "id": "sn37.26:0.2",
          "pali": "3. Balavagga"
        },
        {
          "id": "sn37.26:0.3",
          "pali": "Pasayhasutta"
        },
        {
          "id": "sn37.26:1.1",
          "pali": "“Pañcimāni, bhikkhave, mātugāmassa balāni."
        },
        {
          "id": "sn37.26:1.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn37.26:1.3",
          "pali": "Rūpabalaṃ, bhogabalaṃ, ñātibalaṃ, puttabalaṃ, sīlabalaṃ—"
        },
        {
          "id": "sn37.26:1.4",
          "pali": "imāni kho, bhikkhave, pañca mātugāmassa balāni."
        },
        {
          "id": "sn37.26:1.5",
          "pali": "Imehi kho, bhikkhave, pañcahi balehi samannāgato mātugāmo sāmikaṃ pasayha agāraṃ ajjhāvasatī”ti."
        },
        {
          "id": "sn37.26:1.6",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn37.27",
      "segments": [
        {
          "id": "sn37.27:0.1",
          "pali": "Saṃyutta Nikāya 37.27"
        },
        {
          "id": "sn37.27:0.2",
          "pali": "3. Balavagga"
        },
        {
          "id": "sn37.27:0.3",
          "pali": "Abhibhuyyasutta"
        },
        {
          "id": "sn37.27:1.1",
          "pali": "“Pañcimāni, bhikkhave, mātugāmassa balāni."
        },
        {
          "id": "sn37.27:1.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn37.27:1.3",
          "pali": "Rūpabalaṃ, bhogabalaṃ, ñātibalaṃ, puttabalaṃ, sīlabalaṃ—"
        },
        {
          "id": "sn37.27:1.4",
          "pali": "imāni kho, bhikkhave, pañca mātugāmassa balāni."
        },
        {
          "id": "sn37.27:1.5",
          "pali": "Imehi kho, bhikkhave, pañcahi balehi samannāgato mātugāmo sāmikaṃ abhibhuyya vattatī”ti."
        },
        {
          "id": "sn37.27:1.6",
          "pali": "Tatiyaṃ."
        }
      ]
    },
    {
      "id": "sn37.28",
      "segments": [
        {
          "id": "sn37.28:0.1",
          "pali": "Saṃyutta Nikāya 37.28"
        },
        {
          "id": "sn37.28:0.2",
          "pali": "3. Balavagga"
        },
        {
          "id": "sn37.28:0.3",
          "pali": "Ekasutta"
        },
        {
          "id": "sn37.28:1.1",
          "pali": "“Ekena ca kho, bhikkhave, balena samannāgato puriso mātugāmaṃ abhibhuyya vattati."
        },
        {
          "id": "sn37.28:1.2",
          "pali": "Katamena ekena balena?"
        },
        {
          "id": "sn37.28:1.3",
          "pali": "Issariyabalena abhibhūtaṃ mātugāmaṃ neva rūpabalaṃ tāyati, na bhogabalaṃ tāyati, na ñātibalaṃ tāyati, na puttabalaṃ tāyati, na sīlabalaṃ tāyatī”ti."
        },
        {
          "id": "sn37.28:1.4",
          "pali": "Catutthaṃ."
        }
      ]
    },
    {
      "id": "sn37.29",
      "segments": [
        {
          "id": "sn37.29:0.1",
          "pali": "Saṃyutta Nikāya 37.29"
        },
        {
          "id": "sn37.29:0.2",
          "pali": "3. Balavagga"
        },
        {
          "id": "sn37.29:0.3",
          "pali": "Aṅgasutta"
        },
        {
          "id": "sn37.29:1.1",
          "pali": "“Pañcimāni, bhikkhave, mātugāmassa balāni."
        },
        {
          "id": "sn37.29:1.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn37.29:1.3",
          "pali": "Rūpabalaṃ, bhogabalaṃ, ñātibalaṃ, puttabalaṃ, sīlabalaṃ."
        },
        {
          "id": "sn37.29:1.4",
          "pali": "Rūpabalena ca, bhikkhave, mātugāmo samannāgato hoti, na ca bhogabalena—"
        },
        {
          "id": "sn37.29:1.5",
          "pali": "evaṃ so tenaṅgena aparipūro hoti."
        },
        {
          "id": "sn37.29:1.6",
          "pali": "Yato ca kho, bhikkhave, mātugāmo rūpabalena ca samannāgato hoti, bhogabalena ca—"
        },
        {
          "id": "sn37.29:1.7",
          "pali": "evaṃ so tenaṅgena paripūro hoti."
        },
        {
          "id": "sn37.29:1.8",
          "pali": "Rūpabalena ca, bhikkhave, mātugāmo samannāgato hoti, bhogabalena ca, na ca ñātibalena—"
        },
        {
          "id": "sn37.29:1.9",
          "pali": "evaṃ so tenaṅgena aparipūro hoti."
        },
        {
          "id": "sn37.29:1.10",
          "pali": "Yato ca kho, bhikkhave, mātugāmo rūpabalena ca samannāgato hoti, bhogabalena ca, ñātibalena ca—"
        },
        {
          "id": "sn37.29:1.11",
          "pali": "evaṃ so tenaṅgena paripūro hoti."
        },
        {
          "id": "sn37.29:1.12",
          "pali": "Rūpabalena ca, bhikkhave, mātugāmo samannāgato hoti, bhogabalena ca, ñātibalena ca, na ca puttabalena—"
        },
        {
          "id": "sn37.29:1.13",
          "pali": "evaṃ so tenaṅgena aparipūro hoti."
        },
        {
          "id": "sn37.29:1.14",
          "pali": "Yato ca kho, bhikkhave, mātugāmo rūpabalena ca samannāgato hoti, bhogabalena ca, ñātibalena ca, puttabalena ca—"
        },
        {
          "id": "sn37.29:1.15",
          "pali": "evaṃ so tenaṅgena paripūro hoti."
        },
        {
          "id": "sn37.29:1.16",
          "pali": "Rūpabalena ca, bhikkhave, mātugāmo samannāgato hoti, bhogabalena ca, ñātibalena ca, puttabalena ca, na ca sīlabalena—"
        },
        {
          "id": "sn37.29:1.17",
          "pali": "evaṃ so tenaṅgena aparipūro hoti."
        },
        {
          "id": "sn37.29:1.18",
          "pali": "Yato ca kho, bhikkhave, mātugāmo rūpabalena ca samannāgato hoti, bhogabalena ca, ñātibalena ca, puttabalena ca, sīlabalena ca—"
        },
        {
          "id": "sn37.29:1.19",
          "pali": "evaṃ so tenaṅgena paripūro hoti."
        },
        {
          "id": "sn37.29:1.20",
          "pali": "Imāni kho, bhikkhave, pañca mātugāmassa balānī”ti."
        },
        {
          "id": "sn37.29:1.21",
          "pali": "Pañcamaṃ."
        }
      ]
    },
    {
      "id": "sn37.30",
      "segments": [
        {
          "id": "sn37.30:0.1",
          "pali": "Saṃyutta Nikāya 37.30"
        },
        {
          "id": "sn37.30:0.2",
          "pali": "3. Balavagga"
        },
        {
          "id": "sn37.30:0.3",
          "pali": "Nāsentisutta"
        },
        {
          "id": "sn37.30:1.1",
          "pali": "“Pañcimāni, bhikkhave, mātugāmassa balāni."
        },
        {
          "id": "sn37.30:1.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn37.30:1.3",
          "pali": "Rūpabalaṃ, bhogabalaṃ, ñātibalaṃ, puttabalaṃ, sīlabalaṃ."
        },
        {
          "id": "sn37.30:1.4",
          "pali": "Rūpabalena ca, bhikkhave, mātugāmo samannāgato hoti, na ca sīlabalena, nāsenteva naṃ, kule na vāsenti."
        },
        {
          "id": "sn37.30:1.5",
          "pali": "Rūpabalena ca, bhikkhave, mātugāmo samannāgato hoti, bhogabalena ca, na ca sīlabalena, nāsenteva naṃ, kule na vāsenti."
        },
        {
          "id": "sn37.30:1.6",
          "pali": "Rūpabalena ca, bhikkhave, mātugāmo samannāgato hoti, bhogabalena ca, ñātibalena ca, na ca sīlabalena, nāsenteva naṃ, kule na vāsenti."
        },
        {
          "id": "sn37.30:1.7",
          "pali": "Rūpabalena ca, bhikkhave, mātugāmo samannāgato hoti, bhogabalena ca, ñātibalena ca, puttabalena ca, na ca sīlabalena, nāsenteva naṃ, kule na vāsenti."
        },
        {
          "id": "sn37.30:1.8",
          "pali": "Sīlabalena ca, bhikkhave, mātugāmo samannāgato hoti, na ca rūpabalena, vāsenteva naṃ, kule na nāsenti."
        },
        {
          "id": "sn37.30:1.9",
          "pali": "Sīlabalena ca, bhikkhave, mātugāmo samannāgato hoti, na ca bhogabalena, vāsenteva naṃ, kule na nāsenti."
        },
        {
          "id": "sn37.30:1.10",
          "pali": "Sīlabalena ca, bhikkhave, mātugāmo samannāgato hoti, na ca ñātibalena, vāsenteva naṃ, kule na nāsenti."
        },
        {
          "id": "sn37.30:1.11",
          "pali": "Sīlabalena ca, bhikkhave, mātugāmo samannāgato hoti, na ca puttabalena, vāsenteva naṃ, kule na nāsenti."
        },
        {
          "id": "sn37.30:1.12",
          "pali": "Imāni kho, bhikkhave, pañca mātugāmassa balānī”ti."
        },
        {
          "id": "sn37.30:1.13",
          "pali": "Chaṭṭhaṃ."
        }
      ]
    },
    {
      "id": "sn37.31",
      "segments": [
        {
          "id": "sn37.31:0.1",
          "pali": "Saṃyutta Nikāya 37.31"
        },
        {
          "id": "sn37.31:0.2",
          "pali": "3. Balavagga"
        },
        {
          "id": "sn37.31:0.3",
          "pali": "Hetusutta"
        },
        {
          "id": "sn37.31:1.1",
          "pali": "“Pañcimāni, bhikkhave, mātugāmassa balāni."
        },
        {
          "id": "sn37.31:1.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn37.31:1.3",
          "pali": "Rūpabalaṃ, bhogabalaṃ, ñātibalaṃ, puttabalaṃ, sīlabalaṃ."
        },
        {
          "id": "sn37.31:1.4",
          "pali": "Na, bhikkhave, mātugāmo rūpabalahetu vā bhogabalahetu vā ñātibalahetu vā puttabalahetu vā kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjati."
        },
        {
          "id": "sn37.31:1.5",
          "pali": "Sīlabalahetu kho, bhikkhave, mātugāmo kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjati."
        },
        {
          "id": "sn37.31:1.6",
          "pali": "Imāni kho, bhikkhave, pañca mātugāmassa balānī”ti."
        },
        {
          "id": "sn37.31:1.7",
          "pali": "Sattamaṃ."
        }
      ]
    },
    {
      "id": "sn37.32",
      "segments": [
        {
          "id": "sn37.32:0.1",
          "pali": "Saṃyutta Nikāya 37.32"
        },
        {
          "id": "sn37.32:0.2",
          "pali": "3. Balavagga"
        },
        {
          "id": "sn37.32:0.3",
          "pali": "Ṭhānasutta"
        },
        {
          "id": "sn37.32:1.1",
          "pali": "“Pañcimāni, bhikkhave, ṭhānāni dullabhāni akatapuññena mātugāmena."
        },
        {
          "id": "sn37.32:1.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn37.32:1.3",
          "pali": "Patirūpe kule jāyeyyanti—"
        },
        {
          "id": "sn37.32:1.4",
          "pali": "idaṃ, bhikkhave, paṭhamaṃ ṭhānaṃ dullabhaṃ akatapuññena mātugāmena."
        },
        {
          "id": "sn37.32:1.5",
          "pali": "Patirūpe kule jāyitvā patirūpaṃ kulaṃ gaccheyyanti—"
        },
        {
          "id": "sn37.32:1.6",
          "pali": "idaṃ, bhikkhave, dutiyaṃ ṭhānaṃ dullabhaṃ akatapuññena mātugāmena."
        },
        {
          "id": "sn37.32:1.7",
          "pali": "Patirūpe kule jāyitvā, patirūpaṃ kulaṃ gantvā, asapatti agāraṃ ajjhāvaseyyanti—"
        },
        {
          "id": "sn37.32:1.8",
          "pali": "idaṃ, bhikkhave, tatiyaṃ ṭhānaṃ dullabhaṃ akatapuññena mātugāmena."
        },
        {
          "id": "sn37.32:1.9",
          "pali": "Patirūpe kule jāyitvā, patirūpaṃ kulaṃ gantvā, asapatti agāraṃ ajjhāvasantī puttavatī assanti—"
        },
        {
          "id": "sn37.32:1.10",
          "pali": "idaṃ, bhikkhave, catutthaṃ ṭhānaṃ dullabhaṃ akatapuññena mātugāmena."
        },
        {
          "id": "sn37.32:1.11",
          "pali": "Patirūpe kule jāyitvā, patirūpaṃ kulaṃ gantvā, asapatti agāraṃ ajjhāvasantī puttavatī samānā sāmikaṃ abhibhuyya vatteyyanti—"
        },
        {
          "id": "sn37.32:1.12",
          "pali": "idaṃ, bhikkhave, pañcamaṃ ṭhānaṃ dullabhaṃ akatapuññena mātugāmena."
        },
        {
          "id": "sn37.32:1.13",
          "pali": "Imāni kho, bhikkhave, pañca ṭhānāni dullabhāni akatapuññena mātugāmenāti."
        },
        {
          "id": "sn37.32:2.1",
          "pali": "Pañcimāni, bhikkhave, ṭhānāni sulabhāni katapuññena mātugāmena."
        },
        {
          "id": "sn37.32:2.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn37.32:2.3",
          "pali": "Patirūpe kule jāyeyyanti—"
        },
        {
          "id": "sn37.32:2.4",
          "pali": "idaṃ, bhikkhave, paṭhamaṃ ṭhānaṃ sulabhaṃ katapuññena mātugāmena."
        },
        {
          "id": "sn37.32:2.5",
          "pali": "Patirūpe kule jāyitvā patirūpaṃ kulaṃ gaccheyyanti—"
        },
        {
          "id": "sn37.32:2.6",
          "pali": "idaṃ, bhikkhave, dutiyaṃ ṭhānaṃ sulabhaṃ katapuññena mātugāmena."
        },
        {
          "id": "sn37.32:2.7",
          "pali": "Patirūpe kule jāyitvā patirūpaṃ kulaṃ gantvā asapatti agāraṃ ajjhāvaseyyanti—"
        },
        {
          "id": "sn37.32:2.8",
          "pali": "idaṃ, bhikkhave, tatiyaṃ ṭhānaṃ sulabhaṃ katapuññena mātugāmena."
        },
        {
          "id": "sn37.32:2.9",
          "pali": "Patirūpe kule jāyitvā patirūpaṃ kulaṃ gantvā asapatti agāraṃ ajjhāvasantī puttavatī assanti—"
        },
        {
          "id": "sn37.32:2.10",
          "pali": "idaṃ, bhikkhave, catutthaṃ ṭhānaṃ sulabhaṃ katapuññena mātugāmena."
        },
        {
          "id": "sn37.32:2.11",
          "pali": "Patirūpe kule jāyitvā patirūpaṃ kulaṃ gantvā asapatti agāraṃ ajjhāvasantī puttavatī samānā sāmikaṃ abhibhuyya vatteyyanti—"
        },
        {
          "id": "sn37.32:2.12",
          "pali": "idaṃ, bhikkhave, pañcamaṃ ṭhānaṃ sulabhaṃ katapuññena mātugāmena."
        },
        {
          "id": "sn37.32:2.13",
          "pali": "Imāni kho, bhikkhave, pañca ṭhānāni sulabhāni katapuññena mātugāmenā”ti."
        },
        {
          "id": "sn37.32:2.14",
          "pali": "Aṭṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn37.33",
      "segments": [
        {
          "id": "sn37.33:0.1",
          "pali": "Saṃyutta Nikāya 37.33"
        },
        {
          "id": "sn37.33:0.2",
          "pali": "3. Balavagga"
        },
        {
          "id": "sn37.33:0.3",
          "pali": "Pañcasīlavisāradasutta"
        },
        {
          "id": "sn37.33:1.1",
          "pali": "“Pañcahi, bhikkhave, dhammehi samannāgato mātugāmo visārado agāraṃ ajjhāvasati."
        },
        {
          "id": "sn37.33:1.2",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.33:1.3",
          "pali": "Pāṇātipātā paṭivirato ca hoti, adinnādānā paṭivirato ca hoti, kāmesumicchācārā paṭivirato ca hoti, musāvādā paṭivirato ca hoti, surāmerayamajjappamādaṭṭhānā paṭivirato ca hoti—"
        },
        {
          "id": "sn37.33:1.4",
          "pali": "imehi kho, bhikkhave, pañcahi dhammehi samannāgato mātugāmo visārado agāraṃ ajjhāvasatī”ti."
        },
        {
          "id": "sn37.33:1.5",
          "pali": "Navamaṃ."
        }
      ]
    },
    {
      "id": "sn37.34",
      "segments": [
        {
          "id": "sn37.34:0.1",
          "pali": "Saṃyutta Nikāya 37.34"
        },
        {
          "id": "sn37.34:0.2",
          "pali": "3. Balavagga"
        },
        {
          "id": "sn37.34:0.3",
          "pali": "Vaḍḍhīsutta"
        },
        {
          "id": "sn37.34:1.1",
          "pali": "“Pañcahi, bhikkhave, vaḍḍhīhi vaḍḍhamānā ariyasāvikā ariyāya vaḍḍhiyā vaḍḍhati sārādāyinī ca hoti varādāyinī ca kāyassa."
        },
        {
          "id": "sn37.34:1.2",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.34:1.3",
          "pali": "Saddhāya vaḍḍhati, sīlena vaḍḍhati, sutena vaḍḍhati, cāgena vaḍḍhati, paññāya vaḍḍhati—"
        },
        {
          "id": "sn37.34:1.4",
          "pali": "imehi kho, bhikkhave, pañcahi vaḍḍhīhi vaḍḍhamānā ariyasāvikā ariyāya vaḍḍhiyā vaḍḍhati, sārādāyinī ca hoti, varādāyinī ca kāyassāti."
        },
        {
          "id": "sn37.34:2.1",
          "pali": "Saddhāya sīlena ca yādha vaḍḍhati,"
        },
        {
          "id": "sn37.34:2.2",
          "pali": "Paññāya cāgena sutena cūbhayaṃ;"
        },
        {
          "id": "sn37.34:2.3",
          "pali": "Sā tādisī sīlavatī upāsikā,"
        },
        {
          "id": "sn37.34:2.4",
          "pali": "Ādīyati sāramidheva attano”ti."
        },
        {
          "id": "sn37.34:2.5",
          "pali": "Dasamaṃ."
        },
        {
          "id": "sn37.34:2.6",
          "pali": "Balavaggo tatiyo."
        },
        {
          "id": "sn37.34:3.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn37.34:3.1",
          "pali": "Visāradā pasayha abhibhuyya,"
        },
        {
          "id": "sn37.34:3.2",
          "pali": "Ekaṃ aṅgena pañcamaṃ;"
        },
        {
          "id": "sn37.34:3.3",
          "pali": "Nāsenti hetu ṭhānañca,"
        },
        {
          "id": "sn37.34:3.4",
          "pali": "Visārado vaḍḍhinā dasāti."
        },
        {
          "id": "sn37.34:3.5",
          "pali": "Mātugāmasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}