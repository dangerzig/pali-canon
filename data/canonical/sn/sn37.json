          "pali": "Sattamaṃ."
        }
      ]
    },
    {
      "id": "sn37.8",
      "segments": [
        {
          "id": "sn37.8:0.1",
          "pali": "Saṃyutta Nikāya 37.8"
        },
        {
          "id": "sn37.8:0.2",
          "pali": "1. Paṭhamapeyyālavagga"
        },
        {
          "id": "sn37.8:0.3",
          "pali": "Maccharīsutta"
        },
        {
          "id": "sn37.8:1.1",
          "pali": "“Pañcahi, anuruddha, dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjati."
        },
        {
          "id": "sn37.8:1.2",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.8:1.3",
          "pali": "Assaddho ca hoti, ahiriko ca hoti, anottappī ca hoti, maccharī ca hoti, duppañño ca hoti—"
        },
        {
          "id": "sn37.8:1.4",
          "pali": "imehi kho, anuruddha, pañcahi dhammehi samannāgato mātugāmo …pe…"
        },
        {
          "id": "sn37.8:1.5",
          "pali": "apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjatī”ti."
        },
        {
          "id": "sn37.8:1.6",
          "pali": "Aṭṭhamaṃ."
        }
      ]
    },
