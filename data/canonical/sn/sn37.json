          "pali": "Upanāhīsutta"
        },
        {
          "id": "sn37.6:1.1",
          "pali": "“Pañcahi, anuruddha, dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjati."
        },
        {
          "id": "sn37.6:1.2",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.6:1.3",
          "pali": "Assaddho ca hoti, ahiriko ca hoti, anottappī ca hoti, upanāhī ca hoti, duppañño ca hoti—"
        },
        {
          "id": "sn37.6:1.4",
          "pali": "imehi kho, anuruddha, pañcahi dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjatī”ti."
        },
        {
          "id": "sn37.6:1.5",
          "pali": "Chaṭṭhaṃ."
        }
      ]
    },
    {
      "id": "sn37.7",
      "segments": [
        {
          "id": "sn37.7:0.1",
          "pali": "Saṃyutta Nikāya 37.7"
