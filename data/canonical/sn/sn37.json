{
  "id": "sn37",
  "name_pali": "Mātugāmasaṃyutta",
  "name_eng": "Women",
  "vagga": "Saḷāyatanavagga",
  "pts": "S iv 238–248",
  "suttas": [
    {
      "id": "sn37.1",
      "segments": [
        {
          "id": "sn37.1:0.1",
          "pali": "Saṃyutta Nikāya 37.1"
        },
        {
          "id": "sn37.1:0.2",
          "pali": "1. Paṭhamapeyyālavagga"
        },
        {
          "id": "sn37.1:0.3",
          "pali": "Mātugāmasutta"
        },
        {
          "id": "sn37.1:1.1",
          "pali": "“Pañcahi, bhikkhave, aṅgehi samannāgato mātugāmo ekantaamanāpo hoti purisassa."
        },
        {
          "id": "sn37.1:1.2",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.1:1.3",
          "pali": "Na ca rūpavā hoti, na ca bhogavā hoti, na ca sīlavā hoti, alaso ca hoti, pajañcassa na labhati—"
        },
        {
          "id": "sn37.1:1.4",
          "pali": "imehi kho, bhikkhave, pañcahi aṅgehi samannāgato mātugāmo ekantaamanāpo hoti purisassa."
        },
        {
          "id": "sn37.1:1.5",
          "pali": "Pañcahi, bhikkhave, aṅgehi samannāgato mātugāmo ekantamanāpo hoti purisassa."
        },
        {
          "id": "sn37.1:1.6",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.1:1.7",
          "pali": "Rūpavā ca hoti, bhogavā ca hoti, sīlavā ca hoti, dakkho ca hoti analaso, pajañcassa labhati—"
        },
        {
          "id": "sn37.1:1.8",
          "pali": "imehi kho, bhikkhave, pañcahi aṅgehi samannāgato mātugāmo ekantamanāpo hoti purisassā”ti."
        },
        {
          "id": "sn37.1:1.9",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn37.2",
      "segments": [
        {
          "id": "sn37.2:0.1",
          "pali": "Saṃyutta Nikāya 37.2"
        },
        {
          "id": "sn37.2:0.2",
          "pali": "1. Paṭhamapeyyālavagga"
        },
        {
          "id": "sn37.2:0.3",
          "pali": "Purisasutta"
        },
        {
          "id": "sn37.2:1.1",
          "pali": "“Pañcahi, bhikkhave, aṅgehi samannāgato puriso ekantaamanāpo hoti mātugāmassa."
        },
        {
          "id": "sn37.2:1.2",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.2:1.3",
          "pali": "Na ca rūpavā hoti, na ca bhogavā hoti, na ca sīlavā hoti, alaso ca hoti, pajañcassa na labhati—"
        },
        {
          "id": "sn37.2:1.4",
          "pali": "imehi kho, bhikkhave, pañcahi aṅgehi samannāgato puriso ekantaamanāpo hoti mātugāmassa."
        },
        {
          "id": "sn37.2:1.5",
          "pali": "Pañcahi, bhikkhave, aṅgehi samannāgato puriso ekantamanāpo hoti mātugāmassa."
        },
        {
          "id": "sn37.2:1.6",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.2:1.7",
          "pali": "Rūpavā ca hoti, bhogavā ca hoti, sīlavā ca hoti, dakkho ca hoti analaso, pajañcassa labhati—"
        },
        {
          "id": "sn37.2:1.8",
          "pali": "imehi kho, bhikkhave, pañcahi aṅgehi samannāgato puriso ekantamanāpo hoti mātugāmassā”ti."
        },
        {
          "id": "sn37.2:1.9",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn37.3",
      "segments": [
        {
          "id": "sn37.3:0.1",
          "pali": "Saṃyutta Nikāya 37.3"
        },
        {
          "id": "sn37.3:0.2",
          "pali": "1. Paṭhamapeyyālavagga"
        },
        {
          "id": "sn37.3:0.3",
          "pali": "Āveṇikadukkhasutta"
        },
        {
          "id": "sn37.3:1.1",
          "pali": "“Pañcimāni, bhikkhave, mātugāmassa āveṇikāni dukkhāni, yāni mātugāmo paccanubhoti, aññatreva purisehi."
        },
        {
          "id": "sn37.3:1.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn37.3:1.3",
          "pali": "Idha, bhikkhave, mātugāmo daharova samāno patikulaṃ gacchati, ñātakehi vinā hoti."
        },
        {
          "id": "sn37.3:1.4",
          "pali": "Idaṃ, bhikkhave, mātugāmassa paṭhamaṃ āveṇikaṃ dukkhaṃ, yaṃ mātugāmo paccanubhoti, aññatreva purisehi."
        },
        {
          "id": "sn37.3:1.5",
          "pali": "Puna caparaṃ, bhikkhave, mātugāmo utunī hoti."
        },
        {
          "id": "sn37.3:1.6",
          "pali": "Idaṃ, bhikkhave, mātugāmassa dutiyaṃ āveṇikaṃ dukkhaṃ, yaṃ mātugāmo paccanubhoti, aññatreva purisehi."
        },
        {
          "id": "sn37.3:1.7",
          "pali": "Puna caparaṃ, bhikkhave, mātugāmo gabbhinī hoti."
        },
        {
          "id": "sn37.3:1.8",
          "pali": "Idaṃ, bhikkhave, mātugāmassa tatiyaṃ āveṇikaṃ dukkhaṃ, yaṃ mātugāmo paccanubhoti, aññatreva purisehi."
        },
        {
          "id": "sn37.3:1.9",
          "pali": "Puna caparaṃ, bhikkhave, mātugāmo vijāyati."
        },
        {
          "id": "sn37.3:1.10",
          "pali": "Idaṃ, bhikkhave, mātugāmassa catutthaṃ āveṇikaṃ dukkhaṃ, yaṃ mātugāmo paccanubhoti, aññatreva purisehi."
        },
        {
          "id": "sn37.3:1.11",
          "pali": "Puna caparaṃ, bhikkhave, mātugāmo purisassa pāricariyaṃ upeti."
        },
        {
          "id": "sn37.3:1.12",
          "pali": "Idaṃ kho, bhikkhave, mātugāmassa pañcamaṃ āveṇikaṃ dukkhaṃ, yaṃ mātugāmo paccanubhoti, aññatreva purisehi."
        },
        {
          "id": "sn37.3:1.13",
          "pali": "Imāni kho, bhikkhave, pañca mātugāmassa āveṇikāni dukkhāni, yāni mātugāmo paccanubhoti, aññatreva purisehī”ti."
        },
        {
          "id": "sn37.3:1.14",
          "pali": "Tatiyaṃ."
        }
      ]
    },
    {
      "id": "sn37.4",
      "segments": [
        {
          "id": "sn37.4:0.1",
          "pali": "Saṃyutta Nikāya 37.4"
        },
        {
          "id": "sn37.4:0.2",
          "pali": "1. Paṭhamapeyyālavagga"
        },
        {
          "id": "sn37.4:0.3",
          "pali": "Tīhidhammehisutta"
        },
        {
          "id": "sn37.4:1.1",
          "pali": "“Tīhi, bhikkhave, dhammehi samannāgato mātugāmo yebhuyyena kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjati."
        },
        {
          "id": "sn37.4:1.2",
          "pali": "Katamehi tīhi?"
        },
        {
          "id": "sn37.4:1.3",
          "pali": "Idha, bhikkhave, mātugāmo pubbaṇhasamayaṃ maccheramalapariyuṭṭhitena cetasā agāraṃ ajjhāvasati."
        },
        {
          "id": "sn37.4:1.4",
          "pali": "Majjhanhikasamayaṃ issāpariyuṭṭhitena cetasā agāraṃ ajjhāvasati."
        },
        {
          "id": "sn37.4:1.5",
          "pali": "Sāyanhasamayaṃ kāmarāgapariyuṭṭhitena cetasā agāraṃ ajjhāvasati."
        },
        {
          "id": "sn37.4:1.6",
          "pali": "Imehi kho, bhikkhave, tīhi dhammehi samannāgato mātugāmo yebhuyyena kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjatī”ti."
        },
        {
          "id": "sn37.4:1.7",
          "pali": "Catutthaṃ."
        },
        {
          "id": "sn37.4:1.8",
          "pali": "(…)"
        }
      ]
    },
    {
      "id": "sn37.5",
      "segments": [
        {
          "id": "sn37.5:0.1",
          "pali": "Saṃyutta Nikāya 37.5"
        },
        {
          "id": "sn37.5:0.2",
          "pali": "1. Paṭhamapeyyālavagga"
        },
        {
          "id": "sn37.5:0.3",
          "pali": "Kodhanasutta"
        },
        {
          "id": "sn37.5:1.1",
          "pali": "Atha kho āyasmā anuruddho yena bhagavā tenupasaṅkami; upasaṅkamitvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho āyasmā anuruddho bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn37.5:1.2",
          "pali": "“idhāhaṃ, bhante, mātugāmaṃ passāmi dibbena cakkhunā visuddhena atikkantamānusakena kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjantaṃ."
        },
        {
          "id": "sn37.5:1.3",
          "pali": "Katīhi nu kho, bhante, dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjatī”ti?"
        },
        {
          "id": "sn37.5:2.1",
          "pali": "“Pañcahi kho, anuruddha, dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjati."
        },
        {
          "id": "sn37.5:2.2",
          "pali": "Katamehi pañcahi?"
        },
        {
          "id": "sn37.5:2.3",
          "pali": "Assaddho ca hoti, ahiriko ca hoti, anottappī ca hoti, kodhano ca hoti, duppañño ca hoti—"
        },
        {
          "id": "sn37.5:2.4",
          "pali": "imehi kho, anuruddha, pañcahi dhammehi samannāgato mātugāmo kāyassa bhedā paraṃ maraṇā apāyaṃ duggatiṃ vinipātaṃ nirayaṃ upapajjatī”ti."
        },
        {
          "id": "sn37.5:2.5",
          "pali": "Pañcamaṃ."
        }
      ]
    },
    {
      "id": "sn37.6",
      "segments": [
        {
          "id": "sn37.6:0.1",
          "pali": "Saṃyutta Nikāya 37.6"
        },
        {
          "id": "sn37.6:0.2",
          "pali": "1. Paṭhamapeyyālavagga"
        },
