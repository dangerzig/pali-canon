{
  "id": "sn10",
  "name_pali": "Yakkhasaṃyutta",
  "name_eng": "Yakkhas",
  "vagga": "Sagāthāvagga",
  "pts": "S i 206–215",
  "suttas": [
    {
      "id": "sn10.1",
      "segments": [
        {
          "id": "sn10.1:0.1",
          "pali": "Saṃyutta Nikāya 10.1"
        },
        {
          "id": "sn10.1:0.2",
          "pali": "1. Indakavagga"
        },
        {
          "id": "sn10.1:0.3",
          "pali": "Indakasutta"
        },
        {
          "id": "sn10.1:1.1",
          "pali": "Evaṃ me sutaṃ—"
        },
        {
          "id": "sn10.1:1.2",
          "pali": "ekaṃ samayaṃ bhagavā rājagahe viharati indakūṭe pabbate, indakassa yakkhassa bhavane."
        },
        {
          "id": "sn10.1:1.3",
          "pali": "Atha kho indako yakkho yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn10.1:2.1",
          "pali": "“Rūpaṃ na jīvanti vadanti buddhā,"
        },
        {
          "id": "sn10.1:2.2",
          "pali": "Kathaṃ nvayaṃ vindatimaṃ sarīraṃ;"
        },
        {
          "id": "sn10.1:2.3",
          "pali": "Kutassa aṭṭhīyakapiṇḍameti,"
        },
        {
          "id": "sn10.1:2.4",
          "pali": "Kathaṃ nvayaṃ sajjati gabbharasmin”ti."
        },
        {
          "id": "sn10.1:3.1",
          "pali": "“Paṭhamaṃ kalalaṃ hoti,"
        },
        {
          "id": "sn10.1:3.2",
          "pali": "kalalā hoti abbudaṃ;"
        },
        {
          "id": "sn10.1:3.3",
          "pali": "Abbudā jāyate pesi,"
        },
        {
          "id": "sn10.1:3.4",
          "pali": "pesi nibbattatī ghano;"
        },
        {
          "id": "sn10.1:3.5",
          "pali": "Ghanā pasākhā jāyanti,"
        },
        {
          "id": "sn10.1:3.6",
          "pali": "kesā lomā nakhāpi ca."
        },
        {
          "id": "sn10.1:4.1",
          "pali": "Yañcassa bhuñjatī mātā,"
        },
        {
          "id": "sn10.1:4.2",
          "pali": "annaṃ pānañca bhojanaṃ;"
        },
        {
          "id": "sn10.1:4.3",
          "pali": "Tena so tattha yāpeti,"
        },
        {
          "id": "sn10.1:4.4",
          "pali": "mātukucchigato naro”ti."
        }
      ]
    },
    {
      "id": "sn10.2",
      "segments": [
        {
          "id": "sn10.2:0.1",
          "pali": "Saṃyutta Nikāya 10.2"
        },
        {
          "id": "sn10.2:0.2",
          "pali": "1. Indakavagga"
        },
        {
          "id": "sn10.2:0.3",
          "pali": "Sakkanāmasutta"
        },
        {
          "id": "sn10.2:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā rājagahe viharati gijjhakūṭe pabbate."
        },
        {
          "id": "sn10.2:1.2",
          "pali": "Atha kho sakkanāmako yakkho yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn10.2:2.1",
          "pali": "“Sabbaganthappahīnassa,"
        },
        {
          "id": "sn10.2:2.2",
          "pali": "vippamuttassa te sato;"
        },
        {
          "id": "sn10.2:2.3",
          "pali": "Samaṇassa na taṃ sādhu,"
        },
        {
          "id": "sn10.2:2.4",
          "pali": "yadaññamanusāsasī”ti."
        },
        {
          "id": "sn10.2:3.1",
          "pali": "“Yena kenaci vaṇṇena,"
        },
        {
          "id": "sn10.2:3.2",
          "pali": "saṃvāso sakka jāyati;"
        },
        {
          "id": "sn10.2:3.3",
          "pali": "Na taṃ arahati sappañño,"
        },
        {
          "id": "sn10.2:3.4",
          "pali": "manasā anukampituṃ."
        },
        {
          "id": "sn10.2:4.1",
          "pali": "Manasā ce pasannena,"
        },
        {
          "id": "sn10.2:4.2",
          "pali": "yadaññamanusāsati;"
        },
        {
          "id": "sn10.2:4.3",
          "pali": "Na tena hoti saṃyutto,"
        },
        {
          "id": "sn10.2:4.4",
          "pali": "yānukampā anuddayā”ti."
        }
      ]
    },
    {
      "id": "sn10.3",
      "segments": [
        {
          "id": "sn10.3:0.1",
          "pali": "Saṃyutta Nikāya 10.3"
        },
        {
          "id": "sn10.3:0.2",
          "pali": "1. Indakavagga"
        },
        {
          "id": "sn10.3:0.3",
          "pali": "Sūcilomasutta"
        },
        {
          "id": "sn10.3:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā gayāyaṃ viharati ṭaṅkitamañce sūcilomassa yakkhassa bhavane."
        },
        {
          "id": "sn10.3:1.2",
          "pali": "Tena kho pana samayena kharo ca yakkho sūcilomo ca yakkho bhagavato avidūre atikkamanti."
        },
        {
          "id": "sn10.3:1.3",
          "pali": "Atha kho kharo yakkho sūcilomaṃ yakkhaṃ etadavoca:"
        },
        {
          "id": "sn10.3:1.4",
          "pali": "“eso samaṇo”ti."
        },
        {
          "id": "sn10.3:1.5",
          "pali": "“Neso samaṇo, samaṇako eso."
        },
        {
          "id": "sn10.3:1.6",
          "pali": "Yāva jānāmi yadi vā so samaṇo yadi vā pana so samaṇako”ti."
        },
        {
          "id": "sn10.3:2.1",
          "pali": "Atha kho sūcilomo yakkho yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavato kāyaṃ upanāmesi."
        },
        {
          "id": "sn10.3:2.2",
          "pali": "Atha kho bhagavā kāyaṃ apanāmesi."
        },
        {
          "id": "sn10.3:2.3",
          "pali": "Atha kho sūcilomo yakkho bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn10.3:2.4",
          "pali": "“bhāyasi maṃ, samaṇā”ti?"
        },
        {
          "id": "sn10.3:2.5",
          "pali": "“Na khvāhaṃ taṃ, āvuso, bhāyāmi;"
        },
        {
          "id": "sn10.3:2.6",
          "pali": "api ca te samphasso pāpako”ti."
        },
        {
          "id": "sn10.3:2.7",
          "pali": "“Pañhaṃ taṃ, samaṇa, pucchissāmi."
        },
        {
          "id": "sn10.3:2.8",
          "pali": "Sace me na byākarissasi, cittaṃ vā te khipissāmi, hadayaṃ vā te phālessāmi, pādesu vā gahetvā pāragaṅgāya khipissāmī”ti."
        },
        {
          "id": "sn10.3:2.9",
          "pali": "“Na khvāhaṃ taṃ, āvuso, passāmi sadevake loke samārake sabrahmake sassamaṇabrāhmaṇiyā pajāya sadevamanussāya, yo me cittaṃ vā khipeyya hadayaṃ vā phāleyya pādesu vā gahetvā pāragaṅgāya khipeyya;"
        },
        {
          "id": "sn10.3:2.10",
          "pali": "api ca tvaṃ, āvuso, puccha yadā kaṅkhasī”ti. (…)"
        },
        {
          "id": "sn10.3:3.1",
          "pali": "“Rāgo ca doso ca kutonidānā,"
        },
        {
          "id": "sn10.3:3.2",
          "pali": "Aratī ratī lomahaṃso kutojā;"
        },
        {
          "id": "sn10.3:3.3",
          "pali": "Kuto samuṭṭhāya manovitakkā,"
        },
        {
          "id": "sn10.3:3.4",
          "pali": "Kumārakā dhaṅkamivossajantī”ti."
        },
        {
          "id": "sn10.3:4.1",
          "pali": "“Rāgo ca doso ca itonidānā,"
        },
        {
          "id": "sn10.3:4.2",
          "pali": "Aratī ratī lomahaṃso itojā;"
        },
        {
          "id": "sn10.3:4.3",
          "pali": "Ito samuṭṭhāya manovitakkā,"
        },
        {
          "id": "sn10.3:4.4",
          "pali": "Kumārakā dhaṅkamivossajanti."
        },
        {
          "id": "sn10.3:5.1",
          "pali": "Snehajā attasambhūtā,"
        },
        {
          "id": "sn10.3:5.2",
          "pali": "nigrodhasseva khandhajā;"
        },
        {
          "id": "sn10.3:5.3",
          "pali": "Puthū visattā kāmesu,"
        },
        {
          "id": "sn10.3:5.4",
          "pali": "māluvāva vitatā vane."
        },
        {
          "id": "sn10.3:6.1",
          "pali": "Ye naṃ pajānanti yatonidānaṃ,"
        },
        {
          "id": "sn10.3:6.2",
          "pali": "Te naṃ vinodenti suṇohi yakkha;"
        },
        {
          "id": "sn10.3:6.3",
          "pali": "Te duttaraṃ oghamimaṃ taranti,"
        },
        {
          "id": "sn10.3:6.4",
          "pali": "Atiṇṇapubbaṃ apunabbhavāyā”ti."
        }
      ]
    },
    {
      "id": "sn10.4",
      "segments": [
        {
          "id": "sn10.4:0.1",
          "pali": "Saṃyutta Nikāya 10.4"
        },
        {
          "id": "sn10.4:0.2",
          "pali": "1. Indakavagga"
        },
        {
          "id": "sn10.4:0.3",
          "pali": "Maṇibhaddasutta"
        },
        {
          "id": "sn10.4:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā magadhesu viharati maṇimālike cetiye maṇibhaddassa yakkhassa bhavane."
        },
        {
          "id": "sn10.4:1.2",
          "pali": "Atha kho maṇibhaddo yakkho yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavato santike imaṃ gāthaṃ abhāsi:"
        },
        {
          "id": "sn10.4:2.1",
          "pali": "“Satīmato sadā bhaddaṃ,"
        },
        {
          "id": "sn10.4:2.2",
          "pali": "satimā sukhamedhati;"
        },
        {
          "id": "sn10.4:2.3",
          "pali": "Satīmato suve seyyo,"
        },
        {
          "id": "sn10.4:2.4",
          "pali": "verā ca parimuccatī”ti."
        },
        {
          "id": "sn10.4:3.1",
          "pali": "“Satīmato sadā bhaddaṃ,"
        },
        {
          "id": "sn10.4:3.2",
          "pali": "satimā sukhamedhati;"
        },
        {
          "id": "sn10.4:3.3",
          "pali": "Satīmato suve seyyo,"
        },
        {
          "id": "sn10.4:3.4",
          "pali": "verā na parimuccati."
        },
        {
          "id": "sn10.4:4.1",
          "pali": "Yassa sabbamahorattaṃ,"
        },
        {
          "id": "sn10.4:4.2",
          "pali": "ahiṃsāya rato mano;"
        },
        {
          "id": "sn10.4:4.3",
          "pali": "Mettaṃso sabbabhūtesu,"
        },
        {
          "id": "sn10.4:4.4",
          "pali": "veraṃ tassa na kenacī”ti."
        }
      ]
    },
    {
      "id": "sn10.5",
      "segments": [
        {
          "id": "sn10.5:0.1",
          "pali": "Saṃyutta Nikāya 10.5"
        },
        {
          "id": "sn10.5:0.2",
          "pali": "1. Indakavagga"
        },
        {
          "id": "sn10.5:0.3",
          "pali": "Sānusutta"
        },
        {
          "id": "sn10.5:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
        },
        {
          "id": "sn10.5:1.2",
          "pali": "Tena kho pana samayena aññatarissā upāsikāya sānu nāma putto yakkhena gahito hoti."
        },
        {
          "id": "sn10.5:1.3",
          "pali": "Atha kho sā upāsikā paridevamānā tāyaṃ velāyaṃ imā gāthāyo abhāsi:"
        },
        {
          "id": "sn10.5:2.1",
          "pali": "“Cātuddasiṃ pañcadasiṃ,"
        },
        {
          "id": "sn10.5:2.2",
          "pali": "yā ca pakkhassa aṭṭhamī;"
        },
        {
          "id": "sn10.5:2.3",
          "pali": "Pāṭihāriyapakkhañca,"
        },
        {
          "id": "sn10.5:2.4",
          "pali": "aṭṭhaṅgasusamāgataṃ."
        },
        {
          "id": "sn10.5:3.1",
          "pali": "Uposathaṃ upavasanti,"
        },
        {
          "id": "sn10.5:3.2",
          "pali": "brahmacariyaṃ caranti ye;"
        },
        {
          "id": "sn10.5:3.3",
          "pali": "Na tehi yakkhā kīḷanti,"
        },
        {
          "id": "sn10.5:3.4",
          "pali": "iti me arahataṃ sutaṃ;"
        },
        {
          "id": "sn10.5:3.5",
          "pali": "Sā dāni ajja passāmi,"
        },
        {
          "id": "sn10.5:3.6",
          "pali": "yakkhā kīḷanti sānunā”ti."
        },
        {
          "id": "sn10.5:4.1",
          "pali": "“Cātuddasiṃ pañcadasiṃ,"
        },
        {
          "id": "sn10.5:4.2",
          "pali": "yā ca pakkhassa aṭṭhamī;"
        },
        {
          "id": "sn10.5:4.3",
          "pali": "Pāṭihāriyapakkhañca,"
        },
        {
          "id": "sn10.5:4.4",
          "pali": "aṭṭhaṅgasusamāgataṃ;"
        },
        {
          "id": "sn10.5:5.1",
          "pali": "Uposathaṃ upavasanti,"
        },
        {
          "id": "sn10.5:5.2",
          "pali": "brahmacariyaṃ caranti ye."
        },
        {
          "id": "sn10.5:5.3",
          "pali": "Na tehi yakkhā kīḷanti,"
        },
        {
          "id": "sn10.5:5.4",
          "pali": "sāhu te arahataṃ sutaṃ;"
        },
        {
          "id": "sn10.5:6.1",
          "pali": "Sānuṃ pabuddhaṃ vajjāsi,"
        },
        {
          "id": "sn10.5:6.2",
          "pali": "yakkhānaṃ vacanaṃ idaṃ;"
        },
        {
          "id": "sn10.5:6.3",
          "pali": "Mākāsi pāpakaṃ kammaṃ,"
        },
        {
          "id": "sn10.5:6.4",
          "pali": "āvi vā yadi vā raho."
        },
        {
          "id": "sn10.5:7.1",
          "pali": "Sace ca pāpakaṃ kammaṃ,"
        },
        {
          "id": "sn10.5:7.2",
          "pali": "karissasi karosi vā;"
        },
        {
          "id": "sn10.5:7.3",
          "pali": "Na te dukkhā pamutyatthi,"
        },
        {
          "id": "sn10.5:7.4",
          "pali": "uppaccāpi palāyato”ti."
        },
        {
          "id": "sn10.5:8.1",
          "pali": "“Mataṃ vā amma rodanti,"
        },
        {
          "id": "sn10.5:8.2",
          "pali": "yo vā jīvaṃ na dissati;"
        },
        {
          "id": "sn10.5:8.3",
          "pali": "Jīvantaṃ amma passantī,"
        },
        {
          "id": "sn10.5:8.4",
          "pali": "kasmā maṃ amma rodasī”ti."
        },
        {
          "id": "sn10.5:9.1",
          "pali": "“Mataṃ vā putta rodanti,"
        },
        {
          "id": "sn10.5:9.2",
          "pali": "yo vā jīvaṃ na dissati;"
        },
        {
          "id": "sn10.5:9.3",
          "pali": "Yo ca kāme cajitvāna,"
        },
        {
          "id": "sn10.5:9.4",
          "pali": "punarāgacchate idha;"
        },
        {
          "id": "sn10.5:9.5",
          "pali": "Taṃ vāpi putta rodanti,"
        },
        {
          "id": "sn10.5:9.6",
          "pali": "puna jīvaṃ mato hi so."
        },
        {
          "id": "sn10.5:10.1",
          "pali": "Kukkuḷā ubbhato tāta,"
        },
        {
          "id": "sn10.5:10.2",
          "pali": "kukkuḷaṃ patitumicchasi;"
        },
        {
          "id": "sn10.5:10.3",
          "pali": "Narakā ubbhato tāta,"
        },
        {
          "id": "sn10.5:10.4",
          "pali": "narakaṃ patitumicchasi."
        },
        {
          "id": "sn10.5:11.1",
          "pali": "Abhidhāvatha bhaddante,"
        },
        {
          "id": "sn10.5:11.2",
          "pali": "kassa ujjhāpayāmase;"
        },
        {
          "id": "sn10.5:11.3",
          "pali": "Ādittā nīhataṃ bhaṇḍaṃ,"
        },
        {
          "id": "sn10.5:11.4",
          "pali": "puna ḍayhitumicchasī”ti."
        }
      ]
    },
    {
      "id": "sn10.6",
      "segments": [
        {
          "id": "sn10.6:0.1",
          "pali": "Saṃyutta Nikāya 10.6"
        },
        {
          "id": "sn10.6:0.2",
          "pali": "1. Indakavagga"
        },
        {
          "id": "sn10.6:0.3",
          "pali": "Piyaṅkarasutta"
        },
        {
          "id": "sn10.6:1.1",
          "pali": "Ekaṃ samayaṃ āyasmā anuruddho sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
        },
        {
          "id": "sn10.6:1.2",
          "pali": "Tena kho pana samayena āyasmā anuruddho rattiyā paccūsasamayaṃ paccuṭṭhāya dhammapadāni bhāsati."
        },
        {
          "id": "sn10.6:1.3",
          "pali": "Atha kho piyaṅkaramātā yakkhinī puttakaṃ evaṃ tosesi:"
        },
        {
          "id": "sn10.6:2.1",
          "pali": "“Mā saddaṃ kari piyaṅkara,"
        },
        {
          "id": "sn10.6:2.2",
          "pali": "Bhikkhu dhammapadāni bhāsati;"
        },
        {
          "id": "sn10.6:2.3",
          "pali": "Api ca dhammapadaṃ vijāniya,"
        },
        {
          "id": "sn10.6:2.4",
          "pali": "Paṭipajjema hitāya no siyā."
        },
        {
          "id": "sn10.6:3.1",
          "pali": "Pāṇesu ca saṃyamāmase,"
        },
        {
          "id": "sn10.6:3.2",
          "pali": "Sampajānamusā na bhaṇāmase;"
        },
        {
          "id": "sn10.6:3.3",
          "pali": "Sikkhema susīlyamattano,"
        },
        {
          "id": "sn10.6:3.4",
          "pali": "Api muccema pisācayoniyā”ti."
        }
      ]
    },
    {
      "id": "sn10.7",
      "segments": [
        {
          "id": "sn10.7:0.1",
          "pali": "Saṃyutta Nikāya 10.7"
        },
        {
          "id": "sn10.7:0.2",
          "pali": "1. Indakavagga"
        },
        {
          "id": "sn10.7:0.3",
          "pali": "Punabbasusutta"
        },
        {
          "id": "sn10.7:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
        },
        {
          "id": "sn10.7:1.2",
          "pali": "Tena kho pana samayena bhagavā bhikkhū nibbānapaṭisaṃyuttāya dhammiyā kathāya sandasseti samādapeti samuttejeti sampahaṃseti."
        },
        {
          "id": "sn10.7:1.3",
          "pali": "Te ca bhikkhū aṭṭhiṃ katvā manasi katvā sabbacetasā samannāharitvā ohitasotā dhammaṃ suṇanti."
        },
        {
          "id": "sn10.7:1.4",
          "pali": "Atha kho punabbasumātā yakkhinī puttake evaṃ tosesi:"
        },
        {
          "id": "sn10.7:2.1",
          "pali": "“Tuṇhī uttarike hohi,"
        },
        {
          "id": "sn10.7:2.2",
          "pali": "tuṇhī hohi punabbasu;"
        },
        {
          "id": "sn10.7:2.3",
          "pali": "Yāvāhaṃ buddhaseṭṭhassa,"
        },
        {
          "id": "sn10.7:2.4",
          "pali": "dhammaṃ sossāmi satthuno."
        },
        {
          "id": "sn10.7:3.1",
          "pali": "Nibbānaṃ bhagavā āha,"
        },
        {
          "id": "sn10.7:3.2",
          "pali": "sabbaganthappamocanaṃ;"
        },
        {
          "id": "sn10.7:3.3",
          "pali": "Ativelā ca me hoti,"
        },
        {
          "id": "sn10.7:3.4",
          "pali": "asmiṃ dhamme piyāyanā."
        },
        {
          "id": "sn10.7:4.1",
          "pali": "Piyo loke sako putto,"
        },
        {
          "id": "sn10.7:4.2",
          "pali": "piyo loke sako pati;"
        },
        {
          "id": "sn10.7:4.3",
          "pali": "Tato piyatarā mayhaṃ,"
        },
        {
          "id": "sn10.7:4.4",
          "pali": "assa dhammassa magganā."
        },
        {
          "id": "sn10.7:5.1",
          "pali": "Na hi putto pati vāpi,"
        },
        {
          "id": "sn10.7:5.2",
          "pali": "piyo dukkhā pamocaye;"
        },
        {
          "id": "sn10.7:5.3",
          "pali": "Yathā saddhammassavanaṃ,"
        },
        {
          "id": "sn10.7:5.4",
          "pali": "dukkhā moceti pāṇinaṃ."
        },
        {
          "id": "sn10.7:6.1",
          "pali": "Loke dukkhaparetasmiṃ,"
        },
        {
          "id": "sn10.7:6.2",
          "pali": "Jarāmaraṇasaṃyute;"
        },
        {
          "id": "sn10.7:6.3",
          "pali": "Jarāmaraṇamokkhāya,"
        },
        {
          "id": "sn10.7:6.4",
          "pali": "Yaṃ dhammaṃ abhisambudhaṃ;"
        },
        {
          "id": "sn10.7:6.5",
          "pali": "Taṃ dhammaṃ sotumicchāmi,"
        },
        {
          "id": "sn10.7:6.6",
          "pali": "Tuṇhī hohi punabbasū”ti."
        },
        {
          "id": "sn10.7:7.1",
          "pali": "“Ammā na byāharissāmi,"
        },
        {
          "id": "sn10.7:7.2",
          "pali": "tuṇhībhūtāyamuttarā;"
        },
        {
          "id": "sn10.7:7.3",
          "pali": "Dhammameva nisāmehi,"
        },
        {
          "id": "sn10.7:7.4",
          "pali": "saddhammassavanaṃ sukhaṃ;"
        },
        {
          "id": "sn10.7:7.5",
          "pali": "Saddhammassa anaññāya,"
        },
        {
          "id": "sn10.7:7.6",
          "pali": "ammā dukkhaṃ carāmase."
        },
        {
          "id": "sn10.7:8.1",
          "pali": "Esa devamanussānaṃ,"
        },
        {
          "id": "sn10.7:8.2",
          "pali": "sammūḷhānaṃ pabhaṅkaro;"
        },
        {
          "id": "sn10.7:8.3",
          "pali": "Buddho antimasārīro,"
        },
        {
          "id": "sn10.7:8.4",
          "pali": "dhammaṃ deseti cakkhumā”ti."
        },
        {
          "id": "sn10.7:9.1",
          "pali": "“Sādhu kho paṇḍito nāma,"
        },
        {
          "id": "sn10.7:9.2",
          "pali": "putto jāto uresayo;"
        },
        {
          "id": "sn10.7:9.3",
          "pali": "Putto me buddhaseṭṭhassa,"
        },
        {
          "id": "sn10.7:9.4",
          "pali": "dhammaṃ suddhaṃ piyāyati."
        },
        {
          "id": "sn10.7:10.1",
          "pali": "Punabbasu sukhī hohi,"
        },
        {
          "id": "sn10.7:10.2",
          "pali": "ajjāhamhi samuggatā;"
        },
        {
          "id": "sn10.7:10.3",
          "pali": "Diṭṭhāni ariyasaccāni,"
        },
        {
          "id": "sn10.7:10.4",
          "pali": "uttarāpi suṇātu me”ti."
        }
      ]
    },
    {
      "id": "sn10.8",
      "segments": [
        {
          "id": "sn10.8:0.1",
          "pali": "Saṃyutta Nikāya 10.8"
        },
        {
          "id": "sn10.8:0.2",
          "pali": "1. Indakavagga"
        },
        {
          "id": "sn10.8:0.3",
          "pali": "Sudattasutta"
        },
        {
          "id": "sn10.8:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā rājagahe viharati sītavane."
        },
        {
          "id": "sn10.8:1.2",
          "pali": "Tena kho pana samayena anāthapiṇḍiko gahapati rājagahaṃ anuppatto hoti kenacideva karaṇīyena."
        },
        {
          "id": "sn10.8:1.3",
          "pali": "Assosi kho anāthapiṇḍiko gahapati:"
        },
        {
          "id": "sn10.8:1.4",
          "pali": "“buddho kira loke uppanno”ti."
        },
        {
          "id": "sn10.8:1.5",
          "pali": "Tāvadeva ca pana bhagavantaṃ dassanāya upasaṅkamitukāmo hoti. Athassa anāthapiṇḍikassa gahapatissa etadahosi:"
        },
        {
          "id": "sn10.8:1.6",
          "pali": "“akālo kho ajja bhagavantaṃ dassanāya upasaṅkamituṃ."
        },
        {
          "id": "sn10.8:1.7",
          "pali": "Sve dānāhaṃ kālena bhagavantaṃ dassanāya gamissāmī”ti buddhagatāya satiyā nipajji."
        },
        {
          "id": "sn10.8:1.8",
          "pali": "Rattiyā sudaṃ tikkhattuṃ vuṭṭhāsi pabhātanti maññamāno."
        },
        {
          "id": "sn10.8:1.9",
          "pali": "Atha kho anāthapiṇḍiko gahapati yena sivathikadvāraṃ tenupasaṅkami."
        },
        {
          "id": "sn10.8:1.10",
          "pali": "Amanussā dvāraṃ vivariṃsu."
        },
        {
          "id": "sn10.8:1.11",
          "pali": "Atha kho anāthapiṇḍikassa gahapatissa nagaramhā nikkhamantassa āloko antaradhāyi, andhakāro pāturahosi, bhayaṃ chambhitattaṃ lomahaṃso udapādi, tatova puna nivattitukāmo ahosi."
        },
        {
          "id": "sn10.8:1.12",
          "pali": "Atha kho sivako yakkho antarahito saddamanussāvesi:"
        },
        {
          "id": "sn10.8:2.1",
          "pali": "“Sataṃ hatthī sataṃ assā,"
        },
        {
          "id": "sn10.8:2.2",
          "pali": "Sataṃ assatarīrathā;"
        },
        {
          "id": "sn10.8:2.3",
          "pali": "Sataṃ kaññāsahassāni,"
        },
        {
          "id": "sn10.8:2.4",
          "pali": "Āmukkamaṇikuṇḍalā;"
        },
        {
          "id": "sn10.8:2.5",
          "pali": "Ekassa padavītihārassa,"
        },
        {
          "id": "sn10.8:2.6",
          "pali": "Kalaṃ nāgghanti soḷasiṃ."
        },
        {
          "id": "sn10.8:3.1",
          "pali": "Abhikkama gahapati,"
        },
        {
          "id": "sn10.8:3.2",
          "pali": "abhikkama gahapati;"
        },
        {
          "id": "sn10.8:3.3",
          "pali": "Abhikkamanaṃ te seyyo,"
        },
        {
          "id": "sn10.8:3.4",
          "pali": "no paṭikkamanan”ti."
        },
        {
          "id": "sn10.8:4.1",
          "pali": "Atha kho anāthapiṇḍikassa gahapatissa andhakāro antaradhāyi, āloko pāturahosi, yaṃ ahosi bhayaṃ chambhitattaṃ lomahaṃso, so paṭippassambhi."
        },
        {
          "id": "sn10.8:4.2",
          "pali": "Dutiyampi kho anāthapiṇḍikassa gahapatissa āloko antaradhāyi, andhakāro pāturahosi, bhayaṃ chambhitattaṃ lomahaṃso udapādi, tatova puna nivattitukāmo ahosi."
        },
        {
          "id": "sn10.8:4.3",
          "pali": "Dutiyampi kho sivako yakkho antarahito saddamanussāvesi:"
        },
        {
          "id": "sn10.8:5.1",
          "pali": "“Sataṃ hatthī sataṃ assā,"
        },
        {
          "id": "sn10.8:5.2",
          "pali": "…pe…"
        },
        {
          "id": "sn10.8:5.3",
          "pali": "Kalaṃ nāgghanti soḷasiṃ."
        },
        {
          "id": "sn10.8:6.1",
          "pali": "Abhikkama gahapati,"
        },
        {
          "id": "sn10.8:6.2",
          "pali": "abhikkama gahapati;"
        },
        {
          "id": "sn10.8:6.3",
          "pali": "Abhikkamanaṃ te seyyo,"
        },
        {
          "id": "sn10.8:6.4",
          "pali": "no paṭikkamanan”ti."
        },
        {
          "id": "sn10.8:7.1",
          "pali": "Atha kho anāthapiṇḍikassa gahapatissa andhakāro antaradhāyi, āloko pāturahosi, yaṃ ahosi bhayaṃ chambhitattaṃ lomahaṃso, so paṭippassambhi."
        },
        {
          "id": "sn10.8:7.2",
          "pali": "Tatiyampi kho anāthapiṇḍikassa gahapatissa āloko antaradhāyi, andhakāro pāturahosi, bhayaṃ chambhitattaṃ lomahaṃso udapādi, tatova puna nivattitukāmo ahosi."
        },
        {
          "id": "sn10.8:7.3",
          "pali": "Tatiyampi kho sivako yakkho antarahito saddamanussāvesi:"
        },
        {
          "id": "sn10.8:8.1",
          "pali": "“Sataṃ hatthī sataṃ assā,"
        },
        {
          "id": "sn10.8:8.2",
          "pali": "…pe…"
        },
        {
          "id": "sn10.8:8.3",
          "pali": "Kalaṃ nāgghanti soḷasiṃ."
        },
        {
          "id": "sn10.8:9.1",
          "pali": "Abhikkama gahapati,"
        },
        {
          "id": "sn10.8:9.2",
          "pali": "abhikkama gahapati;"
        },
        {
          "id": "sn10.8:9.3",
          "pali": "Abhikkamanaṃ te seyyo,"
        },
        {
          "id": "sn10.8:9.4",
          "pali": "no paṭikkamanan”ti."
        },
        {
          "id": "sn10.8:10.1",
          "pali": "Atha kho anāthapiṇḍikassa gahapatissa andhakāro antaradhāyi, āloko pāturahosi, yaṃ ahosi bhayaṃ chambhitattaṃ lomahaṃso, so paṭippassambhi."
        },
        {
          "id": "sn10.8:10.2",
          "pali": "Atha kho anāthapiṇḍiko gahapati yena sītavanaṃ yena bhagavā tenupasaṅkami."
        },
        {
          "id": "sn10.8:11.1",
          "pali": "Tena kho pana samayena bhagavā rattiyā paccūsasamayaṃ paccuṭṭhāya abbhokāse caṅkamati."
        },
        {
          "id": "sn10.8:11.2",
          "pali": "Addasā kho bhagavā anāthapiṇḍikaṃ gahapatiṃ dūratova āgacchantaṃ."
        },
        {
          "id": "sn10.8:11.3",
          "pali": "Disvāna caṅkamā orohitvā paññatte āsane nisīdi."
        },
        {
          "id": "sn10.8:11.4",
          "pali": "Nisajja kho bhagavā anāthapiṇḍikaṃ gahapatiṃ etadavoca:"
        },
        {
          "id": "sn10.8:11.5",
          "pali": "“ehi, sudattā”ti."
        },
        {
          "id": "sn10.8:11.6",
          "pali": "Atha kho anāthapiṇḍiko gahapati, nāmena maṃ bhagavā ālapatīti, haṭṭho udaggo tattheva bhagavato pādesu sirasā nipatitvā bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn10.8:11.7",
          "pali": "“kacci, bhante, bhagavā sukhamasayitthā”ti?"
        },
        {
          "id": "sn10.8:12.1",
          "pali": "“Sabbadā ve sukhaṃ seti,"
        },
        {
          "id": "sn10.8:12.2",
          "pali": "brāhmaṇo parinibbuto;"
        },
        {
          "id": "sn10.8:12.3",
          "pali": "Yo na limpati kāmesu,"
        },
        {
          "id": "sn10.8:12.4",
          "pali": "sītibhūto nirūpadhi."
        },
        {
          "id": "sn10.8:13.1",
          "pali": "Sabbā āsattiyo chetvā,"
        },
        {
          "id": "sn10.8:13.2",
          "pali": "vineyya hadaye daraṃ;"
        },
        {
          "id": "sn10.8:13.3",
          "pali": "Upasanto sukhaṃ seti,"
        },
        {
          "id": "sn10.8:13.4",
          "pali": "santiṃ pappuyya cetasā”ti."
        }
      ]
    },
    {
      "id": "sn10.9",
      "segments": [
        {
          "id": "sn10.9:0.1",
          "pali": "Saṃyutta Nikāya 10.9"
        },
        {
          "id": "sn10.9:0.2",
          "pali": "1. Indakavagga"
        },
        {
          "id": "sn10.9:0.3",
          "pali": "Paṭhamasukkāsutta"
        },
        {
          "id": "sn10.9:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā rājagahe viharati veḷuvane kalandakanivāpe."
        },
        {
          "id": "sn10.9:1.2",
          "pali": "Tena kho pana samayena sukkā bhikkhunī mahatiyā parisāya parivutā dhammaṃ deseti."
        },
        {
          "id": "sn10.9:1.3",
          "pali": "Atha kho sukkāya bhikkhuniyā abhippasanno yakkho rājagahe rathikāya rathikaṃ siṅghāṭakena siṅghāṭakaṃ upasaṅkamitvā tāyaṃ velāyaṃ imā gāthāyo abhāsi:"
        },
        {
          "id": "sn10.9:2.1",
          "pali": "“Kiṃ me katā rājagahe manussā,"
        },
        {
          "id": "sn10.9:2.2",
          "pali": "Madhupītāva seyare;"
        },
        {
          "id": "sn10.9:2.3",
          "pali": "Ye sukkaṃ na payirupāsanti,"
        },
        {
          "id": "sn10.9:2.4",
          "pali": "Desentiṃ amataṃ padaṃ."
        },
        {
          "id": "sn10.9:3.1",
          "pali": "Tañca pana appaṭivānīyaṃ,"
        },
        {
          "id": "sn10.9:3.2",
          "pali": "Asecanakamojavaṃ;"
        },
        {
          "id": "sn10.9:3.3",
          "pali": "Pivanti maññe sappaññā,"
        },
        {
          "id": "sn10.9:3.4",
          "pali": "Valāhakamiva panthagū”ti."
        }
      ]
    },
    {
      "id": "sn10.10",
      "segments": [
        {
          "id": "sn10.10:0.1",
          "pali": "Saṃyutta Nikāya 10.10"
        },
        {
          "id": "sn10.10:0.2",
          "pali": "1. Indakavagga"
        },
        {
          "id": "sn10.10:0.3",
          "pali": "Dutiyasukkāsutta"
        },
        {
          "id": "sn10.10:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā rājagahe viharati veḷuvane kalandakanivāpe."
        },
        {
          "id": "sn10.10:1.2",
          "pali": "Tena kho pana samayena aññataro upāsako sukkāya bhikkhuniyā bhojanaṃ adāsi."
        },
        {
          "id": "sn10.10:1.3",
          "pali": "Atha kho sukkāya bhikkhuniyā abhippasanno yakkho rājagahe rathikāya rathikaṃ siṅghāṭakena siṅghāṭakaṃ upasaṅkamitvā tāyaṃ velāyaṃ imaṃ gāthaṃ abhāsi:"
        },
        {
          "id": "sn10.10:2.1",
          "pali": "“Puññaṃ vata pasavi bahuṃ,"
        },
        {
          "id": "sn10.10:2.2",
          "pali": "Sappañño vatāyaṃ upāsako;"
        },
        {
          "id": "sn10.10:2.3",
          "pali": "Yo sukkāya adāsi bhojanaṃ,"
        },
        {
          "id": "sn10.10:2.4",
          "pali": "Sabbaganthehi vippamuttiyā”ti."
        }
      ]
    },
    {
      "id": "sn10.11",
      "segments": [
        {
          "id": "sn10.11:0.1",
          "pali": "Saṃyutta Nikāya 10.11"
        },
        {
          "id": "sn10.11:0.2",
          "pali": "1. Indakavagga"
        },
        {
          "id": "sn10.11:0.3",
          "pali": "Cīrāsutta"
        },
        {
          "id": "sn10.11:1.1",
          "pali": "Evaṃ me sutaṃ—"
        },
        {
          "id": "sn10.11:1.2",
          "pali": "ekaṃ samayaṃ bhagavā rājagahe viharati veḷuvane kalandakanivāpe."
        },
        {
          "id": "sn10.11:1.3",
          "pali": "Tena kho pana samayena aññataro upāsako cīrāya bhikkhuniyā cīvaraṃ adāsi."
        },
        {
          "id": "sn10.11:1.4",
          "pali": "Atha kho cīrāya bhikkhuniyā abhippasanno yakkho rājagahe rathikāya rathikaṃ siṅghāṭakena siṅghāṭakaṃ upasaṅkamitvā tāyaṃ velāyaṃ imaṃ gāthaṃ abhāsi:"
        },
        {
          "id": "sn10.11:2.1",
          "pali": "“Puññaṃ vata pasavi bahuṃ,"
        },
        {
          "id": "sn10.11:2.2",
          "pali": "Sappañño vatāyaṃ upāsako;"
        },
        {
          "id": "sn10.11:2.3",
          "pali": "Yo cīrāya adāsi cīvaraṃ,"
        },
        {
          "id": "sn10.11:2.4",
          "pali": "Sabbayogehi vippamuttiyā”ti."
        }
      ]
    },
    {
      "id": "sn10.12",
      "segments": [
        {
          "id": "sn10.12:0.1",
          "pali": "Saṃyutta Nikāya 10.12"
        },
        {
          "id": "sn10.12:0.2",
          "pali": "1. Indakavagga"
        },
        {
          "id": "sn10.12:0.3",
          "pali": "Āḷavakasutta"
        },
        {
          "id": "sn10.12:1.1",
          "pali": "Evaṃ me sutaṃ—"
        },
        {
          "id": "sn10.12:1.2",
          "pali": "ekaṃ samayaṃ bhagavā āḷaviyaṃ viharati āḷavakassa yakkhassa bhavane."
        },
        {
          "id": "sn10.12:1.3",
          "pali": "Atha kho āḷavako yakkho yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn10.12:1.4",
          "pali": "“nikkhama, samaṇā”ti."
        },
        {
          "id": "sn10.12:1.5",
          "pali": "“Sādhāvuso”ti bhagavā nikkhami."
        },
        {
          "id": "sn10.12:1.6",
          "pali": "“Pavisa, samaṇā”ti."
        },
        {
          "id": "sn10.12:1.7",
          "pali": "“Sādhāvuso”ti bhagavā pāvisi."
        },
        {
          "id": "sn10.12:1.8",
          "pali": "Dutiyampi kho āḷavako yakkho bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn10.12:1.9",
          "pali": "“nikkhama, samaṇā”ti."
        },
        {
          "id": "sn10.12:1.10",
          "pali": "“Sādhāvuso”ti bhagavā nikkhami."
        },
        {
          "id": "sn10.12:1.11",
          "pali": "“Pavisa, samaṇā”ti."
        },
        {
          "id": "sn10.12:1.12",
          "pali": "“Sādhāvuso”ti bhagavā pāvisi."
        },
        {
          "id": "sn10.12:1.13",
          "pali": "Tatiyampi kho āḷavako yakkho bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn10.12:1.14",
          "pali": "“nikkhama, samaṇā”ti."
        },
        {
          "id": "sn10.12:1.15",
          "pali": "“Sādhāvuso”ti bhagavā nikkhami."
        },
        {
          "id": "sn10.12:1.16",
          "pali": "“Pavisa, samaṇā”ti."
        },
        {
          "id": "sn10.12:1.17",
          "pali": "“Sādhāvuso”ti bhagavā pāvisi."
        },
        {
          "id": "sn10.12:1.18",
          "pali": "Catutthampi kho āḷavako yakkho bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn10.12:1.19",
          "pali": "“nikkhama, samaṇā”ti."
        },
        {
          "id": "sn10.12:1.20",
          "pali": "“Na khvāhaṃ taṃ, āvuso, nikkhamissāmi."
        },
        {
          "id": "sn10.12:1.21",
          "pali": "Yaṃ te karaṇīyaṃ taṃ karohī”ti."
        },
        {
          "id": "sn10.12:1.22",
          "pali": "“Pañhaṃ taṃ, samaṇa, pucchissāmi."
        },
        {
          "id": "sn10.12:1.23",
          "pali": "Sace me na byākarissasi, cittaṃ vā te khipissāmi, hadayaṃ vā te phālessāmi, pādesu vā gahetvā pāragaṅgāya khipissāmī”ti."
        },
        {
          "id": "sn10.12:1.24",
          "pali": "“Na khvāhaṃ taṃ, āvuso, passāmi sadevake loke samārake sabrahmake sassamaṇabrāhmaṇiyā pajāya sadevamanussāya, yo me cittaṃ vā khipeyya hadayaṃ vā phāleyya, pādesu vā gahetvā pāragaṅgāya khipeyya."
        },
        {
          "id": "sn10.12:1.25",
          "pali": "Api ca tvaṃ, āvuso, puccha yadā kaṅkhasī”ti (…)."
        },
        {
          "id": "sn10.12:2.1",
          "pali": "“Kiṃsūdha vittaṃ purisassa seṭṭhaṃ,"
        },
        {
          "id": "sn10.12:2.2",
          "pali": "Kiṃsu suciṇṇaṃ sukhamāvahāti;"
        },
        {
          "id": "sn10.12:2.3",
          "pali": "Kiṃsu have sādutaraṃ rasānaṃ,"
        },
        {
          "id": "sn10.12:2.4",
          "pali": "Kathaṃjīviṃ jīvitamāhu seṭṭhan”ti."
        },
        {
          "id": "sn10.12:3.1",
          "pali": "“Saddhīdha vittaṃ purisassa seṭṭhaṃ,"
        },
        {
          "id": "sn10.12:3.2",
          "pali": "Dhammo suciṇṇo sukhamāvahāti;"
        },
        {
          "id": "sn10.12:3.3",
          "pali": "Saccaṃ have sādutaraṃ rasānaṃ,"
        },
        {
          "id": "sn10.12:3.4",
          "pali": "Paññājīviṃ jīvitamāhu seṭṭhan”ti."
        },
        {
          "id": "sn10.12:4.1",
          "pali": "“Kathaṃsu tarati oghaṃ,"
        },
        {
          "id": "sn10.12:4.2",
          "pali": "kathaṃsu tarati aṇṇavaṃ;"
        },
        {
          "id": "sn10.12:4.3",
          "pali": "Kathaṃsu dukkhamacceti,"
        },
        {
          "id": "sn10.12:4.4",
          "pali": "kathaṃsu parisujjhatī”ti."
        },
        {
          "id": "sn10.12:5.1",
          "pali": "“Saddhāya tarati oghaṃ,"
        },
        {
          "id": "sn10.12:5.2",
          "pali": "appamādena aṇṇavaṃ;"
        },
        {
          "id": "sn10.12:5.3",
          "pali": "Vīriyena dukkhamacceti,"
        },
        {
          "id": "sn10.12:5.4",
          "pali": "paññāya parisujjhatī”ti."
        },
        {
          "id": "sn10.12:6.1",
          "pali": "“Kathaṃsu labhate paññaṃ,"
        },
        {
          "id": "sn10.12:6.2",
          "pali": "kathaṃsu vindate dhanaṃ;"
        },
        {
          "id": "sn10.12:6.3",
          "pali": "Kathaṃsu kittiṃ pappoti,"
        },
        {
          "id": "sn10.12:6.4",
          "pali": "kathaṃ mittāni ganthati;"
        },
        {
          "id": "sn10.12:6.5",
          "pali": "Asmā lokā paraṃ lokaṃ,"
        },
        {
          "id": "sn10.12:6.6",
          "pali": "kathaṃ pecca na socatī”ti."
        },
        {
          "id": "sn10.12:7.1",
          "pali": "“Saddahāno arahataṃ,"
        },
        {
          "id": "sn10.12:7.2",
          "pali": "dhammaṃ nibbānapattiyā;"
        },
        {
          "id": "sn10.12:7.3",
          "pali": "Sussūsaṃ labhate paññaṃ,"
        },
        {
          "id": "sn10.12:7.4",
          "pali": "appamatto vicakkhaṇo."
        },
        {
          "id": "sn10.12:8.1",
          "pali": "Patirūpakārī dhuravā,"
        },
        {
          "id": "sn10.12:8.2",
          "pali": "uṭṭhātā vindate dhanaṃ;"
        },
        {
          "id": "sn10.12:8.3",
          "pali": "Saccena kittiṃ pappoti,"
        },
        {
          "id": "sn10.12:8.4",
          "pali": "dadaṃ mittāni ganthati;"
        },
        {
          "id": "sn10.12:8.5",
          "pali": "Asmā lokā paraṃ lokaṃ,"
        },
        {
          "id": "sn10.12:8.6",
          "pali": "evaṃ pecca na socati."
        },
        {
          "id": "sn10.12:9.1",
          "pali": "Yassete caturo dhammā,"
        },
        {
          "id": "sn10.12:9.2",
          "pali": "saddhassa gharamesino;"
        },
        {
          "id": "sn10.12:9.3",
          "pali": "Saccaṃ dhammo dhiti cāgo,"
        },
        {
          "id": "sn10.12:9.4",
          "pali": "sa ve pecca na socati."
        },
        {
          "id": "sn10.12:10.1",
          "pali": "Iṅgha aññepi pucchassu,"
        },
        {
          "id": "sn10.12:10.2",
          "pali": "puthū samaṇabrāhmaṇe;"
        },
        {
          "id": "sn10.12:10.3",
          "pali": "Yadi saccā dhammā cāgā,"
        },
        {
          "id": "sn10.12:10.4",
          "pali": "khantyā bhiyyodha vijjatī”ti."
        },
        {
          "id": "sn10.12:11.1",
          "pali": "“Kathaṃ nu dāni puccheyyaṃ,"
        },
        {
          "id": "sn10.12:11.2",
          "pali": "puthū samaṇabrāhmaṇe;"
        },
        {
          "id": "sn10.12:11.3",
          "pali": "Yohaṃ ajja pajānāmi,"
        },
        {
          "id": "sn10.12:11.4",
          "pali": "yo attho samparāyiko."
        },
        {
          "id": "sn10.12:12.1",
          "pali": "Atthāya vata me buddho,"
        },
        {
          "id": "sn10.12:12.2",
          "pali": "vāsāyāḷavimāgamā;"
        },
        {
          "id": "sn10.12:12.3",
          "pali": "Yohaṃ ajja pajānāmi,"
        },
        {
          "id": "sn10.12:12.4",
          "pali": "yattha dinnaṃ mahapphalaṃ."
        },
        {
          "id": "sn10.12:13.1",
          "pali": "So ahaṃ vicarissāmi,"
        },
        {
          "id": "sn10.12:13.2",
          "pali": "Gāmā gāmaṃ purā puraṃ;"
        },
        {
          "id": "sn10.12:13.3",
          "pali": "Namassamāno sambuddhaṃ,"
        },
        {
          "id": "sn10.12:13.4",
          "pali": "Dhammassa ca sudhammatan”ti."
        },
        {
          "id": "sn10.12:13.5",
          "pali": "Indakavaggo paṭhamo."
        },
        {
          "id": "sn10.12:14.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn10.12:14.1",
          "pali": "Indako sakka sūci ca,"
        },
        {
          "id": "sn10.12:14.2",
          "pali": "Maṇibhaddo ca sānu ca;"
        },
        {
          "id": "sn10.12:14.3",
          "pali": "Piyaṅkara punabbasu sudatto ca,"
        },
        {
          "id": "sn10.12:14.4",
          "pali": "Dve sukkā cīraāḷavīti dvādasa."
        },
        {
          "id": "sn10.12:14.5",
          "pali": "Yakkhasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}