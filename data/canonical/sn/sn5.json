{
  "id": "sn5",
  "name_pali": "Bhikkhunīsaṃyutta",
  "name_eng": "Nuns",
  "vagga": "Sagāthāvagga",
  "pts": "S i 128–135",
  "suttas": [
    {
      "id": "sn5.1",
      "segments": [
        {
          "id": "sn5.1:0.1",
          "pali": "Saṃyutta Nikāya 5.1"
        },
        {
          "id": "sn5.1:0.2",
          "pali": "1. Bhikkhunīvagga"
        },
        {
          "id": "sn5.1:0.3",
          "pali": "Āḷavikāsutta"
        },
        {
          "id": "sn5.1:1.1",
          "pali": "Evaṃ me sutaṃ—"
        },
        {
          "id": "sn5.1:1.2",
          "pali": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
        },
        {
          "id": "sn5.1:1.3",
          "pali": "Atha kho āḷavikā bhikkhunī pubbaṇhasamayaṃ nivāsetvā pattacīvaramādāya sāvatthiṃ piṇḍāya pāvisi."
        },
        {
          "id": "sn5.1:1.4",
          "pali": "Sāvatthiyaṃ piṇḍāya caritvā pacchābhattaṃ piṇḍapātapaṭikkantā yena andhavanaṃ tenupasaṅkami vivekatthinī."
        },
        {
          "id": "sn5.1:1.5",
          "pali": "Atha kho māro pāpimā āḷavikāya bhikkhuniyā bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo vivekamhā cāvetukāmo yena āḷavikā bhikkhunī tenupasaṅkami; upasaṅkamitvā āḷavikaṃ bhikkhuniṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn5.1:2.1",
          "pali": "“Natthi nissaraṇaṃ loke,"
        },
        {
          "id": "sn5.1:2.2",
          "pali": "kiṃ vivekena kāhasi;"
        },
        {
          "id": "sn5.1:2.3",
          "pali": "Bhuñjassu kāmaratiyo,"
        },
        {
          "id": "sn5.1:2.4",
          "pali": "māhu pacchānutāpinī”ti."
        },
        {
          "id": "sn5.1:3.1",
          "pali": "Atha kho āḷavikāya bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.1:3.2",
          "pali": "“ko nu khvāyaṃ manusso vā amanusso vā gāthaṃ bhāsatī”ti?"
        },
        {
          "id": "sn5.1:3.3",
          "pali": "Atha kho āḷavikāya bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.1:3.4",
          "pali": "“māro kho ayaṃ pāpimā mama bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo vivekamhā cāvetukāmo gāthaṃ bhāsatī”ti."
        },
        {
          "id": "sn5.1:3.5",
          "pali": "Atha kho āḷavikā bhikkhunī “māro ayaṃ pāpimā” iti viditvā māraṃ pāpimantaṃ gāthāhi paccabhāsi:"
        },
        {
          "id": "sn5.1:4.1",
          "pali": "“Atthi nissaraṇaṃ loke,"
        },
        {
          "id": "sn5.1:4.2",
          "pali": "paññāya me suphussitaṃ;"
        },
        {
          "id": "sn5.1:4.3",
          "pali": "Pamattabandhu pāpima,"
        },
        {
          "id": "sn5.1:4.4",
          "pali": "na tvaṃ jānāsi taṃ padaṃ."
        },
        {
          "id": "sn5.1:5.1",
          "pali": "Sattisūlūpamā kāmā,"
        },
        {
          "id": "sn5.1:5.2",
          "pali": "khandhāsaṃ adhikuṭṭanā;"
        },
        {
          "id": "sn5.1:5.3",
          "pali": "Yaṃ tvaṃ kāmaratiṃ brūsi,"
        },
        {
          "id": "sn5.1:5.4",
          "pali": "arati mayha sā ahū”ti."
        },
        {
          "id": "sn5.1:6.1",
          "pali": "Atha kho māro pāpimā “jānāti maṃ āḷavikā bhikkhunī”ti dukkhī dummano tatthevantaradhāyīti."
        }
      ]
    },
    {
      "id": "sn5.2",
      "segments": [
        {
          "id": "sn5.2:0.1",
          "pali": "Saṃyutta Nikāya 5.2"
        },
        {
          "id": "sn5.2:0.2",
          "pali": "1. Bhikkhunīvagga"
        },
        {
          "id": "sn5.2:0.3",
          "pali": "Somāsutta"
        },
        {
          "id": "sn5.2:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn5.2:1.2",
          "pali": "Atha kho somā bhikkhunī pubbaṇhasamayaṃ nivāsetvā pattacīvaramādāya sāvatthiṃ piṇḍāya pāvisi."
        },
        {
          "id": "sn5.2:1.3",
          "pali": "Sāvatthiyaṃ piṇḍāya caritvā pacchābhattaṃ piṇḍapātapaṭikkantā yena andhavanaṃ tenupasaṅkami divāvihārāya."
        },
        {
          "id": "sn5.2:1.4",
          "pali": "Andhavanaṃ ajjhogāhetvā aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi."
        },
        {
          "id": "sn5.2:1.5",
          "pali": "Atha kho māro pāpimā somāya bhikkhuniyā bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo samādhimhā cāvetukāmo yena somā bhikkhunī tenupasaṅkami; upasaṅkamitvā somaṃ bhikkhuniṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn5.2:2.1",
          "pali": "“Yaṃ taṃ isīhi pattabbaṃ,"
        },
        {
          "id": "sn5.2:2.2",
          "pali": "ṭhānaṃ durabhisambhavaṃ;"
        },
        {
          "id": "sn5.2:2.3",
          "pali": "Na taṃ dvaṅgulapaññāya,"
        },
        {
          "id": "sn5.2:2.4",
          "pali": "sakkā pappotumitthiyā”ti."
        },
        {
          "id": "sn5.2:3.1",
          "pali": "Atha kho somāya bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.2:3.2",
          "pali": "“ko nu khvāyaṃ manusso vā amanusso vā gāthaṃ bhāsatī”ti?"
        },
        {
          "id": "sn5.2:3.3",
          "pali": "Atha kho somāya bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.2:3.4",
          "pali": "“māro kho ayaṃ pāpimā mama bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo samādhimhā cāvetukāmo gāthaṃ bhāsatī”ti."
        },
        {
          "id": "sn5.2:3.5",
          "pali": "Atha kho somā bhikkhunī “māro ayaṃ pāpimā” iti viditvā māraṃ pāpimantaṃ gāthāhi paccabhāsi:"
        },
        {
          "id": "sn5.2:4.1",
          "pali": "“Itthibhāvo kiṃ kayirā,"
        },
        {
          "id": "sn5.2:4.2",
          "pali": "cittamhi susamāhite;"
        },
        {
          "id": "sn5.2:4.3",
          "pali": "Ñāṇamhi vattamānamhi,"
        },
        {
          "id": "sn5.2:4.4",
          "pali": "sammā dhammaṃ vipassato."
        },
        {
          "id": "sn5.2:5.1",
          "pali": "Yassa nūna siyā evaṃ,"
        },
        {
          "id": "sn5.2:5.2",
          "pali": "Itthāhaṃ purisoti vā;"
        },
        {
          "id": "sn5.2:5.3",
          "pali": "Kiñci vā pana aññasmi,"
        },
        {
          "id": "sn5.2:5.4",
          "pali": "Taṃ māro vattumarahatī”ti."
        },
        {
          "id": "sn5.2:6.1",
          "pali": "Atha kho māro pāpimā “jānāti maṃ somā bhikkhunī”ti dukkhī dummano tatthevantaradhāyīti."
        }
      ]
    },
    {
      "id": "sn5.3",
      "segments": [
        {
          "id": "sn5.3:0.1",
          "pali": "Saṃyutta Nikāya 5.3"
        },
        {
          "id": "sn5.3:0.2",
          "pali": "1. Bhikkhunīvagga"
        },
        {
          "id": "sn5.3:0.3",
          "pali": "Kisāgotamīsutta"
        },
        {
          "id": "sn5.3:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn5.3:1.2",
          "pali": "Atha kho kisāgotamī bhikkhunī pubbaṇhasamayaṃ nivāsetvā pattacīvaramādāya sāvatthiṃ piṇḍāya pāvisi."
        },
        {
          "id": "sn5.3:1.3",
          "pali": "Sāvatthiyaṃ piṇḍāya caritvā pacchābhattaṃ piṇḍapātapaṭikkantā yena andhavanaṃ tenupasaṅkami, upasaṅkamitvā divāvihārāya."
        },
        {
          "id": "sn5.3:1.4",
          "pali": "Andhavanaṃ ajjhogāhetvā aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi."
        },
        {
          "id": "sn5.3:1.5",
          "pali": "Atha kho māro pāpimā kisāgotamiyā bhikkhuniyā bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo samādhimhā cāvetukāmo yena kisāgotamī bhikkhunī tenupasaṅkami; upasaṅkamitvā kisāgotamiṃ bhikkhuniṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn5.3:2.1",
          "pali": "“Kiṃ nu tvaṃ mataputtāva,"
        },
        {
          "id": "sn5.3:2.2",
          "pali": "ekamāsi rudammukhī;"
        },
        {
          "id": "sn5.3:2.3",
          "pali": "Vanamajjhagatā ekā,"
        },
        {
          "id": "sn5.3:2.4",
          "pali": "purisaṃ nu gavesasī”ti."
        },
        {
          "id": "sn5.3:3.1",
          "pali": "Atha kho kisāgotamiyā bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.3:3.2",
          "pali": "“ko nu khvāyaṃ manusso vā amanusso vā gāthaṃ bhāsatī”ti?"
        },
        {
          "id": "sn5.3:3.3",
          "pali": "Atha kho kisāgotamiyā bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.3:3.4",
          "pali": "“māro kho ayaṃ pāpimā mama bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo samādhimhā cāvetukāmo gāthaṃ bhāsatī”ti."
        },
        {
          "id": "sn5.3:4.1",
          "pali": "Atha kho kisāgotamī bhikkhunī “māro ayaṃ pāpimā” iti viditvā māraṃ pāpimantaṃ gāthāhi paccabhāsi:"
        },
        {
          "id": "sn5.3:5.1",
          "pali": "“Accantaṃ mataputtāmhi,"
        },
        {
          "id": "sn5.3:5.2",
          "pali": "purisā etadantikā;"
        },
        {
          "id": "sn5.3:5.3",
          "pali": "Na socāmi na rodāmi,"
        },
        {
          "id": "sn5.3:5.4",
          "pali": "na taṃ bhāyāmi āvuso."
        },
        {
          "id": "sn5.3:6.1",
          "pali": "Sabbattha vihatā nandī,"
        },
        {
          "id": "sn5.3:6.2",
          "pali": "tamokkhandho padālito;"
        },
        {
          "id": "sn5.3:6.3",
          "pali": "Jetvāna maccuno senaṃ,"
        },
        {
          "id": "sn5.3:6.4",
          "pali": "viharāmi anāsavā”ti."
        },
        {
          "id": "sn5.3:7.1",
          "pali": "Atha kho māro pāpimā “jānāti maṃ kisāgotamī bhikkhunī”ti dukkhī dummano tatthevantaradhāyīti."
        }
      ]
    },
    {
      "id": "sn5.4",
      "segments": [
        {
          "id": "sn5.4:0.1",
          "pali": "Saṃyutta Nikāya 5.4"
        },
        {
          "id": "sn5.4:0.2",
          "pali": "1. Bhikkhunīvagga"
        },
        {
          "id": "sn5.4:0.3",
          "pali": "Vijayāsutta"
        },
        {
          "id": "sn5.4:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn5.4:1.2",
          "pali": "Atha kho vijayā bhikkhunī pubbaṇhasamayaṃ nivāsetvā …pe…"
        },
        {
          "id": "sn5.4:1.3",
          "pali": "aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi."
        },
        {
          "id": "sn5.4:1.4",
          "pali": "Atha kho māro pāpimā vijayāya bhikkhuniyā bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo samādhimhā cāvetukāmo yena vijayā bhikkhunī tenupasaṅkami; upasaṅkamitvā vijayaṃ bhikkhuniṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn5.4:2.1",
          "pali": "“Daharā tvaṃ rūpavatī,"
        },
        {
          "id": "sn5.4:2.2",
          "pali": "ahañca daharo susu;"
        },
        {
          "id": "sn5.4:2.3",
          "pali": "Pañcaṅgikena turiyena,"
        },
        {
          "id": "sn5.4:2.4",
          "pali": "ehayyebhiramāmase”ti."
        },
        {
          "id": "sn5.4:3.1",
          "pali": "Atha kho vijayāya bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.4:3.2",
          "pali": "“ko nu khvāyaṃ manusso vā amanusso vā gāthaṃ bhāsatī”ti?"
        },
        {
          "id": "sn5.4:3.3",
          "pali": "Atha kho vijayāya bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.4:3.4",
          "pali": "“māro kho ayaṃ pāpimā mama bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo samādhimhā cāvetukāmo gāthaṃ bhāsatī”ti."
        },
        {
          "id": "sn5.4:3.5",
          "pali": "Atha kho vijayā bhikkhunī “māro ayaṃ pāpimā” iti viditvā māraṃ pāpimantaṃ gāthāhi paccabhāsi:"
        },
        {
          "id": "sn5.4:4.1",
          "pali": "“Rūpā saddā rasā gandhā,"
        },
        {
          "id": "sn5.4:4.2",
          "pali": "phoṭṭhabbā ca manoramā;"
        },
        {
          "id": "sn5.4:4.3",
          "pali": "Niyyātayāmi tuyheva,"
        },
        {
          "id": "sn5.4:4.4",
          "pali": "māra nāhaṃ tenatthikā."
        },
        {
          "id": "sn5.4:5.1",
          "pali": "Iminā pūtikāyena,"
        },
        {
          "id": "sn5.4:5.2",
          "pali": "bhindanena pabhaṅgunā;"
        },
        {
          "id": "sn5.4:5.3",
          "pali": "Aṭṭīyāmi harāyāmi,"
        },
        {
          "id": "sn5.4:5.4",
          "pali": "kāmataṇhā samūhatā."
        },
        {
          "id": "sn5.4:6.1",
          "pali": "Ye ca rūpūpagā sattā,"
        },
        {
          "id": "sn5.4:6.2",
          "pali": "ye ca arūpaṭṭhāyino;"
        },
        {
          "id": "sn5.4:6.3",
          "pali": "Yā ca santā samāpatti,"
        },
        {
          "id": "sn5.4:6.4",
          "pali": "sabbattha vihato tamo”ti."
        },
        {
          "id": "sn5.4:7.1",
          "pali": "Atha kho māro pāpimā “jānāti maṃ vijayā bhikkhunī”ti dukkhī dummano tatthevantaradhāyīti."
        }
      ]
    },
    {
      "id": "sn5.5",
      "segments": [
        {
          "id": "sn5.5:0.1",
          "pali": "Saṃyutta Nikāya 5.5"
        },
        {
          "id": "sn5.5:0.2",
          "pali": "1. Bhikkhunīvagga"
        },
        {
          "id": "sn5.5:0.3",
          "pali": "Uppalavaṇṇāsutta"
        },
        {
          "id": "sn5.5:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn5.5:1.2",
          "pali": "Atha kho uppalavaṇṇā bhikkhunī pubbaṇhasamayaṃ nivāsetvā …pe…"
        },
        {
          "id": "sn5.5:1.3",
          "pali": "aññatarasmiṃ supupphitasālarukkhamūle aṭṭhāsi."
        },
        {
          "id": "sn5.5:1.4",
          "pali": "Atha kho māro pāpimā uppalavaṇṇāya bhikkhuniyā bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo samādhimhā cāvetukāmo yena uppalavaṇṇā bhikkhunī tenupasaṅkami; upasaṅkamitvā uppalavaṇṇaṃ bhikkhuniṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn5.5:2.1",
          "pali": "“Supupphitaggaṃ upagamma bhikkhuni,"
        },
        {
          "id": "sn5.5:2.2",
          "pali": "Ekā tuvaṃ tiṭṭhasi sālamūle;"
        },
        {
          "id": "sn5.5:2.3",
          "pali": "Na catthi te dutiyā vaṇṇadhātu,"
        },
        {
          "id": "sn5.5:2.4",
          "pali": "Bāle na tvaṃ bhāyasi dhuttakānan”ti."
        },
        {
          "id": "sn5.5:3.1",
          "pali": "Atha kho uppalavaṇṇāya bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.5:3.2",
          "pali": "“ko nu khvāyaṃ manusso vā amanusso vā gāthaṃ bhāsatī”ti?"
        },
        {
          "id": "sn5.5:3.3",
          "pali": "Atha kho uppalavaṇṇāya bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.5:3.4",
          "pali": "“māro kho ayaṃ pāpimā mama bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo samādhimhā cāvetukāmo gāthaṃ bhāsatī”ti."
        },
        {
          "id": "sn5.5:3.5",
          "pali": "Atha kho uppalavaṇṇā bhikkhunī “māro ayaṃ pāpimā” iti viditvā māraṃ pāpimantaṃ gāthāhi paccabhāsi:"
        },
        {
          "id": "sn5.5:4.1",
          "pali": "“Sataṃ sahassānipi dhuttakānaṃ,"
        },
        {
          "id": "sn5.5:4.2",
          "pali": "Idhāgatā tādisakā bhaveyyuṃ;"
        },
        {
          "id": "sn5.5:4.3",
          "pali": "Lomaṃ na iñjāmi na santasāmi,"
        },
        {
          "id": "sn5.5:4.4",
          "pali": "Na māra bhāyāmi tamekikāpi."
        },
        {
          "id": "sn5.5:5.1",
          "pali": "Esā antaradhāyāmi,"
        },
        {
          "id": "sn5.5:5.2",
          "pali": "kucchiṃ vā pavisāmi te;"
        },
        {
          "id": "sn5.5:5.3",
          "pali": "Pakhumantarikāyampi,"
        },
        {
          "id": "sn5.5:5.4",
          "pali": "tiṭṭhantiṃ maṃ na dakkhasi."
        },
        {
          "id": "sn5.5:6.1",
          "pali": "Cittasmiṃ vasībhūtāmhi,"
        },
        {
          "id": "sn5.5:6.2",
          "pali": "iddhipādā subhāvitā;"
        },
        {
          "id": "sn5.5:6.3",
          "pali": "Sabbabandhanamuttāmhi,"
        },
        {
          "id": "sn5.5:6.4",
          "pali": "na taṃ bhāyāmi āvuso”ti."
        },
        {
          "id": "sn5.5:7.1",
          "pali": "Atha kho māro pāpimā “jānāti maṃ uppalavaṇṇā bhikkhunī”ti dukkhī dummano tatthevantaradhāyīti."
        }
      ]
    },
    {
      "id": "sn5.6",
      "segments": [
        {
          "id": "sn5.6:0.1",
          "pali": "Saṃyutta Nikāya 5.6"
        },
        {
          "id": "sn5.6:0.2",
          "pali": "1. Bhikkhunīvagga"
        },
        {
          "id": "sn5.6:0.3",
          "pali": "Cālāsutta"
        },
        {
          "id": "sn5.6:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn5.6:1.2",
          "pali": "Atha kho cālā bhikkhunī pubbaṇhasamayaṃ nivāsetvā …pe…"
        },
        {
          "id": "sn5.6:1.3",
          "pali": "aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi."
        },
        {
          "id": "sn5.6:1.4",
          "pali": "Atha kho māro pāpimā yena cālā bhikkhunī tenupasaṅkami; upasaṅkamitvā cālaṃ bhikkhuniṃ etadavoca:"
        },
        {
          "id": "sn5.6:1.5",
          "pali": "“kiṃ nu tvaṃ, bhikkhuni, na rocesī”ti?"
        },
        {
          "id": "sn5.6:1.6",
          "pali": "“Jātiṃ khvāhaṃ, āvuso, na rocemī”ti."
        },
        {
          "id": "sn5.6:2.1",
          "pali": "“Kiṃ nu jātiṃ na rocesi,"
        },
        {
          "id": "sn5.6:2.2",
          "pali": "jāto kāmāni bhuñjati;"
        },
        {
          "id": "sn5.6:2.3",
          "pali": "Ko nu taṃ idamādapayi,"
        },
        {
          "id": "sn5.6:2.4",
          "pali": "jātiṃ mā roca bhikkhunī”ti."
        },
        {
          "id": "sn5.6:3.1",
          "pali": "“Jātassa maraṇaṃ hoti,"
        },
        {
          "id": "sn5.6:3.2",
          "pali": "jāto dukkhāni phussati;"
        },
        {
          "id": "sn5.6:3.3",
          "pali": "Bandhaṃ vadhaṃ pariklesaṃ,"
        },
        {
          "id": "sn5.6:3.4",
          "pali": "tasmā jātiṃ na rocaye."
        },
        {
          "id": "sn5.6:4.1",
          "pali": "Buddho dhammamadesesi,"
        },
        {
          "id": "sn5.6:4.2",
          "pali": "jātiyā samatikkamaṃ;"
        },
        {
          "id": "sn5.6:4.3",
          "pali": "Sabbadukkhappahānāya,"
        },
        {
          "id": "sn5.6:4.4",
          "pali": "so maṃ sacce nivesayi."
        },
        {
          "id": "sn5.6:5.1",
          "pali": "Ye ca rūpūpagā sattā,"
        },
        {
          "id": "sn5.6:5.2",
          "pali": "ye ca arūpaṭṭhāyino;"
        },
        {
          "id": "sn5.6:5.3",
          "pali": "Nirodhaṃ appajānantā,"
        },
        {
          "id": "sn5.6:5.4",
          "pali": "āgantāro punabbhavan”ti."
        },
        {
          "id": "sn5.6:6.1",
          "pali": "Atha kho māro pāpimā “jānāti maṃ cālā bhikkhunī”ti dukkhī dummano tatthevantaradhāyīti."
        }
      ]
    },
    {
      "id": "sn5.7",
      "segments": [
        {
          "id": "sn5.7:0.1",
          "pali": "Saṃyutta Nikāya 5.7"
        },
        {
          "id": "sn5.7:0.2",
          "pali": "1. Bhikkhunīvagga"
        },
        {
          "id": "sn5.7:0.3",
          "pali": "Upacālāsutta"
        },
        {
          "id": "sn5.7:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn5.7:1.2",
          "pali": "Atha kho upacālā bhikkhunī pubbaṇhasamayaṃ nivāsetvā …pe…"
        },
        {
          "id": "sn5.7:1.3",
          "pali": "aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi."
        },
        {
          "id": "sn5.7:1.4",
          "pali": "Atha kho māro pāpimā yena upacālā bhikkhunī tenupasaṅkami; upasaṅkamitvā upacālaṃ bhikkhuniṃ etadavoca:"
        },
        {
          "id": "sn5.7:1.5",
          "pali": "“kattha nu tvaṃ, bhikkhuni, uppajjitukāmā”ti?"
        },
        {
          "id": "sn5.7:1.6",
          "pali": "“Na khvāhaṃ, āvuso, katthaci uppajjitukāmā”ti."
        },
        {
          "id": "sn5.7:2.1",
          "pali": "“Tāvatiṃsā ca yāmā ca,"
        },
        {
          "id": "sn5.7:2.2",
          "pali": "tusitā cāpi devatā;"
        },
        {
          "id": "sn5.7:2.3",
          "pali": "Nimmānaratino devā,"
        },
        {
          "id": "sn5.7:2.4",
          "pali": "ye devā vasavattino;"
        },
        {
          "id": "sn5.7:2.5",
          "pali": "Tattha cittaṃ paṇidhehi,"
        },
        {
          "id": "sn5.7:2.6",
          "pali": "ratiṃ paccanubhossasī”ti."
        },
        {
          "id": "sn5.7:3.1",
          "pali": "“Tāvatiṃsā ca yāmā ca,"
        },
        {
          "id": "sn5.7:3.2",
          "pali": "tusitā cāpi devatā;"
        },
        {
          "id": "sn5.7:3.3",
          "pali": "Nimmānaratino devā,"
        },
        {
          "id": "sn5.7:3.4",
          "pali": "ye devā vasavattino;"
        },
        {
          "id": "sn5.7:3.5",
          "pali": "Kāmabandhanabaddhā te,"
        },
        {
          "id": "sn5.7:3.6",
          "pali": "enti māravasaṃ puna."
        },
        {
          "id": "sn5.7:4.1",
          "pali": "Sabbo ādīpito loko,"
        },
        {
          "id": "sn5.7:4.2",
          "pali": "sabbo loko padhūpito;"
        },
        {
          "id": "sn5.7:4.3",
          "pali": "Sabbo pajjālito loko,"
        },
        {
          "id": "sn5.7:4.4",
          "pali": "sabbo loko pakampito."
        },
        {
          "id": "sn5.7:5.1",
          "pali": "Akampitaṃ apajjalitaṃ,"
        },
        {
          "id": "sn5.7:5.2",
          "pali": "aputhujjanasevitaṃ;"
        },
        {
          "id": "sn5.7:5.3",
          "pali": "Agati yattha mārassa,"
        },
        {
          "id": "sn5.7:5.4",
          "pali": "tattha me nirato mano”ti."
        },
        {
          "id": "sn5.7:6.1",
          "pali": "Atha kho māro pāpimā “jānāti maṃ upacālā bhikkhunī”ti dukkhī dummano tatthevantaradhāyīti."
        }
      ]
    },
    {
      "id": "sn5.8",
      "segments": [
        {
          "id": "sn5.8:0.1",
          "pali": "Saṃyutta Nikāya 5.8"
        },
        {
          "id": "sn5.8:0.2",
          "pali": "1. Bhikkhunīvagga"
        },
        {
          "id": "sn5.8:0.3",
          "pali": "Sīsupacālāsutta"
        },
        {
          "id": "sn5.8:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn5.8:1.2",
          "pali": "Atha kho sīsupacālā bhikkhunī pubbaṇhasamayaṃ nivāsetvā …pe…"
        },
        {
          "id": "sn5.8:1.3",
          "pali": "aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi."
        },
        {
          "id": "sn5.8:1.4",
          "pali": "Atha kho māro pāpimā yena sīsupacālā bhikkhunī tenupasaṅkami; upasaṅkamitvā sīsupacālaṃ bhikkhuniṃ etadavoca:"
        },
        {
          "id": "sn5.8:1.5",
          "pali": "“kassa nu tvaṃ, bhikkhuni, pāsaṇḍaṃ rocesī”ti?"
        },
        {
          "id": "sn5.8:1.6",
          "pali": "“Na khvāhaṃ, āvuso, kassaci pāsaṇḍaṃ rocemī”ti."
        },
        {
          "id": "sn5.8:2.1",
          "pali": "“Kaṃ nu uddissa muṇḍāsi,"
        },
        {
          "id": "sn5.8:2.2",
          "pali": "Samaṇī viya dissasi;"
        },
        {
          "id": "sn5.8:2.3",
          "pali": "Na ca rocesi pāsaṇḍaṃ,"
        },
        {
          "id": "sn5.8:2.4",
          "pali": "Kimiva carasi momūhā”ti."
        },
        {
          "id": "sn5.8:3.1",
          "pali": "“Ito bahiddhā pāsaṇḍā,"
        },
        {
          "id": "sn5.8:3.2",
          "pali": "diṭṭhīsu pasīdanti te;"
        },
        {
          "id": "sn5.8:3.3",
          "pali": "Na tesaṃ dhammaṃ rocemi,"
        },
        {
          "id": "sn5.8:3.4",
          "pali": "te dhammassa akovidā."
        },
        {
          "id": "sn5.8:4.1",
          "pali": "Atthi sakyakule jāto,"
        },
        {
          "id": "sn5.8:4.2",
          "pali": "buddho appaṭipuggalo;"
        },
        {
          "id": "sn5.8:4.3",
          "pali": "Sabbābhibhū māranudo,"
        },
        {
          "id": "sn5.8:4.4",
          "pali": "sabbatthamaparājito."
        },
        {
          "id": "sn5.8:5.1",
          "pali": "Sabbattha mutto asito,"
        },
        {
          "id": "sn5.8:5.2",
          "pali": "sabbaṃ passati cakkhumā;"
        },
        {
          "id": "sn5.8:5.3",
          "pali": "Sabbakammakkhayaṃ patto,"
        },
        {
          "id": "sn5.8:5.4",
          "pali": "vimutto upadhisaṅkhaye;"
        },
        {
          "id": "sn5.8:5.5",
          "pali": "So mayhaṃ bhagavā satthā,"
        },
        {
          "id": "sn5.8:5.6",
          "pali": "tassa rocemi sāsanan”ti."
        },
        {
          "id": "sn5.8:6.1",
          "pali": "Atha kho māro pāpimā “jānāti maṃ sīsupacālā bhikkhunī”ti dukkhī dummano tatthevantaradhāyīti."
        }
      ]
    },
    {
      "id": "sn5.9",
      "segments": [
        {
          "id": "sn5.9:0.1",
          "pali": "Saṃyutta Nikāya 5.9"
        },
        {
          "id": "sn5.9:0.2",
          "pali": "1. Bhikkhunīvagga"
        },
        {
          "id": "sn5.9:0.3",
          "pali": "Selāsutta"
        },
        {
          "id": "sn5.9:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn5.9:1.2",
          "pali": "Atha kho selā bhikkhunī pubbaṇhasamayaṃ nivāsetvā …pe…"
        },
        {
          "id": "sn5.9:1.3",
          "pali": "aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi."
        },
        {
          "id": "sn5.9:1.4",
          "pali": "Atha kho māro pāpimā selāya bhikkhuniyā bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo …pe…"
        },
        {
          "id": "sn5.9:1.5",
          "pali": "selaṃ bhikkhuniṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn5.9:2.1",
          "pali": "“Kenidaṃ pakataṃ bimbaṃ,"
        },
        {
          "id": "sn5.9:2.2",
          "pali": "kvanu bimbassa kārako;"
        },
        {
          "id": "sn5.9:2.3",
          "pali": "Kvanu bimbaṃ samuppannaṃ,"
        },
        {
          "id": "sn5.9:2.4",
          "pali": "kvanu bimbaṃ nirujjhatī”ti."
        },
        {
          "id": "sn5.9:3.1",
          "pali": "Atha kho selāya bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.9:3.2",
          "pali": "“ko nu khvāyaṃ manusso vā amanusso vā gāthaṃ bhāsatī”ti?"
        },
        {
          "id": "sn5.9:3.3",
          "pali": "Atha kho selāya bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.9:3.4",
          "pali": "“māro kho ayaṃ pāpimā mama bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo samādhimhā cāvetukāmo gāthaṃ bhāsatī”ti."
        },
        {
          "id": "sn5.9:3.5",
          "pali": "Atha kho selā bhikkhunī “māro ayaṃ pāpimā” iti viditvā māraṃ pāpimantaṃ gāthāhi paccabhāsi:"
        },
        {
          "id": "sn5.9:4.1",
          "pali": "“Nayidaṃ attakataṃ bimbaṃ,"
        },
        {
          "id": "sn5.9:4.2",
          "pali": "nayidaṃ parakataṃ aghaṃ;"
        },
        {
          "id": "sn5.9:4.3",
          "pali": "Hetuṃ paṭicca sambhūtaṃ,"
        },
        {
          "id": "sn5.9:4.4",
          "pali": "hetubhaṅgā nirujjhati."
        },
        {
          "id": "sn5.9:5.1",
          "pali": "Yathā aññataraṃ bījaṃ,"
        },
        {
          "id": "sn5.9:5.2",
          "pali": "khette vuttaṃ virūhati;"
        },
        {
          "id": "sn5.9:5.3",
          "pali": "Pathavīrasañcāgamma,"
        },
        {
          "id": "sn5.9:5.4",
          "pali": "sinehañca tadūbhayaṃ."
        },
        {
          "id": "sn5.9:6.1",
          "pali": "Evaṃ khandhā ca dhātuyo,"
        },
        {
          "id": "sn5.9:6.2",
          "pali": "cha ca āyatanā ime;"
        },
        {
          "id": "sn5.9:6.3",
          "pali": "Hetuṃ paṭicca sambhūtā,"
        },
        {
          "id": "sn5.9:6.4",
          "pali": "hetubhaṅgā nirujjhare”ti."
        },
        {
          "id": "sn5.9:7.1",
          "pali": "Atha kho māro pāpimā “jānāti maṃ selā bhikkhunī”ti dukkhī dummano tatthevantaradhāyīti."
        }
      ]
    },
    {
      "id": "sn5.10",
      "segments": [
        {
          "id": "sn5.10:0.1",
          "pali": "Saṃyutta Nikāya 5.10"
        },
        {
          "id": "sn5.10:0.2",
          "pali": "1. Bhikkhunīvagga"
        },
        {
          "id": "sn5.10:0.3",
          "pali": "Vajirāsutta"
        },
        {
          "id": "sn5.10:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn5.10:1.2",
          "pali": "Atha kho vajirā bhikkhunī pubbaṇhasamayaṃ nivāsetvā pattacīvaramādāya sāvatthiṃ piṇḍāya pāvisi."
        },
        {
          "id": "sn5.10:1.3",
          "pali": "Sāvatthiyaṃ piṇḍāya caritvā pacchābhattaṃ piṇḍapātapaṭikkantā yena andhavanaṃ tenupasaṅkami divāvihārāya."
        },
        {
          "id": "sn5.10:1.4",
          "pali": "Andhavanaṃ ajjhogāhetvā aññatarasmiṃ rukkhamūle divāvihāraṃ nisīdi."
        },
        {
          "id": "sn5.10:1.5",
          "pali": "Atha kho māro pāpimā vajirāya bhikkhuniyā bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo samādhimhā cāvetukāmo yena vajirā bhikkhunī tenupasaṅkami; upasaṅkamitvā vajiraṃ bhikkhuniṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn5.10:2.1",
          "pali": "“Kenāyaṃ pakato satto,"
        },
        {
          "id": "sn5.10:2.2",
          "pali": "kuvaṃ sattassa kārako;"
        },
        {
          "id": "sn5.10:2.3",
          "pali": "Kuvaṃ satto samuppanno,"
        },
        {
          "id": "sn5.10:2.4",
          "pali": "kuvaṃ satto nirujjhatī”ti."
        },
        {
          "id": "sn5.10:3.1",
          "pali": "Atha kho vajirāya bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.10:3.2",
          "pali": "“ko nu khvāyaṃ manusso vā amanusso vā gāthaṃ bhāsatī”ti?"
        },
        {
          "id": "sn5.10:3.3",
          "pali": "Atha kho vajirāya bhikkhuniyā etadahosi:"
        },
        {
          "id": "sn5.10:3.4",
          "pali": "“māro kho ayaṃ pāpimā mama bhayaṃ chambhitattaṃ lomahaṃsaṃ uppādetukāmo samādhimhā cāvetukāmo gāthaṃ bhāsatī”ti."
        },
        {
          "id": "sn5.10:3.5",
          "pali": "Atha kho vajirā bhikkhunī “māro ayaṃ pāpimā” iti viditvā, māraṃ pāpimantaṃ gāthāhi paccabhāsi:"
        },
        {
          "id": "sn5.10:4.1",
          "pali": "“Kiṃ nu sattoti paccesi,"
        },
        {
          "id": "sn5.10:4.2",
          "pali": "māra diṭṭhigataṃ nu te;"
        },
        {
          "id": "sn5.10:4.3",
          "pali": "Suddhasaṅkhārapuñjoyaṃ,"
        },
        {
          "id": "sn5.10:4.4",
          "pali": "nayidha sattupalabbhati."
        },
        {
          "id": "sn5.10:5.1",
          "pali": "Yathā hi aṅgasambhārā,"
        },
        {
          "id": "sn5.10:5.2",
          "pali": "hoti saddo ratho iti;"
        },
        {
          "id": "sn5.10:5.3",
          "pali": "Evaṃ khandhesu santesu,"
        },
        {
          "id": "sn5.10:5.4",
          "pali": "hoti sattoti sammuti."
        },
        {
          "id": "sn5.10:6.1",
          "pali": "Dukkhameva hi sambhoti,"
        },
        {
          "id": "sn5.10:6.2",
          "pali": "dukkhaṃ tiṭṭhati veti ca;"
        },
        {
          "id": "sn5.10:6.3",
          "pali": "Nāññatra dukkhā sambhoti,"
        },
        {
          "id": "sn5.10:6.4",
          "pali": "nāññaṃ dukkhā nirujjhatī”ti."
        },
        {
          "id": "sn5.10:7.1",
          "pali": "Atha kho māro pāpimā “jānāti maṃ vajirā bhikkhunī”ti dukkhī dummano tatthevantaradhāyīti."
        },
        {
          "id": "sn5.10:7.2",
          "pali": "Bhikkhunīvaggo paṭhamo."
        },
        {
          "id": "sn5.10:8.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn5.10:8.1",
          "pali": "Āḷavikā ca somā ca,"
        },
        {
          "id": "sn5.10:8.2",
          "pali": "Gotamī vijayā saha;"
        },
        {
          "id": "sn5.10:8.3",
          "pali": "Uppalavaṇṇā ca cālā,"
        },
        {
          "id": "sn5.10:8.4",
          "pali": "Upacālā sīsupacālā ca;"
        },
        {
          "id": "sn5.10:8.5",
          "pali": "Selā vajirāya te dasāti."
        },
        {
          "id": "sn5.10:8.6",
          "pali": "Bhikkhunīsaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}