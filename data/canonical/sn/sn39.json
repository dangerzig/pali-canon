{
  "id": "sn39",
  "name_pali": "Sāmaṇḍakasaṃyutta",
  "name_eng": "Sāmaṇḍaka",
  "vagga": "Saḷāyatanavagga",
  "pts": "S iv 261–262",
  "suttas": [
    {
      "id": "sn39.1-15",
      "segments": [
        {
          "id": "sn39.1-15:0.1",
          "pali": "Saṃyutta Nikāya 39.1"
        },
        {
          "id": "sn39.1-15:0.2",
          "pali": "1. Sāmaṇḍakavagga"
        },
        {
          "id": "sn39.1-15:0.3",
          "pali": "Sāmaṇḍakasutta"
        },
        {
          "id": "sn39.1-15:1.1",
          "pali": "Ekaṃ samayaṃ āyasmā sāriputto vajjīsu viharati ukkacelāyaṃ gaṅgāya nadiyā tīre."
        },
        {
          "id": "sn39.1-15:1.2",
          "pali": "Atha kho sāmaṇḍako paribbājako yenāyasmā sāriputto tenupasaṅkami; upasaṅkamitvā āyasmatā sāriputtena saddhiṃ sammodi."
        },
        {
          "id": "sn39.1-15:1.3",
          "pali": "Sammodanīyaṃ kathaṃ sāraṇīyaṃ vītisāretvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho sāmaṇḍako paribbājako āyasmantaṃ sāriputtaṃ etadavoca:"
        },
        {
          "id": "sn39.1-15:2.1",
          "pali": "“‘Nibbānaṃ, nibbānan’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn39.1-15:2.2",
          "pali": "Katamaṃ nu kho, āvuso, nibbānan”ti?"
        },
        {
          "id": "sn39.1-15:2.3",
          "pali": "“Yo kho, āvuso, rāgakkhayo dosakkhayo mohakkhayo—"
        },
        {
          "id": "sn39.1-15:2.4",
          "pali": "idaṃ vuccati nibbānan”ti."
        },
        {
          "id": "sn39.1-15:2.5",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā, etassa nibbānassa sacchikiriyāyā”ti?"
        },
        {
          "id": "sn39.1-15:2.6",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā, etassa nibbānassa sacchikiriyāyā”ti."
        },
        {
          "id": "sn39.1-15:3.1",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā etassa nibbānassa sacchikiriyāyā”ti?"
        },
        {
          "id": "sn39.1-15:3.2",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo, etassa nibbānassa sacchikiriyāya, seyyathidaṃ—"
        },
        {
          "id": "sn39.1-15:3.3",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn39.1-15:3.4",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā, etassa nibbānassa sacchikiriyāyā”ti."
        },
        {
          "id": "sn39.1-15:3.5",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etassa nibbānassa sacchikiriyāya."
        },
        {
          "id": "sn39.1-15:3.6",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn39.1-15:3.7",
          "pali": "Paṭhamaṃ."
        },
        {
          "id": "sn39.1-15:4.1",
          "pali": "(Yathā jambukhādakasaṃyuttaṃ, tathā vitthāretabbaṃ.)"
        }
      ]
    },
    {
      "id": "sn39.16",
      "segments": [
        {
          "id": "sn39.16:0.1",
          "pali": "Saṃyutta Nikāya 39.16"
        },
        {
          "id": "sn39.16:0.2",
          "pali": "1. Sāmaṇḍakavagga"
        },
        {
          "id": "sn39.16:0.3",
          "pali": "Dukkarasutta"
        },
        {
          "id": "sn39.16:1.1",
          "pali": "“Kiṃ nu kho, āvuso sāriputta, imasmiṃ dhammavinaye dukkaran”ti?"
        },
        {
          "id": "sn39.16:1.2",
          "pali": "“Pabbajjā kho, āvuso, imasmiṃ dhammavinaye dukkarā”ti."
        },
        {
          "id": "sn39.16:1.3",
          "pali": "“Pabbajitena panāvuso, kiṃ dukkaran”ti?"
        },
        {
          "id": "sn39.16:1.4",
          "pali": "“Pabbajitena kho, āvuso, abhirati dukkarā”ti."
        },
        {
          "id": "sn39.16:1.5",
          "pali": "“Abhiratena panāvuso, kiṃ dukkaran”ti?"
        },
        {
          "id": "sn39.16:1.6",
          "pali": "“Abhiratena kho, āvuso, dhammānudhammappaṭipatti dukkarā”ti."
        },
        {
          "id": "sn39.16:1.7",
          "pali": "“Kīvaciraṃ panāvuso, dhammānudhammappaṭipanno bhikkhu arahaṃ assā”ti?"
        },
        {
          "id": "sn39.16:1.8",
          "pali": "“Naciraṃ, āvuso”ti."
        },
        {
          "id": "sn39.16:1.9",
          "pali": "Soḷasamaṃ."
        },
        {
          "id": "sn39.16:1.10",
          "pali": "(Purimakasadisaṃ uddānaṃ.)"
        },
        {
          "id": "sn39.16:1.11",
          "pali": "Sāmaṇḍakasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}