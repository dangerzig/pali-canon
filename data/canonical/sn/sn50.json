{
  "id": "sn50",
  "name_pali": "Balasaṃyutta",
  "name_eng": "The Powers",
  "vagga": "Mahāvagga",
  "pts": "S v 249–250",
  "suttas": [
    {
      "id": "sn50.1-12",
      "segments": [
        {
          "id": "sn50.1-12:0.1",
          "pali": "Saṃyutta Nikāya 50.1–12"
        },
        {
          "id": "sn50.1-12:0.2",
          "pali": "1. Gaṅgāpeyyālavagga"
        },
        {
          "id": "sn50.1-12:0.3",
          "pali": "Balādisutta"
        },
        {
          "id": "sn50.1-12:1.1",
          "pali": "“Pañcimāni, bhikkhave, balāni."
        },
        {
          "id": "sn50.1-12:1.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn50.1-12:1.3",
          "pali": "Saddhābalaṃ, vīriyabalaṃ, satibalaṃ, samādhibalaṃ, paññābalaṃ—"
        },
        {
          "id": "sn50.1-12:1.4",
          "pali": "imāni kho, bhikkhave, pañca balānīti."
        },
        {
          "id": "sn50.1-12:1.5",
          "pali": "Seyyathāpi, bhikkhave, gaṅgā nadī pācīnaninnā pācīnapoṇā pācīnapabbhārā;"
        },
        {
          "id": "sn50.1-12:1.6",
          "pali": "evameva kho, bhikkhave, bhikkhu pañca balāni bhāvento pañca balāni bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro."
        },
        {
          "id": "sn50.1-12:1.7",
          "pali": "Kathañca, bhikkhave, bhikkhu pañca balāni bhāvento pañca balāni bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro?"
        },
        {
          "id": "sn50.1-12:1.8",
          "pali": "Idha, bhikkhave, bhikkhu saddhābalaṃ bhāveti vivekanissitaṃ virāganissitaṃ nirodhanissitaṃ vossaggapariṇāmiṃ,"
        },
        {
          "id": "sn50.1-12:1.9",
          "pali": "vīriyabalaṃ …pe…"
        },
        {
          "id": "sn50.1-12:1.10",
          "pali": "satibalaṃ …"
        },
        {
          "id": "sn50.1-12:1.11",
          "pali": "samādhibalaṃ …"
        },
        {
          "id": "sn50.1-12:1.12",
          "pali": "paññābalaṃ bhāveti vivekanissitaṃ virāganissitaṃ nirodhanissitaṃ vossaggapariṇāmiṃ."
        },
        {
          "id": "sn50.1-12:1.13",
          "pali": "Evaṃ kho, bhikkhave, bhikkhu pañca balāni bhāvento pañca balāni bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro”ti."
        },
        {
          "id": "sn50.1-12:1.14",
          "pali": "Dvādasamaṃ."
        },
        {
          "id": "sn50.1-12:1.15",
          "pali": "Gaṅgāpeyyālavaggo paṭhamo."
        },
        {
          "id": "sn50.1-12:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn50.1-12:2.1",
          "pali": "Cha pācīnato ninnā,"
        },
        {
          "id": "sn50.1-12:2.2",
          "pali": "cha ninnā ca samuddato;"
        },
        {
          "id": "sn50.1-12:2.3",
          "pali": "Dvete cha dvādasa honti,"
        },
        {
          "id": "sn50.1-12:2.4",
          "pali": "vaggo tena pavuccatīti."
        }
      ]
    },
    {
      "id": "sn50.13-22",
      "segments": [
        {
          "id": "sn50.13-22:0.1",
          "pali": "Saṃyutta Nikāya 50.13"
        },
        {
          "id": "sn50.13-22:0.2",
          "pali": "2. Appamādavagga"
        },
        {
          "id": "sn50.13-22:0.3",
          "pali": "Appamādavagga"
        },
        {
          "id": "sn50.13-22:1.1",
          "pali": "(Appamādavaggo vitthāretabbo.)"
        },
        {
          "id": "sn50.13-22:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn50.13-22:2.1",
          "pali": "Tathāgataṃ padaṃ kūṭaṃ,"
        },
        {
          "id": "sn50.13-22:2.2",
          "pali": "mūlaṃ sārena vassikaṃ;"
        },
        {
          "id": "sn50.13-22:2.3",
          "pali": "Rājā candimasūriyā,"
        },
        {
          "id": "sn50.13-22:2.4",
          "pali": "vatthena dasamaṃ padanti."
        }
      ]
    },
    {
      "id": "sn50.23-34",
      "segments": [
        {
          "id": "sn50.23-34:0.1",
          "pali": "Saṃyutta Nikāya 50.23"
        },
        {
          "id": "sn50.23-34:0.2",
          "pali": "3. Balakaraṇīyavagga"
        },
        {
          "id": "sn50.23-34:0.3",
          "pali": "Balakaraṇīyavagga"
        },
        {
          "id": "sn50.23-34:1.1",
          "pali": "(Balakaraṇīyavaggo vitthāretabbo.)"
        },
        {
          "id": "sn50.23-34:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn50.23-34:2.1",
          "pali": "Balaṃ bījañca nāgo ca,"
        },
        {
          "id": "sn50.23-34:2.2",
          "pali": "rukkho kumbhena sūkiyā;"
        },
        {
          "id": "sn50.23-34:2.3",
          "pali": "Ākāsena ca dve meghā,"
        },
        {
          "id": "sn50.23-34:2.4",
          "pali": "nāvā āgantukā nadīti."
        }
      ]
    },
    {
      "id": "sn50.35-44",
      "segments": [
        {
          "id": "sn50.35-44:0.1",
          "pali": "Saṃyutta Nikāya 50.35"
        },
        {
          "id": "sn50.35-44:0.2",
          "pali": "4. Esanāvagga"
        },
        {
          "id": "sn50.35-44:0.3",
          "pali": "Esanāvagga"
        },
        {
          "id": "sn50.35-44:1.1",
          "pali": "(Esanāvaggo vitthāretabbo.)"
        },
        {
          "id": "sn50.35-44:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn50.35-44:2.1",
          "pali": "Esanā vidhā āsavo,"
        },
        {
          "id": "sn50.35-44:2.2",
          "pali": "Bhavo ca dukkhatā tisso;"
        },
        {
          "id": "sn50.35-44:2.3",
          "pali": "Khilaṃ malañca nīgho ca,"
        },
        {
          "id": "sn50.35-44:2.4",
          "pali": "Vedanā taṇhā tasinā cāti."
        }
      ]
    },
    {
      "id": "sn50.45-54",
      "segments": [
        {
          "id": "sn50.45-54:0.1",
          "pali": "Saṃyutta Nikāya 50.45–54"
        },
        {
          "id": "sn50.45-54:0.2",
          "pali": "5. Oghavagga"
        },
        {
          "id": "sn50.45-54:0.3",
          "pali": "Oghādisutta"
        },
        {
          "id": "sn50.45-54:1.1",
          "pali": "“Pañcimāni, bhikkhave, uddhambhāgiyāni saṃyojanāni."
        },
        {
          "id": "sn50.45-54:1.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn50.45-54:1.3",
          "pali": "Rūparāgo, arūparāgo, māno, uddhaccaṃ, avijjā—"
        },
        {
          "id": "sn50.45-54:1.4",
          "pali": "imāni kho, bhikkhave, pañcuddhambhāgiyāni saṃyojanāni."
        },
        {
          "id": "sn50.45-54:1.5",
          "pali": "Imesaṃ kho, bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya pariññāya parikkhayāya pahānāya pañca balāni bhāvetabbāni."
        },
        {
          "id": "sn50.45-54:1.6",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn50.45-54:1.7",
          "pali": "Idha, bhikkhave, bhikkhu, saddhābalaṃ bhāveti vivekanissitaṃ virāganissitaṃ nirodhanissitaṃ vossaggapariṇāmiṃ,"
        },
        {
          "id": "sn50.45-54:1.8",
          "pali": "vīriyabalaṃ …pe…"
        },
        {
          "id": "sn50.45-54:1.9",
          "pali": "satibalaṃ …"
        },
        {
          "id": "sn50.45-54:1.10",
          "pali": "samādhibalaṃ …"
        },
        {
          "id": "sn50.45-54:1.11",
          "pali": "paññābalaṃ bhāveti vivekanissitaṃ virāganissitaṃ nirodhanissitaṃ vossaggapariṇāmiṃ."
        },
        {
          "id": "sn50.45-54:1.12",
          "pali": "Imesaṃ kho, bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya pariññāya parikkhayāya pahānāya imāni pañca balāni bhāvetabbānī”ti."
        },
        {
          "id": "sn50.45-54:1.13",
          "pali": "(Evaṃ vitthāretabbā.)"
        }
      ]
    },
    {
      "id": "sn50.55-66",
      "segments": [
        {
          "id": "sn50.55-66:0.1",
          "pali": "Saṃyutta Nikāya 50.55–66"
        },
        {
          "id": "sn50.55-66:0.2",
          "pali": "6. Punagaṅgāpeyyālavagga"
        },
        {
          "id": "sn50.55-66:0.3",
          "pali": "Pācīnādisutta"
        },
        {
          "id": "sn50.55-66:1.1",
          "pali": "“Seyyathāpi, bhikkhave, gaṅgā nadī pācīnaninnā pācīnapoṇā pācīnapabbhārā;"
        },
        {
          "id": "sn50.55-66:1.2",
          "pali": "evameva kho, bhikkhave, bhikkhu pañca balāni bhāvento pañca balāni bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro."
        },
        {
          "id": "sn50.55-66:1.3",
          "pali": "Kathañca, bhikkhave, bhikkhu pañca balāni bhāvento pañca balāni bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro?"
        },
        {
          "id": "sn50.55-66:1.4",
          "pali": "Idha, bhikkhave, bhikkhu, saddhābalaṃ bhāveti rāgavinayapariyosānaṃ dosavinayapariyosānaṃ mohavinayapariyosānaṃ …"
        },
        {
          "id": "sn50.55-66:1.5",
          "pali": "evaṃ kho, bhikkhave, bhikkhu pañca balāni bhāvento pañca balāni bahulīkaronto nibbānaninno hoti nibbānapoṇo nibbānapabbhāro”ti."
        },
        {
          "id": "sn50.55-66:1.6",
          "pali": "Vitthāretabbā."
        },
        {
          "id": "sn50.55-66:1.7",
          "pali": "Dvādasamaṃ."
        },
        {
          "id": "sn50.55-66:1.8",
          "pali": "Gaṅgāpeyyālavaggo chaṭṭho."
        },
        {
          "id": "sn50.55-66:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn50.55-66:2.1",
          "pali": "Cha pācīnato ninnā,"
        },
        {
          "id": "sn50.55-66:2.2",
          "pali": "cha ninnā ca samuddato;"
        },
        {
          "id": "sn50.55-66:2.3",
          "pali": "Dvete cha dvādasa honti,"
        },
        {
          "id": "sn50.55-66:2.4",
          "pali": "vaggo tena pavuccatīti."
        }
      ]
    },
    {
      "id": "sn50.67-76",
      "segments": [
        {
          "id": "sn50.67-76:0.1",
          "pali": "Saṃyutta Nikāya 50.67"
        },
