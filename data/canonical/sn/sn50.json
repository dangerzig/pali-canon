        }
      ]
    },
    {
      "id": "sn50.77-88",
      "segments": [
        {
          "id": "sn50.77-88:0.1",
          "pali": "Saṃyutta Nikāya 50.77"
        },
        {
          "id": "sn50.77-88:0.2",
          "pali": "7. Punabalakaraṇīyavagga"
        },
        {
          "id": "sn50.77-88:0.3",
          "pali": "Punabalakaraṇīyavagga"
        },
        {
          "id": "sn50.77-88:1.1",
          "pali": "(Appamādavagga-balakaraṇīyavaggā vitthāretabbā.)"
        }
      ]
    },
    {
      "id": "sn50.89-98",
      "segments": [
        {
          "id": "sn50.89-98:0.1",
          "pali": "Saṃyutta Nikāya 50.89–98"
        },
        {
          "id": "sn50.89-98:0.2",
          "pali": "8. Punaesanāvagga"
        },
        {
          "id": "sn50.89-98:0.3",
          "pali": "Punaesanādisutta"
        },
        {
          "id": "sn50.89-98:1.1",
          "pali": "(Evaṃ esanāpāḷi vitthāretabbā—rāgavinayapariyosānaṃ dosavinayapariyosānaṃ mohavinayapariyosānaṃ.)"
        },
        {
          "id": "sn50.89-98:1.2",
          "pali": "Esanāvaggo navamo."
        },
        {
          "id": "sn50.89-98:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn50.89-98:2.1",
          "pali": "Esanā vidhā āsavo,"
        },
        {
          "id": "sn50.89-98:2.2",
          "pali": "Bhavo ca dukkhatā tisso;"
        },
        {
          "id": "sn50.89-98:2.3",
          "pali": "Khilaṃ malañca nīgho ca,"
        },
        {
          "id": "sn50.89-98:2.4",
          "pali": "Vedanā taṇhā tasinā cāti."
        }
      ]
    },
    {
      "id": "sn50.99-108",
      "segments": [
        {
          "id": "sn50.99-108:0.1",
          "pali": "Saṃyutta Nikāya 50.99–108"
        },
        {
          "id": "sn50.99-108:0.2",
          "pali": "9. Punaoghavagga"
        },
        {
          "id": "sn50.99-108:0.3",
          "pali": "Punaoghādisutta"
        },
        {
          "id": "sn50.99-108:1.1",
          "pali": "“Pañcimāni, bhikkhave, uddhambhāgiyāni saṃyojanāni."
        },
        {
          "id": "sn50.99-108:1.2",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn50.99-108:1.3",
          "pali": "Rūparāgo, arūparāgo, māno, uddhaccaṃ avijjā—"
        },
        {
          "id": "sn50.99-108:1.4",
          "pali": "imāni kho, bhikkhave, pañcuddhambhāgiyāni saṃyojanāni."
        },
        {
          "id": "sn50.99-108:1.5",
          "pali": "Imesaṃ kho, bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya pariññāya parikkhayāya pahānāya pañca balāni bhāvetabbāni."
        },
        {
          "id": "sn50.99-108:1.6",
          "pali": "Katamāni pañca?"
        },
        {
          "id": "sn50.99-108:1.7",
          "pali": "Idha, bhikkhave, bhikkhu saddhābalaṃ bhāveti …pe… paññābalaṃ bhāveti rāgavinayapariyosānaṃ dosavinayapariyosānaṃ mohavinayapariyosānaṃ."
        },
        {
          "id": "sn50.99-108:1.8",
          "pali": "Imesaṃ kho, bhikkhave, pañcannaṃ uddhambhāgiyānaṃ saṃyojanānaṃ abhiññāya pariññāya parikkhayāya pahānāya imāni pañca balāni bhāvetabbānī”ti."
        },
        {
          "id": "sn50.99-108:1.9",
          "pali": "Dasamaṃ."
        },
        {
          "id": "sn50.99-108:1.10",
          "pali": "Oghavaggo dasamo."
        },
        {
          "id": "sn50.99-108:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn50.99-108:2.1",
          "pali": "Ogho yogo upādānaṃ,"
        },
        {
          "id": "sn50.99-108:2.2",
          "pali": "ganthā anusayena ca;"
        },
        {
          "id": "sn50.99-108:2.3",
          "pali": "Kāmaguṇā nīvaraṇā,"
        },
        {
          "id": "sn50.99-108:2.4",
          "pali": "khandhā oruddhambhāgiyāti."
        },
        {
          "id": "sn50.99-108:2.5",
          "pali": "Balasaṃyuttaṃ chaṭṭhaṃ."
        }
      ]
    }
  ]
}