{
  "id": "sn8",
  "name_pali": "Vaṅgīsasaṃyutta",
  "name_eng": "Vaṅgīsa",
  "vagga": "Sagāthāvagga",
  "pts": "S i 185–196",
  "suttas": [
    {
      "id": "sn8.1",
      "segments": [
        {
          "id": "sn8.1:0.1",
          "pali": "Saṃyutta Nikāya 8.1"
        },
        {
          "id": "sn8.1:0.2",
          "pali": "1. Vaṅgīsavagga"
        },
        {
          "id": "sn8.1:0.3",
          "pali": "Nikkhantasutta"
        },
        {
          "id": "sn8.1:1.1",
          "pali": "Evaṃ me sutaṃ—"
        },
        {
          "id": "sn8.1:1.2",
          "pali": "ekaṃ samayaṃ āyasmā vaṅgīso āḷaviyaṃ viharati aggāḷave cetiye āyasmatā nigrodhakappena upajjhāyena saddhiṃ."
        },
        {
          "id": "sn8.1:1.3",
          "pali": "Tena kho pana samayena āyasmā vaṅgīso navako hoti acirapabbajito ohiyyako vihārapālo."
        },
        {
          "id": "sn8.1:1.4",
          "pali": "Atha kho sambahulā itthiyo samalaṅkaritvā yena aggāḷavako ārāmo tenupasaṅkamiṃsu vihārapekkhikāyo."
        },
        {
          "id": "sn8.1:1.5",
          "pali": "Atha kho āyasmato vaṅgīsassa tā itthiyo disvā anabhirati uppajjati, rāgo cittaṃ anuddhaṃseti."
        },
        {
          "id": "sn8.1:1.6",
          "pali": "Atha kho āyasmato vaṅgīsassa etadahosi:"
        },
        {
          "id": "sn8.1:1.7",
          "pali": "“alābhā vata me, na vata me lābhā; dulladdhaṃ vata me, na vata me suladdhaṃ;"
        },
        {
          "id": "sn8.1:1.8",
          "pali": "yassa me anabhirati uppannā, rāgo cittaṃ anuddhaṃseti, taṃ kutettha labbhā, yaṃ me paro anabhiratiṃ vinodetvā abhiratiṃ uppādeyya."
        },
        {
          "id": "sn8.1:1.9",
          "pali": "Yannūnāhaṃ attanāva attano anabhiratiṃ vinodetvā abhiratiṃ uppādeyyan”ti."
        },
        {
          "id": "sn8.1:1.10",
          "pali": "Atha kho āyasmā vaṅgīso attanāva attano anabhiratiṃ vinodetvā abhiratiṃ uppādetvā tāyaṃ velāyaṃ imā gāthāyo abhāsi:"
        },
        {
          "id": "sn8.1:2.1",
          "pali": "“Nikkhantaṃ vata maṃ santaṃ,"
        },
        {
          "id": "sn8.1:2.2",
          "pali": "agārasmānagāriyaṃ;"
        },
        {
          "id": "sn8.1:2.3",
          "pali": "Vitakkā upadhāvanti,"
        },
        {
          "id": "sn8.1:2.4",
          "pali": "pagabbhā kaṇhato ime."
        },
        {
          "id": "sn8.1:3.1",
          "pali": "Uggaputtā mahissāsā,"
        },
        {
          "id": "sn8.1:3.2",
          "pali": "sikkhitā daḷhadhammino;"
        },
        {
          "id": "sn8.1:3.3",
          "pali": "Samantā parikireyyuṃ,"
        },
        {
          "id": "sn8.1:3.4",
          "pali": "sahassaṃ apalāyinaṃ."
        },
        {
          "id": "sn8.1:4.1",
          "pali": "Sacepi etato bhiyyo,"
        },
        {
          "id": "sn8.1:4.2",
          "pali": "āgamissanti itthiyo;"
        },
        {
          "id": "sn8.1:4.3",
          "pali": "Neva maṃ byādhayissanti,"
        },
        {
          "id": "sn8.1:4.4",
          "pali": "dhamme samhi patiṭṭhitaṃ."
        },
        {
          "id": "sn8.1:5.1",
          "pali": "Sakkhī hi me sutaṃ etaṃ,"
        },
        {
          "id": "sn8.1:5.2",
          "pali": "buddhassādiccabandhuno;"
        },
        {
          "id": "sn8.1:5.3",
          "pali": "Nibbānagamanaṃ maggaṃ,"
        },
        {
          "id": "sn8.1:5.4",
          "pali": "tattha me nirato mano."
        },
        {
          "id": "sn8.1:6.1",
          "pali": "Evañce maṃ viharantaṃ,"
        },
        {
          "id": "sn8.1:6.2",
          "pali": "pāpima upagacchasi;"
        },
        {
          "id": "sn8.1:6.3",
          "pali": "Tathā maccu karissāmi,"
        },
        {
          "id": "sn8.1:6.4",
          "pali": "na me maggampi dakkhasī”ti."
        }
      ]
    },
    {
      "id": "sn8.2",
      "segments": [
        {
          "id": "sn8.2:0.1",
          "pali": "Saṃyutta Nikāya 8.2"
        },
        {
          "id": "sn8.2:0.2",
          "pali": "1. Vaṅgīsavagga"
        },
        {
          "id": "sn8.2:0.3",
          "pali": "Aratīsutta"
        },
        {
          "id": "sn8.2:1.1",
          "pali": "Ekaṃ samayaṃ …pe… āyasmā vaṅgīso āḷaviyaṃ viharati aggāḷave cetiye āyasmatā nigrodhakappena upajjhāyena saddhiṃ."
        },
        {
          "id": "sn8.2:1.2",
          "pali": "Tena kho pana samayena āyasmā nigrodhakappo pacchābhattaṃ piṇḍapātapaṭikkanto vihāraṃ pavisati, sāyaṃ vā nikkhamati aparajju vā kāle."
        },
        {
          "id": "sn8.2:1.3",
          "pali": "Tena kho pana samayena āyasmato vaṅgīsassa anabhirati uppannā hoti, rāgo cittaṃ anuddhaṃseti."
        },
        {
          "id": "sn8.2:1.4",
          "pali": "Atha kho āyasmato vaṅgīsassa etadahosi:"
        },
        {
          "id": "sn8.2:1.5",
          "pali": "“alābhā vata me, na vata me lābhā; dulladdhaṃ vata me, na vata me suladdhaṃ;"
        },
        {
          "id": "sn8.2:1.6",
          "pali": "yassa me anabhirati uppannā, rāgo cittaṃ anuddhaṃseti; taṃ kutettha labbhā, yaṃ me paro anabhiratiṃ vinodetvā abhiratiṃ uppādeyya."
        },
        {
          "id": "sn8.2:1.7",
          "pali": "Yannūnāhaṃ attanāva attano anabhiratiṃ vinodetvā abhiratiṃ uppādeyyan”ti."
        },
        {
          "id": "sn8.2:1.8",
          "pali": "Atha kho āyasmā vaṅgīso attanāva attano anabhiratiṃ vinodetvā abhiratiṃ uppādetvā tāyaṃ velāyaṃ imā gāthāyo abhāsi:"
        },
        {
          "id": "sn8.2:2.1",
          "pali": "“Aratiñca ratiñca pahāya,"
        },
        {
          "id": "sn8.2:2.2",
          "pali": "Sabbaso gehasitañca vitakkaṃ;"
        },
        {
          "id": "sn8.2:2.3",
          "pali": "Vanathaṃ na kareyya kuhiñci,"
        },
        {
          "id": "sn8.2:2.4",
          "pali": "Nibbanatho arato sa hi bhikkhu."
        },
        {
          "id": "sn8.2:3.1",
          "pali": "Yamidha pathaviñca vehāsaṃ,"
        },
        {
          "id": "sn8.2:3.2",
          "pali": "Rūpagatañca jagatogadhaṃ;"
        },
        {
          "id": "sn8.2:3.3",
          "pali": "Kiñci parijīyati sabbamaniccaṃ,"
        },
        {
          "id": "sn8.2:3.4",
          "pali": "Evaṃ samecca caranti mutattā."
        },
        {
          "id": "sn8.2:4.1",
          "pali": "Upadhīsu janā gadhitāse,"
        },
        {
          "id": "sn8.2:4.2",
          "pali": "Diṭṭhasute paṭighe ca mute ca;"
        },
        {
          "id": "sn8.2:4.3",
          "pali": "Ettha vinodaya chandamanejo,"
        },
        {
          "id": "sn8.2:4.4",
          "pali": "Yo ettha na limpati taṃ munimāhu."
        },
        {
          "id": "sn8.2:5.1",
          "pali": "Atha saṭṭhinissitā savitakkā,"
        },
        {
          "id": "sn8.2:5.2",
          "pali": "Puthū janatāya adhammā niviṭṭhā;"
        },
        {
          "id": "sn8.2:5.3",
          "pali": "Na ca vaggagatassa kuhiñci,"
        },
        {
          "id": "sn8.2:5.4",
          "pali": "No pana duṭṭhullabhāṇī sa bhikkhu."
        },
        {
          "id": "sn8.2:6.1",
          "pali": "Dabbo cirarattasamāhito,"
        },
        {
          "id": "sn8.2:6.2",
          "pali": "Akuhako nipako apihālu;"
        },
        {
          "id": "sn8.2:6.3",
          "pali": "Santaṃ padaṃ ajjhagamā muni paṭicca,"
        },
        {
          "id": "sn8.2:6.4",
          "pali": "Parinibbuto kaṅkhati kālan”ti."
        }
      ]
    },
    {
      "id": "sn8.3",
      "segments": [
        {
          "id": "sn8.3:0.1",
          "pali": "Saṃyutta Nikāya 8.3"
        },
        {
          "id": "sn8.3:0.2",
          "pali": "1. Vaṅgīsavagga"
        },
        {
          "id": "sn8.3:0.3",
          "pali": "Pesalasutta"
        },
        {
          "id": "sn8.3:1.1",
          "pali": "Ekaṃ samayaṃ āyasmā vaṅgīso āḷaviyaṃ viharati aggāḷave cetiye āyasmatā nigrodhakappena upajjhāyena saddhiṃ."
        },
        {
          "id": "sn8.3:1.2",
          "pali": "Tena kho pana samayena āyasmā vaṅgīso attano paṭibhānena aññe pesale bhikkhū atimaññati."
        },
        {
          "id": "sn8.3:1.3",
          "pali": "Atha kho āyasmato vaṅgīsassa etadahosi:"
        },
        {
          "id": "sn8.3:1.4",
          "pali": "“alābhā vata me, na vata me lābhā; dulladdhaṃ vata me, na vata me suladdhaṃ;"
        },
        {
          "id": "sn8.3:1.5",
          "pali": "yvāhaṃ attano paṭibhānena aññe pesale bhikkhū atimaññāmī”ti."
        },
        {
          "id": "sn8.3:1.6",
          "pali": "Atha kho āyasmā vaṅgīso attanāva attano vippaṭisāraṃ uppādetvā tāyaṃ velāyaṃ imā gāthāyo abhāsi:"
        },
        {
          "id": "sn8.3:2.1",
          "pali": "“Mānaṃ pajahassu gotama,"
        },
        {
          "id": "sn8.3:2.2",
          "pali": "Mānapathañca pajahassu;"
        },
        {
          "id": "sn8.3:2.3",
          "pali": "Asesaṃ mānapathasmiṃ,"
        },
        {
          "id": "sn8.3:2.4",
          "pali": "Samucchito vippaṭisārīhuvā cirarattaṃ."
        },
        {
          "id": "sn8.3:3.1",
          "pali": "Makkhena makkhitā pajā,"
        },
        {
          "id": "sn8.3:3.2",
          "pali": "Mānahatā nirayaṃ papatanti;"
        },
        {
          "id": "sn8.3:3.3",
          "pali": "Socanti janā cirarattaṃ,"
        },
        {
          "id": "sn8.3:3.4",
          "pali": "Mānahatā nirayaṃ upapannā."
        },
        {
          "id": "sn8.3:4.1",
          "pali": "Na hi socati bhikkhu kadāci,"
        },
        {
          "id": "sn8.3:4.2",
          "pali": "Maggajino sammāpaṭipanno;"
        },
        {
          "id": "sn8.3:4.3",
          "pali": "Kittiñca sukhañca anubhoti,"
        },
        {
          "id": "sn8.3:4.4",
          "pali": "Dhammadasoti tamāhu pahitattaṃ."
        },
        {
          "id": "sn8.3:5.1",
          "pali": "Tasmā akhilodha padhānavā,"
        },
        {
          "id": "sn8.3:5.2",
          "pali": "Nīvaraṇāni pahāya visuddho;"
        },
        {
          "id": "sn8.3:5.3",
          "pali": "Mānañca pahāya asesaṃ,"
        },
        {
          "id": "sn8.3:5.4",
          "pali": "Vijjāyantakaro samitāvī”ti."
        }
      ]
    },
    {
      "id": "sn8.4",
      "segments": [
        {
          "id": "sn8.4:0.1",
          "pali": "Saṃyutta Nikāya 8.4"
        },
        {
          "id": "sn8.4:0.2",
          "pali": "1. Vaṅgīsavagga"
        },
        {
          "id": "sn8.4:0.3",
          "pali": "Ānandasutta"
        },
        {
          "id": "sn8.4:1.1",
          "pali": "Ekaṃ samayaṃ āyasmā ānando sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
        },
        {
          "id": "sn8.4:1.2",
          "pali": "Atha kho āyasmā ānando pubbaṇhasamayaṃ nivāsetvā pattacīvaramādāya sāvatthiṃ piṇḍāya pāvisi āyasmatā vaṅgīsena pacchāsamaṇena."
        },
        {
          "id": "sn8.4:1.3",
          "pali": "Tena kho pana samayena āyasmato vaṅgīsassa anabhirati uppannā hoti, rāgo cittaṃ anuddhaṃseti."
        },
        {
          "id": "sn8.4:1.4",
          "pali": "Atha kho āyasmā vaṅgīso āyasmantaṃ ānandaṃ gāthāya ajjhabhāsi:"
        },
        {
          "id": "sn8.4:2.1",
          "pali": "“Kāmarāgena ḍayhāmi,"
        },
        {
          "id": "sn8.4:2.2",
          "pali": "cittaṃ me pariḍayhati;"
        },
        {
          "id": "sn8.4:2.3",
          "pali": "Sādhu nibbāpanaṃ brūhi,"
        },
        {
          "id": "sn8.4:2.4",
          "pali": "anukampāya gotamā”ti."
        },
        {
          "id": "sn8.4:3.1",
          "pali": "“Saññāya vipariyesā,"
        },
        {
          "id": "sn8.4:3.2",
          "pali": "cittaṃ te pariḍayhati;"
        },
        {
          "id": "sn8.4:3.3",
          "pali": "Nimittaṃ parivajjehi,"
        },
        {
          "id": "sn8.4:3.4",
          "pali": "subhaṃ rāgūpasaṃhitaṃ."
        },
        {
          "id": "sn8.4:4.1",
          "pali": "Saṅkhāre parato passa,"
        },
        {
          "id": "sn8.4:4.2",
          "pali": "dukkhato mā ca attato;"
        },
        {
          "id": "sn8.4:4.3",
          "pali": "Nibbāpehi mahārāgaṃ,"
        },
        {
          "id": "sn8.4:4.4",
          "pali": "mā ḍayhittho punappunaṃ."
        },
        {
          "id": "sn8.4:5.1",
          "pali": "Asubhāya cittaṃ bhāvehi,"
        },
        {
          "id": "sn8.4:5.2",
          "pali": "ekaggaṃ susamāhitaṃ;"
        },
        {
          "id": "sn8.4:5.3",
          "pali": "Sati kāyagatā tyatthu,"
        },
        {
          "id": "sn8.4:5.4",
          "pali": "nibbidābahulo bhava."
        },
        {
          "id": "sn8.4:6.1",
          "pali": "Animittañca bhāvehi,"
        },
        {
          "id": "sn8.4:6.2",
          "pali": "mānānusayamujjaha;"
        },
        {
          "id": "sn8.4:6.3",
          "pali": "Tato mānābhisamayā,"
        },
        {
          "id": "sn8.4:6.4",
          "pali": "upasanto carissasī”ti."
        }
      ]
    },
    {
      "id": "sn8.5",
      "segments": [
        {
          "id": "sn8.5:0.1",
          "pali": "Saṃyutta Nikāya 8.5"
        },
        {
          "id": "sn8.5:0.2",
          "pali": "1. Vaṅgīsavagga"
        },
        {
          "id": "sn8.5:0.3",
          "pali": "Subhāsitasutta"
        },
        {
          "id": "sn8.5:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn8.5:1.2",
          "pali": "Tatra kho bhagavā bhikkhū āmantesi:"
        },
        {
          "id": "sn8.5:1.3",
          "pali": "“bhikkhavo”ti."
        },
        {
          "id": "sn8.5:1.4",
          "pali": "“Bhadante”ti te bhikkhū bhagavato paccassosuṃ."
        },
        {
          "id": "sn8.5:1.5",
          "pali": "Bhagavā etadavoca:"
        },
        {
          "id": "sn8.5:2.1",
          "pali": "“Catūhi, bhikkhave, aṅgehi samannāgatā vācā subhāsitā hoti, no dubbhāsitā; anavajjā ca ananuvajjā ca viññūnaṃ."
        },
        {
          "id": "sn8.5:2.2",
          "pali": "Katamehi catūhi?"
        },
        {
          "id": "sn8.5:2.3",
          "pali": "Idha, bhikkhave, bhikkhu subhāsitaṃyeva bhāsati no dubbhāsitaṃ, dhammaṃyeva bhāsati no adhammaṃ, piyaṃyeva bhāsati no appiyaṃ, saccaṃyeva bhāsati no alikaṃ."
        },
        {
          "id": "sn8.5:2.4",
          "pali": "Imehi kho, bhikkhave, catūhi aṅgehi samannāgatā vācā subhāsitā hoti, no dubbhāsitā, anavajjā ca ananuvajjā ca viññūnan”ti."
        },
        {
          "id": "sn8.5:2.5",
          "pali": "Idamavoca bhagavā."
        },
        {
          "id": "sn8.5:2.6",
          "pali": "Idaṃ vatvāna sugato athāparaṃ etadavoca satthā:"
        },
        {
          "id": "sn8.5:3.1",
          "pali": "“Subhāsitaṃ uttamamāhu santo,"
        },
        {
          "id": "sn8.5:3.2",
          "pali": "Dhammaṃ bhaṇe nādhammaṃ taṃ dutiyaṃ;"
        },
        {
          "id": "sn8.5:3.3",
          "pali": "Piyaṃ bhaṇe nāppiyaṃ taṃ tatiyaṃ,"
        },
        {
          "id": "sn8.5:3.4",
          "pali": "Saccaṃ bhaṇe nālikaṃ taṃ catutthan”ti."
        },
        {
          "id": "sn8.5:4.1",
          "pali": "Atha kho āyasmā vaṅgīso uṭṭhāyāsanā ekaṃsaṃ uttarāsaṅgaṃ karitvā yena bhagavā tenañjaliṃ paṇāmetvā bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn8.5:4.2",
          "pali": "“paṭibhāti maṃ, bhagavā, paṭibhāti maṃ, sugatā”ti."
        },
        {
          "id": "sn8.5:4.3",
          "pali": "“Paṭibhātu taṃ, vaṅgīsā”ti bhagavā avoca."
        },
        {
          "id": "sn8.5:4.4",
          "pali": "Atha kho āyasmā vaṅgīso bhagavantaṃ sammukhā sāruppāhi gāthāhi abhitthavi:"
        },
        {
          "id": "sn8.5:5.1",
          "pali": "“Tameva vācaṃ bhāseyya,"
        },
        {
          "id": "sn8.5:5.2",
          "pali": "yāyattānaṃ na tāpaye;"
        },
        {
          "id": "sn8.5:5.3",
          "pali": "Pare ca na vihiṃseyya,"
        },
        {
          "id": "sn8.5:5.4",
          "pali": "sā ve vācā subhāsitā."
        },
        {
          "id": "sn8.5:6.1",
          "pali": "Piyavācaṃva bhāseyya,"
        },
        {
          "id": "sn8.5:6.2",
          "pali": "yā vācā paṭinanditā;"
        },
        {
          "id": "sn8.5:6.3",
          "pali": "Yaṃ anādāya pāpāni,"
        },
        {
          "id": "sn8.5:6.4",
          "pali": "paresaṃ bhāsate piyaṃ."
        },
        {
          "id": "sn8.5:7.1",
          "pali": "Saccaṃ ve amatā vācā,"
        },
        {
          "id": "sn8.5:7.2",
          "pali": "esa dhammo sanantano;"
        },
        {
          "id": "sn8.5:7.3",
          "pali": "Sacce atthe ca dhamme ca,"
        },
        {
          "id": "sn8.5:7.4",
          "pali": "āhu santo patiṭṭhitā."
        },
        {
          "id": "sn8.5:8.1",
          "pali": "Yaṃ buddho bhāsate vācaṃ,"
        },
        {
          "id": "sn8.5:8.2",
          "pali": "khemaṃ nibbānapattiyā;"
        },
        {
          "id": "sn8.5:8.3",
          "pali": "Dukkhassantakiriyāya,"
        },
        {
          "id": "sn8.5:8.4",
          "pali": "sā ve vācānamuttamā”ti."
        }
      ]
    },
    {
      "id": "sn8.6",
      "segments": [
        {
          "id": "sn8.6:0.1",
          "pali": "Saṃyutta Nikāya 8.6"
        },
        {
          "id": "sn8.6:0.2",
          "pali": "1. Vaṅgīsavagga"
        },
        {
          "id": "sn8.6:0.3",
          "pali": "Sāriputtasutta"
        },
        {
          "id": "sn8.6:1.1",
          "pali": "Ekaṃ samayaṃ āyasmā sāriputto sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
        },
        {
          "id": "sn8.6:1.2",
          "pali": "Tena kho pana samayena āyasmā sāriputto bhikkhū dhammiyā kathāya sandasseti samādapeti samuttejeti sampahaṃseti poriyā vācāya vissaṭṭhāya anelagalāya atthassa viññāpaniyā."
        },
        {
          "id": "sn8.6:1.3",
          "pali": "Te ca bhikkhū aṭṭhiṃ katvā manasi katvā sabbacetasā samannāharitvā ohitasotā dhammaṃ suṇanti."
        },
        {
          "id": "sn8.6:1.4",
          "pali": "Atha kho āyasmato vaṅgīsassa etadahosi:"
        },
        {
          "id": "sn8.6:1.5",
          "pali": "“ayaṃ kho āyasmā sāriputto bhikkhū dhammiyā kathāya sandasseti samādapeti samuttejeti sampahaṃseti poriyā vācāya vissaṭṭhāya anelagalāya atthassa viññāpaniyā."
        },
        {
          "id": "sn8.6:1.6",
          "pali": "Te ca bhikkhū aṭṭhiṃ katvā manasi katvā sabbacetasā samannāharitvā ohitasotā dhammaṃ suṇanti."
        },
        {
          "id": "sn8.6:1.7",
          "pali": "Yannūnāhaṃ āyasmantaṃ sāriputtaṃ sammukhā sāruppāhi gāthāhi abhitthaveyyan”ti."
        },
        {
          "id": "sn8.6:2.1",
          "pali": "Atha kho āyasmā vaṅgīso uṭṭhāyāsanā ekaṃsaṃ uttarāsaṅgaṃ karitvā yenāyasmā sāriputto tenañjaliṃ paṇāmetvā āyasmantaṃ sāriputtaṃ etadavoca:"
        },
        {
          "id": "sn8.6:2.2",
          "pali": "“paṭibhāti maṃ, āvuso sāriputta, paṭibhāti maṃ, āvuso sāriputtā”ti."
        },
        {
          "id": "sn8.6:2.3",
          "pali": "“Paṭibhātu taṃ, āvuso vaṅgīsā”ti."
        },
        {
          "id": "sn8.6:2.4",
          "pali": "Atha kho āyasmā vaṅgīso āyasmantaṃ sāriputtaṃ sammukhā sāruppāhi gāthāhi abhitthavi:"
        },
        {
          "id": "sn8.6:3.1",
          "pali": "“Gambhīrapañño medhāvī,"
        },
        {
          "id": "sn8.6:3.2",
          "pali": "maggāmaggassa kovido;"
        },
        {
          "id": "sn8.6:3.3",
          "pali": "Sāriputto mahāpañño,"
        },
        {
          "id": "sn8.6:3.4",
          "pali": "dhammaṃ deseti bhikkhunaṃ."
        },
        {
          "id": "sn8.6:4.1",
          "pali": "Saṅkhittenapi deseti,"
        },
        {
          "id": "sn8.6:4.2",
          "pali": "vitthārenapi bhāsati;"
        },
        {
          "id": "sn8.6:4.3",
          "pali": "Sāḷikāyiva nigghoso,"
        },
        {
          "id": "sn8.6:4.4",
          "pali": "paṭibhānaṃ udīrayi."
        },
        {
          "id": "sn8.6:5.1",
          "pali": "Tassa taṃ desayantassa,"
        },
        {
          "id": "sn8.6:5.2",
          "pali": "suṇanti madhuraṃ giraṃ;"
        },
        {
          "id": "sn8.6:5.3",
          "pali": "Sarena rajanīyena,"
        },
        {
          "id": "sn8.6:5.4",
          "pali": "savanīyena vaggunā;"
        },
        {
          "id": "sn8.6:5.5",
          "pali": "Udaggacittā muditā,"
        },
        {
          "id": "sn8.6:5.6",
          "pali": "sotaṃ odhenti bhikkhavo”ti."
        }
      ]
    },
    {
      "id": "sn8.7",
      "segments": [
        {
          "id": "sn8.7:0.1",
          "pali": "Saṃyutta Nikāya 8.7"
        },
        {
          "id": "sn8.7:0.2",
          "pali": "1. Vaṅgīsavagga"
        },
        {
          "id": "sn8.7:0.3",
          "pali": "Pavāraṇāsutta"
        },
        {
          "id": "sn8.7:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati pubbārāme migāramātupāsāde mahatā bhikkhusaṅghena saddhiṃ pañcamattehi bhikkhusatehi sabbeheva arahantehi."
        },
        {
          "id": "sn8.7:1.2",
          "pali": "Tena kho pana samayena bhagavā tadahuposathe pannarase pavāraṇāya bhikkhusaṅghaparivuto abbhokāse nisinno hoti."
        },
        {
          "id": "sn8.7:1.3",
          "pali": "Atha kho bhagavā tuṇhībhūtaṃ bhikkhusaṅghaṃ anuviloketvā bhikkhū āmantesi:"
        },
        {
          "id": "sn8.7:1.4",
          "pali": "“handa dāni, bhikkhave, pavāremi vo."
        },
        {
          "id": "sn8.7:1.5",
          "pali": "Na ca me kiñci garahatha kāyikaṃ vā vācasikaṃ vā”ti."
        },
        {
          "id": "sn8.7:2.1",
          "pali": "Evaṃ vutte, āyasmā sāriputto uṭṭhāyāsanā ekaṃsaṃ uttarāsaṅgaṃ karitvā yena bhagavā tenañjaliṃ paṇāmetvā bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn8.7:2.2",
          "pali": "“na kho mayaṃ, bhante, bhagavato kiñci garahāma kāyikaṃ vā vācasikaṃ vā."
        },
        {
          "id": "sn8.7:2.3",
          "pali": "Bhagavā hi, bhante, anuppannassa maggassa uppādetā, asañjātassa maggassa sañjanetā, anakkhātassa maggassa akkhātā, maggaññū maggavidū maggakovido."
        },
        {
          "id": "sn8.7:2.4",
          "pali": "Maggānugā ca, bhante, etarahi sāvakā viharanti pacchā samannāgatā;"
        },
        {
          "id": "sn8.7:2.5",
          "pali": "ahañca kho, bhante, bhagavantaṃ pavāremi."
        },
        {
          "id": "sn8.7:2.6",
          "pali": "Na ca me bhagavā kiñci garahati kāyikaṃ vā vācasikaṃ vā”ti."
        },
        {
          "id": "sn8.7:3.1",
          "pali": "“Na khvāhaṃ te, sāriputta, kiñci garahāmi kāyikaṃ vā vācasikaṃ vā."
        },
        {
          "id": "sn8.7:3.2",
          "pali": "Paṇḍito tvaṃ, sāriputta, mahāpañño tvaṃ, sāriputta, puthupañño tvaṃ, sāriputta, hāsapañño tvaṃ, sāriputta, javanapañño tvaṃ, sāriputta, tikkhapañño tvaṃ, sāriputta, nibbedhikapañño tvaṃ, sāriputta."
        },
        {
          "id": "sn8.7:3.3",
          "pali": "Seyyathāpi, sāriputta, rañño cakkavattissa jeṭṭhaputto pitarā pavattitaṃ cakkaṃ sammadeva anuppavatteti;"
        },
        {
          "id": "sn8.7:3.4",
          "pali": "evameva kho tvaṃ, sāriputta, mayā anuttaraṃ dhammacakkaṃ pavattitaṃ sammadeva anuppavattesī”ti."
        },
        {
          "id": "sn8.7:4.1",
          "pali": "“No ce kira me, bhante, bhagavā kiñci garahati kāyikaṃ vā vācasikaṃ vā."
        },
        {
          "id": "sn8.7:4.2",
          "pali": "Imesaṃ pana, bhante, bhagavā pañcannaṃ bhikkhusatānaṃ na kiñci garahati kāyikaṃ vā vācasikaṃ vā”ti."
        },
        {
          "id": "sn8.7:4.3",
          "pali": "“Imesampi khvāhaṃ, sāriputta, pañcannaṃ bhikkhusatānaṃ na kiñci garahāmi kāyikaṃ vā vācasikaṃ vā."
        },
        {
          "id": "sn8.7:4.4",
          "pali": "Imesañhi, sāriputta, pañcannaṃ bhikkhusatānaṃ saṭṭhi bhikkhū tevijjā, saṭṭhi bhikkhū chaḷabhiññā, saṭṭhi bhikkhū ubhatobhāgavimuttā, atha itare paññāvimuttā”ti."
        },
        {
          "id": "sn8.7:5.1",
          "pali": "Atha kho āyasmā vaṅgīso uṭṭhāyāsanā ekaṃsaṃ uttarāsaṅgaṃ karitvā yena bhagavā tenañjaliṃ paṇāmetvā bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn8.7:5.2",
          "pali": "“paṭibhāti maṃ, bhagavā, paṭibhāti maṃ, sugatā”ti."
        },
        {
          "id": "sn8.7:5.3",
          "pali": "“Paṭibhātu taṃ, vaṅgīsā”ti bhagavā avoca."
        },
        {
          "id": "sn8.7:5.4",
          "pali": "Atha kho āyasmā vaṅgīso bhagavantaṃ sammukhā sāruppāhi gāthāhi abhitthavi:"
        },
        {
          "id": "sn8.7:6.1",
          "pali": "“Ajja pannarase visuddhiyā,"
        },
        {
          "id": "sn8.7:6.2",
          "pali": "Bhikkhū pañcasatā samāgatā;"
        },
        {
          "id": "sn8.7:6.3",
          "pali": "Saṃyojanabandhanacchidā,"
        },
        {
          "id": "sn8.7:6.4",
          "pali": "Anīghā khīṇapunabbhavā isī."
        },
        {
          "id": "sn8.7:7.1",
          "pali": "Cakkavattī yathā rājā,"
        },
        {
          "id": "sn8.7:7.2",
          "pali": "amaccaparivārito;"
        },
        {
          "id": "sn8.7:7.3",
          "pali": "Samantā anupariyeti,"
        },
        {
          "id": "sn8.7:7.4",
          "pali": "sāgarantaṃ mahiṃ imaṃ."
        },
        {
          "id": "sn8.7:8.1",
          "pali": "Evaṃ vijitasaṅgāmaṃ,"
        },
        {
          "id": "sn8.7:8.2",
          "pali": "satthavāhaṃ anuttaraṃ;"
        },
        {
          "id": "sn8.7:8.3",
          "pali": "Sāvakā payirupāsanti,"
        },
        {
          "id": "sn8.7:8.4",
          "pali": "tevijjā maccuhāyino."
        },
        {
          "id": "sn8.7:9.1",
          "pali": "Sabbe bhagavato puttā,"
        },
        {
          "id": "sn8.7:9.2",
          "pali": "palāpettha na vijjati;"
        },
        {
          "id": "sn8.7:9.3",
          "pali": "Taṇhāsallassa hantāraṃ,"
        },
        {
          "id": "sn8.7:9.4",
          "pali": "vande ādiccabandhunan”ti."
        }
      ]
    },
    {
      "id": "sn8.8",
      "segments": [
        {
          "id": "sn8.8:0.1",
          "pali": "Saṃyutta Nikāya 8.8"
        },
        {
          "id": "sn8.8:0.2",
          "pali": "1. Vaṅgīsavagga"
        },
        {
          "id": "sn8.8:0.3",
          "pali": "Parosahassasutta"
        },
        {
          "id": "sn8.8:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme mahatā bhikkhusaṅghena saddhiṃ aḍḍhatelasehi bhikkhusatehi."
        },
        {
          "id": "sn8.8:1.2",
          "pali": "Tena kho pana samayena bhagavā bhikkhū nibbānapaṭisaṃyuttāya dhammiyā kathāya sandasseti samādapeti samuttejeti sampahaṃseti."
        },
        {
          "id": "sn8.8:1.3",
          "pali": "Te ca bhikkhū aṭṭhiṃ katvā manasi katvā sabbacetasā samannāharitvā ohitasotā dhammaṃ suṇanti."
        },
        {
          "id": "sn8.8:1.4",
          "pali": "Atha kho āyasmato vaṅgīsassa etadahosi:"
        },
        {
          "id": "sn8.8:1.5",
          "pali": "“ayaṃ kho bhagavā bhikkhū nibbānapaṭisaṃyuttāya dhammiyā kathāya sandasseti samādapeti samuttejeti sampahaṃseti."
        },
        {
          "id": "sn8.8:1.6",
          "pali": "Te ca bhikkhū aṭṭhiṃ katvā manasi katvā sabbacetasā samannāharitvā ohitasotā dhammaṃ suṇanti."
        },
        {
          "id": "sn8.8:1.7",
          "pali": "Yannūnāhaṃ bhagavantaṃ sammukhā sāruppāhi gāthāhi abhitthaveyyan”ti."
        },
        {
          "id": "sn8.8:2.1",
          "pali": "Atha kho āyasmā vaṅgīso uṭṭhāyāsanā ekaṃsaṃ uttarāsaṅgaṃ karitvā yena bhagavā tenañjaliṃ paṇāmetvā bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn8.8:2.2",
          "pali": "“paṭibhāti maṃ, bhagavā, paṭibhāti maṃ, sugatā”ti."
        },
        {
          "id": "sn8.8:2.3",
          "pali": "“Paṭibhātu taṃ, vaṅgīsā”ti bhagavā avoca."
        },
        {
          "id": "sn8.8:2.4",
          "pali": "Atha kho āyasmā vaṅgīso bhagavantaṃ sammukhā sāruppāhi gāthāhi abhitthavi:"
        },
        {
          "id": "sn8.8:3.1",
          "pali": "“Parosahassaṃ bhikkhūnaṃ,"
        },
        {
          "id": "sn8.8:3.2",
          "pali": "sugataṃ payirupāsati;"
        },
        {
          "id": "sn8.8:3.3",
          "pali": "Desentaṃ virajaṃ dhammaṃ,"
        },
        {
          "id": "sn8.8:3.4",
          "pali": "nibbānaṃ akutobhayaṃ."
        },
        {
          "id": "sn8.8:4.1",
          "pali": "Suṇanti dhammaṃ vimalaṃ,"
        },
        {
          "id": "sn8.8:4.2",
          "pali": "sammāsambuddhadesitaṃ;"
        },
        {
          "id": "sn8.8:4.3",
          "pali": "Sobhati vata sambuddho,"
        },
        {
          "id": "sn8.8:4.4",
          "pali": "bhikkhusaṅghapurakkhato."
        },
        {
          "id": "sn8.8:5.1",
          "pali": "Nāganāmosi bhagavā,"
        },
        {
          "id": "sn8.8:5.2",
          "pali": "isīnaṃ isisattamo;"
        },
        {
          "id": "sn8.8:5.3",
          "pali": "Mahāmeghova hutvāna,"
        },
        {
          "id": "sn8.8:5.4",
          "pali": "sāvake abhivassati."
        },
        {
          "id": "sn8.8:6.1",
          "pali": "Divāvihārā nikkhamma,"
        },
        {
          "id": "sn8.8:6.2",
          "pali": "satthudassanakamyatā;"
        },
        {
          "id": "sn8.8:6.3",
          "pali": "Sāvako te mahāvīra,"
        },
        {
          "id": "sn8.8:6.4",
          "pali": "pāde vandati vaṅgiso”ti."
        },
        {
          "id": "sn8.8:7.1",
          "pali": "“Kiṃ nu te, vaṅgīsa, imā gāthāyo pubbe parivitakkitā, udāhu ṭhānasova taṃ paṭibhantī”ti?"
        },
        {
          "id": "sn8.8:7.2",
          "pali": "“Na kho me, bhante, imā gāthāyo pubbe parivitakkitā, atha kho ṭhānasova maṃ paṭibhantī”ti."
        },
        {
          "id": "sn8.8:7.3",
          "pali": "“Tena hi taṃ, vaṅgīsa, bhiyyoso mattāya pubbe aparivitakkitā gāthāyo paṭibhantū”ti."
        },
        {
          "id": "sn8.8:7.4",
          "pali": "“Evaṃ, bhante”ti kho āyasmā vaṅgīso bhagavato paṭissutvā bhiyyoso mattāya bhagavantaṃ pubbe aparivitakkitāhi gāthāhi abhitthavi:"
        },
        {
          "id": "sn8.8:8.1",
          "pali": "“Ummaggapathaṃ mārassa abhibhuyya,"
        },
        {
          "id": "sn8.8:8.2",
          "pali": "Carasi pabhijja khilāni;"
        },
        {
          "id": "sn8.8:8.3",
          "pali": "Taṃ passatha bandhapamuñcakaraṃ,"
        },
        {
          "id": "sn8.8:8.4",
          "pali": "Asitaṃ bhāgaso pavibhajaṃ."
        },
        {
          "id": "sn8.8:9.1",
          "pali": "Oghassa nittharaṇatthaṃ,"
        },
        {
          "id": "sn8.8:9.2",
          "pali": "Anekavihitaṃ maggaṃ akkhāsi;"
        },
        {
          "id": "sn8.8:9.3",
          "pali": "Tasmiñce amate akkhāte,"
        },
        {
          "id": "sn8.8:9.4",
          "pali": "Dhammaddasā ṭhitā asaṃhīrā."
        },
        {
          "id": "sn8.8:10.1",
          "pali": "Pajjotakaro ativijjha,"
        },
        {
          "id": "sn8.8:10.2",
          "pali": "Sabbaṭṭhitīnaṃ atikkamamaddasa;"
        },
        {
          "id": "sn8.8:10.3",
          "pali": "Ñatvā ca sacchikatvā ca,"
        },
        {
          "id": "sn8.8:10.4",
          "pali": "Aggaṃ so desayi dasaddhānaṃ."
        },
        {
          "id": "sn8.8:11.1",
          "pali": "Evaṃ sudesite dhamme,"
        },
        {
          "id": "sn8.8:11.2",
          "pali": "Ko pamādo vijānataṃ dhammaṃ;"
        },
        {
          "id": "sn8.8:11.3",
          "pali": "Tasmā hi tassa bhagavato sāsane,"
        },
        {
          "id": "sn8.8:11.4",
          "pali": "Appamatto sadā namassamanusikkhe”ti."
        }
      ]
    },
    {
      "id": "sn8.9",
      "segments": [
        {
          "id": "sn8.9:0.1",
          "pali": "Saṃyutta Nikāya 8.9"
        },
        {
          "id": "sn8.9:0.2",
          "pali": "1. Vaṅgīsavagga"
        },
        {
          "id": "sn8.9:0.3",
          "pali": "Koṇḍaññasutta"
        },
        {
          "id": "sn8.9:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā rājagahe viharati veḷuvane kalandakanivāpe."
        },
        {
          "id": "sn8.9:1.2",
          "pali": "Atha kho āyasmā aññāsikoṇḍañño sucirasseva yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavato pādesu sirasā nipatitvā bhagavato pādāni mukhena ca paricumbati, pāṇīhi ca parisambāhati, nāmañca sāveti:"
        },
        {
          "id": "sn8.9:1.3",
          "pali": "“koṇḍaññohaṃ, bhagavā, koṇḍaññohaṃ, sugatā”ti."
        },
        {
          "id": "sn8.9:1.4",
          "pali": "Atha kho āyasmato vaṅgīsassa etadahosi:"
        },
        {
          "id": "sn8.9:1.5",
          "pali": "“ayaṃ kho āyasmā aññāsikoṇḍañño sucirasseva yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavato pādesu sirasā nipatitvā bhagavato pādāni mukhena ca paricumbati, pāṇīhi ca parisambāhati, nāmañca sāveti:"
        },
        {
          "id": "sn8.9:1.6",
          "pali": "‘koṇḍaññohaṃ, bhagavā, koṇḍaññohaṃ, sugatā’ti."
        },
        {
          "id": "sn8.9:1.7",
          "pali": "Yannūnāhaṃ āyasmantaṃ aññāsikoṇḍaññaṃ bhagavato sammukhā sāruppāhi gāthāhi abhitthaveyyan”ti."
        },
        {
          "id": "sn8.9:2.1",
          "pali": "Atha kho āyasmā vaṅgīso uṭṭhāyāsanā ekaṃsaṃ uttarāsaṅgaṃ karitvā yena bhagavā tenañjaliṃ paṇāmetvā bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn8.9:2.2",
          "pali": "“paṭibhāti maṃ, bhagavā, paṭibhāti maṃ, sugatā”ti."
        },
        {
          "id": "sn8.9:2.3",
          "pali": "“Paṭibhātu taṃ, vaṅgīsā”ti bhagavā avoca."
        },
        {
          "id": "sn8.9:2.4",
          "pali": "Atha kho āyasmā vaṅgīso āyasmantaṃ aññāsikoṇḍaññaṃ bhagavato sammukhā sāruppāhi gāthāhi abhitthavi:"
        },
        {
          "id": "sn8.9:3.1",
          "pali": "“Buddhānubuddho so thero,"
        },
        {
          "id": "sn8.9:3.2",
          "pali": "koṇḍañño tibbanikkamo;"
        },
        {
          "id": "sn8.9:3.3",
          "pali": "Lābhī sukhavihārānaṃ,"
        },
        {
          "id": "sn8.9:3.4",
          "pali": "vivekānaṃ abhiṇhaso."
        },
        {
          "id": "sn8.9:4.1",
          "pali": "Yaṃ sāvakena pattabbaṃ,"
        },
        {
          "id": "sn8.9:4.2",
          "pali": "satthusāsanakārinā;"
        },
        {
          "id": "sn8.9:4.3",
          "pali": "Sabbassa taṃ anuppattaṃ,"
        },
        {
          "id": "sn8.9:4.4",
          "pali": "appamattassa sikkhato."
        },
        {
          "id": "sn8.9:5.1",
          "pali": "Mahānubhāvo tevijjo,"
        },
        {
          "id": "sn8.9:5.2",
          "pali": "cetopariyāyakovido;"
        },
        {
          "id": "sn8.9:5.3",
          "pali": "Koṇḍañño buddhadāyādo,"
        },
        {
          "id": "sn8.9:5.4",
          "pali": "pāde vandati satthuno”ti."
        }
      ]
    },
    {
      "id": "sn8.10",
      "segments": [
        {
          "id": "sn8.10:0.1",
          "pali": "Saṃyutta Nikāya 8.10"
        },
        {
          "id": "sn8.10:0.2",
          "pali": "1. Vaṅgīsavagga"
        },
        {
          "id": "sn8.10:0.3",
          "pali": "Moggallānasutta"
        },
        {
          "id": "sn8.10:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā rājagahe viharati isigilipasse kāḷasilāyaṃ mahatā bhikkhusaṅghena saddhiṃ pañcamattehi bhikkhusatehi sabbeheva arahantehi."
        },
        {
          "id": "sn8.10:1.2",
          "pali": "Tesaṃ sudaṃ āyasmā mahāmoggallāno cetasā cittaṃ samannesati vippamuttaṃ nirupadhiṃ."
        },
        {
          "id": "sn8.10:1.3",
          "pali": "Atha kho āyasmato vaṅgīsassa etadahosi:"
        },
        {
          "id": "sn8.10:1.4",
          "pali": "“ayaṃ kho bhagavā rājagahe viharati isigilipasse kāḷasilāyaṃ mahatā bhikkhusaṅghena saddhiṃ pañcamattehi bhikkhusatehi sabbeheva arahantehi."
        },
        {
          "id": "sn8.10:1.5",
          "pali": "Tesaṃ sudaṃ āyasmā mahāmoggallāno cetasā cittaṃ samannesati vippamuttaṃ nirupadhiṃ."
        },
        {
          "id": "sn8.10:1.6",
          "pali": "Yannūnāhaṃ āyasmantaṃ mahāmoggallānaṃ bhagavato sammukhā sāruppāhi gāthāhi abhitthaveyyan”ti."
        },
        {
          "id": "sn8.10:2.1",
          "pali": "Atha kho āyasmā vaṅgīso uṭṭhāyāsanā ekaṃsaṃ uttarāsaṅgaṃ karitvā yena bhagavā tenañjaliṃ paṇāmetvā bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn8.10:2.2",
          "pali": "“paṭibhāti maṃ, bhagavā, paṭibhāti maṃ, sugatā”ti."
        },
        {
          "id": "sn8.10:2.3",
          "pali": "“Paṭibhātu taṃ, vaṅgīsā”ti bhagavā avoca."
        },
        {
          "id": "sn8.10:2.4",
          "pali": "Atha kho āyasmā vaṅgīso āyasmantaṃ mahāmoggallānaṃ bhagavato sammukhā sāruppāhi gāthāhi abhitthavi:"
        },
        {
          "id": "sn8.10:3.1",
          "pali": "“Nagassa passe āsīnaṃ,"
        },
        {
          "id": "sn8.10:3.2",
          "pali": "muniṃ dukkhassa pāraguṃ;"
        },
        {
          "id": "sn8.10:3.3",
          "pali": "Sāvakā payirupāsanti,"
        },
        {
          "id": "sn8.10:3.4",
          "pali": "tevijjā maccuhāyino."
        },
        {
          "id": "sn8.10:4.1",
          "pali": "Te cetasā anupariyeti,"
        },
        {
          "id": "sn8.10:4.2",
          "pali": "Moggallāno mahiddhiko;"
        },
        {
          "id": "sn8.10:4.3",
          "pali": "Cittaṃ nesaṃ samannesaṃ,"
        },
        {
          "id": "sn8.10:4.4",
          "pali": "Vippamuttaṃ nirūpadhiṃ."
        },
        {
          "id": "sn8.10:5.1",
          "pali": "Evaṃ sabbaṅgasampannaṃ,"
        },
        {
          "id": "sn8.10:5.2",
          "pali": "Muniṃ dukkhassa pāraguṃ;"
        },
        {
          "id": "sn8.10:5.3",
          "pali": "Anekākārasampannaṃ,"
        },
        {
          "id": "sn8.10:5.4",
          "pali": "Payirupāsanti gotaman”ti."
        }
      ]
    },
    {
      "id": "sn8.11",
      "segments": [
        {
          "id": "sn8.11:0.1",
          "pali": "Saṃyutta Nikāya 8.11"
        },
        {
          "id": "sn8.11:0.2",
          "pali": "1. Vaṅgīsavagga"
        },
        {
          "id": "sn8.11:0.3",
          "pali": "Gaggarāsutta"
        },
        {
          "id": "sn8.11:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā campāyaṃ viharati gaggarāya pokkharaṇiyā tīre mahatā bhikkhusaṅghena saddhiṃ pañcamattehi bhikkhusatehi sattahi ca upāsakasatehi sattahi ca upāsikāsatehi anekehi ca devatāsahassehi."
        },
        {
          "id": "sn8.11:1.2",
          "pali": "Tyāssudaṃ bhagavā atirocati vaṇṇena ceva yasasā ca."
        },
        {
          "id": "sn8.11:1.3",
          "pali": "Atha kho āyasmato vaṅgīsassa etadahosi:"
        },
        {
          "id": "sn8.11:1.4",
          "pali": "“ayaṃ kho bhagavā campāyaṃ viharati gaggarāya pokkharaṇiyā tīre mahatā bhikkhusaṅghena saddhiṃ pañcamattehi bhikkhusatehi sattahi ca upāsakasatehi sattahi ca upāsikāsatehi anekehi ca devatāsahassehi."
        },
        {
          "id": "sn8.11:1.5",
          "pali": "Tyāssudaṃ bhagavā atirocati vaṇṇena ceva yasasā ca."
        },
        {
          "id": "sn8.11:1.6",
          "pali": "Yannūnāhaṃ bhagavantaṃ sammukhā sāruppāya gāthāya abhitthaveyyan”ti."
        },
        {
          "id": "sn8.11:2.1",
          "pali": "Atha kho āyasmā vaṅgīso uṭṭhāyāsanā ekaṃsaṃ uttarāsaṅgaṃ karitvā yena bhagavā tenañjaliṃ paṇāmetvā bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn8.11:2.2",
          "pali": "“paṭibhāti maṃ, bhagavā, paṭibhāti maṃ, sugatā”ti."
        },
        {
          "id": "sn8.11:2.3",
          "pali": "“Paṭibhātu taṃ, vaṅgīsā”ti bhagavā avoca."
        },
        {
          "id": "sn8.11:2.4",
          "pali": "Atha kho āyasmā vaṅgīso bhagavantaṃ sammukhā sāruppāya gāthāya abhitthavi:"
        },
        {
          "id": "sn8.11:3.1",
          "pali": "“Cando yathā vigatavalāhake nabhe,"
        },
        {
          "id": "sn8.11:3.2",
          "pali": "Virocati vigatamalova bhāṇumā;"
        },
        {
          "id": "sn8.11:3.3",
          "pali": "Evampi aṅgīrasa tvaṃ mahāmuni,"
        },
        {
          "id": "sn8.11:3.4",
          "pali": "Atirocasi yasasā sabbalokan”ti."
        }
      ]
    },
    {
      "id": "sn8.12",
      "segments": [
        {
          "id": "sn8.12:0.1",
          "pali": "Saṃyutta Nikāya 8.12"
        },
        {
          "id": "sn8.12:0.2",
          "pali": "1. Vaṅgīsavagga"
        },
        {
          "id": "sn8.12:0.3",
          "pali": "Vaṅgīsasutta"
        },
        {
          "id": "sn8.12:1.1",
          "pali": "Ekaṃ samayaṃ āyasmā vaṅgīso sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
        },
        {
          "id": "sn8.12:1.2",
          "pali": "Tena kho pana samayena āyasmā vaṅgīso aciraarahattappatto hutvā vimuttisukhaṃ paṭisaṃvedī tāyaṃ velāyaṃ imā gāthāyo abhāsi:"
        },
        {
          "id": "sn8.12:2.1",
          "pali": "“Kāveyyamattā vicarimha pubbe,"
        },
        {
          "id": "sn8.12:2.2",
          "pali": "Gāmā gāmaṃ purā puraṃ;"
        },
        {
          "id": "sn8.12:2.3",
          "pali": "Athaddasāma sambuddhaṃ,"
        },
        {
          "id": "sn8.12:2.4",
          "pali": "Saddhā no upapajjatha."
        },
        {
          "id": "sn8.12:3.1",
          "pali": "So me dhammamadesesi,"
        },
        {
          "id": "sn8.12:3.2",
          "pali": "khandhāyatanadhātuyo;"
        },
        {
          "id": "sn8.12:3.3",
          "pali": "Tassāhaṃ dhammaṃ sutvāna,"
        },
        {
          "id": "sn8.12:3.4",
          "pali": "pabbajiṃ anagāriyaṃ."
        },
        {
          "id": "sn8.12:4.1",
          "pali": "Bahunnaṃ vata atthāya,"
        },
        {
          "id": "sn8.12:4.2",
          "pali": "bodhiṃ ajjhagamā muni;"
        },
        {
          "id": "sn8.12:4.3",
          "pali": "Bhikkhūnaṃ bhikkhunīnañca,"
        },
        {
          "id": "sn8.12:4.4",
          "pali": "ye niyāmagataddasā."
        },
        {
          "id": "sn8.12:5.1",
          "pali": "Svāgataṃ vata me āsi,"
        },
        {
          "id": "sn8.12:5.2",
          "pali": "mama buddhassa santike;"
        },
        {
          "id": "sn8.12:5.3",
          "pali": "Tisso vijjā anuppattā,"
        },
        {
          "id": "sn8.12:5.4",
          "pali": "kataṃ buddhassa sāsanaṃ."
        },
        {
          "id": "sn8.12:6.1",
          "pali": "Pubbenivāsaṃ jānāmi,"
        },
        {
          "id": "sn8.12:6.2",
          "pali": "Dibbacakkhuṃ visodhitaṃ;"
        },
        {
          "id": "sn8.12:6.3",
          "pali": "Tevijjo iddhipattomhi,"
        },
        {
          "id": "sn8.12:6.4",
          "pali": "Cetopariyāyakovido”ti."
        },
        {
          "id": "sn8.12:7.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn8.12:7.1",
          "pali": "Nikkhantaṃ arati ceva,"
        },
        {
          "id": "sn8.12:7.2",
          "pali": "pesalā atimaññanā;"
        },
        {
          "id": "sn8.12:7.3",
          "pali": "Ānandena subhāsitā,"
        },
        {
          "id": "sn8.12:7.4",
          "pali": "sāriputtapavāraṇā;"
        },
        {
          "id": "sn8.12:7.5",
          "pali": "Parosahassaṃ koṇḍañño,"
        },
        {
          "id": "sn8.12:7.6",
          "pali": "moggallānena gaggarā;"
        },
        {
          "id": "sn8.12:7.7",
          "pali": "Vaṅgīsena dvādasāti."
        },
        {
          "id": "sn8.12:7.8",
          "pali": "Vaṅgīsasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}