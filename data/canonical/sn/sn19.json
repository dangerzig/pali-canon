{
  "id": "sn19",
  "name_pali": "Lakkhaṇasaṃyutta",
  "name_eng": "Lakkhaṇa",
  "vagga": "Nidānavagga",
  "pts": "S ii 254–262",
  "suttas": [
    {
      "id": "sn19.1",
      "segments": [
        {
          "id": "sn19.1:0.1",
          "pali": "Saṃyutta Nikāya 19.1"
        },
        {
          "id": "sn19.1:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn19.1:0.3",
          "pali": "Aṭṭhisutta"
        },
        {
          "id": "sn19.1:1.1",
          "pali": "Evaṃ me sutaṃ—"
        },
        {
          "id": "sn19.1:1.2",
          "pali": "ekaṃ samayaṃ bhagavā rājagahe viharati veḷuvane kalandakanivāpe."
        },
        {
          "id": "sn19.1:1.3",
          "pali": "Tena kho pana samayena āyasmā ca lakkhaṇo āyasmā ca mahāmoggallāno gijjhakūṭe pabbate viharanti."
        },
        {
          "id": "sn19.1:1.4",
          "pali": "Atha kho āyasmā mahāmoggallāno pubbaṇhasamayaṃ nivāsetvā pattacīvaramādāya yenāyasmā lakkhaṇo tenupasaṅkami; upasaṅkamitvā āyasmantaṃ lakkhaṇaṃ etadavoca:"
        },
        {
          "id": "sn19.1:1.5",
          "pali": "“āyāmāvuso lakkhaṇa, rājagahaṃ piṇḍāya pavisissāmā”ti."
        },
        {
          "id": "sn19.1:1.6",
          "pali": "“Evamāvuso”ti kho āyasmā lakkhaṇo āyasmato mahāmoggallānassa paccassosi."
        },
        {
          "id": "sn19.1:1.7",
          "pali": "Atha kho āyasmā mahāmoggallāno gijjhakūṭā pabbatā orohanto aññatarasmiṃ padese sitaṃ pātvākāsi."
        },
        {
          "id": "sn19.1:1.8",
          "pali": "Atha kho āyasmā lakkhaṇo āyasmantaṃ mahāmoggallānaṃ etadavoca:"
        },
        {
          "id": "sn19.1:1.9",
          "pali": "“ko nu kho, āvuso moggallāna, hetu ko paccayo sitassa pātukammāyā”ti?"
        },
        {
          "id": "sn19.1:1.10",
          "pali": "“Akālo kho, āvuso lakkhaṇa, etassa pañhassa."
        },
        {
          "id": "sn19.1:1.11",
          "pali": "Bhagavato maṃ santike etaṃ pañhaṃ pucchā”ti."
        },
        {
          "id": "sn19.1:2.1",
          "pali": "Atha kho āyasmā ca lakkhaṇo āyasmā ca mahāmoggallāno rājagahe piṇḍāya caritvā pacchābhattaṃ piṇḍapātapaṭikkantā yena bhagavā tenupasaṅkamiṃsu; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdiṃsu. Ekamantaṃ nisinno kho āyasmā lakkhaṇo āyasmantaṃ mahāmoggallānaṃ etadavoca:"
        },
        {
          "id": "sn19.1:2.2",
          "pali": "“idhāyasmā mahāmoggallāno gijjhakūṭā pabbatā orohanto aññatarasmiṃ padese sitaṃ pātvākāsi."
        },
        {
          "id": "sn19.1:2.3",
          "pali": "Ko nu kho, āvuso moggallāna, hetu ko paccayo sitassa pātukammāyā”ti?"
        },
        {
          "id": "sn19.1:3.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ aṭṭhikasaṅkhalikaṃ vehāsaṃ gacchantiṃ."
        },
        {
          "id": "sn19.1:3.2",
          "pali": "Tamenaṃ gijjhāpi kākāpi kulalāpi anupatitvā anupatitvā phāsuḷantarikāhi vitudenti vitacchenti virājenti."
        },
        {
          "id": "sn19.1:3.3",
          "pali": "Sā sudaṃ aṭṭassaraṃ karoti."
        },
        {
          "id": "sn19.1:3.4",
          "pali": "Tassa mayhaṃ, āvuso, etadahosi:"
        },
        {
          "id": "sn19.1:3.5",
          "pali": "‘acchariyaṃ vata bho, abbhutaṃ vata bho."
        },
        {
          "id": "sn19.1:3.6",
          "pali": "Evarūpopi nāma satto bhavissati."
        },
        {
          "id": "sn19.1:3.7",
          "pali": "Evarūpopi nāma yakkho bhavissati."
        },
        {
          "id": "sn19.1:3.8",
          "pali": "Evarūpopi nāma attabhāvapaṭilābho bhavissatī’”ti."
        },
        {
          "id": "sn19.1:4.1",
          "pali": "Atha kho bhagavā bhikkhū āmantesi:"
        },
        {
          "id": "sn19.1:4.2",
          "pali": "“cakkhubhūtā vata, bhikkhave, sāvakā viharanti;"
        },
        {
          "id": "sn19.1:4.3",
          "pali": "ñāṇabhūtā vata, bhikkhave, sāvakā viharanti, yatra hi nāma sāvako evarūpaṃ ñassati vā dakkhati vā sakkhiṃ vā karissati."
        },
        {
          "id": "sn19.1:4.4",
          "pali": "Pubbeva me so, bhikkhave, satto diṭṭho ahosi, api cāhaṃ na byākāsiṃ."
        },
        {
          "id": "sn19.1:4.5",
          "pali": "Ahañcetaṃ byākareyyaṃ, pare ca me na saddaheyyuṃ."
        },
        {
          "id": "sn19.1:4.6",
          "pali": "Ye me na saddaheyyuṃ, tesaṃ taṃ assa dīgharattaṃ ahitāya dukkhāya."
        },
        {
          "id": "sn19.1:4.7",
          "pali": "Eso, bhikkhave, satto imasmiṃyeva rājagahe goghātako ahosi."
        },
        {
          "id": "sn19.1:4.8",
          "pali": "So tassa kammassa vipākena bahūni vassāni bahūni vassasatāni bahūni vassasahassāni bahūni vassasatasahassāni niraye paccitvā tasseva kammassa vipākāvasesena evarūpaṃ attabhāvapaṭilābhaṃ paṭisaṃvedayatī”ti."
        },
        {
          "id": "sn19.1:4.9",
          "pali": "(Sabbesaṃ suttantānaṃ eseva peyyālo.)"
        },
        {
          "id": "sn19.1:4.10",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn19.2",
      "segments": [
        {
          "id": "sn19.2:0.1",
          "pali": "Saṃyutta Nikāya 19.2"
        },
        {
          "id": "sn19.2:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn19.2:0.3",
          "pali": "Pesisutta"
        },
        {
          "id": "sn19.2:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ maṃsapesiṃ vehāsaṃ gacchantiṃ."
        },
        {
          "id": "sn19.2:1.2",
          "pali": "Tamenaṃ gijjhāpi kākāpi kulalāpi anupatitvā anupatitvā vitacchenti virājenti."
        },
        {
          "id": "sn19.2:1.3",
          "pali": "Sā sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.2:1.4",
          "pali": "eso, bhikkhave, satto imasmiṃyeva rājagahe goghātako ahosi …pe…."
        },
        {
          "id": "sn19.2:1.5",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn19.3",
      "segments": [
        {
          "id": "sn19.3:0.1",
          "pali": "Saṃyutta Nikāya 19.3"
        },
        {
          "id": "sn19.3:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn19.3:0.3",
          "pali": "Piṇḍasutta"
        },
        {
          "id": "sn19.3:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ maṃsapiṇḍaṃ vehāsaṃ gacchantaṃ."
        },
        {
          "id": "sn19.3:1.2",
          "pali": "Tamenaṃ gijjhāpi kākāpi kulalāpi anupatitvā anupatitvā vitacchenti virājenti."
        },
        {
          "id": "sn19.3:1.3",
          "pali": "Sā sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.3:1.4",
          "pali": "eso, bhikkhave, satto imasmiṃyeva rājagahe sākuṇiko ahosi …pe…."
        },
        {
          "id": "sn19.3:1.5",
          "pali": "Tatiyaṃ."
        }
      ]
    },
    {
      "id": "sn19.4",
      "segments": [
        {
          "id": "sn19.4:0.1",
          "pali": "Saṃyutta Nikāya 19.4"
        },
        {
          "id": "sn19.4:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn19.4:0.3",
          "pali": "Nicchavisutta"
        },
        {
          "id": "sn19.4:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ nicchaviṃ purisaṃ vehāsaṃ gacchantaṃ."
        },
        {
          "id": "sn19.4:1.2",
          "pali": "Tamenaṃ gijjhāpi kākāpi kulalāpi anupatitvā anupatitvā vitacchenti virājenti."
        },
        {
          "id": "sn19.4:1.3",
          "pali": "So sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.4:1.4",
          "pali": "eso, bhikkhave, satto imasmiṃyeva rājagahe orabbhiko ahosi …pe…."
        },
        {
          "id": "sn19.4:1.5",
          "pali": "Catutthaṃ."
        }
      ]
    },
    {
      "id": "sn19.5",
      "segments": [
        {
          "id": "sn19.5:0.1",
          "pali": "Saṃyutta Nikāya 19.5"
        },
        {
          "id": "sn19.5:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn19.5:0.3",
          "pali": "Asilomasutta"
        },
        {
          "id": "sn19.5:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ asilomaṃ purisaṃ vehāsaṃ gacchantaṃ."
        },
        {
          "id": "sn19.5:1.2",
          "pali": "Tassa te asī uppatitvā uppatitvā tasseva kāye nipatanti."
        },
        {
          "id": "sn19.5:1.3",
          "pali": "So sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.5:1.4",
          "pali": "eso, bhikkhave, satto imasmiṃyeva rājagahe sūkariko ahosi …pe…."
        },
        {
          "id": "sn19.5:1.5",
          "pali": "Pañcamaṃ."
        }
      ]
    },
    {
      "id": "sn19.6",
      "segments": [
        {
          "id": "sn19.6:0.1",
          "pali": "Saṃyutta Nikāya 19.6"
        },
        {
          "id": "sn19.6:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn19.6:0.3",
          "pali": "Sattisutta"
        },
        {
          "id": "sn19.6:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ sattilomaṃ purisaṃ vehāsaṃ gacchantaṃ."
        },
        {
          "id": "sn19.6:1.2",
          "pali": "Tassa tā sattiyo uppatitvā uppatitvā tasseva kāye nipatanti."
        },
        {
          "id": "sn19.6:1.3",
          "pali": "So sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.6:1.4",
          "pali": "eso, bhikkhave, satto imasmiṃyeva rājagahe māgaviko ahosi …pe…."
        },
        {
          "id": "sn19.6:1.5",
          "pali": "Chaṭṭhaṃ."
        }
      ]
    },
    {
      "id": "sn19.7",
      "segments": [
        {
          "id": "sn19.7:0.1",
          "pali": "Saṃyutta Nikāya 19.7"
        },
        {
          "id": "sn19.7:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn19.7:0.3",
          "pali": "Usulomasutta"
        },
        {
          "id": "sn19.7:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ usulomaṃ purisaṃ vehāsaṃ gacchantaṃ."
        },
        {
          "id": "sn19.7:1.2",
          "pali": "Tassa te usū uppatitvā uppatitvā tasseva kāye nipatanti."
        },
        {
          "id": "sn19.7:1.3",
          "pali": "So sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.7:1.4",
          "pali": "eso, bhikkhave, satto imasmiṃyeva rājagahe kāraṇiko ahosi …pe…."
        },
        {
          "id": "sn19.7:1.5",
          "pali": "Sattamaṃ."
        }
      ]
    },
    {
      "id": "sn19.8",
      "segments": [
        {
          "id": "sn19.8:0.1",
          "pali": "Saṃyutta Nikāya 19.8"
        },
        {
          "id": "sn19.8:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn19.8:0.3",
          "pali": "Sūcilomasutta"
        },
        {
          "id": "sn19.8:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ sūcilomaṃ purisaṃ vehāsaṃ gacchantaṃ."
        },
        {
          "id": "sn19.8:1.2",
          "pali": "Tassa tā sūciyo uppatitvā uppatitvā tasseva kāye nipatanti."
        },
        {
          "id": "sn19.8:1.3",
          "pali": "So sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.8:1.4",
          "pali": "eso, bhikkhave, satto imasmiṃyeva rājagahe sūto ahosi …pe…."
        },
        {
          "id": "sn19.8:1.5",
          "pali": "Aṭṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn19.9",
      "segments": [
        {
          "id": "sn19.9:0.1",
          "pali": "Saṃyutta Nikāya 19.9"
        },
        {
          "id": "sn19.9:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn19.9:0.3",
          "pali": "Dutiyasūcilomasutta"
        },
        {
          "id": "sn19.9:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ sūcilomaṃ purisaṃ vehāsaṃ gacchantaṃ."
        },
        {
          "id": "sn19.9:1.2",
          "pali": "Tassa tā sūciyo sīse pavisitvā mukhato nikkhamanti;"
        },
        {
          "id": "sn19.9:1.3",
          "pali": "mukhe pavisitvā urato nikkhamanti;"
        },
        {
          "id": "sn19.9:1.4",
          "pali": "ure pavisitvā udarato nikkhamanti;"
        },
        {
          "id": "sn19.9:1.5",
          "pali": "udare pavisitvā ūrūhi nikkhamanti;"
        },
        {
          "id": "sn19.9:1.6",
          "pali": "ūrūsu pavisitvā jaṅghāhi nikkhamanti;"
        },
        {
          "id": "sn19.9:1.7",
          "pali": "jaṅghāsu pavisitvā pādehi nikkhamanti;"
        },
        {
          "id": "sn19.9:1.8",
          "pali": "so sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.9:1.9",
          "pali": "eso, bhikkhave, satto imasmiṃyeva rājagahe sūcako ahosi …pe…."
        },
        {
          "id": "sn19.9:1.10",
          "pali": "Navamaṃ."
        }
      ]
    },
    {
      "id": "sn19.10",
      "segments": [
        {
          "id": "sn19.10:0.1",
          "pali": "Saṃyutta Nikāya 19.10"
        },
        {
          "id": "sn19.10:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn19.10:0.3",
          "pali": "Kumbhaṇḍasutta"
        },
        {
          "id": "sn19.10:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ kumbhaṇḍaṃ purisaṃ vehāsaṃ gacchantaṃ."
        },
        {
          "id": "sn19.10:1.2",
          "pali": "So gacchantopi teva aṇḍe khandhe āropetvā gacchati."
        },
        {
          "id": "sn19.10:1.3",
          "pali": "Nisīdantopi tesveva aṇḍesu nisīdati."
        },
        {
          "id": "sn19.10:1.4",
          "pali": "Tamenaṃ gijjhāpi kākāpi kulalāpi anupatitvā anupatitvā vitacchenti virājenti."
        },
        {
          "id": "sn19.10:1.5",
          "pali": "So sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.10:1.6",
          "pali": "eso, bhikkhave, satto imasmiṃyeva rājagahe gāmakūṭako ahosi …pe…."
        },
        {
          "id": "sn19.10:1.7",
          "pali": "Dasamaṃ."
        },
        {
          "id": "sn19.10:1.8",
          "pali": "Paṭhamo vaggo."
        },
        {
          "id": "sn19.10:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn19.10:2.1",
          "pali": "Aṭṭhi pesi ubho gāvaghātakā,"
        },
        {
          "id": "sn19.10:2.2",
          "pali": "Piṇḍo sākuṇiyo nicchavorabbhi;"
        },
        {
          "id": "sn19.10:2.3",
          "pali": "Asi sūkariko sattimāgavi,"
        },
        {
          "id": "sn19.10:2.4",
          "pali": "Usu kāraṇiko sūci sārathi;"
        },
        {
          "id": "sn19.10:2.5",
          "pali": "Yo ca sibbiyati sūcako hi so,"
        },
        {
          "id": "sn19.10:2.6",
          "pali": "Aṇḍabhāri ahu gāmakūṭakoti."
        }
      ]
    },
    {
      "id": "sn19.11",
      "segments": [
        {
          "id": "sn19.11:0.1",
          "pali": "Saṃyutta Nikāya 19.11"
        },
        {
          "id": "sn19.11:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn19.11:0.3",
          "pali": "Sasīsakasutta"
        },
        {
          "id": "sn19.11:1.1",
          "pali": "Evaṃ me sutaṃ—"
        },
        {
          "id": "sn19.11:1.2",
          "pali": "ekaṃ samayaṃ rājagahe veḷuvane."
        },
        {
          "id": "sn19.11:1.3",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ purisaṃ gūthakūpe sasīsakaṃ nimuggaṃ …pe…"
        },
        {
          "id": "sn19.11:1.4",
          "pali": "eso, bhikkhave, satto imasmiṃyeva rājagahe pāradāriko ahosi …pe…."
        },
        {
          "id": "sn19.11:1.5",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn19.12",
      "segments": [
        {
          "id": "sn19.12:0.1",
          "pali": "Saṃyutta Nikāya 19.12"
        },
        {
          "id": "sn19.12:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn19.12:0.3",
          "pali": "Gūthakhādasutta"
        },
        {
          "id": "sn19.12:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ purisaṃ gūthakūpe nimuggaṃ ubhohi hatthehi gūthaṃ khādantaṃ …pe…"
        },
        {
          "id": "sn19.12:1.2",
          "pali": "eso, bhikkhave, satto imasmiṃyeva rājagahe duṭṭhabrāhmaṇo ahosi."
        },
        {
          "id": "sn19.12:1.3",
          "pali": "So kassapassa sammāsambuddhassa pāvacane bhikkhusaṅghaṃ bhattena nimantetvā doṇiyo gūthassa pūrāpetvā etadavoca—"
        },
        {
          "id": "sn19.12:1.4",
          "pali": "aho bhonto yāvadatthaṃ bhuñjantu ceva harantu cā’ti …pe…."
        },
        {
          "id": "sn19.12:1.5",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn19.13",
      "segments": [
        {
          "id": "sn19.13:0.1",
          "pali": "Saṃyutta Nikāya 19.13"
        },
        {
          "id": "sn19.13:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn19.13:0.3",
          "pali": "Nicchavitthisutta"
        },
        {
          "id": "sn19.13:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ nicchaviṃ itthiṃ vehāsaṃ gacchantiṃ."
        },
        {
          "id": "sn19.13:1.2",
          "pali": "Tamenaṃ gijjhāpi kākāpi kulalāpi anupatitvā anupatitvā vitacchenti virājenti."
        },
        {
          "id": "sn19.13:1.3",
          "pali": "Sā sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.13:1.4",
          "pali": "esā, bhikkhave, itthī imasmiṃyeva rājagahe aticārinī ahosi …pe…."
        },
        {
          "id": "sn19.13:1.5",
          "pali": "Tatiyaṃ."
        }
      ]
    },
    {
      "id": "sn19.14",
      "segments": [
        {
          "id": "sn19.14:0.1",
          "pali": "Saṃyutta Nikāya 19.14"
        },
        {
          "id": "sn19.14:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn19.14:0.3",
          "pali": "Maṅgulitthisutta"
        },
        {
          "id": "sn19.14:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ itthiṃ duggandhaṃ maṅguliṃ vehāsaṃ gacchantiṃ."
        },
        {
          "id": "sn19.14:1.2",
          "pali": "Tamenaṃ gijjhāpi kākāpi kulalāpi anupatitvā anupatitvā vitacchenti virājenti."
        },
        {
          "id": "sn19.14:1.3",
          "pali": "Sā sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.14:1.4",
          "pali": "esā, bhikkhave, itthī imasmiṃyeva rājagahe ikkhaṇikā ahosi …pe…."
        },
        {
          "id": "sn19.14:1.5",
          "pali": "Catutthaṃ."
        }
      ]
    },
    {
      "id": "sn19.15",
      "segments": [
        {
          "id": "sn19.15:0.1",
          "pali": "Saṃyutta Nikāya 19.15"
        },
        {
          "id": "sn19.15:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn19.15:0.3",
          "pali": "Okilinīsutta"
        },
        {
          "id": "sn19.15:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ itthiṃ uppakkaṃ okiliniṃ okiriniṃ vehāsaṃ gacchantiṃ."
        },
        {
          "id": "sn19.15:1.2",
          "pali": "Sā sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.15:1.3",
          "pali": "esā, bhikkhave, itthī kaliṅgassa rañño aggamahesī ahosi."
        },
        {
          "id": "sn19.15:1.4",
          "pali": "Sā issāpakatā sapattiṃ aṅgārakaṭāhena okiri …pe…."
        },
        {
          "id": "sn19.15:1.5",
          "pali": "Pañcamaṃ."
        }
      ]
    },
    {
      "id": "sn19.16",
      "segments": [
        {
          "id": "sn19.16:0.1",
          "pali": "Saṃyutta Nikāya 19.16"
        },
        {
          "id": "sn19.16:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn19.16:0.3",
          "pali": "Asīsakasutta"
        },
        {
          "id": "sn19.16:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ asīsakaṃ kabandhaṃ vehāsaṃ gacchantaṃ."
        },
        {
          "id": "sn19.16:1.2",
          "pali": "Tassa ure akkhīni ceva honti mukhañca."
        },
        {
          "id": "sn19.16:1.3",
          "pali": "Tamenaṃ gijjhāpi kākāpi kulalāpi anupatitvā anupatitvā vitacchenti virājenti."
        },
        {
          "id": "sn19.16:1.4",
          "pali": "So sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.16:1.5",
          "pali": "eso, bhikkhave, satto imasmiṃyeva rājagahe hāriko nāma coraghātako ahosi …pe…."
        },
        {
          "id": "sn19.16:1.6",
          "pali": "Chaṭṭhaṃ."
        }
      ]
    },
    {
      "id": "sn19.17",
      "segments": [
        {
          "id": "sn19.17:0.1",
          "pali": "Saṃyutta Nikāya 19.17"
        },
        {
          "id": "sn19.17:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn19.17:0.3",
          "pali": "Pāpabhikkhusutta"
        },
        {
          "id": "sn19.17:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ bhikkhuṃ vehāsaṃ gacchantaṃ."
        },
        {
          "id": "sn19.17:1.2",
          "pali": "Tassa saṅghāṭipi ādittā sampajjalitā sajotibhūtā, pattopi āditto sampajjalito sajotibhūto, kāyabandhanampi ādittaṃ sampajjalitaṃ sajotibhūtaṃ, kāyopi āditto sampajjalito sajotibhūto."
        },
        {
          "id": "sn19.17:1.3",
          "pali": "So sudaṃ aṭṭassaraṃ karoti …pe…"
        },
        {
          "id": "sn19.17:1.4",
          "pali": "eso, bhikkhave, bhikkhu kassapassa sammāsambuddhassa pāvacane pāpabhikkhu ahosi …pe…."
        },
        {
          "id": "sn19.17:1.5",
          "pali": "Sattamaṃ."
        }
      ]
    },
    {
      "id": "sn19.18",
      "segments": [
        {
          "id": "sn19.18:0.1",
          "pali": "Saṃyutta Nikāya 19.18"
        },
        {
          "id": "sn19.18:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn19.18:0.3",
          "pali": "Pāpabhikkhunīsutta"
        },
        {
          "id": "sn19.18:1.1",
          "pali": "“Addasaṃ bhikkhuniṃ vehāsaṃ gacchantiṃ."
        },
        {
          "id": "sn19.18:1.2",
          "pali": "Tassā saṅghāṭipi ādittā …pe…"
        },
        {
          "id": "sn19.18:1.3",
          "pali": "pāpabhikkhunī ahosi …pe…."
        },
        {
          "id": "sn19.18:1.4",
          "pali": "Aṭṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn19.19",
      "segments": [
        {
          "id": "sn19.19:0.1",
          "pali": "Saṃyutta Nikāya 19.19"
        },
        {
          "id": "sn19.19:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn19.19:0.3",
          "pali": "Pāpasikkhamānasutta"
        },
        {
          "id": "sn19.19:1.1",
          "pali": "“Addasaṃ sikkhamānaṃ vehāsaṃ gacchantiṃ."
        },
        {
          "id": "sn19.19:1.2",
          "pali": "Tassā saṅghāṭipi ādittā …pe…"
        },
        {
          "id": "sn19.19:1.3",
          "pali": "pāpasikkhamānā ahosi …pe…."
        },
        {
          "id": "sn19.19:1.4",
          "pali": "Navamaṃ."
        }
      ]
    },
    {
      "id": "sn19.20",
      "segments": [
        {
          "id": "sn19.20:0.1",
          "pali": "Saṃyutta Nikāya 19.20"
        },
        {
          "id": "sn19.20:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn19.20:0.3",
          "pali": "Pāpasāmaṇerasutta"
        },
        {
          "id": "sn19.20:1.1",
          "pali": "“Addasaṃ sāmaṇeraṃ vehāsaṃ gacchantaṃ."
        },
        {
          "id": "sn19.20:1.2",
          "pali": "Tassa saṅghāṭipi ādittā …pe…"
        },
        {
          "id": "sn19.20:1.3",
          "pali": "pāpasāmaṇero ahosi …pe…."
        },
        {
          "id": "sn19.20:1.4",
          "pali": "Dasamaṃ."
        }
      ]
    },
    {
      "id": "sn19.21",
      "segments": [
        {
          "id": "sn19.21:0.1",
          "pali": "Saṃyutta Nikāya 19.21"
        },
        {
          "id": "sn19.21:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn19.21:0.3",
          "pali": "Pāpasāmaṇerīsutta"
        },
        {
          "id": "sn19.21:1.1",
          "pali": "“Idhāhaṃ, āvuso, gijjhakūṭā pabbatā orohanto addasaṃ sāmaṇeriṃ vehāsaṃ gacchantiṃ."
        },
        {
          "id": "sn19.21:1.2",
          "pali": "Tassā saṅghāṭipi ādittā sampajjalitā sajotibhūtā, pattopi āditto sampajjalito sajotibhūto, kāyabandhanampi ādittaṃ sampajjalitaṃ sajotibhūtaṃ, kāyopi āditto sampajjalito sajotibhūto."
        },
        {
          "id": "sn19.21:1.3",
          "pali": "Sā sudaṃ aṭṭassaraṃ karoti."
        },
        {
          "id": "sn19.21:1.4",
          "pali": "Tassa mayhaṃ, āvuso, etadahosi:"
        },
        {
          "id": "sn19.21:1.5",
          "pali": "‘acchariyaṃ vata bho, abbhutaṃ vata bho."
        },
        {
          "id": "sn19.21:1.6",
          "pali": "Evarūpopi nāma satto bhavissati."
        },
        {
          "id": "sn19.21:1.7",
          "pali": "Evarūpopi nāma yakkho bhavissati."
        },
        {
          "id": "sn19.21:1.8",
          "pali": "Evarūpopi nāma attabhāvapaṭilābho bhavissatī’”ti."
        },
        {
          "id": "sn19.21:2.1",
          "pali": "Atha kho bhagavā bhikkhū āmantesi:"
        },
        {
          "id": "sn19.21:2.2",
          "pali": "“cakkhubhūtā vata, bhikkhave, sāvakā viharanti;"
        },
        {
          "id": "sn19.21:2.3",
          "pali": "ñāṇabhūtā vata, bhikkhave, sāvakā viharanti, yatra hi nāma sāvako evarūpaṃ ñassati vā dakkhati vā sakkhiṃ vā karissati."
        },
        {
          "id": "sn19.21:2.4",
          "pali": "Pubbeva me sā, bhikkhave, sāmaṇerī diṭṭhā ahosi."
        },
        {
          "id": "sn19.21:2.5",
          "pali": "Api cāhaṃ na byākāsiṃ."
        },
        {
          "id": "sn19.21:2.6",
          "pali": "Ahañcetaṃ byākareyyaṃ, pare ca me na saddaheyyuṃ."
        },
        {
          "id": "sn19.21:2.7",
          "pali": "Ye me na saddaheyyuṃ, tesaṃ taṃ assa dīgharattaṃ ahitāya dukkhāya."
        },
        {
          "id": "sn19.21:2.8",
          "pali": "Esā, bhikkhave, sāmaṇerī kassapassa sammāsambuddhassa pāvacane pāpasāmaṇerī ahosi."
        },
        {
          "id": "sn19.21:2.9",
          "pali": "Sā tassa kammassa vipākena bahūni vassāni bahūni vassasatāni bahūni vassasahassāni bahūni vassasatasahassāni niraye paccitvā tasseva kammassa vipākāvasesena evarūpaṃ attabhāvapaṭilābhaṃ paṭisaṃvedayatī”ti."
        },
        {
          "id": "sn19.21:2.10",
          "pali": "Ekādasamaṃ."
        },
        {
          "id": "sn19.21:2.11",
          "pali": "Dutiyo vaggo."
        },
        {
          "id": "sn19.21:3.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn19.21:3.1",
          "pali": "Kūpe nimuggo hi so pāradāriko,"
        },
        {
          "id": "sn19.21:3.2",
          "pali": "Gūthakhādi ahu duṭṭhabrāhmaṇo;"
        },
        {
          "id": "sn19.21:3.3",
          "pali": "Nicchavitthi aticārinī ahu,"
        },
        {
          "id": "sn19.21:3.4",
          "pali": "Maṅgulitthi ahu ikkhaṇitthikā;"
        },
        {
          "id": "sn19.21:3.5",
          "pali": "Okilini sapattaṅgārokiri,"
        },
        {
          "id": "sn19.21:3.6",
          "pali": "Sīsacchinno ahu coraghātako."
        },
        {
          "id": "sn19.21:4.1",
          "pali": "Bhikkhu bhikkhunī sikkhamānā,"
        },
        {
          "id": "sn19.21:4.2",
          "pali": "Sāmaṇero atha sāmaṇerikā;"
        },
        {
          "id": "sn19.21:4.3",
          "pali": "Kassapassa vinayasmiṃ pabbajjaṃ,"
        },
        {
          "id": "sn19.21:4.4",
          "pali": "Pāpakammaṃ kariṃsu tāvadeti."
        },
        {
          "id": "sn19.21:4.5",
          "pali": "Lakkhaṇasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}