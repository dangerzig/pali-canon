        {
          "id": "sn31.23-112:1.25",
          "pali": "āvasathaṃ deti …"
        },
        {
          "id": "sn31.23-112:1.26",
          "pali": "padīpeyyaṃ deti."
        },
        {
          "id": "sn31.23-112:1.27",
          "pali": "So kāyassa bhedā paraṃ maraṇā gandhagandhe adhivatthānaṃ devānaṃ sahabyataṃ upapajjati."
        },
        {
          "id": "sn31.23-112:1.28",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā gandhagandhe adhivatthānaṃ devānaṃ sahabyataṃ upapajjatī”ti."
        },
        {
          "id": "sn31.23-112:1.29",
          "pali": "Dvādasasatimaṃ."
        },
        {
          "id": "sn31.23-112:2.1",
          "pali": "(Evaṃ piṇḍakena ekasatañca dvādasa ca suttantā honti.)"
        },
        {
          "id": "sn31.23-112:2.2",
          "pali": "Gandhabbavaggo paṭhamo."
        },
        {
          "id": "sn31.23-112:3.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn31.23-112:3.1",
          "pali": "Suddhikañca sucaritaṃ,"
        },
        {
          "id": "sn31.23-112:3.2",
          "pali": "dātā hi apare dasa;"
        },
        {
          "id": "sn31.23-112:3.3",
          "pali": "Dānūpakārā satadhā,"
        },
        {
          "id": "sn31.23-112:3.4",
          "pali": "gandhabbe suppakāsitāti."
        },
        {
          "id": "sn31.23-112:3.5",
          "pali": "Gandhabbakāyasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}