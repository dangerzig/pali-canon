{
  "id": "sn31",
  "name_pali": "Gandhabbasaṃyutta",
  "name_eng": "Gandhabbas",
  "vagga": "Khandhavagga",
  "pts": "S iii 249–251",
  "suttas": [
    {
      "id": "sn31.1",
      "segments": [
        {
          "id": "sn31.1:0.1",
          "pali": "Saṃyutta Nikāya 31.1"
        },
        {
          "id": "sn31.1:0.2",
          "pali": "1. Gandhabbavagga"
        },
        {
          "id": "sn31.1:0.3",
          "pali": "Suddhikasutta"
        },
        {
          "id": "sn31.1:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme …pe…"
        },
        {
          "id": "sn31.1:1.2",
          "pali": "bhagavā etadavoca:"
        },
        {
          "id": "sn31.1:1.3",
          "pali": "“gandhabbakāyike vo, bhikkhave, deve desessāmi."
        },
        {
          "id": "sn31.1:1.4",
          "pali": "Taṃ suṇātha."
        },
        {
          "id": "sn31.1:1.5",
          "pali": "Katamā ca, bhikkhave, gandhabbakāyikā devā?"
        },
        {
          "id": "sn31.1:1.6",
          "pali": "Santi, bhikkhave, mūlagandhe adhivatthā devā."
        },
        {
          "id": "sn31.1:1.7",
          "pali": "Santi, bhikkhave, sāragandhe adhivatthā devā."
        },
        {
          "id": "sn31.1:1.8",
          "pali": "Santi, bhikkhave, pheggugandhe adhivatthā devā."
        },
        {
          "id": "sn31.1:1.9",
          "pali": "Santi, bhikkhave, tacagandhe adhivatthā devā."
        },
        {
          "id": "sn31.1:1.10",
          "pali": "Santi, bhikkhave, papaṭikagandhe adhivatthā devā."
        },
        {
          "id": "sn31.1:1.11",
          "pali": "Santi, bhikkhave, pattagandhe adhivatthā devā."
        },
        {
          "id": "sn31.1:1.12",
          "pali": "Santi, bhikkhave, pupphagandhe adhivatthā devā."
        },
        {
          "id": "sn31.1:1.13",
          "pali": "Santi, bhikkhave, phalagandhe adhivatthā devā."
        },
        {
          "id": "sn31.1:1.14",
          "pali": "Santi, bhikkhave, rasagandhe adhivatthā devā."
        },
        {
          "id": "sn31.1:1.15",
          "pali": "Santi, bhikkhave, gandhagandhe adhivatthā devā."
        },
        {
          "id": "sn31.1:1.16",
          "pali": "Ime vuccanti, bhikkhave, gandhabbakāyikā devā”ti."
        },
        {
          "id": "sn31.1:1.17",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn31.2",
      "segments": [
        {
          "id": "sn31.2:0.1",
          "pali": "Saṃyutta Nikāya 31.2"
        },
        {
          "id": "sn31.2:0.2",
          "pali": "1. Gandhabbavagga"
        },
        {
          "id": "sn31.2:0.3",
          "pali": "Sucaritasutta"
        },
        {
          "id": "sn31.2:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn31.2:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn31.2:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā gandhabbakāyikānaṃ devānaṃ sahabyataṃ upapajjatī”ti?"
        },
        {
          "id": "sn31.2:1.4",
          "pali": "“Idha, bhikkhu, ekacco kāyena sucaritaṃ carati, vācāya sucaritaṃ carati, manasā sucaritaṃ carati."
        },
        {
          "id": "sn31.2:1.5",
          "pali": "Tassa sutaṃ hoti:"
        },
        {
          "id": "sn31.2:1.6",
          "pali": "‘gandhabbakāyikā devā dīghāyukā vaṇṇavanto sukhabahulā’ti."
        },
        {
          "id": "sn31.2:1.7",
          "pali": "Tassa evaṃ hoti:"
        },
        {
          "id": "sn31.2:1.8",
          "pali": "‘aho vatāhaṃ kāyassa bhedā paraṃ maraṇā gandhabbakāyikānaṃ devānaṃ sahabyataṃ upapajjeyyan’ti."
        },
        {
          "id": "sn31.2:1.9",
          "pali": "So kāyassa bhedā paraṃ maraṇā gandhabbakāyikānaṃ devānaṃ sahabyataṃ upapajjati."
        },
        {
          "id": "sn31.2:1.10",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā gandhabbakāyikānaṃ devānaṃ sahabyataṃ upapajjatī”ti."
        },
        {
          "id": "sn31.2:1.11",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn31.3",
      "segments": [
        {
          "id": "sn31.3:0.1",
          "pali": "Saṃyutta Nikāya 31.3"
        },
        {
          "id": "sn31.3:0.2",
          "pali": "1. Gandhabbavagga"
        },
        {
          "id": "sn31.3:0.3",
          "pali": "Mūlagandhadātāsutta"
        },
        {
          "id": "sn31.3:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn31.3:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn31.3:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā mūlagandhe adhivatthānaṃ devānaṃ sahabyataṃ upapajjatī”ti?"
        },
        {
          "id": "sn31.3:1.4",
          "pali": "“Idha, bhikkhu, ekacco kāyena sucaritaṃ carati, vācāya sucaritaṃ carati, manasā sucaritaṃ carati."
        },
        {
          "id": "sn31.3:1.5",
          "pali": "Tassa sutaṃ hoti:"
        },
        {
          "id": "sn31.3:1.6",
          "pali": "‘mūlagandhe adhivatthā devā dīghāyukā vaṇṇavanto sukhabahulā’ti."
        },
        {
          "id": "sn31.3:1.7",
          "pali": "Tassa evaṃ hoti:"
        },
        {
          "id": "sn31.3:1.8",
          "pali": "‘aho vatāhaṃ kāyassa bhedā paraṃ maraṇā mūlagandhe adhivatthānaṃ devānaṃ sahabyataṃ upapajjeyyan’ti."
        },
        {
          "id": "sn31.3:1.9",
          "pali": "So dātā hoti mūlagandhānaṃ."
        },
        {
          "id": "sn31.3:1.10",
          "pali": "So kāyassa bhedā paraṃ maraṇā mūlagandhe adhivatthānaṃ devānaṃ sahabyataṃ upapajjati."
        },
        {
          "id": "sn31.3:1.11",
          "pali": "Ayaṃ kho, bhikkhu, hetu …pe…"
        },
        {
          "id": "sn31.3:1.12",
          "pali": "yena midhekacco kāyassa bhedā paraṃ maraṇā mūlagandhe adhivatthānaṃ devānaṃ sahabyataṃ upapajjatī”ti."
        },
        {
          "id": "sn31.3:1.13",
          "pali": "Tatiyaṃ."
        }
      ]
    },
