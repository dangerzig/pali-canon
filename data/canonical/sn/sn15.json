{
  "id": "sn15",
  "name_pali": "Anamataggasaṃyutta",
  "name_eng": "Without Discoverable Beginning",
  "vagga": "Nidānavagga",
  "pts": "S ii 178–193",
  "suttas": [
    {
      "id": "sn15.1",
      "segments": [
        {
          "id": "sn15.1:0.1",
          "pali": "Saṃyutta Nikāya 15.1"
        },
        {
          "id": "sn15.1:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn15.1:0.3",
          "pali": "Tiṇakaṭṭhasutta"
        },
        {
          "id": "sn15.1:1.1",
          "pali": "Evaṃ me sutaṃ—"
        },
        {
          "id": "sn15.1:1.2",
          "pali": "ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
        },
        {
          "id": "sn15.1:1.3",
          "pali": "Tatra kho bhagavā bhikkhū āmantesi:"
        },
        {
          "id": "sn15.1:1.4",
          "pali": "“bhikkhavo”ti."
        },
        {
          "id": "sn15.1:1.5",
          "pali": "“Bhadante”ti te bhikkhū bhagavato paccassosuṃ."
        },
        {
          "id": "sn15.1:1.6",
          "pali": "Bhagavā etadavoca:"
        },
        {
          "id": "sn15.1:1.7",
          "pali": "“Anamataggoyaṃ, bhikkhave, saṃsāro."
        },
        {
          "id": "sn15.1:1.8",
          "pali": "Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ."
        },
        {
          "id": "sn15.1:1.9",
          "pali": "Seyyathāpi, bhikkhave, puriso yaṃ imasmiṃ jambudīpe tiṇakaṭṭhasākhāpalāsaṃ taṃ chetvā ekajjhaṃ saṃharitvā caturaṅgulaṃ caturaṅgulaṃ ghaṭikaṃ katvā nikkhipeyya:"
        },
        {
          "id": "sn15.1:1.10",
          "pali": "‘ayaṃ me mātā, tassā me mātu ayaṃ mātā’ti, apariyādinnāva, bhikkhave, tassa purisassa mātumātaro assu, atha imasmiṃ jambudīpe tiṇakaṭṭhasākhāpalāsaṃ parikkhayaṃ pariyādānaṃ gaccheyya."
        },
        {
          "id": "sn15.1:1.11",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.1:1.12",
          "pali": "Anamataggoyaṃ, bhikkhave, saṃsāro."
        },
        {
          "id": "sn15.1:1.13",
          "pali": "Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ."
        },
        {
          "id": "sn15.1:1.14",
          "pali": "Evaṃ dīgharattaṃ vo, bhikkhave, dukkhaṃ paccanubhūtaṃ tibbaṃ paccanubhūtaṃ byasanaṃ paccanubhūtaṃ, kaṭasī vaḍḍhitā."
        },
        {
          "id": "sn15.1:1.15",
          "pali": "Yāvañcidaṃ, bhikkhave, alameva sabbasaṅkhāresu nibbindituṃ alaṃ virajjituṃ alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.1:1.16",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn15.2",
      "segments": [
        {
          "id": "sn15.2:0.1",
          "pali": "Saṃyutta Nikāya 15.2"
        },
        {
          "id": "sn15.2:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn15.2:0.3",
          "pali": "Pathavīsutta"
        },
        {
          "id": "sn15.2:1.1",
          "pali": "Sāvatthiyaṃ viharati."
        },
        {
          "id": "sn15.2:1.2",
          "pali": "“Anamataggoyaṃ, bhikkhave, saṃsāro."
        },
        {
          "id": "sn15.2:1.3",
          "pali": "Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ."
        },
        {
          "id": "sn15.2:1.4",
          "pali": "Seyyathāpi, bhikkhave, puriso imaṃ mahāpathaviṃ kolaṭṭhimattaṃ kolaṭṭhimattaṃ mattikāguḷikaṃ karitvā nikkhipeyya:"
        },
        {
          "id": "sn15.2:1.5",
          "pali": "‘ayaṃ me pitā, tassa me pitu ayaṃ pitā’ti, apariyādinnāva bhikkhave, tassa purisassa pitupitaro assu, athāyaṃ mahāpathavī parikkhayaṃ pariyādānaṃ gaccheyya."
        },
        {
          "id": "sn15.2:1.6",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.2:1.7",
          "pali": "Anamataggoyaṃ, bhikkhave, saṃsāro."
        },
        {
          "id": "sn15.2:1.8",
          "pali": "Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ."
        },
        {
          "id": "sn15.2:1.9",
          "pali": "Evaṃ dīgharattaṃ vo, bhikkhave, dukkhaṃ paccanubhūtaṃ tibbaṃ paccanubhūtaṃ byasanaṃ paccanubhūtaṃ, kaṭasī vaḍḍhitā."
        },
        {
          "id": "sn15.2:1.10",
          "pali": "Yāvañcidaṃ, bhikkhave, alameva sabbasaṅkhāresu nibbindituṃ, alaṃ virajjituṃ, alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.2:1.11",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn15.3",
      "segments": [
        {
          "id": "sn15.3:0.1",
          "pali": "Saṃyutta Nikāya 15.3"
        },
        {
          "id": "sn15.3:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn15.3:0.3",
          "pali": "Assusutta"
        },
        {
          "id": "sn15.3:1.1",
          "pali": "Sāvatthiyaṃ viharati."
        },
        {
          "id": "sn15.3:1.2",
          "pali": "“Anamataggoyaṃ, bhikkhave, saṃsāro."
        },
        {
          "id": "sn15.3:1.3",
          "pali": "Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ."
        },
        {
          "id": "sn15.3:1.4",
          "pali": "Taṃ kiṃ maññatha, bhikkhave, katamaṃ nu kho bahutaraṃ, yaṃ vā vo iminā dīghena addhunā sandhāvataṃ saṃsarataṃ amanāpasampayogā manāpavippayogā kandantānaṃ rodantānaṃ assu passannaṃ paggharitaṃ, yaṃ vā catūsu mahāsamuddesu udakan”ti?"
        },
        {
          "id": "sn15.3:1.5",
          "pali": "“Yathā kho mayaṃ, bhante, bhagavatā dhammaṃ desitaṃ ājānāma, etadeva, bhante, bahutaraṃ yaṃ no iminā dīghena addhunā sandhāvataṃ saṃsarataṃ amanāpasampayogā manāpavippayogā kandantānaṃ rodantānaṃ assu passannaṃ paggharitaṃ, na tveva catūsu mahāsamuddesu udakan”ti."
        },
        {
          "id": "sn15.3:2.1",
          "pali": "“Sādhu sādhu, bhikkhave, sādhu kho me tumhe, bhikkhave, evaṃ dhammaṃ desitaṃ ājānātha."
        },
        {
          "id": "sn15.3:2.2",
          "pali": "Etadeva, bhikkhave, bahutaraṃ yaṃ vo iminā dīghena addhunā sandhāvataṃ saṃsarataṃ amanāpasampayogā manāpavippayogā kandantānaṃ rodantānaṃ assu passannaṃ paggharitaṃ, na tveva catūsu mahāsamuddesu udakaṃ."
        },
        {
          "id": "sn15.3:2.3",
          "pali": "Dīgharattaṃ vo, bhikkhave, mātumaraṇaṃ paccanubhūtaṃ;"
        },
        {
          "id": "sn15.3:2.4",
          "pali": "tesaṃ vo mātumaraṇaṃ paccanubhontānaṃ amanāpasampayogā manāpavippayogā kandantānaṃ rodantānaṃ assu passannaṃ paggharitaṃ, na tveva catūsu mahāsamuddesu udakaṃ."
        },
        {
          "id": "sn15.3:2.5",
          "pali": "Dīgharattaṃ vo, bhikkhave, pitumaraṇaṃ paccanubhūtaṃ …pe…"
        },
        {
          "id": "sn15.3:2.6",
          "pali": "bhātumaraṇaṃ paccanubhūtaṃ …"
        },
        {
          "id": "sn15.3:2.7",
          "pali": "bhaginimaraṇaṃ paccanubhūtaṃ …"
        },
        {
          "id": "sn15.3:2.8",
          "pali": "puttamaraṇaṃ paccanubhūtaṃ …"
        },
        {
          "id": "sn15.3:2.9",
          "pali": "dhītumaraṇaṃ paccanubhūtaṃ …"
        },
        {
          "id": "sn15.3:2.10",
          "pali": "ñātibyasanaṃ paccanubhūtaṃ …"
        },
        {
          "id": "sn15.3:2.11",
          "pali": "bhogabyasanaṃ paccanubhūtaṃ."
        },
        {
          "id": "sn15.3:2.12",
          "pali": "Dīgharattaṃ vo, bhikkhave, rogabyasanaṃ paccanubhūtaṃ, tesaṃ vo rogabyasanaṃ paccanubhontānaṃ amanāpasampayogā manāpavippayogā kandantānaṃ rodantānaṃ assu passannaṃ paggharitaṃ, na tveva catūsu mahāsamuddesu udakaṃ."
        },
        {
          "id": "sn15.3:2.13",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.3:2.14",
          "pali": "Anamataggoyaṃ, bhikkhave, saṃsāro …pe…"
        },
        {
          "id": "sn15.3:2.15",
          "pali": "yāvañcidaṃ, bhikkhave, alameva sabbasaṅkhāresu nibbindituṃ, alaṃ virajjituṃ, alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.3:2.16",
          "pali": "Tatiyaṃ."
        }
      ]
    },
    {
      "id": "sn15.4",
      "segments": [
        {
          "id": "sn15.4:0.1",
          "pali": "Saṃyutta Nikāya 15.4"
        },
        {
          "id": "sn15.4:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn15.4:0.3",
          "pali": "Khīrasutta"
        },
        {
          "id": "sn15.4:1.1",
          "pali": "Sāvatthiyaṃ viharati."
        },
        {
          "id": "sn15.4:1.2",
          "pali": "“Anamataggoyaṃ, bhikkhave, saṃsāro."
        },
        {
          "id": "sn15.4:1.3",
          "pali": "Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ."
        },
        {
          "id": "sn15.4:1.4",
          "pali": "Taṃ kiṃ maññatha, bhikkhave, katamaṃ nu kho bahutaraṃ, yaṃ vā vo iminā dīghena addhunā sandhāvataṃ saṃsarataṃ mātuthaññaṃ pītaṃ, yaṃ vā catūsu mahāsamuddesu udakan”ti?"
        },
        {
          "id": "sn15.4:1.5",
          "pali": "“Yathā kho mayaṃ, bhante, bhagavatā dhammaṃ desitaṃ ājānāma, etadeva, bhante, bahutaraṃ yaṃ no iminā dīghena addhunā sandhāvataṃ saṃsarataṃ mātuthaññaṃ pītaṃ, na tveva catūsu mahāsamuddesu udakan”ti."
        },
        {
          "id": "sn15.4:2.1",
          "pali": "“Sādhu sādhu, bhikkhave, sādhu kho me tumhe, bhikkhave, evaṃ dhammaṃ desitaṃ ājānātha."
        },
        {
          "id": "sn15.4:2.2",
          "pali": "Etadeva, bhikkhave, bahutaraṃ yaṃ vo iminā dīghena addhunā sandhāvataṃ saṃsarataṃ mātuthaññaṃ pītaṃ, na tveva catūsu mahāsamuddesu udakaṃ."
        },
        {
          "id": "sn15.4:2.3",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.4:2.4",
          "pali": "Anamataggoyaṃ, bhikkhave, saṃsāro …pe…"
        },
        {
          "id": "sn15.4:2.5",
          "pali": "alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.4:2.6",
          "pali": "Catutthaṃ."
        }
      ]
    },
    {
      "id": "sn15.5",
      "segments": [
        {
          "id": "sn15.5:0.1",
          "pali": "Saṃyutta Nikāya 15.5"
        },
        {
          "id": "sn15.5:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn15.5:0.3",
          "pali": "Pabbatasutta"
        },
        {
          "id": "sn15.5:1.1",
          "pali": "Sāvatthiyaṃ viharati …pe… ārāme …pe…."
        },
        {
          "id": "sn15.5:1.2",
          "pali": "Atha kho aññataro bhikkhu yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn15.5:1.3",
          "pali": "“kīvadīgho nu kho, bhante, kappo”ti?"
        },
        {
          "id": "sn15.5:1.4",
          "pali": "“Dīgho kho, bhikkhu, kappo."
        },
        {
          "id": "sn15.5:1.5",
          "pali": "So na sukaro saṅkhātuṃ ettakāni vassāni iti vā, ettakāni vassasatāni iti vā, ettakāni vassasahassāni iti vā, ettakāni vassasatasahassāni iti vā”ti."
        },
        {
          "id": "sn15.5:2.1",
          "pali": "“Sakkā pana, bhante, upamaṃ kātun”ti?"
        },
        {
          "id": "sn15.5:2.2",
          "pali": "“Sakkā, bhikkhū”ti bhagavā avoca."
        },
        {
          "id": "sn15.5:2.3",
          "pali": "“Seyyathāpi, bhikkhu, mahāselo pabbato yojanaṃ āyāmena yojanaṃ vitthārena yojanaṃ ubbedhena acchinno asusiro ekagghano."
        },
        {
          "id": "sn15.5:2.4",
          "pali": "Tamenaṃ puriso vassasatassa vassasatassa accayena kāsikena vatthena sakiṃ sakiṃ parimajjeyya."
        },
        {
          "id": "sn15.5:2.5",
          "pali": "Khippataraṃ kho so, bhikkhu, mahāselo pabbato iminā upakkamena parikkhayaṃ pariyādānaṃ gaccheyya, na tveva kappo."
        },
        {
          "id": "sn15.5:2.6",
          "pali": "Evaṃ dīgho, bhikkhu, kappo."
        },
        {
          "id": "sn15.5:2.7",
          "pali": "Evaṃ dīghānaṃ kho, bhikkhu, kappānaṃ neko kappo saṃsito, nekaṃ kappasataṃ saṃsitaṃ, nekaṃ kappasahassaṃ saṃsitaṃ, nekaṃ kappasatasahassaṃ saṃsitaṃ."
        },
        {
          "id": "sn15.5:2.8",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.5:2.9",
          "pali": "Anamataggoyaṃ, bhikkhu, saṃsāro."
        },
        {
          "id": "sn15.5:2.10",
          "pali": "Pubbā koṭi …pe…"
        },
        {
          "id": "sn15.5:2.11",
          "pali": "yāvañcidaṃ, bhikkhu, alameva sabbasaṅkhāresu nibbindituṃ, alaṃ virajjituṃ, alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.5:2.12",
          "pali": "Pañcamaṃ."
        }
      ]
    },
    {
      "id": "sn15.6",
      "segments": [
        {
          "id": "sn15.6:0.1",
          "pali": "Saṃyutta Nikāya 15.6"
        },
        {
          "id": "sn15.6:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn15.6:0.3",
          "pali": "Sāsapasutta"
        },
        {
          "id": "sn15.6:1.1",
          "pali": "Sāvatthiyaṃ viharati."
        },
        {
          "id": "sn15.6:1.2",
          "pali": "Atha kho aññataro bhikkhu yena bhagavā …pe… ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn15.6:1.3",
          "pali": "“kīvadīgho nu kho, bhante, kappo”ti?"
        },
        {
          "id": "sn15.6:1.4",
          "pali": "“Dīgho kho, bhikkhu, kappo."
        },
        {
          "id": "sn15.6:1.5",
          "pali": "So na sukaro saṅkhātuṃ ettakāni vassāni iti vā …pe… ettakāni vassasatasahassāni iti vā”ti."
        },
        {
          "id": "sn15.6:2.1",
          "pali": "“Sakkā pana, bhante, upamaṃ kātun”ti?"
        },
        {
          "id": "sn15.6:2.2",
          "pali": "“Sakkā, bhikkhū”ti bhagavā avoca."
        },
        {
          "id": "sn15.6:2.3",
          "pali": "“Seyyathāpi, bhikkhu, āyasaṃ nagaraṃ yojanaṃ āyāmena yojanaṃ vitthārena yojanaṃ ubbedhena, puṇṇaṃ sāsapānaṃ guḷikābaddhaṃ."
        },
        {
          "id": "sn15.6:2.4",
          "pali": "Tato puriso vassasatassa vassasatassa accayena ekamekaṃ sāsapaṃ uddhareyya."
        },
        {
          "id": "sn15.6:2.5",
          "pali": "Khippataraṃ kho so, bhikkhu, mahāsāsaparāsi iminā upakkamena parikkhayaṃ pariyādānaṃ gaccheyya, na tveva kappo."
        },
        {
          "id": "sn15.6:2.6",
          "pali": "Evaṃ dīgho kho, bhikkhu, kappo."
        },
        {
          "id": "sn15.6:2.7",
          "pali": "Evaṃ dīghānaṃ kho, bhikkhu, kappānaṃ neko kappo saṃsito, nekaṃ kappasataṃ saṃsitaṃ, nekaṃ kappasahassaṃ saṃsitaṃ, nekaṃ kappasatasahassaṃ saṃsitaṃ."
        },
        {
          "id": "sn15.6:2.8",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.6:2.9",
          "pali": "Anamataggoyaṃ, bhikkhu, saṃsāro …pe…"
        },
        {
          "id": "sn15.6:2.10",
          "pali": "alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.6:2.11",
          "pali": "Chaṭṭhaṃ."
        }
      ]
    },
    {
      "id": "sn15.7",
      "segments": [
        {
          "id": "sn15.7:0.1",
          "pali": "Saṃyutta Nikāya 15.7"
        },
        {
          "id": "sn15.7:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn15.7:0.3",
          "pali": "Sāvakasutta"
        },
        {
          "id": "sn15.7:1.1",
          "pali": "Sāvatthiyaṃ viharati."
        },
        {
          "id": "sn15.7:1.2",
          "pali": "Atha kho sambahulā bhikkhū yena bhagavā …pe… ekamantaṃ nisinnā kho te bhikkhū bhagavantaṃ etadavocuṃ:"
        },
        {
          "id": "sn15.7:1.3",
          "pali": "“kīvabahukā nu kho, bhante, kappā abbhatītā atikkantā”ti?"
        },
        {
          "id": "sn15.7:1.4",
          "pali": "“Bahukā kho, bhikkhave, kappā abbhatītā atikkantā."
        },
        {
          "id": "sn15.7:1.5",
          "pali": "Te na sukarā saṅkhātuṃ:"
        },
        {
          "id": "sn15.7:1.6",
          "pali": "‘ettakā kappā iti vā, ettakāni kappasatāni iti vā, ettakāni kappasahassāni iti vā, ettakāni kappasatasahassāni iti vā’”ti."
        },
        {
          "id": "sn15.7:2.1",
          "pali": "“Sakkā pana, bhante, upamaṃ kātun”ti?"
        },
        {
          "id": "sn15.7:2.2",
          "pali": "“Sakkā, bhikkhave”ti bhagavā avoca."
        },
        {
          "id": "sn15.7:2.3",
          "pali": "“Idhassu, bhikkhave, cattāro sāvakā vassasatāyukā vassasatajīvino."
        },
        {
          "id": "sn15.7:2.4",
          "pali": "Te divase divase kappasatasahassaṃ kappasatasahassaṃ anussareyyuṃ."
        },
        {
          "id": "sn15.7:2.5",
          "pali": "Ananussaritāva, bhikkhave, tehi kappā assu, atha kho te cattāro sāvakā vassasatāyukā vassasatajīvino vassasatassa accayena kālaṃ kareyyuṃ."
        },
        {
          "id": "sn15.7:2.6",
          "pali": "Evaṃ bahukā kho, bhikkhave, kappā abbhatītā atikkantā."
        },
        {
          "id": "sn15.7:2.7",
          "pali": "Te na sukarā saṅkhātuṃ:"
        },
        {
          "id": "sn15.7:2.8",
          "pali": "‘ettakā kappā iti vā, ettakāni kappasatāni iti vā, ettakāni kappasahassāni iti vā, ettakāni kappasatasahassāni iti vā’ti."
        },
        {
          "id": "sn15.7:2.9",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.7:2.10",
          "pali": "Anamataggoyaṃ, bhikkhave, saṃsāro …pe…"
        },
        {
          "id": "sn15.7:2.11",
          "pali": "alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.7:2.12",
          "pali": "Sattamaṃ."
        }
      ]
    },
    {
      "id": "sn15.8",
      "segments": [
        {
          "id": "sn15.8:0.1",
          "pali": "Saṃyutta Nikāya 15.8"
        },
        {
          "id": "sn15.8:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn15.8:0.3",
          "pali": "Gaṅgāsutta"
        },
        {
          "id": "sn15.8:1.1",
          "pali": "Rājagahe viharati veḷuvane."
        },
        {
          "id": "sn15.8:1.2",
          "pali": "Atha kho aññataro brāhmaṇo yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavatā saddhiṃ sammodi."
        },
        {
          "id": "sn15.8:1.3",
          "pali": "Sammodanīyaṃ kathaṃ sāraṇīyaṃ vītisāretvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho so brāhmaṇo bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn15.8:1.4",
          "pali": "“kīvabahukā nu kho, bho gotama, kappā abbhatītā atikkantā”ti?"
        },
        {
          "id": "sn15.8:1.5",
          "pali": "“Bahukā kho, brāhmaṇa, kappā abbhatītā atikkantā."
        },
        {
          "id": "sn15.8:1.6",
          "pali": "Te na sukarā saṅkhātuṃ:"
        },
        {
          "id": "sn15.8:1.7",
          "pali": "‘ettakā kappā iti vā, ettakāni kappasatāni iti vā, ettakāni kappasahassāni iti vā, ettakāni kappasatasahassāni iti vā’”ti."
        },
        {
          "id": "sn15.8:2.1",
          "pali": "“Sakkā pana, bho gotama, upamaṃ kātun”ti?"
        },
        {
          "id": "sn15.8:2.2",
          "pali": "“Sakkā, brāhmaṇā”ti bhagavā avoca."
        },
        {
          "id": "sn15.8:2.3",
          "pali": "“Seyyathāpi, brāhmaṇa, yato cāyaṃ gaṅgā nadī pabhavati yattha ca mahāsamuddaṃ appeti, yā etasmiṃ antare vālikā sā na sukarā saṅkhātuṃ:"
        },
        {
          "id": "sn15.8:2.4",
          "pali": "‘ettakā vālikā iti vā, ettakāni vālikasatāni iti vā, ettakāni vālikasahassāni iti vā, ettakāni vālikasatasahassāni iti vā’ti."
        },
        {
          "id": "sn15.8:2.5",
          "pali": "Tato bahutarā kho, brāhmaṇa, kappā abbhatītā atikkantā."
        },
        {
          "id": "sn15.8:2.6",
          "pali": "Te na sukarā saṅkhātuṃ:"
        },
        {
          "id": "sn15.8:2.7",
          "pali": "‘ettakā kappā iti vā, ettakāni kappasatāni iti vā, ettakāni kappasahassāni iti vā, ettakāni kappasatasahassāni iti vā’ti."
        },
        {
          "id": "sn15.8:2.8",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.8:2.9",
          "pali": "Anamataggoyaṃ, brāhmaṇa, saṃsāro."
        },
        {
          "id": "sn15.8:2.10",
          "pali": "Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ."
        },
        {
          "id": "sn15.8:2.11",
          "pali": "Evaṃ dīgharattaṃ kho, brāhmaṇa, dukkhaṃ paccanubhūtaṃ tibbaṃ paccanubhūtaṃ byasanaṃ paccanubhūtaṃ, kaṭasī vaḍḍhitā."
        },
        {
          "id": "sn15.8:2.12",
          "pali": "Yāvañcidaṃ, brāhmaṇa, alameva sabbasaṅkhāresu nibbindituṃ, alaṃ virajjituṃ, alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.8:3.1",
          "pali": "Evaṃ vutte, so brāhmaṇo bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn15.8:3.2",
          "pali": "“abhikkantaṃ, bho gotama, abhikkantaṃ, bho gotama …pe…"
        },
        {
          "id": "sn15.8:3.3",
          "pali": "upāsakaṃ maṃ bhavaṃ gotamo dhāretu ajjatagge pāṇupetaṃ saraṇaṃ gatan”ti."
        },
        {
          "id": "sn15.8:3.4",
          "pali": "Aṭṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn15.9",
      "segments": [
        {
          "id": "sn15.9:0.1",
          "pali": "Saṃyutta Nikāya 15.9"
        },
        {
          "id": "sn15.9:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn15.9:0.3",
          "pali": "Daṇḍasutta"
        },
        {
          "id": "sn15.9:1.1",
          "pali": "Sāvatthiyaṃ viharati."
        },
        {
          "id": "sn15.9:1.2",
          "pali": "“Anamataggoyaṃ, bhikkhave, saṃsāro."
        },
        {
          "id": "sn15.9:1.3",
          "pali": "Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ."
        },
        {
          "id": "sn15.9:1.4",
          "pali": "Seyyathāpi, bhikkhave, daṇḍo uparivehāsaṃ khitto sakimpi mūlena nipatati, sakimpi majjhena nipatati, sakimpi antena nipatati;"
        },
        {
          "id": "sn15.9:1.5",
          "pali": "evameva kho, bhikkhave, avijjānīvaraṇā sattā taṇhāsaṃyojanā sandhāvantā saṃsarantā sakimpi asmā lokā paraṃ lokaṃ gacchanti, sakimpi parasmā lokā imaṃ lokaṃ āgacchanti."
        },
        {
          "id": "sn15.9:1.6",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.9:1.7",
          "pali": "Anamataggoyaṃ, bhikkhave, saṃsāro …pe…"
        },
        {
          "id": "sn15.9:1.8",
          "pali": "alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.9:1.9",
          "pali": "Navamaṃ."
        }
      ]
    },
    {
      "id": "sn15.10",
      "segments": [
        {
          "id": "sn15.10:0.1",
          "pali": "Saṃyutta Nikāya 15.10"
        },
        {
          "id": "sn15.10:0.2",
          "pali": "1. Paṭhamavagga"
        },
        {
          "id": "sn15.10:0.3",
          "pali": "Puggalasutta"
        },
        {
          "id": "sn15.10:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā rājagahe viharati gijjhakūṭe pabbate."
        },
        {
          "id": "sn15.10:1.2",
          "pali": "Tatra kho bhagavā bhikkhū āmantesi:"
        },
        {
          "id": "sn15.10:1.3",
          "pali": "“bhikkhavo”ti."
        },
        {
          "id": "sn15.10:1.4",
          "pali": "“Bhadante”ti te bhikkhū bhagavato paccassosuṃ."
        },
        {
          "id": "sn15.10:1.5",
          "pali": "Bhagavā etadavoca:"
        },
        {
          "id": "sn15.10:2.1",
          "pali": "“Anamataggoyaṃ, bhikkhave, saṃsāro …pe…"
        },
        {
          "id": "sn15.10:2.2",
          "pali": "ekapuggalassa, bhikkhave, kappaṃ sandhāvato saṃsarato siyā evaṃ mahā aṭṭhikaṅkalo aṭṭhipuñjo aṭṭhirāsi yathāyaṃ vepullo pabbato, sace saṃhārako assa, sambhatañca na vinasseyya."
        },
        {
          "id": "sn15.10:2.3",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.10:2.4",
          "pali": "Anamataggoyaṃ, bhikkhave, saṃsāro …pe…"
        },
        {
          "id": "sn15.10:2.5",
          "pali": "alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.10:3.1",
          "pali": "Idamavoca bhagavā."
        },
        {
          "id": "sn15.10:3.2",
          "pali": "Idaṃ vatvāna sugato athāparaṃ etadavoca satthā:"
        },
        {
          "id": "sn15.10:4.1",
          "pali": "“Ekassekena kappena,"
        },
        {
          "id": "sn15.10:4.2",
          "pali": "puggalassaṭṭhisañcayo;"
        },
        {
          "id": "sn15.10:4.3",
          "pali": "Siyā pabbatasamo rāsi,"
        },
        {
          "id": "sn15.10:4.4",
          "pali": "iti vuttaṃ mahesinā."
        },
        {
          "id": "sn15.10:5.1",
          "pali": "So kho panāyaṃ akkhāto,"
        },
        {
          "id": "sn15.10:5.2",
          "pali": "vepullo pabbato mahā;"
        },
        {
          "id": "sn15.10:5.3",
          "pali": "Uttaro gijjhakūṭassa,"
        },
        {
          "id": "sn15.10:5.4",
          "pali": "magadhānaṃ giribbaje."
        },
        {
          "id": "sn15.10:6.1",
          "pali": "Yato ca ariyasaccāni,"
        },
        {
          "id": "sn15.10:6.2",
          "pali": "sammappaññāya passati;"
        },
        {
          "id": "sn15.10:6.3",
          "pali": "Dukkhaṃ dukkhasamuppādaṃ,"
        },
        {
          "id": "sn15.10:6.4",
          "pali": "dukkhassa ca atikkamaṃ;"
        },
        {
          "id": "sn15.10:6.5",
          "pali": "Ariyaṃ caṭṭhaṅgikaṃ maggaṃ,"
        },
        {
          "id": "sn15.10:6.6",
          "pali": "dukkhūpasamagāminaṃ."
        },
        {
          "id": "sn15.10:7.1",
          "pali": "Sa sattakkhattuṃparamaṃ,"
        },
        {
          "id": "sn15.10:7.2",
          "pali": "sandhāvitvāna puggalo;"
        },
        {
          "id": "sn15.10:7.3",
          "pali": "Dukkhassantakaro hoti,"
        },
        {
          "id": "sn15.10:7.4",
          "pali": "sabbasaṃyojanakkhayā”ti."
        },
        {
          "id": "sn15.10:7.5",
          "pali": "Dasamaṃ."
        },
        {
          "id": "sn15.10:7.6",
          "pali": "Paṭhamo vaggo."
        },
        {
          "id": "sn15.10:8.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn15.10:8.1",
          "pali": "Tiṇakaṭṭhañca pathavī,"
        },
        {
          "id": "sn15.10:8.2",
          "pali": "assu khīrañca pabbataṃ;"
        },
        {
          "id": "sn15.10:8.3",
          "pali": "Sāsapā sāvakā gaṅgā,"
        },
        {
          "id": "sn15.10:8.4",
          "pali": "daṇḍo ca puggalena cāti."
        }
      ]
    },
    {
      "id": "sn15.11",
      "segments": [
        {
          "id": "sn15.11:0.1",
          "pali": "Saṃyutta Nikāya 15.11"
        },
        {
          "id": "sn15.11:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn15.11:0.3",
          "pali": "Duggatasutta"
        },
        {
          "id": "sn15.11:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati."
        },
        {
          "id": "sn15.11:1.2",
          "pali": "Tatra kho …pe…"
        },
        {
          "id": "sn15.11:1.3",
          "pali": "“Anamataggoyaṃ, bhikkhave, saṃsāro."
        },
        {
          "id": "sn15.11:1.4",
          "pali": "Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ."
        },
        {
          "id": "sn15.11:1.5",
          "pali": "Yaṃ, bhikkhave, passeyyātha duggataṃ durūpetaṃ niṭṭhamettha gantabbaṃ:"
        },
        {
          "id": "sn15.11:1.6",
          "pali": "‘amhehipi evarūpaṃ paccanubhūtaṃ iminā dīghena addhunā’ti."
        },
        {
          "id": "sn15.11:1.7",
          "pali": "Taṃ kissa hetu …pe…"
        },
        {
          "id": "sn15.11:1.8",
          "pali": "yāvañcidaṃ, bhikkhave, alameva sabbasaṅkhāresu nibbindituṃ alaṃ virajjituṃ alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.11:1.9",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn15.12",
      "segments": [
        {
          "id": "sn15.12:0.1",
          "pali": "Saṃyutta Nikāya 15.12"
        },
        {
          "id": "sn15.12:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn15.12:0.3",
          "pali": "Sukhitasutta"
        },
        {
          "id": "sn15.12:1.1",
          "pali": "Sāvatthiyaṃ viharati."
        },
        {
          "id": "sn15.12:1.2",
          "pali": "“Anamataggoyaṃ, bhikkhave, saṃsāro …pe…"
        },
        {
          "id": "sn15.12:1.3",
          "pali": "yaṃ, bhikkhave, passeyyātha sukhitaṃ susajjitaṃ, niṭṭhamettha gantabbaṃ:"
        },
        {
          "id": "sn15.12:1.4",
          "pali": "‘amhehipi evarūpaṃ paccanubhūtaṃ iminā dīghena addhunā’ti."
        },
        {
          "id": "sn15.12:1.5",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.12:1.6",
          "pali": "Anamataggoyaṃ, bhikkhave, saṃsāro."
        },
        {
          "id": "sn15.12:1.7",
          "pali": "Pubbā koṭi na paññāyati …pe…"
        },
        {
          "id": "sn15.12:1.8",
          "pali": "alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.12:1.9",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn15.13",
      "segments": [
        {
          "id": "sn15.13:0.1",
          "pali": "Saṃyutta Nikāya 15.13"
        },
        {
          "id": "sn15.13:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn15.13:0.3",
          "pali": "Tiṃsamattasutta"
        },
        {
          "id": "sn15.13:1.1",
          "pali": "Rājagahe viharati veḷuvane."
        },
        {
          "id": "sn15.13:1.2",
          "pali": "Atha kho tiṃsamattā pāveyyakā bhikkhū sabbe āraññikā sabbe piṇḍapātikā sabbe paṃsukūlikā sabbe tecīvarikā sabbe sasaṃyojanā yena bhagavā tenupasaṅkamiṃsu; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdiṃsu."
        },
        {
          "id": "sn15.13:1.3",
          "pali": "Atha kho bhagavato etadahosi:"
        },
        {
          "id": "sn15.13:1.4",
          "pali": "“ime kho tiṃsamattā pāveyyakā bhikkhū sabbe āraññikā sabbe piṇḍapātikā sabbe paṃsukūlikā sabbe tecīvarikā sabbe sasaṃyojanā."
        },
        {
          "id": "sn15.13:1.5",
          "pali": "Yannūnāhaṃ imesaṃ tathā dhammaṃ deseyyaṃ yathā nesaṃ imasmiṃyeva āsane anupādāya āsavehi cittāni vimucceyyun”ti."
        },
        {
          "id": "sn15.13:1.6",
          "pali": "Atha kho bhagavā bhikkhū āmantesi:"
        },
        {
          "id": "sn15.13:1.7",
          "pali": "“bhikkhavo”ti."
        },
        {
          "id": "sn15.13:1.8",
          "pali": "“Bhadante”ti te bhikkhū bhagavato paccassosuṃ."
        },
        {
          "id": "sn15.13:1.9",
          "pali": "Bhagavā etadavoca:"
        },
        {
          "id": "sn15.13:2.1",
          "pali": "“Anamataggoyaṃ, bhikkhave, saṃsāro."
        },
        {
          "id": "sn15.13:2.2",
          "pali": "Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ."
        },
        {
          "id": "sn15.13:2.3",
          "pali": "Taṃ kiṃ maññatha, bhikkhave, katamaṃ nu kho bahutaraṃ, yaṃ vā vo iminā dīghena addhunā sandhāvataṃ saṃsarataṃ sīsacchinnānaṃ lohitaṃ passannaṃ paggharitaṃ, yaṃ vā catūsu mahāsamuddesu udakan”ti?"
        },
        {
          "id": "sn15.13:2.4",
          "pali": "“Yathā kho mayaṃ, bhante, bhagavatā dhammaṃ desitaṃ ājānāma, etadeva, bhante, bahutaraṃ, yaṃ no iminā dīghena addhunā sandhāvataṃ saṃsarataṃ sīsacchinnānaṃ lohitaṃ passannaṃ paggharitaṃ, na tveva catūsu mahāsamuddesu udakan”ti."
        },
        {
          "id": "sn15.13:3.1",
          "pali": "“Sādhu sādhu, bhikkhave, sādhu kho me tumhe, bhikkhave, evaṃ dhammaṃ desitaṃ ājānātha."
        },
        {
          "id": "sn15.13:3.2",
          "pali": "Etadeva, bhikkhave, bahutaraṃ, yaṃ vo iminā dīghena addhunā sandhāvataṃ saṃsarataṃ sīsacchinnānaṃ lohitaṃ passannaṃ paggharitaṃ, na tveva catūsu mahāsamuddesu udakaṃ."
        },
        {
          "id": "sn15.13:3.3",
          "pali": "Dīgharattaṃ vo, bhikkhave, gunnaṃ sataṃ gobhūtānaṃ sīsacchinnānaṃ lohitaṃ passannaṃ paggharitaṃ, na tveva catūsu mahāsamuddesu udakaṃ."
        },
        {
          "id": "sn15.13:3.4",
          "pali": "Dīgharattaṃ vo, bhikkhave, mahiṃsānaṃ sataṃ mahiṃsabhūtānaṃ sīsacchinnānaṃ lohitaṃ passannaṃ paggharitaṃ …pe…"
        },
        {
          "id": "sn15.13:3.5",
          "pali": "dīgharattaṃ vo, bhikkhave, urabbhānaṃ sataṃ urabbhabhūtānaṃ …pe…"
        },
        {
          "id": "sn15.13:3.6",
          "pali": "ajānaṃ sataṃ ajabhūtānaṃ …"
        },
        {
          "id": "sn15.13:3.7",
          "pali": "migānaṃ sataṃ migabhūtānaṃ …"
        },
        {
          "id": "sn15.13:3.8",
          "pali": "kukkuṭānaṃ sataṃ kukkuṭabhūtānaṃ …"
        },
        {
          "id": "sn15.13:3.9",
          "pali": "sūkarānaṃ sataṃ sūkarabhūtānaṃ …"
        },
        {
          "id": "sn15.13:3.10",
          "pali": "dīgharattaṃ vo, bhikkhave, corā gāmaghātāti gahetvā sīsacchinnānaṃ lohitaṃ passannaṃ paggharitaṃ."
        },
        {
          "id": "sn15.13:3.11",
          "pali": "Dīgharattaṃ vo, bhikkhave, corā pāripanthikāti gahetvā sīsacchinnānaṃ lohitaṃ passannaṃ paggharitaṃ."
        },
        {
          "id": "sn15.13:3.12",
          "pali": "Dīgharattaṃ vo, bhikkhave, corā pāradārikāti gahetvā sīsacchinnānaṃ lohitaṃ passannaṃ paggharitaṃ, na tveva catūsu mahāsamuddesu udakaṃ."
        },
        {
          "id": "sn15.13:3.13",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.13:3.14",
          "pali": "Anamataggoyaṃ, bhikkhave, saṃsāro …pe…"
        },
        {
          "id": "sn15.13:3.15",
          "pali": "alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.13:4.1",
          "pali": "Idamavoca bhagavā."
        },
        {
          "id": "sn15.13:4.2",
          "pali": "Attamanā te bhikkhū bhagavato bhāsitaṃ abhinandunti."
        },
        {
          "id": "sn15.13:4.3",
          "pali": "Imasmiñca pana veyyākaraṇasmiṃ bhaññamāne tiṃsamattānaṃ pāveyyakānaṃ bhikkhūnaṃ anupādāya āsavehi cittāni vimucciṃsūti."
        },
        {
          "id": "sn15.13:4.4",
          "pali": "Tatiyaṃ."
        }
      ]
    },
    {
      "id": "sn15.14",
      "segments": [
        {
          "id": "sn15.14:0.1",
          "pali": "Saṃyutta Nikāya 15.14"
        },
        {
          "id": "sn15.14:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn15.14:0.3",
          "pali": "Mātusutta"
        },
        {
          "id": "sn15.14:1.1",
          "pali": "Sāvatthiyaṃ viharati."
        },
        {
          "id": "sn15.14:1.2",
          "pali": "“Anamataggoyaṃ, bhikkhave, saṃsāro …pe…"
        },
        {
          "id": "sn15.14:1.3",
          "pali": "na so, bhikkhave, satto sulabharūpo yo namātābhūtapubbo iminā dīghena addhunā."
        },
        {
          "id": "sn15.14:1.4",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.14:1.5",
          "pali": "Anamataggoyaṃ, bhikkhave, saṃsāro …pe…"
        },
        {
          "id": "sn15.14:1.6",
          "pali": "alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.14:1.7",
          "pali": "Catutthaṃ."
        }
      ]
    },
    {
      "id": "sn15.15",
      "segments": [
        {
          "id": "sn15.15:0.1",
          "pali": "Saṃyutta Nikāya 15.15"
        },
        {
          "id": "sn15.15:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn15.15:0.3",
          "pali": "Pitusutta"
        },
        {
          "id": "sn15.15:1.1",
          "pali": "Sāvatthiyaṃ viharati."
        },
        {
          "id": "sn15.15:1.2",
          "pali": "“Anamataggoyaṃ, bhikkhave, saṃsāro …pe…"
        },
        {
          "id": "sn15.15:1.3",
          "pali": "na so, bhikkhave, satto sulabharūpo yo napitābhūtapubbo …pe…"
        },
        {
          "id": "sn15.15:1.4",
          "pali": "alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.15:1.5",
          "pali": "Pañcamaṃ."
        }
      ]
    },
    {
      "id": "sn15.16",
      "segments": [
        {
          "id": "sn15.16:0.1",
          "pali": "Saṃyutta Nikāya 15.16"
        },
        {
          "id": "sn15.16:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn15.16:0.3",
          "pali": "Bhātusutta"
        },
        {
          "id": "sn15.16:1.1",
          "pali": "Sāvatthiyaṃ viharati …pe…"
        },
        {
          "id": "sn15.16:1.2",
          "pali": "“na so, bhikkhave, satto sulabharūpo yo nabhātābhūtapubbo …pe…"
        },
        {
          "id": "sn15.16:1.3",
          "pali": "alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.16:1.4",
          "pali": "Chaṭṭhaṃ."
        }
      ]
    },
    {
      "id": "sn15.17",
      "segments": [
        {
          "id": "sn15.17:0.1",
          "pali": "Saṃyutta Nikāya 15.17"
        },
        {
          "id": "sn15.17:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn15.17:0.3",
          "pali": "Bhaginisutta"
        },
        {
          "id": "sn15.17:1.1",
          "pali": "Sāvatthiyaṃ viharati …pe…"
        },
        {
          "id": "sn15.17:1.2",
          "pali": "“na so, bhikkhave, satto sulabharūpo yo nabhaginibhūtapubbo …pe…"
        },
        {
          "id": "sn15.17:1.3",
          "pali": "alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.17:1.4",
          "pali": "Sattamaṃ."
        }
      ]
    },
    {
      "id": "sn15.18",
      "segments": [
        {
          "id": "sn15.18:0.1",
          "pali": "Saṃyutta Nikāya 15.18"
        },
        {
          "id": "sn15.18:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn15.18:0.3",
          "pali": "Puttasutta"
        },
        {
          "id": "sn15.18:1.1",
          "pali": "Sāvatthiyaṃ viharati …pe…"
        },
        {
          "id": "sn15.18:1.2",
          "pali": "“na so, bhikkhave, satto sulabharūpo yo naputtabhūtapubbo …pe…"
        },
        {
          "id": "sn15.18:1.3",
          "pali": "alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.18:1.4",
          "pali": "Aṭṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn15.19",
      "segments": [
        {
          "id": "sn15.19:0.1",
          "pali": "Saṃyutta Nikāya 15.19"
        },
        {
          "id": "sn15.19:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn15.19:0.3",
          "pali": "Dhītusutta"
        },
        {
          "id": "sn15.19:1.1",
          "pali": "Sāvatthiyaṃ viharati."
        },
        {
          "id": "sn15.19:1.2",
          "pali": "“Anamataggoyaṃ, bhikkhave, saṃsāro."
        },
        {
          "id": "sn15.19:1.3",
          "pali": "Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ."
        },
        {
          "id": "sn15.19:1.4",
          "pali": "Na so, bhikkhave, satto sulabharūpo yo na dhītābhūtapubbo iminā dīghena addhunā."
        },
        {
          "id": "sn15.19:1.5",
          "pali": "Taṃ kissa hetu?"
        },
        {
          "id": "sn15.19:1.6",
          "pali": "Anamataggoyaṃ, bhikkhave, saṃsāro."
        },
        {
          "id": "sn15.19:1.7",
          "pali": "Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ."
        },
        {
          "id": "sn15.19:1.8",
          "pali": "Evaṃ dīgharattaṃ vo, bhikkhave, dukkhaṃ paccanubhūtaṃ tibbaṃ paccanubhūtaṃ byasanaṃ paccanubhūtaṃ, kaṭasī vaḍḍhitā."
        },
        {
          "id": "sn15.19:1.9",
          "pali": "Yāvañcidaṃ, bhikkhave, alameva sabbasaṅkhāresu nibbindituṃ, alaṃ virajjituṃ, alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.19:1.10",
          "pali": "Navamaṃ."
        }
      ]
    },
    {
      "id": "sn15.20",
      "segments": [
        {
          "id": "sn15.20:0.1",
          "pali": "Saṃyutta Nikāya 15.20"
        },
        {
          "id": "sn15.20:0.2",
          "pali": "2. Dutiyavagga"
        },
        {
          "id": "sn15.20:0.3",
          "pali": "Vepullapabbatasutta"
        },
        {
          "id": "sn15.20:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā rājagahe viharati gijjhakūṭe pabbate."
        },
        {
          "id": "sn15.20:1.2",
          "pali": "Tatra kho bhagavā bhikkhū āmantesi:"
        },
        {
          "id": "sn15.20:1.3",
          "pali": "“bhikkhavo”ti."
        },
        {
          "id": "sn15.20:1.4",
          "pali": "“Bhadante”ti te bhikkhū bhagavato paccassosuṃ."
        },
        {
          "id": "sn15.20:1.5",
          "pali": "Bhagavā etadavoca:"
        },
        {
          "id": "sn15.20:2.1",
          "pali": "“Anamataggoyaṃ, bhikkhave, saṃsāro."
        },
        {
          "id": "sn15.20:2.2",
          "pali": "Pubbā koṭi na paññāyati avijjānīvaraṇānaṃ sattānaṃ taṇhāsaṃyojanānaṃ sandhāvataṃ saṃsarataṃ."
        },
        {
          "id": "sn15.20:2.3",
          "pali": "Bhūtapubbaṃ, bhikkhave, imassa vepullassa pabbatassa ‘pācīnavaṃso’tveva samaññā udapādi."
        },
        {
          "id": "sn15.20:2.4",
          "pali": "Tena kho pana, bhikkhave, samayena manussānaṃ ‘tivarā’tveva samaññā udapādi."
        },
        {
          "id": "sn15.20:2.5",
          "pali": "Tivarānaṃ, bhikkhave, manussānaṃ cattārīsa vassasahassāni āyuppamāṇaṃ ahosi."
        },
        {
          "id": "sn15.20:2.6",
          "pali": "Tivarā, bhikkhave, manussā pācīnavaṃsaṃ pabbataṃ catūhena ārohanti, catūhena orohanti."
        },
        {
          "id": "sn15.20:2.7",
          "pali": "Tena kho pana, bhikkhave, samayena kakusandho bhagavā arahaṃ sammāsambuddho loke uppanno hoti."
        },
        {
          "id": "sn15.20:2.8",
          "pali": "Kakusandhassa, bhikkhave, bhagavato arahato sammāsambuddhassa vidhurasañjīvaṃ nāma sāvakayugaṃ ahosi aggaṃ bhaddayugaṃ."
        },
        {
          "id": "sn15.20:2.9",
          "pali": "Passatha, bhikkhave, sā cevimassa pabbatassa samaññā antarahitā, te ca manussā kālaṅkatā, so ca bhagavā parinibbuto."
        },
        {
          "id": "sn15.20:2.10",
          "pali": "Evaṃ aniccā, bhikkhave, saṅkhārā;"
        },
        {
          "id": "sn15.20:2.11",
          "pali": "evaṃ addhuvā, bhikkhave, saṅkhārā;"
        },
        {
          "id": "sn15.20:2.12",
          "pali": "evaṃ anassāsikā, bhikkhave, saṅkhārā."
        },
        {
          "id": "sn15.20:2.13",
          "pali": "Yāvañcidaṃ, bhikkhave, alameva sabbasaṅkhāresu nibbindituṃ, alaṃ virajjituṃ, alaṃ vimuccituṃ."
        },
        {
          "id": "sn15.20:3.1",
          "pali": "Bhūtapubbaṃ, bhikkhave, imassa vepullassa pabbatassa ‘vaṅkako’tveva samaññā udapādi."
        },
        {
          "id": "sn15.20:3.2",
          "pali": "Tena kho pana, bhikkhave, samayena manussānaṃ ‘rohitassā’tveva samaññā udapādi."
        },
        {
          "id": "sn15.20:3.3",
          "pali": "Rohitassānaṃ, bhikkhave, manussānaṃ tiṃsavassasahassāni āyuppamāṇaṃ ahosi."
        },
        {
          "id": "sn15.20:3.4",
          "pali": "Rohitassā, bhikkhave, manussā vaṅkakaṃ pabbataṃ tīhena ārohanti, tīhena orohanti."
        },
        {
          "id": "sn15.20:3.5",
          "pali": "Tena kho pana, bhikkhave, samayena koṇāgamano bhagavā arahaṃ sammāsambuddho loke uppanno hoti."
        },
        {
          "id": "sn15.20:3.6",
          "pali": "Koṇāgamanassa, bhikkhave, bhagavato arahato sammāsambuddhassa bhiyyosuttaraṃ nāma sāvakayugaṃ ahosi aggaṃ bhaddayugaṃ."
        },
        {
          "id": "sn15.20:3.7",
          "pali": "Passatha, bhikkhave, sā cevimassa pabbatassa samaññā antarahitā, te ca manussā kālaṅkatā, so ca bhagavā parinibbuto."
        },
        {
          "id": "sn15.20:3.8",
          "pali": "Evaṃ aniccā, bhikkhave, saṅkhārā …pe…"
        },
        {
          "id": "sn15.20:3.9",
          "pali": "alaṃ vimuccituṃ."
        },
        {
          "id": "sn15.20:4.1",
          "pali": "Bhūtapubbaṃ, bhikkhave, imassa vepullassa pabbatassa ‘supasso’tveva samaññā udapādi."
        },
        {
          "id": "sn15.20:4.2",
          "pali": "Tena kho pana, bhikkhave, samayena manussānaṃ ‘suppiyā’tveva samaññā udapādi."
        },
        {
          "id": "sn15.20:4.3",
          "pali": "Suppiyānaṃ, bhikkhave, manussānaṃ vīsativassasahassāni āyuppamāṇaṃ ahosi."
        },
        {
          "id": "sn15.20:4.4",
          "pali": "Suppiyā, bhikkhave, manussā supassaṃ pabbataṃ dvīhena ārohanti, dvīhena orohanti."
        },
        {
          "id": "sn15.20:4.5",
          "pali": "Tena kho pana, bhikkhave, samayena kassapo bhagavā arahaṃ sammāsambuddho loke uppanno hoti."
        },
        {
          "id": "sn15.20:4.6",
          "pali": "Kassapassa, bhikkhave, bhagavato arahato sammāsambuddhassa tissabhāradvājaṃ nāma sāvakayugaṃ ahosi aggaṃ bhaddayugaṃ."
        },
        {
          "id": "sn15.20:4.7",
          "pali": "Passatha, bhikkhave, sā cevimassa pabbatassa samaññā antarahitā, te ca manussā kālaṅkatā, so ca bhagavā parinibbuto."
        },
        {
          "id": "sn15.20:4.8",
          "pali": "Evaṃ aniccā, bhikkhave, saṅkhārā;"
        },
        {
          "id": "sn15.20:4.9",
          "pali": "evaṃ addhuvā, bhikkhave, saṅkhārā …pe…"
        },
        {
          "id": "sn15.20:4.10",
          "pali": "alaṃ vimuccituṃ."
        },
        {
          "id": "sn15.20:5.1",
          "pali": "Etarahi kho pana, bhikkhave, imassa vepullassa pabbatassa ‘vepullo’tveva samaññā udapādi."
        },
        {
          "id": "sn15.20:5.2",
          "pali": "Etarahi kho pana, bhikkhave, imesaṃ manussānaṃ ‘māgadhakā’tveva samaññā udapādi."
        },
        {
          "id": "sn15.20:5.3",
          "pali": "Māgadhakānaṃ, bhikkhave, manussānaṃ appakaṃ āyuppamāṇaṃ parittaṃ lahukaṃ;"
        },
        {
          "id": "sn15.20:5.4",
          "pali": "yo ciraṃ jīvati so vassasataṃ appaṃ vā bhiyyo."
        },
        {
          "id": "sn15.20:5.5",
          "pali": "Māgadhakā, bhikkhave, manussā vepullaṃ pabbataṃ muhuttena ārohanti muhuttena orohanti."
        },
        {
          "id": "sn15.20:5.6",
          "pali": "Etarahi kho panāhaṃ, bhikkhave, arahaṃ sammāsambuddho loke uppanno."
        },
        {
          "id": "sn15.20:5.7",
          "pali": "Mayhaṃ kho pana, bhikkhave, sāriputtamoggallānaṃ nāma sāvakayugaṃ aggaṃ bhaddayugaṃ."
        },
        {
          "id": "sn15.20:5.8",
          "pali": "Bhavissati, bhikkhave, so samayo yā ayañcevimassa pabbatassa samaññā antaradhāyissati, ime ca manussā kālaṃ karissanti, ahañca parinibbāyissāmi."
        },
        {
          "id": "sn15.20:5.9",
          "pali": "Evaṃ aniccā, bhikkhave, saṅkhārā;"
        },
        {
          "id": "sn15.20:5.10",
          "pali": "evaṃ addhuvā, bhikkhave, saṅkhārā;"
        },
        {
          "id": "sn15.20:5.11",
          "pali": "evaṃ anassāsikā, bhikkhave, saṅkhārā."
        },
        {
          "id": "sn15.20:5.12",
          "pali": "Yāvañcidaṃ, bhikkhave, alameva sabbasaṅkhāresu nibbindituṃ, alaṃ virajjituṃ, alaṃ vimuccitun”ti."
        },
        {
          "id": "sn15.20:6.1",
          "pali": "Idamavoca bhagavā."
        },
        {
          "id": "sn15.20:6.2",
          "pali": "Idaṃ vatvāna sugato athāparaṃ etadavoca satthā:"
        },
        {
          "id": "sn15.20:7.1",
          "pali": "“Pācīnavaṃso tivarānaṃ,"
        },
        {
          "id": "sn15.20:7.2",
          "pali": "rohitassāna vaṅkako;"
        },
        {
          "id": "sn15.20:7.3",
          "pali": "Suppiyānaṃ supassoti,"
        },
        {
          "id": "sn15.20:7.4",
          "pali": "māgadhānañca vepullo."
        },
        {
          "id": "sn15.20:8.1",
          "pali": "Aniccā vata saṅkhārā,"
        },
        {
          "id": "sn15.20:8.2",
          "pali": "uppādavayadhammino;"
        },
        {
          "id": "sn15.20:8.3",
          "pali": "Uppajjitvā nirujjhanti,"
        },
        {
          "id": "sn15.20:8.4",
          "pali": "tesaṃ vūpasamo sukho”ti."
        },
        {
          "id": "sn15.20:8.5",
          "pali": "Dasamaṃ."
        },
        {
          "id": "sn15.20:8.6",
          "pali": "Dutiyo vaggo."
        },
        {
          "id": "sn15.20:9.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn15.20:9.1",
          "pali": "Duggataṃ sukhitañceva,"
        },
        {
          "id": "sn15.20:9.2",
          "pali": "tiṃsa mātāpitena ca;"
        },
        {
          "id": "sn15.20:9.3",
          "pali": "Bhātā bhaginī putto ca,"
        },
        {
          "id": "sn15.20:9.4",
          "pali": "dhītā vepullapabbataṃ."
        },
        {
          "id": "sn15.20:9.5",
          "pali": "Anamataggasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}