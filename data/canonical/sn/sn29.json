{
  "id": "sn29",
  "name_pali": "Nāgasaṃyutta",
  "name_eng": "Nāgas",
  "vagga": "Khandhavagga",
  "pts": "S iii 240–242",
  "suttas": [
    {
      "id": "sn29.1",
      "segments": [
        {
          "id": "sn29.1:0.1",
          "pali": "Saṃyutta Nikāya 29.1"
        },
        {
          "id": "sn29.1:0.2",
          "pali": "1. Nāgavagga"
        },
        {
          "id": "sn29.1:0.3",
          "pali": "Suddhikasutta"
        },
        {
          "id": "sn29.1:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn29.1:1.2",
          "pali": "“Catasso imā, bhikkhave, nāgayoniyo."
        },
        {
          "id": "sn29.1:1.3",
          "pali": "Katamā catasso?"
        },
        {
          "id": "sn29.1:1.4",
          "pali": "Aṇḍajā nāgā, jalābujā nāgā, saṃsedajā nāgā, opapātikā nāgā—"
        },
        {
          "id": "sn29.1:1.5",
          "pali": "imā kho, bhikkhave, catasso nāgayoniyo”ti."
        },
        {
          "id": "sn29.1:1.6",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn29.2",
      "segments": [
        {
          "id": "sn29.2:0.1",
          "pali": "Saṃyutta Nikāya 29.2"
        },
        {
          "id": "sn29.2:0.2",
          "pali": "1. Nāgavagga"
        },
        {
          "id": "sn29.2:0.3",
          "pali": "Paṇītatarasutta"
        },
        {
          "id": "sn29.2:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn29.2:1.2",
          "pali": "“Catasso imā, bhikkhave, nāgayoniyo."
        },
        {
          "id": "sn29.2:1.3",
          "pali": "Katamā catasso?"
        },
        {
          "id": "sn29.2:1.4",
          "pali": "Aṇḍajā nāgā, jalābujā nāgā, saṃsedajā nāgā, opapātikā nāgā."
        },
        {
          "id": "sn29.2:1.5",
          "pali": "Tatra, bhikkhave, aṇḍajehi nāgehi jalābujā ca saṃsedajā ca opapātikā ca nāgā paṇītatarā."
        },
        {
          "id": "sn29.2:1.6",
          "pali": "Tatra, bhikkhave, aṇḍajehi ca jalābujehi ca nāgehi saṃsedajā ca opapātikā ca nāgā paṇītatarā."
        },
        {
          "id": "sn29.2:1.7",
          "pali": "Tatra, bhikkhave, aṇḍajehi ca jalābujehi ca saṃsedajehi ca nāgehi opapātikā nāgā paṇītatarā."
        },
        {
          "id": "sn29.2:1.8",
          "pali": "Imā kho, bhikkhave, catasso nāgayoniyo”ti."
        },
        {
          "id": "sn29.2:1.9",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn29.3",
      "segments": [
        {
          "id": "sn29.3:0.1",
          "pali": "Saṃyutta Nikāya 29.3"
        },
        {
          "id": "sn29.3:0.2",
          "pali": "1. Nāgavagga"
        },
        {
          "id": "sn29.3:0.3",
          "pali": "Uposathasutta"
        },
        {
          "id": "sn29.3:1.1",
          "pali": "Ekaṃ samayaṃ bhagavā sāvatthiyaṃ viharati jetavane anāthapiṇḍikassa ārāme."
        },
        {
          "id": "sn29.3:1.2",
          "pali": "Atha kho aññataro bhikkhu yena bhagavā tenupasaṅkami; upasaṅkamitvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn29.3:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yena m’idhekacce aṇḍajā nāgā uposathaṃ upavasanti vossaṭṭhakāyā ca bhavantī”ti?"
        },
        {
          "id": "sn29.3:2.1",
          "pali": "“Idha, bhikkhu, ekaccānaṃ aṇḍajānaṃ nāgānaṃ evaṃ hoti:"
        },
        {
          "id": "sn29.3:2.2",
          "pali": "‘mayaṃ kho pubbe kāyena dvayakārino ahumha, vācāya dvayakārino, manasā dvayakārino."
        },
        {
          "id": "sn29.3:2.3",
          "pali": "Te mayaṃ kāyena dvayakārino, vācāya dvayakārino, manasā dvayakārino, kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ nāgānaṃ sahabyataṃ upapannā."
        },
        {
          "id": "sn29.3:2.4",
          "pali": "Sacajja mayaṃ kāyena sucaritaṃ careyyāma, vācāya sucaritaṃ careyyāma, manasā sucaritaṃ careyyāma, evaṃ mayaṃ kāyassa bhedā paraṃ maraṇā sugatiṃ saggaṃ lokaṃ upapajjeyyāma."
        },
        {
          "id": "sn29.3:2.5",
          "pali": "Handa mayaṃ etarahi kāyena sucaritaṃ carāma, vācāya sucaritaṃ carāma, manasā sucaritaṃ carāmā’ti."
        },
        {
          "id": "sn29.3:2.6",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena m’idhekacce aṇḍajā nāgā uposathaṃ upavasanti vossaṭṭhakāyā ca bhavantī”ti."
        },
        {
          "id": "sn29.3:2.7",
          "pali": "Tatiyaṃ."
        }
      ]
    },
    {
      "id": "sn29.4",
      "segments": [
        {
          "id": "sn29.4:0.1",
          "pali": "Saṃyutta Nikāya 29.4"
        },
