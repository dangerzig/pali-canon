        {
          "id": "sn29.7:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ nāgānaṃ sahabyataṃ upapajjatī”ti?"
        },
        {
          "id": "sn29.7:2.1",
          "pali": "“Idha, bhikkhu, ekacco kāyena dvayakārī hoti, vācāya dvayakārī hoti, manasā dvayakārī hoti."
        },
        {
          "id": "sn29.7:2.2",
          "pali": "Tassa sutaṃ hoti:"
        },
        {
          "id": "sn29.7:2.3",
          "pali": "‘aṇḍajā nāgā dīghāyukā vaṇṇavanto sukhabahulā’ti."
        },
        {
          "id": "sn29.7:2.4",
          "pali": "Tassa evaṃ hoti:"
        },
        {
          "id": "sn29.7:2.5",
          "pali": "‘aho vatāhaṃ kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ nāgānaṃ sahabyataṃ upapajjeyyan’ti."
        },
        {
          "id": "sn29.7:2.6",
          "pali": "So kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ nāgānaṃ sahabyataṃ upapajjati."
        },
        {
          "id": "sn29.7:2.7",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ nāgānaṃ sahabyataṃ upapajjatī”ti."
        },
        {
          "id": "sn29.7:2.8",
          "pali": "Sattamaṃ."
        }
      ]
    },
