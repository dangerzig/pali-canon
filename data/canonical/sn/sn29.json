        },
        {
          "id": "sn29.4:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn29.4:1.2",
          "pali": "Atha kho aññataro bhikkhu yena bhagavā …pe… ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn29.4:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yena m’idhekacce jalābujā nāgā uposathaṃ upavasanti vossaṭṭhakāyā ca bhavantī”ti?"
        },
        {
          "id": "sn29.4:1.4",
          "pali": "(Sabbaṃ vitthāretabbaṃ.)"
        },
        {
          "id": "sn29.4:1.5",
          "pali": "“Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena m’idhekacce jalābujā nāgā uposathaṃ upavasanti vossaṭṭhakāyā ca bhavantī”ti."
        },
        {
          "id": "sn29.4:1.6",
          "pali": "Catutthaṃ."
        }
      ]
    },
