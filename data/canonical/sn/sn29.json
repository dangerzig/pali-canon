        },
        {
          "id": "sn29.11-20:2.12",
          "pali": "mālaṃ deti …pe…"
        },
        {
          "id": "sn29.11-20:2.13",
          "pali": "gandhaṃ deti …pe…"
        },
        {
          "id": "sn29.11-20:2.14",
          "pali": "vilepanaṃ deti …pe…"
        },
        {
          "id": "sn29.11-20:2.15",
          "pali": "seyyaṃ deti …pe…"
        },
        {
          "id": "sn29.11-20:2.16",
          "pali": "āvasathaṃ deti …pe…"
        },
        {
          "id": "sn29.11-20:2.17",
          "pali": "padīpeyyaṃ deti."
        },
        {
          "id": "sn29.11-20:2.18",
          "pali": "So kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ nāgānaṃ sahabyataṃ upapajjati."
        },
        {
          "id": "sn29.11-20:2.19",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ nāgānaṃ sahabyataṃ upapajjatī”ti."
        },
        {
          "id": "sn29.11-20:2.20",
          "pali": "Vīsatimaṃ."
        }
      ]
    },
    {
      "id": "sn29.21-50",
      "segments": [
        {
          "id": "sn29.21-50:0.1",
          "pali": "Saṃyutta Nikāya 29.21–50"
        },
        {
          "id": "sn29.21-50:0.2",
          "pali": "1. Nāgavagga"
        },
        {
          "id": "sn29.21-50:0.3",
          "pali": "Jalābujādidānūpakārasuttattiṃsaka"
        },
        {
          "id": "sn29.21-50:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn29.21-50:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn29.21-50:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā jalābujānaṃ nāgānaṃ …pe…"
        },
        {
          "id": "sn29.21-50:1.4",
          "pali": "saṃsedajānaṃ nāgānaṃ …pe…"
        },
        {
          "id": "sn29.21-50:1.5",
          "pali": "opapātikānaṃ nāgānaṃ sahabyataṃ upapajjatī”ti?"
        },
        {
          "id": "sn29.21-50:2.1",
          "pali": "“Idha, bhikkhu, ekacco kāyena dvayakārī hoti, vācāya dvayakārī, manasā dvayakārī."
        },
        {
          "id": "sn29.21-50:2.2",
          "pali": "Tassa sutaṃ hoti:"
        },
        {
          "id": "sn29.21-50:2.3",
          "pali": "‘opapātikā nāgā dīghāyukā vaṇṇavanto sukhabahulā’ti."
        },
        {
          "id": "sn29.21-50:2.4",
          "pali": "Tassa evaṃ hoti:"
        },
        {
          "id": "sn29.21-50:2.5",
          "pali": "‘aho vatāhaṃ kāyassa bhedā paraṃ maraṇā opapātikānaṃ nāgānaṃ sahabyataṃ upapajjeyyan’ti."
        },
        {
          "id": "sn29.21-50:2.6",
          "pali": "So annaṃ deti …pe…"
        },
        {
          "id": "sn29.21-50:2.7",
          "pali": "pānaṃ deti …pe…"
        },
        {
          "id": "sn29.21-50:2.8",
          "pali": "padīpeyyaṃ deti."
        },
        {
          "id": "sn29.21-50:2.9",
          "pali": "So kāyassa bhedā paraṃ maraṇā opapātikānaṃ nāgānaṃ sahabyataṃ upapajjati."
        },
        {
          "id": "sn29.21-50:2.10",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā opapātikānaṃ nāgānaṃ sahabyataṃ upapajjatī”ti."
        },
        {
          "id": "sn29.21-50:3.1",
          "pali": "(Iminā peyyālena dasa dasa suttantā kātabbā."
        },
        {
          "id": "sn29.21-50:3.2",
          "pali": "Evaṃ catūsu yonīsu cattālīsaṃ veyyākaraṇā honti."
        },
        {
          "id": "sn29.21-50:3.3",
          "pali": "Purimehi pana dasahi suttantehi saha honti paṇṇāsasuttantāti.)"
        },
        {
          "id": "sn29.21-50:3.4",
          "pali": "Nāgavaggo paṭhamo."
        },
        {
          "id": "sn29.21-50:4.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn29.21-50:4.1",
          "pali": "Suddhikaṃ paṇītataraṃ,"
        },
        {
          "id": "sn29.21-50:4.2",
          "pali": "caturo ca uposathā;"
        },
        {
          "id": "sn29.21-50:4.3",
          "pali": "Tassa sutaṃ caturo ca,"
        },
        {
          "id": "sn29.21-50:4.4",
          "pali": "dānūpakārā ca tālīsaṃ;"
        },
        {
          "id": "sn29.21-50:4.5",
          "pali": "Paṇṇāsa piṇḍato suttā,"
        },
        {
          "id": "sn29.21-50:4.6",
          "pali": "nāgamhi suppakāsitāti."
        },
        {
          "id": "sn29.21-50:4.7",
          "pali": "Nāgasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}