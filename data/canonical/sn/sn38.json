{
  "id": "sn38",
  "name_pali": "Jambukhādakasaṃyutta",
  "name_eng": "Jambukhādaka",
  "vagga": "Saḷāyatanavagga",
  "pts": "S iv 251–261",
  "suttas": [
    {
      "id": "sn38.1",
      "segments": [
        {
          "id": "sn38.1:0.1",
          "pali": "Saṃyutta Nikāya 38.1"
        },
        {
          "id": "sn38.1:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.1:0.3",
          "pali": "Nibbānapañhāsutta"
        },
        {
          "id": "sn38.1:1.1",
          "pali": "Ekaṃ samayaṃ āyasmā sāriputto magadhesu viharati nālakagāmake."
        },
        {
          "id": "sn38.1:1.2",
          "pali": "Atha kho jambukhādako paribbājako yenāyasmā sāriputto tenupasaṅkami; upasaṅkamitvā āyasmatā sāriputtena saddhiṃ sammodi."
        },
        {
          "id": "sn38.1:1.3",
          "pali": "Sammodanīyaṃ kathaṃ sāraṇīyaṃ vītisāretvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho jambukhādako paribbājako āyasmantaṃ sāriputtaṃ etadavoca:"
        },
        {
          "id": "sn38.1:2.1",
          "pali": "“‘Nibbānaṃ, nibbānan’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn38.1:2.2",
          "pali": "Katamaṃ nu kho, āvuso, nibbānan”ti?"
        },
        {
          "id": "sn38.1:2.3",
          "pali": "“Yo kho, āvuso, rāgakkhayo dosakkhayo mohakkhayo—"
        },
        {
          "id": "sn38.1:2.4",
          "pali": "idaṃ vuccati nibbānan”ti."
        },
        {
          "id": "sn38.1:2.5",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā etassa nibbānassa sacchikiriyāyā”ti?"
        },
        {
          "id": "sn38.1:2.6",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā etassa nibbānassa sacchikiriyāyā”ti."
        },
        {
          "id": "sn38.1:2.7",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā etassa nibbānassa sacchikiriyāyā”ti?"
        },
        {
          "id": "sn38.1:2.8",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo etassa nibbānassa sacchikiriyāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.1:2.9",
          "pali": "sammādiṭṭhi sammāsaṅkappo sammāvācā sammākammanto sammāājīvo sammāvāyāmo sammāsati sammāsamādhi."
        },
        {
          "id": "sn38.1:2.10",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā etassa nibbānassa sacchikiriyāyā”ti."
        },
        {
          "id": "sn38.1:2.11",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā etassa nibbānassa sacchikiriyāya."
        },
        {
          "id": "sn38.1:2.12",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.1:2.13",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn38.2",
      "segments": [
        {
          "id": "sn38.2:0.1",
          "pali": "Saṃyutta Nikāya 38.2"
        },
        {
          "id": "sn38.2:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.2:0.3",
          "pali": "Arahattapañhāsutta"
        },
        {
          "id": "sn38.2:1.1",
          "pali": "“‘Arahattaṃ, arahattan’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn38.2:1.2",
          "pali": "Katamaṃ nu kho, āvuso, arahattan”ti?"
        },
        {
          "id": "sn38.2:1.3",
          "pali": "“Yo kho, āvuso, rāgakkhayo dosakkhayo mohakkhayo—"
        },
        {
          "id": "sn38.2:1.4",
          "pali": "idaṃ vuccati arahattan”ti."
        },
        {
          "id": "sn38.2:1.5",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā etassa arahattassa sacchikiriyāyā”ti?"
        },
        {
          "id": "sn38.2:1.6",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā etassa arahattassa sacchikiriyāyā”ti."
        },
        {
          "id": "sn38.2:1.7",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā etassa arahattassa sacchikiriyāyā”ti?"
        },
        {
          "id": "sn38.2:1.8",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo etassa arahattassa sacchikiriyāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.2:1.9",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.2:1.10",
          "pali": "Ayaṃ kho, āvuso, maggo, ayaṃ paṭipadā etassa arahattassa sacchikiriyāyā”ti."
        },
        {
          "id": "sn38.2:1.11",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā etassa arahattassa sacchikiriyāya."
        },
        {
          "id": "sn38.2:1.12",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.2:1.13",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn38.3",
      "segments": [
        {
          "id": "sn38.3:0.1",
          "pali": "Saṃyutta Nikāya 38.3"
        },
        {
          "id": "sn38.3:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.3:0.3",
          "pali": "Dhammavādīpañhāsutta"
        },
        {
          "id": "sn38.3:1.1",
          "pali": "“Ke nu kho, āvuso sāriputta, loke dhammavādino, ke loke suppaṭipannā, ke loke sugatā”ti?"
        },
        {
          "id": "sn38.3:1.2",
          "pali": "“Ye kho, āvuso, rāgappahānāya dhammaṃ desenti, dosappahānāya dhammaṃ desenti, mohappahānāya dhammaṃ desenti, te loke dhammavādino."
        },
        {
          "id": "sn38.3:1.3",
          "pali": "Ye kho, āvuso, rāgassa pahānāya paṭipannā, dosassa pahānāya paṭipannā, mohassa pahānāya paṭipannā, te loke suppaṭipannā."
        },
        {
          "id": "sn38.3:1.4",
          "pali": "Yesaṃ kho, āvuso, rāgo pahīno ucchinnamūlo tālāvatthukato anabhāvaṅkato āyatiṃ anuppādadhammo, doso pahīno ucchinnamūlo tālāvatthukato anabhāvaṅkato āyatiṃ anuppādadhammo, moho pahīno ucchinnamūlo tālāvatthukato anabhāvaṅkato āyatiṃ anuppādadhammo, te loke sugatā”ti."
        },
        {
          "id": "sn38.3:2.1",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā etassa rāgassa dosassa mohassa pahānāyā”ti?"
        },
        {
          "id": "sn38.3:2.2",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā etassa rāgassa dosassa mohassa pahānāyā”ti."
        },
        {
          "id": "sn38.3:2.3",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā etassa rāgassa dosassa mohassa pahānāyā”ti?"
        },
        {
          "id": "sn38.3:2.4",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo etassa rāgassa dosassa mohassa pahānāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.3:2.5",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.3:2.6",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā etassa rāgassa dosassa mohassa pahānāyā”ti."
        },
        {
          "id": "sn38.3:2.7",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etassa rāgassa dosassa mohassa pahānāya."
        },
        {
          "id": "sn38.3:2.8",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.3:2.9",
          "pali": "Tatiyaṃ."
        }
      ]
    },
    {
      "id": "sn38.4",
      "segments": [
        {
          "id": "sn38.4:0.1",
          "pali": "Saṃyutta Nikāya 38.4"
        },
        {
          "id": "sn38.4:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.4:0.3",
          "pali": "Kimatthiyasutta"
        },
        {
          "id": "sn38.4:1.1",
          "pali": "“Kimatthiyaṃ, āvuso sāriputta, samaṇe gotame brahmacariyaṃ vussatī”ti?"
        },
        {
          "id": "sn38.4:1.2",
          "pali": "“Dukkhassa kho, āvuso, pariññatthaṃ bhagavati brahmacariyaṃ vussatī”ti."
        },
        {
          "id": "sn38.4:1.3",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā etassa dukkhassa pariññāyā”ti?"
        },
        {
          "id": "sn38.4:1.4",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā, etassa dukkhassa pariññāyā”ti?"
        },
        {
          "id": "sn38.4:1.5",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā, etassa dukkhassa pariññāyā”ti?"
        },
        {
          "id": "sn38.4:2.1",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo, etassa dukkhassa pariññāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.4:2.2",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.4:2.3",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā etassa dukkhassa pariññāyā”ti."
        },
        {
          "id": "sn38.4:2.4",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etassa dukkhassa pariññāya."
        },
        {
          "id": "sn38.4:2.5",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.4:2.6",
          "pali": "Catutthaṃ."
        }
      ]
    },
    {
      "id": "sn38.5",
      "segments": [
        {
          "id": "sn38.5:0.1",
          "pali": "Saṃyutta Nikāya 38.5"
        },
        {
          "id": "sn38.5:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.5:0.3",
          "pali": "Assāsappattasutta"
        },
        {
          "id": "sn38.5:1.1",
          "pali": "“‘Assāsappatto, assāsappatto’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn38.5:1.2",
          "pali": "Kittāvatā nu kho, āvuso, assāsappatto hotī”ti?"
        },
        {
          "id": "sn38.5:1.3",
          "pali": "“Yato kho, āvuso, bhikkhu channaṃ phassāyatanānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ pajānāti, ettāvatā kho, āvuso, assāsappatto hotī”ti."
        },
        {
          "id": "sn38.5:1.4",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā, etassa assāsassa sacchikiriyāyā”ti?"
        },
        {
          "id": "sn38.5:1.5",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā, etassa assāsassa sacchikiriyāyā”ti."
        },
        {
          "id": "sn38.5:1.6",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā, etassa assāsassa sacchikiriyāyā”ti?"
        },
        {
          "id": "sn38.5:1.7",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo etassa assāsassa sacchikiriyāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.5:1.8",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.5:1.9",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā, etassa assāsassa sacchikiriyāyā”ti."
        },
        {
          "id": "sn38.5:1.10",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etassa assāsassa sacchikiriyāya."
        },
        {
          "id": "sn38.5:1.11",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.5:1.12",
          "pali": "Pañcamaṃ."
        }
      ]
    },
    {
      "id": "sn38.6",
      "segments": [
        {
          "id": "sn38.6:0.1",
          "pali": "Saṃyutta Nikāya 38.6"
        },
        {
          "id": "sn38.6:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.6:0.3",
          "pali": "Paramassāsappattasutta"
        },
        {
          "id": "sn38.6:1.1",
          "pali": "“‘Paramassāsappatto, paramassāsappatto’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn38.6:1.2",
          "pali": "Kittāvatā nu kho, āvuso, paramassāsappatto hotī”ti?"
        },
        {
          "id": "sn38.6:1.3",
          "pali": "“Yato kho, āvuso, bhikkhu channaṃ phassāyatanānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā anupādāvimutto hoti, ettāvatā kho, āvuso, paramassāsappatto hotī”ti."
        },
        {
          "id": "sn38.6:1.4",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā, etassa paramassāsassa sacchikiriyāyā”ti?"
        },
        {
          "id": "sn38.6:1.5",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā, etassa paramassāsassa sacchikiriyāyā”ti."
        },
        {
          "id": "sn38.6:1.6",
          "pali": "“Katamo pana, āvuso, maggo katamā paṭipadā, etassa paramassāsassa sacchikiriyāyā”ti?"
        },
        {
          "id": "sn38.6:1.7",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo etassa paramassāsassa sacchikiriyāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.6:1.8",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.6:1.9",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā, etassa paramassāsassa sacchikiriyāyā”ti."
        },
        {
          "id": "sn38.6:1.10",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etassa paramassāsassa sacchikiriyāya."
        },
        {
          "id": "sn38.6:1.11",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.6:1.12",
          "pali": "Chaṭṭhaṃ."
        }
      ]
    },
    {
      "id": "sn38.7",
      "segments": [
        {
          "id": "sn38.7:0.1",
          "pali": "Saṃyutta Nikāya 38.7"
        },
        {
          "id": "sn38.7:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.7:0.3",
          "pali": "Vedanāpañhāsutta"
        },
        {
          "id": "sn38.7:1.1",
          "pali": "“‘Vedanā, vedanā’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn38.7:1.2",
          "pali": "Katamā nu kho, āvuso, vedanā”ti?"
        },
        {
          "id": "sn38.7:1.3",
          "pali": "“Tisso imāvuso, vedanā."
        },
        {
          "id": "sn38.7:1.4",
          "pali": "Katamā tisso?"
        },
        {
          "id": "sn38.7:1.5",
          "pali": "Sukhā vedanā, dukkhā vedanā, adukkhamasukhā vedanā—"
        },
        {
          "id": "sn38.7:1.6",
          "pali": "imā kho, āvuso, tisso vedanā”ti."
        },
        {
          "id": "sn38.7:1.7",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā, etāsaṃ tissannaṃ vedanānaṃ pariññāyā”ti?"
        },
        {
          "id": "sn38.7:1.8",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā, etāsaṃ tissannaṃ vedanānaṃ pariññāyā”ti."
        },
        {
          "id": "sn38.7:1.9",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā, etāsaṃ tissannaṃ vedanānaṃ pariññāyā”ti?"
        },
        {
          "id": "sn38.7:1.10",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo, etāsaṃ tissannaṃ vedanānaṃ pariññāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.7:1.11",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.7:1.12",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā, etāsaṃ tissannaṃ vedanānaṃ pariññāyā”ti."
        },
        {
          "id": "sn38.7:1.13",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etāsaṃ tissannaṃ vedanānaṃ pariññāya."
        },
        {
          "id": "sn38.7:1.14",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.7:1.15",
          "pali": "Sattamaṃ."
        }
      ]
    },
    {
      "id": "sn38.8",
      "segments": [
        {
          "id": "sn38.8:0.1",
          "pali": "Saṃyutta Nikāya 38.8"
        },
        {
          "id": "sn38.8:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.8:0.3",
          "pali": "Āsavapañhāsutta"
        },
        {
          "id": "sn38.8:1.1",
          "pali": "“‘Āsavo, āsavo’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn38.8:1.2",
          "pali": "Katamo nu kho, āvuso, āsavo”ti?"
        },
        {
          "id": "sn38.8:1.3",
          "pali": "“Tayo me, āvuso, āsavā."
        },
        {
          "id": "sn38.8:1.4",
          "pali": "Kāmāsavo, bhavāsavo, avijjāsavo—"
        },
        {
          "id": "sn38.8:1.5",
          "pali": "ime kho, āvuso, tayo āsavā”ti."
        },
        {
          "id": "sn38.8:1.6",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā etesaṃ āsavānaṃ pahānāyā”ti?"
        },
        {
          "id": "sn38.8:1.7",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā etesaṃ āsavānaṃ pahānāyā”ti."
        },
        {
          "id": "sn38.8:1.8",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā etesaṃ āsavānaṃ pahānāyā”ti?"
        },
        {
          "id": "sn38.8:1.9",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo etesaṃ āsavānaṃ pahānāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.8:1.10",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.8:1.11",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā, etesaṃ āsavānaṃ pahānāyā”ti."
        },
        {
          "id": "sn38.8:1.12",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etesaṃ āsavānaṃ pahānāya."
        },
        {
          "id": "sn38.8:1.13",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.8:1.14",
          "pali": "Aṭṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn38.9",
      "segments": [
        {
          "id": "sn38.9:0.1",
          "pali": "Saṃyutta Nikāya 38.9"
        },
        {
          "id": "sn38.9:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.9:0.3",
          "pali": "Avijjāpañhāsutta"
        },
        {
          "id": "sn38.9:1.1",
          "pali": "“‘Avijjā, avijjā’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn38.9:1.2",
          "pali": "Katamā nu kho, āvuso, avijjā”ti?"
        },
        {
          "id": "sn38.9:1.3",
          "pali": "“Yaṃ kho, āvuso, dukkhe aññāṇaṃ, dukkhasamudaye aññāṇaṃ, dukkhanirodhe aññāṇaṃ, dukkhanirodhagāminiyā paṭipadāya aññāṇaṃ—"
        },
        {
          "id": "sn38.9:1.4",
          "pali": "ayaṃ vuccatāvuso, avijjā”ti."
        },
        {
          "id": "sn38.9:1.5",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā, etissā avijjāya pahānāyā”ti?"
        },
        {
          "id": "sn38.9:1.6",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā, etissā avijjāya pahānāyā”ti."
        },
        {
          "id": "sn38.9:1.7",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā, etissā avijjāya pahānāyā”ti?"
        },
        {
          "id": "sn38.9:1.8",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo, etissā avijjāya pahānāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.9:1.9",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.9:1.10",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā, etissā avijjāya pahānāyā”ti."
        },
        {
          "id": "sn38.9:1.11",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etissā avijjāya pahānāya."
        },
        {
          "id": "sn38.9:1.12",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.9:1.13",
          "pali": "Navamaṃ."
        }
      ]
    },
    {
      "id": "sn38.10",
      "segments": [
        {
          "id": "sn38.10:0.1",
          "pali": "Saṃyutta Nikāya 38.10"
        },
        {
          "id": "sn38.10:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.10:0.3",
          "pali": "Taṇhāpañhāsutta"
        },
        {
          "id": "sn38.10:1.1",
          "pali": "“‘Taṇhā, taṇhā’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn38.10:1.2",
          "pali": "Katamā nu kho, āvuso, taṇhā”ti?"
        },
        {
          "id": "sn38.10:1.3",
          "pali": "“Tisso imā, āvuso, taṇhā."
        },
        {
          "id": "sn38.10:1.4",
          "pali": "Kāmataṇhā, bhavataṇhā, vibhavataṇhā—"
        },
        {
          "id": "sn38.10:1.5",
          "pali": "imā kho, āvuso, tisso taṇhā”ti."
        },
        {
          "id": "sn38.10:1.6",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā, etāsaṃ taṇhānaṃ pahānāyā”ti?"
        },
        {
          "id": "sn38.10:1.7",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā, etāsaṃ taṇhānaṃ pahānāyā”ti."
        },
        {
          "id": "sn38.10:1.8",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā, etāsaṃ taṇhānaṃ pahānāyā”ti?"
        },
        {
          "id": "sn38.10:1.9",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo, etāsaṃ taṇhānaṃ pahānāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.10:1.10",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.10:1.11",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā, etāsaṃ taṇhānaṃ pahānāyā”ti."
        },
        {
          "id": "sn38.10:1.12",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etāsaṃ taṇhānaṃ pahānāya."
        },
        {
          "id": "sn38.10:1.13",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.10:1.14",
          "pali": "Dasamaṃ."
        }
      ]
    },
    {
      "id": "sn38.11",
      "segments": [
        {
          "id": "sn38.11:0.1",
          "pali": "Saṃyutta Nikāya 38.11"
        },
        {
          "id": "sn38.11:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.11:0.3",
          "pali": "Oghapañhāsutta"
        },
        {
          "id": "sn38.11:1.1",
          "pali": "“‘Ogho, ogho’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn38.11:1.2",
          "pali": "Katamo nu kho, āvuso, ogho”ti?"
        },
        {
          "id": "sn38.11:1.3",
          "pali": "“Cattārome, āvuso, oghā."
        },
        {
          "id": "sn38.11:1.4",
          "pali": "Kāmogho, bhavogho, diṭṭhogho, avijjogho—"
        },
        {
          "id": "sn38.11:1.5",
          "pali": "ime kho, āvuso, cattāro oghā”ti."
        },
        {
          "id": "sn38.11:1.6",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā, etesaṃ oghānaṃ pahānāyā”ti?"
        },
        {
          "id": "sn38.11:1.7",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā, etesaṃ oghānaṃ pahānāyā”ti."
        },
        {
          "id": "sn38.11:1.8",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā, etesaṃ oghānaṃ pahānāyā”ti?"
        },
        {
          "id": "sn38.11:1.9",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo, etesaṃ oghānaṃ pahānāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.11:1.10",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.11:1.11",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā, etesaṃ oghānaṃ pahānāyā”ti."
        },
        {
          "id": "sn38.11:1.12",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etesaṃ oghānaṃ pahānāya."
        },
        {
          "id": "sn38.11:1.13",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.11:1.14",
          "pali": "Ekādasamaṃ."
        }
      ]
    },
    {
      "id": "sn38.12",
      "segments": [
        {
          "id": "sn38.12:0.1",
          "pali": "Saṃyutta Nikāya 38.12"
        },
        {
          "id": "sn38.12:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.12:0.3",
          "pali": "Upādānapañhāsutta"
        },
        {
          "id": "sn38.12:1.1",
          "pali": "“‘Upādānaṃ, upādānan’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn38.12:1.2",
          "pali": "Katamaṃ nu kho, āvuso, upādānan”ti?"
        },
        {
          "id": "sn38.12:1.3",
          "pali": "“Cattārimāni, āvuso, upādānāni."
        },
        {
          "id": "sn38.12:1.4",
          "pali": "Kāmupādānaṃ, diṭṭhupādānaṃ sīlabbatupādānaṃ, attavādupādānaṃ—"
        },
        {
          "id": "sn38.12:1.5",
          "pali": "imāni kho, āvuso, cattāri upādānānī”ti."
        },
        {
          "id": "sn38.12:1.6",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā, etesaṃ upādānānaṃ pahānāyā”ti?"
        },
        {
          "id": "sn38.12:1.7",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā, etesaṃ upādānānaṃ pahānāyā”ti."
        },
        {
          "id": "sn38.12:1.8",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā, etesaṃ upādānānaṃ pahānāyā”ti?"
        },
        {
          "id": "sn38.12:1.9",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo, etesaṃ upādānānaṃ pahānāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.12:1.10",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.12:1.11",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā, etesaṃ upādānānaṃ pahānāyā”ti."
        },
        {
          "id": "sn38.12:1.12",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etesaṃ upādānānaṃ pahānāya."
        },
        {
          "id": "sn38.12:1.13",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.12:1.14",
          "pali": "Dvādasamaṃ."
        }
      ]
    },
    {
      "id": "sn38.13",
      "segments": [
        {
          "id": "sn38.13:0.1",
          "pali": "Saṃyutta Nikāya 38.13"
        },
        {
          "id": "sn38.13:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.13:0.3",
          "pali": "Bhavapañhāsutta"
        },
        {
          "id": "sn38.13:1.1",
          "pali": "“‘Bhavo, bhavo’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn38.13:1.2",
          "pali": "Katamo nu kho, āvuso, bhavo”ti?"
        },
        {
          "id": "sn38.13:1.3",
          "pali": "“Tayome, āvuso, bhavā."
        },
        {
          "id": "sn38.13:1.4",
          "pali": "Kāmabhavo, rūpabhavo, arūpabhavo—"
        },
        {
          "id": "sn38.13:1.5",
          "pali": "ime kho, āvuso, tayo bhavā”ti."
        },
        {
          "id": "sn38.13:1.6",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā, etesaṃ bhavānaṃ pariññāyā”ti?"
        },
        {
          "id": "sn38.13:1.7",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā, etesaṃ bhavānaṃ pariññāyā”ti."
        },
        {
          "id": "sn38.13:1.8",
          "pali": "“Katamo, panāvuso, maggo katamā paṭipadā, etesaṃ bhavānaṃ pariññāyā”ti?"
        },
        {
          "id": "sn38.13:1.9",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo, etesaṃ bhavānaṃ pariññāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.13:1.10",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.13:1.11",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā, etesaṃ bhavānaṃ pariññāyā”ti."
        },
        {
          "id": "sn38.13:1.12",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etesaṃ bhavānaṃ pariññāya."
        },
        {
          "id": "sn38.13:1.13",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.13:1.14",
          "pali": "Terasamaṃ."
        }
      ]
    },
    {
      "id": "sn38.14",
      "segments": [
        {
          "id": "sn38.14:0.1",
          "pali": "Saṃyutta Nikāya 38.14"
        },
        {
          "id": "sn38.14:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.14:0.3",
          "pali": "Dukkhapañhāsutta"
        },
        {
          "id": "sn38.14:1.1",
          "pali": "“‘Dukkhaṃ, dukkhan’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn38.14:1.2",
          "pali": "Katamaṃ nu kho, āvuso, dukkhan”ti?"
        },
        {
          "id": "sn38.14:1.3",
          "pali": "“Tisso imā, āvuso, dukkhatā."
        },
        {
          "id": "sn38.14:1.4",
          "pali": "Dukkhadukkhatā, saṅkhāradukkhatā, vipariṇāmadukkhatā—"
        },
        {
          "id": "sn38.14:1.5",
          "pali": "imā kho, āvuso, tisso dukkhatā”ti."
        },
        {
          "id": "sn38.14:1.6",
          "pali": "“Atthi panāvuso maggo atthi paṭipadā, etāsaṃ dukkhatānaṃ pariññāyā”ti?"
        },
        {
          "id": "sn38.14:1.7",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā, etāsaṃ dukkhatānaṃ pariññāyā”ti."
        },
        {
          "id": "sn38.14:1.8",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā, etāsaṃ dukkhatānaṃ pariññāyā”ti?"
        },
        {
          "id": "sn38.14:1.9",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo, etāsaṃ dukkhatānaṃ pariññāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.14:1.10",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.14:1.11",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā, etāsaṃ dukkhatānaṃ pariññāyā”ti."
        },
        {
          "id": "sn38.14:1.12",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etāsaṃ dukkhatānaṃ pariññāya."
        },
        {
          "id": "sn38.14:1.13",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.14:1.14",
          "pali": "Cuddasamaṃ."
        }
      ]
    },
    {
      "id": "sn38.15",
      "segments": [
        {
          "id": "sn38.15:0.1",
          "pali": "Saṃyutta Nikāya 38.15"
        },
        {
          "id": "sn38.15:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.15:0.3",
          "pali": "Sakkāyapañhāsutta"
        },
        {
          "id": "sn38.15:1.1",
          "pali": "“‘Sakkāyo, sakkāyo’ti, āvuso sāriputta, vuccati."
        },
        {
          "id": "sn38.15:1.2",
          "pali": "Katamo nu kho, āvuso, sakkāyo”ti?"
        },
        {
          "id": "sn38.15:1.3",
          "pali": "“Pañcime, āvuso, upādānakkhandhā sakkāyo vutto bhagavatā, seyyathidaṃ—"
        },
        {
          "id": "sn38.15:1.4",
          "pali": "rūpupādānakkhandho, vedanupādānakkhandho, saññupādānakkhandho, saṅkhārupādānakkhandho, viññāṇupādānakkhandho."
        },
        {
          "id": "sn38.15:1.5",
          "pali": "Ime kho, āvuso, pañcupādānakkhandhā sakkāyo vutto bhagavatā”ti."
        },
        {
          "id": "sn38.15:1.6",
          "pali": "“Atthi panāvuso, maggo atthi paṭipadā, etassa sakkāyassa pariññāyā”ti?"
        },
        {
          "id": "sn38.15:1.7",
          "pali": "“Atthi kho, āvuso, maggo atthi paṭipadā, etassa sakkāyassa pariññāyā”ti."
        },
        {
          "id": "sn38.15:1.8",
          "pali": "“Katamo panāvuso, maggo katamā paṭipadā, etassa sakkāyassa pariññāyā”ti?"
        },
        {
          "id": "sn38.15:1.9",
          "pali": "“Ayameva kho, āvuso, ariyo aṭṭhaṅgiko maggo, etassa sakkāyassa pariññāya, seyyathidaṃ—"
        },
        {
          "id": "sn38.15:1.10",
          "pali": "sammādiṭṭhi …pe… sammāsamādhi."
        },
        {
          "id": "sn38.15:1.11",
          "pali": "Ayaṃ kho, āvuso, maggo ayaṃ paṭipadā, etassa sakkāyassa pariññāyā”ti."
        },
        {
          "id": "sn38.15:1.12",
          "pali": "“Bhaddako, āvuso, maggo bhaddikā paṭipadā, etassa sakkāyassa pariññāya."
        },
        {
          "id": "sn38.15:1.13",
          "pali": "Alañca panāvuso sāriputta, appamādāyā”ti."
        },
        {
          "id": "sn38.15:1.14",
          "pali": "Pannarasamaṃ."
        }
      ]
    },
    {
      "id": "sn38.16",
      "segments": [
        {
          "id": "sn38.16:0.1",
          "pali": "Saṃyutta Nikāya 38.16"
        },
        {
          "id": "sn38.16:0.2",
          "pali": "1. Jambukhādakavagga"
        },
        {
          "id": "sn38.16:0.3",
          "pali": "Dukkarapañhāsutta"
        },
        {
          "id": "sn38.16:1.1",
          "pali": "“Kiṃ nu kho, āvuso sāriputta, imasmiṃ dhammavinaye dukkaran”ti?"
        },
        {
          "id": "sn38.16:1.2",
          "pali": "“Pabbajjā kho, āvuso, imasmiṃ dhammavinaye dukkarā”ti."
        },
        {
          "id": "sn38.16:1.3",
          "pali": "“Pabbajitena panāvuso, kiṃ dukkaran”ti?"
        },
        {
          "id": "sn38.16:1.4",
          "pali": "“Pabbajitena kho, āvuso, abhirati dukkarā”ti."
        },
        {
          "id": "sn38.16:1.5",
          "pali": "“Abhiratena panāvuso, kiṃ dukkaran”ti?"
        },
        {
          "id": "sn38.16:1.6",
          "pali": "“Abhiratena kho, āvuso, dhammānudhammappaṭipatti dukkarā”ti."
        },
        {
          "id": "sn38.16:1.7",
          "pali": "“Kīvaciraṃ panāvuso, dhammānudhammappaṭipanno bhikkhu arahaṃ assā”ti?"
        },
        {
          "id": "sn38.16:1.8",
          "pali": "“Naciraṃ, āvuso”ti."
        },
        {
          "id": "sn38.16:1.9",
          "pali": "Soḷasamaṃ."
        },
        {
          "id": "sn38.16:1.10",
          "pali": "Jambukhādakasaṃyuttaṃ samattaṃ."
        },
        {
          "id": "sn38.16:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn38.16:2.1",
          "pali": "Nibbānaṃ arahattañca,"
        },
        {
          "id": "sn38.16:2.2",
          "pali": "dhammavādī kimatthiyaṃ;"
        },
        {
          "id": "sn38.16:2.3",
          "pali": "Assāso paramassāso,"
        },
        {
          "id": "sn38.16:2.4",
          "pali": "vedanā āsavāvijjā;"
        },
        {
          "id": "sn38.16:2.5",
          "pali": "Taṇhā oghā upādānaṃ,"
        },
        {
          "id": "sn38.16:2.6",
          "pali": "bhavo dukkhañca sakkāyo."
        },
        {
          "id": "sn38.16:2.7",
          "pali": "Imasmiṃ dhammavinaye dukkaranti."
        }
      ]
    }
  ]
}