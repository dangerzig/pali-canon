{
  "id": "sn30",
  "name_pali": "Supaṇṇasaṃyutta",
  "name_eng": "Supaṇṇas",
  "vagga": "Khandhavagga",
  "pts": "S iii 246–248",
  "suttas": [
    {
      "id": "sn30.1",
      "segments": [
        {
          "id": "sn30.1:0.1",
          "pali": "Saṃyutta Nikāya 30.1"
        },
        {
          "id": "sn30.1:0.2",
          "pali": "1. Supaṇṇavagga"
        },
        {
          "id": "sn30.1:0.3",
          "pali": "Suddhikasutta"
        },
        {
          "id": "sn30.1:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn30.1:1.2",
          "pali": "“Catasso imā, bhikkhave, supaṇṇayoniyo."
        },
        {
          "id": "sn30.1:1.3",
          "pali": "Katamā catasso?"
        },
        {
          "id": "sn30.1:1.4",
          "pali": "Aṇḍajā supaṇṇā, jalābujā supaṇṇā, saṃsedajā supaṇṇā, opapātikā supaṇṇā—"
        },
        {
          "id": "sn30.1:1.5",
          "pali": "imā kho, bhikkhave, catasso supaṇṇayoniyo”ti."
        },
        {
          "id": "sn30.1:1.6",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn30.2",
      "segments": [
        {
          "id": "sn30.2:0.1",
          "pali": "Saṃyutta Nikāya 30.2"
        },
        {
          "id": "sn30.2:0.2",
          "pali": "1. Supaṇṇavagga"
        },
        {
          "id": "sn30.2:0.3",
          "pali": "Harantisutta"
        },
        {
          "id": "sn30.2:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn30.2:1.2",
          "pali": "“Catasso imā, bhikkhave, supaṇṇayoniyo."
        },
        {
          "id": "sn30.2:1.3",
          "pali": "Katamā catasso?"
        },
        {
          "id": "sn30.2:1.4",
          "pali": "Aṇḍajā …pe…"
        },
        {
          "id": "sn30.2:1.5",
          "pali": "imā kho, bhikkhave, catasso supaṇṇayoniyo."
        },
        {
          "id": "sn30.2:1.6",
          "pali": "Tatra, bhikkhave, aṇḍajā supaṇṇā aṇḍajeva nāge haranti, na jalābuje, na saṃsedaje, na opapātike."
        },
        {
          "id": "sn30.2:1.7",
          "pali": "Tatra, bhikkhave, jalābujā supaṇṇā aṇḍaje ca jalābuje ca nāge haranti, na saṃsedaje, na opapātike."
        },
        {
          "id": "sn30.2:1.8",
          "pali": "Tatra, bhikkhave, saṃsedajā supaṇṇā aṇḍaje ca jalābuje ca saṃsedaje ca nāge haranti, na opapātike."
        },
        {
          "id": "sn30.2:1.9",
          "pali": "Tatra, bhikkhave, opapātikā supaṇṇā aṇḍaje ca jalābuje ca saṃsedaje ca opapātike ca nāge haranti."
        },
        {
          "id": "sn30.2:1.10",
          "pali": "Imā kho, bhikkhave, catasso supaṇṇayoniyo”ti."
        },
        {
          "id": "sn30.2:1.11",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn30.3",
      "segments": [
        {
          "id": "sn30.3:0.1",
          "pali": "Saṃyutta Nikāya 30.3"
        },
        {
          "id": "sn30.3:0.2",
          "pali": "1. Supaṇṇavagga"
        },
        {
          "id": "sn30.3:0.3",
          "pali": "Dvayakārīsutta"
        },
        {
          "id": "sn30.3:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn30.3:1.2",
          "pali": "Aññataro bhikkhu yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn30.3:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ supaṇṇānaṃ sahabyataṃ upapajjatī”ti?"
        },
        {
          "id": "sn30.3:1.4",
          "pali": "“Idha, bhikkhu, ekacco kāyena dvayakārī hoti, vācāya dvayakārī, manasā dvayakārī."
        },
        {
          "id": "sn30.3:1.5",
          "pali": "Tassa sutaṃ hoti:"
        },
        {
          "id": "sn30.3:1.6",
          "pali": "‘aṇḍajā supaṇṇā dīghāyukā vaṇṇavanto sukhabahulā’ti."
        },
        {
          "id": "sn30.3:1.7",
          "pali": "Tassa evaṃ hoti:"
        },
        {
          "id": "sn30.3:1.8",
          "pali": "‘aho vatāhaṃ kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ supaṇṇānaṃ sahabyataṃ upapajjeyyan’ti."
        },
        {
          "id": "sn30.3:1.9",
          "pali": "So kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ supaṇṇānaṃ sahabyataṃ upapajjati."
        },
        {
          "id": "sn30.3:1.10",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ supaṇṇānaṃ sahabyataṃ upapajjatī”ti."
        },
        {
          "id": "sn30.3:1.11",
          "pali": "Tatiyaṃ."
        }
      ]
    },
    {
      "id": "sn30.4-6",
      "segments": [
        {
          "id": "sn30.4-6:0.1",
          "pali": "Saṃyutta Nikāya 30.4–6"
        },
        {
          "id": "sn30.4-6:0.2",
          "pali": "1. Supaṇṇavagga"
        },
        {
          "id": "sn30.4-6:0.3",
          "pali": "Dutiyādidvayakārīsuttattika"
        },
        {
          "id": "sn30.4-6:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn30.4-6:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn30.4-6:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā jalābujānaṃ supaṇṇānaṃ …pe…"
        },
        {
          "id": "sn30.4-6:1.4",
          "pali": "saṃsedajānaṃ supaṇṇānaṃ …pe…"
        },
        {
          "id": "sn30.4-6:1.5",
          "pali": "opapātikānaṃ supaṇṇānaṃ sahabyataṃ upapajjatī”ti?"
        },
        {
          "id": "sn30.4-6:1.6",
          "pali": "“Idha, bhikkhu, ekacco kāyena dvayakārī hoti, vācāya dvayakārī, manasā dvayakārī."
        },
        {
          "id": "sn30.4-6:1.7",
          "pali": "Tassa sutaṃ hoti:"
        },
        {
          "id": "sn30.4-6:1.8",
          "pali": "‘opapātikā supaṇṇā dīghāyukā vaṇṇavanto sukhabahulā’ti."
        },
        {
          "id": "sn30.4-6:1.9",
          "pali": "Tassa evaṃ hoti:"
        },
        {
          "id": "sn30.4-6:1.10",
          "pali": "‘aho vatāhaṃ kāyassa bhedā paraṃ maraṇā opapātikānaṃ supaṇṇānaṃ sahabyataṃ upapajjeyyan’ti."
        },
        {
          "id": "sn30.4-6:1.11",
          "pali": "So kāyassa bhedā paraṃ maraṇā opapātikānaṃ supaṇṇānaṃ sahabyataṃ upapajjati."
        },
        {
          "id": "sn30.4-6:1.12",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā opapātikānaṃ supaṇṇānaṃ sahabyataṃ upapajjatī”ti."
        },
        {
          "id": "sn30.4-6:1.13",
          "pali": "Chaṭṭhaṃ."
        }
      ]
    },
    {
      "id": "sn30.7-16",
      "segments": [
        {
          "id": "sn30.7-16:0.1",
          "pali": "Saṃyutta Nikāya 30.7–16"
        },
        {
          "id": "sn30.7-16:0.2",
          "pali": "1. Supaṇṇavagga"
        },
        {
          "id": "sn30.7-16:0.3",
          "pali": "Aṇḍajadānūpakārasuttadasaka"
        },
        {
          "id": "sn30.7-16:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn30.7-16:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn30.7-16:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ supaṇṇānaṃ sahabyataṃ upapajjatī”ti?"
        },
        {
          "id": "sn30.7-16:1.4",
          "pali": "“Idha, bhikkhu, ekacco kāyena dvayakārī hoti, vācāya dvayakārī, manasā dvayakārī."
        },
        {
          "id": "sn30.7-16:1.5",
          "pali": "Tassa sutaṃ hoti:"
        },
        {
          "id": "sn30.7-16:1.6",
          "pali": "‘aṇḍajā supaṇṇā dīghāyukā vaṇṇavanto sukhabahulā’ti."
        },
        {
          "id": "sn30.7-16:1.7",
          "pali": "Tassa evaṃ hoti:"
        },
        {
          "id": "sn30.7-16:1.8",
          "pali": "‘aho vatāhaṃ kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ supaṇṇānaṃ sahabyataṃ upapajjeyyan’ti."
        },
        {
          "id": "sn30.7-16:1.9",
          "pali": "So annaṃ deti …pe…"
        },
        {
          "id": "sn30.7-16:1.10",
          "pali": "pānaṃ deti …"
        },
        {
          "id": "sn30.7-16:1.11",
          "pali": "vatthaṃ deti …"
        },
        {
          "id": "sn30.7-16:1.12",
          "pali": "yānaṃ deti …"
        },
        {
          "id": "sn30.7-16:1.13",
          "pali": "mālaṃ deti …"
        },
        {
          "id": "sn30.7-16:1.14",
          "pali": "gandhaṃ deti …"
        },
        {
          "id": "sn30.7-16:1.15",
          "pali": "vilepanaṃ deti …"
        },
        {
          "id": "sn30.7-16:1.16",
          "pali": "seyyaṃ deti …"
        },
        {
          "id": "sn30.7-16:1.17",
          "pali": "āvasathaṃ deti …"
        },
        {
          "id": "sn30.7-16:1.18",
          "pali": "padīpeyyaṃ deti."
        },
        {
          "id": "sn30.7-16:1.19",
          "pali": "So kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ supaṇṇānaṃ sahabyataṃ upapajjati."
        },
        {
          "id": "sn30.7-16:1.20",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā aṇḍajānaṃ supaṇṇānaṃ sahabyataṃ upapajjatī”ti."
        },
        {
          "id": "sn30.7-16:1.21",
          "pali": "Soḷasamaṃ."
        }
      ]
    },
    {
      "id": "sn30.17-46",
      "segments": [
        {
          "id": "sn30.17-46:0.1",
          "pali": "Saṃyutta Nikāya 30.17–46"
        },
        {
          "id": "sn30.17-46:0.2",
          "pali": "1. Supaṇṇavagga"
        },
        {
          "id": "sn30.17-46:0.3",
          "pali": "Jalābujadānūpakārasutta"
        },
        {
          "id": "sn30.17-46:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn30.17-46:1.2",
          "pali": "Ekamantaṃ nisinno kho so bhikkhu bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn30.17-46:1.3",
          "pali": "“ko nu kho, bhante, hetu, ko paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā jalābujānaṃ supaṇṇānaṃ …pe…"
        },
        {
          "id": "sn30.17-46:1.4",
          "pali": "saṃsedajānaṃ supaṇṇānaṃ …pe…"
        },
        {
          "id": "sn30.17-46:1.5",
          "pali": "opapātikānaṃ supaṇṇānaṃ sahabyataṃ upapajjatī”ti?"
        },
        {
          "id": "sn30.17-46:1.6",
          "pali": "“Idha, bhikkhu, ekacco kāyena dvayakārī hoti, vācāya dvayakārī, manasā dvayakārī."
        },
        {
          "id": "sn30.17-46:1.7",
          "pali": "Tassa sutaṃ hoti:"
        },
        {
          "id": "sn30.17-46:1.8",
          "pali": "‘opapātikā supaṇṇā dīghāyukā vaṇṇavanto sukhabahulā’ti."
        },
        {
          "id": "sn30.17-46:1.9",
          "pali": "Tassa evaṃ hoti:"
        },
        {
          "id": "sn30.17-46:1.10",
          "pali": "‘aho vatāhaṃ kāyassa bhedā paraṃ maraṇā opapātikānaṃ supaṇṇānaṃ sahabyataṃ upapajjeyyan’ti."
        },
        {
          "id": "sn30.17-46:1.11",
          "pali": "So annaṃ deti …pe…"
        },
        {
          "id": "sn30.17-46:1.12",
          "pali": "pānaṃ deti …pe…"
        },
        {
          "id": "sn30.17-46:1.13",
          "pali": "padīpeyyaṃ deti."
        },
        {
          "id": "sn30.17-46:1.14",
          "pali": "So kāyassa bhedā paraṃ maraṇā opapātikānaṃ supaṇṇānaṃ sahabyataṃ upapajjati."
        },
        {
          "id": "sn30.17-46:1.15",
          "pali": "Ayaṃ kho, bhikkhu, hetu, ayaṃ paccayo, yena midhekacco kāyassa bhedā paraṃ maraṇā opapātikānaṃ supaṇṇānaṃ sahabyataṃ upapajjatī”ti."
        },
        {
          "id": "sn30.17-46:1.16",
          "pali": "Chacattālīsamaṃ."
        },
        {
          "id": "sn30.17-46:1.17",
          "pali": "(Evaṃ piṇḍakena chacattālīsaṃ suttantā honti.)"
        },
        {
          "id": "sn30.17-46:1.18",
          "pali": "Supaṇṇavaggo paṭhamo."
        },
        {
          "id": "sn30.17-46:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn30.17-46:2.1",
          "pali": "Suddhikaṃ haranti ceva,"
        },
        {
          "id": "sn30.17-46:2.2",
          "pali": "dvayakārī ca caturo;"
        },
        {
          "id": "sn30.17-46:2.3",
          "pali": "Dānūpakārā tālīsaṃ,"
        },
        {
          "id": "sn30.17-46:2.4",
          "pali": "supaṇṇe suppakāsitāti."
        },
        {
          "id": "sn30.17-46:2.5",
          "pali": "Supaṇṇasaṃyuttaṃ samattaṃ."
        }
      ]
    }
  ]
}