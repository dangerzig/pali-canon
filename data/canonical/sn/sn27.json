          "id": "sn27.7:0.3",
          "pali": "Sañcetanāsutta"
        },
        {
          "id": "sn27.7:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn27.7:1.2",
          "pali": "“Yo, bhikkhave, rūpasañcetanāya chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.7:1.3",
          "pali": "Yo saddasañcetanāya …"
        },
        {
          "id": "sn27.7:1.4",
          "pali": "yo gandhasañcetanāya …"
        },
        {
          "id": "sn27.7:1.5",
