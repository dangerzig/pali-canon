          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn27.4:1.2",
          "pali": "“Yo, bhikkhave, cakkhusamphassasmiṃ chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.4:1.3",
          "pali": "Yo sotasamphassasmiṃ …"
        },
        {
          "id": "sn27.4:1.4",
          "pali": "yo ghānasamphassasmiṃ …"
        },
        {
          "id": "sn27.4:1.5",
          "pali": "yo jivhāsamphassasmiṃ …"
        },
        {
          "id": "sn27.4:1.6",
          "pali": "yo kāyasamphassasmiṃ …"
        },
        {
          "id": "sn27.4:1.7",
          "pali": "yo manosamphassasmiṃ chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.4:1.8",
          "pali": "Yato kho, bhikkhave, bhikkhuno …pe…"
        },
        {
          "id": "sn27.4:1.9",
          "pali": "abhiññā sacchikaraṇīyesu dhammesū”ti."
        },
        {
          "id": "sn27.4:1.10",
          "pali": "Catutthaṃ."
        }
      ]
    },
    {
      "id": "sn27.5",
      "segments": [
        {
          "id": "sn27.5:0.1",
          "pali": "Saṃyutta Nikāya 27.5"
