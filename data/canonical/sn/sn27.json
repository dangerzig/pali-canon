        }
      ]
    },
    {
      "id": "sn27.9",
      "segments": [
        {
          "id": "sn27.9:0.1",
          "pali": "Saṃyutta Nikāya 27.9"
        },
        {
          "id": "sn27.9:0.2",
          "pali": "1. Kilesavagga"
        },
        {
          "id": "sn27.9:0.3",
          "pali": "Dhātusutta"
        },
        {
          "id": "sn27.9:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn27.9:1.2",
          "pali": "“Yo, bhikkhave, pathavīdhātuyā chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.9:1.3",
          "pali": "Yo āpodhātuyā …"
        },
        {
          "id": "sn27.9:1.4",
          "pali": "yo tejodhātuyā …"
        },
        {
          "id": "sn27.9:1.5",
          "pali": "yo vāyodhātuyā …"
        },
        {
          "id": "sn27.9:1.6",
          "pali": "yo ākāsadhātuyā …"
        },
        {
          "id": "sn27.9:1.7",
          "pali": "yo viññāṇadhātuyā chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.9:1.8",
          "pali": "Yato kho, bhikkhave, bhikkhuno imesu chasu ṭhānesu cetaso upakkileso pahīno hoti, nekkhammaninnañcassa cittaṃ hoti."
        },
        {
          "id": "sn27.9:1.9",
