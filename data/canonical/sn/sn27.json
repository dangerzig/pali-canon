        }
      ]
    },
    {
      "id": "sn27.8",
      "segments": [
        {
          "id": "sn27.8:0.1",
          "pali": "Saṃyutta Nikāya 27.8"
        },
        {
          "id": "sn27.8:0.2",
          "pali": "1. Kilesavagga"
        },
        {
          "id": "sn27.8:0.3",
          "pali": "Taṇhāsutta"
        },
        {
          "id": "sn27.8:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn27.8:1.2",
          "pali": "“Yo, bhikkhave, rūpataṇhāya chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.8:1.3",
          "pali": "Yo saddataṇhāya …"
        },
        {
          "id": "sn27.8:1.4",
          "pali": "yo gandhataṇhāya …"
        },
        {
          "id": "sn27.8:1.5",
          "pali": "yo rasataṇhāya …"
        },
        {
          "id": "sn27.8:1.6",
          "pali": "yo phoṭṭhabbataṇhāya …"
        },
        {
          "id": "sn27.8:1.7",
          "pali": "yo dhammataṇhāya chandarāgo, cittasseso upakkileso."
        },
