{
  "id": "sn27",
  "name_pali": "Kilesasaṃyutta",
  "name_eng": "Defilements",
  "vagga": "Khandhavagga",
  "pts": "S iii 232–234",
  "suttas": [
    {
      "id": "sn27.1",
      "segments": [
        {
          "id": "sn27.1:0.1",
          "pali": "Saṃyutta Nikāya 27.1"
        },
        {
          "id": "sn27.1:0.2",
          "pali": "1. Kilesavagga"
        },
        {
          "id": "sn27.1:0.3",
          "pali": "Cakkhusutta"
        },
        {
          "id": "sn27.1:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn27.1:1.2",
          "pali": "“Yo, bhikkhave, cakkhusmiṃ chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.1:1.3",
          "pali": "Yo sotasmiṃ chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.1:1.4",
          "pali": "Yo ghānasmiṃ chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.1:1.5",
          "pali": "Yo jivhāya chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.1:1.6",
          "pali": "Yo kāyasmiṃ chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.1:1.7",
          "pali": "Yo manasmiṃ chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.1:1.8",
          "pali": "Yato kho, bhikkhave, bhikkhuno imesu chasu ṭhānesu cetaso upakkileso pahīno hoti, nekkhammaninnañcassa cittaṃ hoti."
        },
        {
          "id": "sn27.1:1.9",
          "pali": "Nekkhammaparibhāvitaṃ cittaṃ kammaniyaṃ khāyati, abhiññā sacchikaraṇīyesu dhammesū”ti."
        },
        {
          "id": "sn27.1:1.10",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn27.2",
      "segments": [
        {
          "id": "sn27.2:0.1",
          "pali": "Saṃyutta Nikāya 27.2"
        },
        {
          "id": "sn27.2:0.2",
          "pali": "1. Kilesavagga"
        },
        {
          "id": "sn27.2:0.3",
          "pali": "Rūpasutta"
        },
        {
          "id": "sn27.2:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn27.2:1.2",
          "pali": "“Yo, bhikkhave, rūpesu chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.2:1.3",
          "pali": "Yo saddesu …"
        },
        {
          "id": "sn27.2:1.4",
          "pali": "yo gandhesu …"
        },
        {
          "id": "sn27.2:1.5",
          "pali": "yo rasesu …"
        },
        {
          "id": "sn27.2:1.6",
          "pali": "yo phoṭṭhabbesu …"
        },
        {
          "id": "sn27.2:1.7",
          "pali": "yo dhammesu chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.2:1.8",
          "pali": "Yato kho, bhikkhave, bhikkhuno imesu chasu ṭhānesu cetaso upakkileso pahīno hoti, nekkhammaninnañcassa cittaṃ hoti."
        },
        {
          "id": "sn27.2:1.9",
          "pali": "Nekkhammaparibhāvitaṃ cittaṃ kammaniyaṃ khāyati, abhiññā sacchikaraṇīyesu dhammesū”ti."
        },
        {
          "id": "sn27.2:1.10",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn27.3",
      "segments": [
        {
          "id": "sn27.3:0.1",
          "pali": "Saṃyutta Nikāya 27.3"
        },
        {
          "id": "sn27.3:0.2",
          "pali": "1. Kilesavagga"
        },
        {
          "id": "sn27.3:0.3",
          "pali": "Viññāṇasutta"
        },
        {
          "id": "sn27.3:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn27.3:1.2",
          "pali": "“Yo, bhikkhave, cakkhuviññāṇasmiṃ chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.3:1.3",
          "pali": "Yo sotaviññāṇasmiṃ …"
        },
        {
          "id": "sn27.3:1.4",
          "pali": "yo ghānaviññāṇasmiṃ …"
        },
        {
          "id": "sn27.3:1.5",
          "pali": "yo jivhāviññāṇasmiṃ …"
        },
        {
          "id": "sn27.3:1.6",
          "pali": "yo kāyaviññāṇasmiṃ …"
        },
        {
          "id": "sn27.3:1.7",
          "pali": "yo manoviññāṇasmiṃ chandarāgo, cittasseso upakkileso."
        },
        {
          "id": "sn27.3:1.8",
          "pali": "Yato kho, bhikkhave, bhikkhuno imesu chasu ṭhānesu cetaso upakkileso pahīno hoti, nekkhammaninnañcassa cittaṃ hoti."
        },
        {
          "id": "sn27.3:1.9",
          "pali": "Nekkhammaparibhāvitaṃ cittaṃ kammaniyaṃ khāyati, abhiññā sacchikaraṇīyesu dhammesū”ti."
        },
        {
          "id": "sn27.3:1.10",
          "pali": "Tatiyaṃ."
        }
      ]
    },
    {
      "id": "sn27.4",
      "segments": [
        {
          "id": "sn27.4:0.1",
          "pali": "Saṃyutta Nikāya 27.4"
