{
  "id": "sn23",
  "name_pali": "Rādhasaṃyutta",
  "name_eng": "Rādha",
  "vagga": "Khandhavagga",
  "pts": "S iii 188–201",
  "suttas": [
    {
      "id": "sn23.1",
      "segments": [
        {
          "id": "sn23.1:0.1",
          "pali": "Saṃyutta Nikāya 23.1"
        },
        {
          "id": "sn23.1:0.2",
          "pali": "1. Paṭhamamāravagga"
        },
        {
          "id": "sn23.1:0.3",
          "pali": "Mārasutta"
        },
        {
          "id": "sn23.1:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn23.1:1.2",
          "pali": "Atha kho āyasmā rādho yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinno kho āyasmā rādho bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn23.1:2.1",
          "pali": "“‘Māro, māro’ti, bhante, vuccati."
        },
        {
          "id": "sn23.1:2.2",
          "pali": "Kittāvatā nu kho, bhante, māro”ti?"
        },
        {
          "id": "sn23.1:2.3",
          "pali": "“Rūpe kho, rādha, sati māro vā assa māretā vā yo vā pana mīyati."
        },
        {
          "id": "sn23.1:2.4",
          "pali": "Tasmātiha tvaṃ, rādha, rūpaṃ māroti passa, māretāti passa, mīyatīti passa, rogoti passa, gaṇḍoti passa, sallanti passa, aghanti passa, aghabhūtanti passa."
        },
        {
          "id": "sn23.1:2.5",
          "pali": "Ye naṃ evaṃ passanti te sammā passanti."
        },
        {
          "id": "sn23.1:2.6",
          "pali": "Vedanāya sati …"
        },
        {
          "id": "sn23.1:2.7",
          "pali": "saññāya sati …"
        },
        {
          "id": "sn23.1:2.8",
          "pali": "saṅkhāresu sati …"
        },
        {
          "id": "sn23.1:2.9",
          "pali": "viññāṇe sati māro vā assa māretā vā yo vā pana mīyati."
        },
        {
          "id": "sn23.1:2.10",
          "pali": "Tasmātiha tvaṃ, rādha, viññāṇaṃ māroti passa, māretāti passa, mīyatīti passa, rogoti passa, gaṇḍoti passa, sallanti passa, aghanti passa, aghabhūtanti passa."
        },
        {
          "id": "sn23.1:2.11",
          "pali": "Ye naṃ evaṃ passanti, te sammā passantī”ti."
        },
        {
          "id": "sn23.1:3.1",
          "pali": "“Sammādassanaṃ pana, bhante, kimatthiyan”ti?"
        },
        {
          "id": "sn23.1:3.2",
          "pali": "“Sammādassanaṃ kho, rādha, nibbidatthaṃ”."
        },
        {
          "id": "sn23.1:3.3",
          "pali": "“Nibbidā pana, bhante, kimatthiyā”ti?"
        },
        {
          "id": "sn23.1:3.4",
          "pali": "“Nibbidā kho, rādha, virāgatthā”."
        },
        {
          "id": "sn23.1:3.5",
          "pali": "“Virāgo pana, bhante, kimatthiyo”ti?"
        },
        {
          "id": "sn23.1:3.6",
          "pali": "“Virāgo kho, rādha, vimuttattho”."
        },
        {
          "id": "sn23.1:3.7",
          "pali": "“Vimutti pana, bhante, kimatthiyā”ti?"
        },
        {
          "id": "sn23.1:3.8",
          "pali": "“Vimutti kho, rādha, nibbānatthā”."
        },
        {
          "id": "sn23.1:3.9",
          "pali": "“Nibbānaṃ pana, bhante, kimatthiyan”ti?"
        },
        {
          "id": "sn23.1:3.10",
          "pali": "“Accayāsi, rādha, pañhaṃ, nāsakkhi pañhassa pariyantaṃ gahetuṃ."
        },
        {
          "id": "sn23.1:3.11",
          "pali": "Nibbānogadhañhi, rādha, brahmacariyaṃ vussati, nibbānaparāyanaṃ nibbānapariyosānan”ti."
        },
        {
          "id": "sn23.1:3.12",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn23.2",
      "segments": [
        {
          "id": "sn23.2:0.1",
          "pali": "Saṃyutta Nikāya 23.2"
        },
        {
          "id": "sn23.2:0.2",
          "pali": "1. Paṭhamamāravagga"
        },
        {
          "id": "sn23.2:0.3",
          "pali": "Sattasutta"
        },
        {
          "id": "sn23.2:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn23.2:1.2",
          "pali": "Ekamantaṃ nisinno kho āyasmā rādho bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn23.2:1.3",
          "pali": "“‘satto, satto’ti, bhante, vuccati."
        },
        {
          "id": "sn23.2:1.4",
          "pali": "Kittāvatā nu kho, bhante, sattoti vuccatī”ti?"
        },
        {
          "id": "sn23.2:1.5",
          "pali": "“Rūpe kho, rādha, yo chando yo rāgo yā nandī yā taṇhā, tatra satto, tatra visatto, tasmā sattoti vuccati."
        },
        {
          "id": "sn23.2:1.6",
          "pali": "Vedanāya …"
        },
        {
          "id": "sn23.2:1.7",
          "pali": "saññāya …"
        },
        {
          "id": "sn23.2:1.8",
          "pali": "saṅkhāresu …"
        },
        {
          "id": "sn23.2:1.9",
          "pali": "viññāṇe yo chando yo rāgo yā nandī yā taṇhā, tatra satto, tatra visatto, tasmā sattoti vuccati."
        },
        {
          "id": "sn23.2:2.1",
          "pali": "Seyyathāpi, rādha, kumārakā vā kumārikāyo vā paṃsvāgārakehi kīḷanti."
        },
        {
          "id": "sn23.2:2.2",
          "pali": "Yāvakīvañca tesu paṃsvāgārakesu avigatarāgā honti avigatacchandā avigatapemā avigatapipāsā avigatapariḷāhā avigatataṇhā, tāva tāni paṃsvāgārakāni allīyanti keḷāyanti dhanāyanti mamāyanti."
        },
        {
          "id": "sn23.2:2.3",
          "pali": "Yato ca kho, rādha, kumārakā vā kumārikāyo vā tesu paṃsvāgārakesu vigatarāgā honti vigatacchandā vigatapemā vigatapipāsā vigatapariḷāhā vigatataṇhā, atha kho tāni paṃsvāgārakāni hatthehi ca pādehi ca vikiranti vidhamanti viddhaṃsenti vikīḷaniyaṃ karonti."
        },
        {
          "id": "sn23.2:2.4",
          "pali": "Evameva kho, rādha, tumhepi rūpaṃ vikiratha vidhamatha viddhaṃsetha vikīḷaniyaṃ karotha taṇhākkhayāya paṭipajjatha."
        },
        {
          "id": "sn23.2:2.5",
          "pali": "Vedanaṃ vikiratha vidhamatha viddhaṃsetha vikīḷaniyaṃ karotha taṇhākkhayāya paṭipajjatha."
        },
        {
          "id": "sn23.2:2.6",
          "pali": "Saññaṃ …"
        },
        {
          "id": "sn23.2:2.7",
          "pali": "saṅkhāre vikiratha vidhamatha viddhaṃsetha vikīḷaniyaṃ karotha taṇhākkhayāya paṭipajjatha."
        },
        {
          "id": "sn23.2:2.8",
          "pali": "Viññāṇaṃ vikiratha vidhamatha viddhaṃsetha vikīḷaniyaṃ karotha taṇhākkhayāya paṭipajjatha."
        },
        {
          "id": "sn23.2:2.9",
          "pali": "Taṇhākkhayo hi, rādha, nibbānan”ti."
        },
        {
          "id": "sn23.2:2.10",
          "pali": "Dutiyaṃ."
        }
      ]
    },
    {
      "id": "sn23.3",
      "segments": [
        {
          "id": "sn23.3:0.1",
          "pali": "Saṃyutta Nikāya 23.3"
        },
        {
          "id": "sn23.3:0.2",
          "pali": "1. Paṭhamamāravagga"
        },
        {
          "id": "sn23.3:0.3",
          "pali": "Bhavanettisutta"
        },
        {
          "id": "sn23.3:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn23.3:1.2",
          "pali": "Ekamantaṃ nisinno kho āyasmā rādho bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn23.3:1.3",
          "pali": "“‘bhavanettinirodho, bhavanettinirodho’ti, bhante, vuccati."
        },
        {
          "id": "sn23.3:1.4",
          "pali": "Katamā nu kho, bhante, bhavanetti, katamo bhavanettinirodho”ti?"
        },
        {
          "id": "sn23.3:1.5",
          "pali": "“Rūpe kho, rādha, yo chando yo rāgo yā nandī yā taṇhā ye upayupādānā cetaso adhiṭṭhānābhinivesānusayā—"
        },
        {
          "id": "sn23.3:1.6",
          "pali": "ayaṃ vuccati bhavanetti."
        },
        {
          "id": "sn23.3:1.7",
          "pali": "Tesaṃ nirodho bhavanettinirodho."
        },
        {
          "id": "sn23.3:1.8",
          "pali": "Vedanāya …"
        },
        {
          "id": "sn23.3:1.9",
          "pali": "saññāya …"
        },
        {
          "id": "sn23.3:1.10",
          "pali": "saṅkhāresu …"
        },
        {
          "id": "sn23.3:1.11",
          "pali": "viññāṇe yo chando …pe… adhiṭṭhānābhinivesānusayā—"
        },
        {
          "id": "sn23.3:1.12",
          "pali": "ayaṃ vuccati bhavanetti."
        },
        {
          "id": "sn23.3:1.13",
          "pali": "Tesaṃ nirodho bhavanettinirodho”ti."
        },
        {
          "id": "sn23.3:1.14",
          "pali": "Tatiyaṃ."
        }
      ]
    },
    {
      "id": "sn23.4",
      "segments": [
        {
          "id": "sn23.4:0.1",
          "pali": "Saṃyutta Nikāya 23.4"
        },
        {
          "id": "sn23.4:0.2",
          "pali": "1. Paṭhamamāravagga"
        },
        {
          "id": "sn23.4:0.3",
          "pali": "Pariññeyyasutta"
        },
        {
          "id": "sn23.4:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn23.4:1.2",
          "pali": "Āyasmā rādho yena bhagavā tenupasaṅkami; upasaṅkamitvā bhagavantaṃ abhivādetvā ekamantaṃ nisīdi. Ekamantaṃ nisinnaṃ kho āyasmantaṃ rādhaṃ bhagavā etadavoca:"
        },
        {
          "id": "sn23.4:2.1",
          "pali": "“Pariññeyye ca, rādha, dhamme desessāmi pariññañca pariññātāviṃ puggalañca."
        },
        {
          "id": "sn23.4:2.2",
          "pali": "Taṃ suṇāhi, sādhukaṃ manasi karohi; bhāsissāmī”ti."
        },
        {
          "id": "sn23.4:2.3",
          "pali": "“Evaṃ, bhante”ti kho āyasmā rādho bhagavato paccassosi."
        },
        {
          "id": "sn23.4:2.4",
          "pali": "Bhagavā etadavoca:"
        },
        {
          "id": "sn23.4:2.5",
          "pali": "“katame ca, rādha, pariññeyyā dhammā?"
        },
        {
          "id": "sn23.4:2.6",
          "pali": "Rūpaṃ kho, rādha, pariññeyyo dhammo, vedanā pariññeyyo dhammo, saññā pariññeyyo dhammo, saṅkhārā pariññeyyo dhammo, viññāṇaṃ pariññeyyo dhammo."
        },
        {
          "id": "sn23.4:2.7",
          "pali": "Ime vuccanti, rādha, pariññeyyā dhammā."
        },
        {
          "id": "sn23.4:2.8",
          "pali": "Katamā ca, rādha, pariññā?"
        },
        {
          "id": "sn23.4:2.9",
          "pali": "Yo kho, rādha, rāgakkhayo dosakkhayo mohakkhayo—"
        },
        {
          "id": "sn23.4:2.10",
          "pali": "ayaṃ vuccati, rādha, pariññā."
        },
        {
          "id": "sn23.4:2.11",
          "pali": "Katamo ca, rādha, pariññātāvī puggalo?"
        },
        {
          "id": "sn23.4:2.12",
          "pali": "‘Arahā’tissa vacanīyaṃ."
        },
        {
          "id": "sn23.4:2.13",
          "pali": "Yvāyaṃ āyasmā evaṃnāmo evaṅgotto—"
        },
        {
          "id": "sn23.4:2.14",
          "pali": "ayaṃ vuccati, rādha, pariññātāvī puggalo”ti."
        },
        {
          "id": "sn23.4:2.15",
          "pali": "Catutthaṃ."
        }
      ]
    },
    {
      "id": "sn23.5",
      "segments": [
        {
          "id": "sn23.5:0.1",
          "pali": "Saṃyutta Nikāya 23.5"
        },
        {
          "id": "sn23.5:0.2",
          "pali": "1. Paṭhamamāravagga"
        },
        {
          "id": "sn23.5:0.3",
          "pali": "Samaṇasutta"
        },
        {
          "id": "sn23.5:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn23.5:1.2",
          "pali": "Ekamantaṃ nisinnaṃ kho āyasmantaṃ rādhaṃ bhagavā etadavoca:"
        },
        {
          "id": "sn23.5:1.3",
          "pali": "“pañcime, rādha, upādānakkhandhā."
        },
        {
          "id": "sn23.5:1.4",
          "pali": "Katame pañca?"
        },
        {
          "id": "sn23.5:1.5",
          "pali": "Rūpupādānakkhandho, vedanupādānakkhandho, saññupādānakkhandho, saṅkhārupādānakkhandho, viññāṇupādānakkhandho."
        },
        {
          "id": "sn23.5:1.6",
          "pali": "Ye hi keci, rādha, samaṇā vā brāhmaṇā vā imesaṃ pañcannaṃ upādānakkhandhānaṃ assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānanti;"
        },
        {
          "id": "sn23.5:1.7",
          "pali": "na me te, rādha, samaṇā vā brāhmaṇā vā samaṇesu vā samaṇasammatā brāhmaṇesu vā brāhmaṇasammatā, na ca pana te āyasmanto sāmaññatthaṃ vā brahmaññatthaṃ vā diṭṭheva dhamme sayaṃ abhiññā sacchikatvā upasampajja viharanti."
        },
        {
          "id": "sn23.5:1.8",
          "pali": "Ye ca kho keci, rādha, samaṇā vā brāhmaṇā vā imesaṃ pañcannaṃ upādānakkhandhānaṃ assādañca ādīnavañca nissaraṇañca yathābhūtaṃ pajānanti;"
        },
        {
          "id": "sn23.5:1.9",
          "pali": "te kho me, rādha, samaṇā vā brāhmaṇā vā samaṇesu ceva samaṇasammatā brāhmaṇesu ca brāhmaṇasammatā, te ca panāyasmanto sāmaññatthañca brahmaññatthañca diṭṭheva dhamme sayaṃ abhiññā sacchikatvā upasampajja viharantī”ti."
        },
        {
          "id": "sn23.5:1.10",
          "pali": "Pañcamaṃ."
        }
      ]
    },
    {
      "id": "sn23.6",
      "segments": [
        {
          "id": "sn23.6:0.1",
          "pali": "Saṃyutta Nikāya 23.6"
        },
        {
          "id": "sn23.6:0.2",
          "pali": "1. Paṭhamamāravagga"
        },
        {
          "id": "sn23.6:0.3",
          "pali": "Dutiyasamaṇasutta"
        },
        {
          "id": "sn23.6:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn23.6:1.2",
          "pali": "Ekamantaṃ nisinnaṃ kho āyasmantaṃ rādhaṃ bhagavā etadavoca:"
        },
        {
          "id": "sn23.6:1.3",
          "pali": "“pañcime, rādha, upādānakkhandhā."
        },
        {
          "id": "sn23.6:1.4",
          "pali": "Katame pañca?"
        },
        {
          "id": "sn23.6:1.5",
          "pali": "Rūpupādānakkhandho …pe… viññāṇupādānakkhandho."
        },
        {
          "id": "sn23.6:1.6",
          "pali": "Ye hi keci, rādha, samaṇā vā brāhmaṇā vā imesaṃ pañcannaṃ upādānakkhandhānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ nappajānanti …pe…"
        },
        {
          "id": "sn23.6:1.7",
          "pali": "sayaṃ abhiññā sacchikatvā upasampajja viharantī”ti."
        },
        {
          "id": "sn23.6:1.8",
          "pali": "Chaṭṭhaṃ."
        }
      ]
    },
    {
      "id": "sn23.7",
      "segments": [
        {
          "id": "sn23.7:0.1",
          "pali": "Saṃyutta Nikāya 23.7"
        },
        {
          "id": "sn23.7:0.2",
          "pali": "1. Paṭhamamāravagga"
        },
        {
          "id": "sn23.7:0.3",
          "pali": "Sotāpannasutta"
        },
        {
          "id": "sn23.7:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn23.7:1.2",
          "pali": "Ekamantaṃ nisinnaṃ kho āyasmantaṃ rādhaṃ bhagavā etadavoca:"
        },
        {
          "id": "sn23.7:1.3",
          "pali": "“pañcime, rādha, upādānakkhandhā."
        },
        {
          "id": "sn23.7:1.4",
          "pali": "Katame pañca?"
        },
        {
          "id": "sn23.7:1.5",
          "pali": "Rūpupādānakkhandho …pe… viññāṇupādānakkhandho."
        },
        {
          "id": "sn23.7:1.6",
          "pali": "Yato kho, rādha, ariyasāvako imesaṃ pañcannaṃ upādānakkhandhānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ pajānāti—"
        },
        {
          "id": "sn23.7:1.7",
          "pali": "ayaṃ vuccati, rādha, ariyasāvako sotāpanno avinipātadhammo niyato sambodhiparāyano”ti."
        },
        {
          "id": "sn23.7:1.8",
          "pali": "Sattamaṃ."
        }
      ]
    },
    {
      "id": "sn23.8",
      "segments": [
        {
          "id": "sn23.8:0.1",
          "pali": "Saṃyutta Nikāya 23.8"
        },
        {
          "id": "sn23.8:0.2",
          "pali": "1. Paṭhamamāravagga"
        },
        {
          "id": "sn23.8:0.3",
          "pali": "Arahantasutta"
        },
        {
          "id": "sn23.8:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn23.8:1.2",
          "pali": "Ekamantaṃ nisinnaṃ kho āyasmantaṃ rādhaṃ bhagavā etadavoca:"
        },
        {
          "id": "sn23.8:1.3",
          "pali": "“pañcime, rādha, upādānakkhandhā."
        },
        {
          "id": "sn23.8:1.4",
          "pali": "Katame pañca?"
        },
        {
          "id": "sn23.8:1.5",
          "pali": "Rūpupādānakkhandho …pe… viññāṇupādānakkhandho."
        },
        {
          "id": "sn23.8:1.6",
          "pali": "Yato kho, rādha, bhikkhu imesaṃ pañcannaṃ upādānakkhandhānaṃ samudayañca atthaṅgamañca assādañca ādīnavañca nissaraṇañca yathābhūtaṃ viditvā anupādāvimutto hoti—"
        },
        {
          "id": "sn23.8:1.7",
          "pali": "ayaṃ vuccati, rādha, bhikkhu arahaṃ khīṇāsavo vusitavā katakaraṇīyo ohitabhāro anuppattasadattho parikkhīṇabhavasaṃyojano sammadaññāvimutto”ti."
        },
        {
          "id": "sn23.8:1.8",
          "pali": "Aṭṭhamaṃ."
        }
      ]
    },
    {
      "id": "sn23.9",
      "segments": [
        {
          "id": "sn23.9:0.1",
          "pali": "Saṃyutta Nikāya 23.9"
        },
        {
          "id": "sn23.9:0.2",
          "pali": "1. Paṭhamamāravagga"
        },
        {
          "id": "sn23.9:0.3",
          "pali": "Chandarāgasutta"
        },
        {
          "id": "sn23.9:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn23.9:1.2",
          "pali": "Ekamantaṃ nisinnaṃ kho āyasmantaṃ rādhaṃ bhagavā etadavoca:"
        },
        {
          "id": "sn23.9:1.3",
          "pali": "“rūpe kho, rādha, yo chando yo rāgo yā nandī yā taṇhā, taṃ pajahatha."
        },
        {
          "id": "sn23.9:1.4",
          "pali": "Evaṃ taṃ rūpaṃ pahīnaṃ bhavissati ucchinnamūlaṃ tālāvatthukataṃ anabhāvaṅkataṃ āyatiṃ anuppādadhammaṃ."
        },
        {
          "id": "sn23.9:1.5",
          "pali": "Vedanāya yo chando yo rāgo yā nandī yā taṇhā, taṃ pajahatha."
        },
        {
          "id": "sn23.9:1.6",
          "pali": "Evaṃ sā vedanā pahīnā bhavissati ucchinnamūlā tālāvatthukatā anabhāvaṅkatā āyatiṃ anuppādadhammā."
        },
        {
          "id": "sn23.9:1.7",
          "pali": "Saññāya …"
        },
        {
          "id": "sn23.9:1.8",
          "pali": "saṅkhāresu yo chando yo rāgo yā nandī yā taṇhā, taṃ pajahatha."
        },
        {
          "id": "sn23.9:1.9",
          "pali": "Evaṃ te saṅkhārā pahīnā bhavissanti ucchinnamūlā tālāvatthukatā anabhāvaṅkatā āyatiṃ anuppādadhammā."
        },
        {
          "id": "sn23.9:1.10",
          "pali": "Viññāṇe yo chando yo rāgo yā nandī yā taṇhā, taṃ pajahatha."
        },
        {
          "id": "sn23.9:1.11",
          "pali": "Evaṃ taṃ viññāṇaṃ pahīnaṃ bhavissati …pe… anuppādadhamman”ti."
        },
        {
          "id": "sn23.9:1.12",
          "pali": "Navamaṃ."
        }
      ]
    },
    {
      "id": "sn23.10",
      "segments": [
        {
          "id": "sn23.10:0.1",
          "pali": "Saṃyutta Nikāya 23.10"
        },
        {
          "id": "sn23.10:0.2",
          "pali": "1. Paṭhamamāravagga"
        },
        {
          "id": "sn23.10:0.3",
          "pali": "Dutiyachandarāgasutta"
        },
        {
          "id": "sn23.10:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn23.10:1.2",
          "pali": "Ekamantaṃ nisinnaṃ kho āyasmantaṃ rādhaṃ bhagavā etadavoca:"
        },
        {
          "id": "sn23.10:1.3",
          "pali": "“rūpe kho, rādha, yo chando yo rāgo yā nandī yā taṇhā ye upayupādānā cetaso adhiṭṭhānābhinivesānusayā, te pajahatha."
        },
        {
          "id": "sn23.10:1.4",
          "pali": "Evaṃ taṃ rūpaṃ pahīnaṃ bhavissati ucchinnamūlaṃ tālāvatthukataṃ anabhāvaṅkataṃ āyatiṃ anuppādadhammaṃ."
        },
        {
          "id": "sn23.10:1.5",
          "pali": "Vedanāya yo chando yo rāgo yā nandī yā taṇhā ye upayupādānā cetaso adhiṭṭhānābhinivesānusayā, te pajahatha."
        },
        {
          "id": "sn23.10:1.6",
          "pali": "Evaṃ sā vedanā pahīnā bhavissati ucchinnamūlā tālāvatthukatā anabhāvaṅkatā āyatiṃ anuppādadhammā."
        },
        {
          "id": "sn23.10:1.7",
          "pali": "Saññāya …"
        },
        {
          "id": "sn23.10:1.8",
          "pali": "saṅkhāresu yo chando yo rāgo yā nandī yā taṇhā ye upayupādānā cetaso adhiṭṭhānābhinivesānusayā, te pajahatha."
        },
        {
          "id": "sn23.10:1.9",
          "pali": "Evaṃ te saṅkhārā pahīnā bhavissanti ucchinnamūlā tālāvatthukatā anabhāvaṅkatā āyatiṃ anuppādadhammā."
        },
        {
          "id": "sn23.10:1.10",
          "pali": "Viññāṇe yo chando yo rāgo yā nandī yā taṇhā ye upayupādānā cetaso adhiṭṭhānābhinivesānusayā, te pajahatha."
        },
        {
          "id": "sn23.10:1.11",
          "pali": "Evaṃ taṃ viññāṇaṃ pahīnaṃ bhavissati ucchinnamūlaṃ tālāvatthukataṃ anabhāvaṅkataṃ āyatiṃ anuppādadhamman”ti."
        },
        {
          "id": "sn23.10:1.12",
          "pali": "Dasamaṃ."
        },
        {
          "id": "sn23.10:1.13",
          "pali": "Rādhasaṃyuttassa paṭhamamāravaggo."
        },
        {
          "id": "sn23.10:2.0",
          "pali": "Tassuddānaṃ"
        },
        {
          "id": "sn23.10:2.1",
          "pali": "Māro satto bhavanetti,"
        },
        {
          "id": "sn23.10:2.2",
          "pali": "pariññeyyā samaṇā duve;"
        },
        {
          "id": "sn23.10:2.3",
          "pali": "Sotāpanno arahā ca,"
        },
        {
          "id": "sn23.10:2.4",
          "pali": "chandarāgāpare duveti."
        }
      ]
    },
    {
      "id": "sn23.11",
      "segments": [
        {
          "id": "sn23.11:0.1",
          "pali": "Saṃyutta Nikāya 23.11"
        },
        {
          "id": "sn23.11:0.2",
          "pali": "2. Dutiyamāravagga"
        },
        {
          "id": "sn23.11:0.3",
          "pali": "Mārasutta"
        },
        {
          "id": "sn23.11:1.1",
          "pali": "Sāvatthinidānaṃ."
        },
        {
          "id": "sn23.11:1.2",
          "pali": "Ekamantaṃ nisinno kho āyasmā rādho bhagavantaṃ etadavoca:"
        },
        {
          "id": "sn23.11:1.3",
          "pali": "“‘māro, māro’ti, bhante, vuccati."
        },
        {
          "id": "sn23.11:1.4",
          "pali": "Katamo nu kho, bhante, māro”ti?"
        },
        {
          "id": "sn23.11:1.5",
          "pali": "“Rūpaṃ kho, rādha, māro, vedanā māro, saññā māro, saṅkhārā māro, viññāṇaṃ māro."
        },
        {
          "id": "sn23.11:1.6",
          "pali": "Evaṃ passaṃ, rādha, sutavā ariyasāvako rūpasmimpi nibbindati, vedanāyapi nibbindati, saññāyapi nibbindati, saṅkhāresupi nibbindati, viññāṇasmimpi nibbindati."
        },
        {
          "id": "sn23.11:1.7",
          "pali": "Nibbindaṃ virajjati; virāgā vimuccati. Vimuttasmiṃ vimuttamiti ñāṇaṃ hoti."
        },
        {
          "id": "sn23.11:1.8",
          "pali": "‘Khīṇā jāti, vusitaṃ brahmacariyaṃ, kataṃ karaṇīyaṃ, nāparaṃ itthattāyā’ti pajānātī”ti."
        },
        {
          "id": "sn23.11:1.9",
          "pali": "Paṭhamaṃ."
        }
      ]
    },
